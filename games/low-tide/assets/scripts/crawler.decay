// The crawler: a house on treads, driven from its helm.
//
// It is heavy and it is slow to answer. The throttle is a lever that stays
// where it was left, so the crawler keeps going while the crew walks away from
// the helm; the rudder only turns it while somebody is holding it. Every bundle
// of resources in the hold is weight, and weight costs both top speed and how
// quickly it gets there.
//
// The Basin decides the rest. Soft ground (sand, mud, kelp, salt crust) and
// rough ground (reef, rock) hold it back. Brine stops it at the water's edge,
// and so does a cliff: ground ahead standing more than a step above the
// ground under it. A crawler stopped there can still turn on the spot.
//
// Turning is turning the whole floor plan: the deck tilemap and everybody on
// it are children of this entity, so they come along with no help from here.

script Crawler {
    @export let base_mass: f32 = 60.0;
    @export let crate_mass: f32 = 6.0;
    @export let top_speed: f32 = 4.2;
    @export let acceleration: f32 = 0.8;
    @export let turn_rate: f32 = 0.55;
    @export let soft_going: f32 = 0.6;
    @export let rough_going: f32 = 0.4;
    // The highest step up the treads can climb, in levels.
    @export let climb: f32 = 2.0;
    // How far ahead of the middle the bow looks, in units.
    @export let reach: f32 = 4.5;

    var last_wash: f32 = -1.0;
    var speed: f32 = 0.0;
    var deck: Entity = null;
    var basin: Entity = null;
    var shadow: Entity = null;

    // Where crates go in the hold, filled from the stern forward and from the
    // walls inward, so the walkway down the middle stays clear.
    var hold_columns = [4.0, 6.0, 4.0, 6.0];
    var hold_rows = [10.0, 10.0, 8.0, 8.0];

    fn start() {
        this.deck = World.find("Deck");
        this.basin = World.find("Basin");
        this.shadow = World.find("Crawler shadow");
        Game.hull_left = 2.0;
        Game.hull_right = 9.0;
        Game.hull_top = 3.0;
        Game.hull_bottom = 12.0;
        Game.structure_mass = 0.0;
        Game.extensions = 0.0;
        Game.capacity = this.hold_columns.length;
        Game.crates = 0.0;
        Game.throttle = 0.0;
        Game.rudder = 0.0;
    }

    fn update(dt: f32) {
        let mass = this.base_mass + Game.structure_mass + Game.crates * this.crate_mass;
        let lightness = this.base_mass / mass;
        let heading = this.transform.rotation_z;
        let middle = Vec2(this.transform.position.x, this.transform.position.y);
        let forward = Vec2(-sin(heading), cos(heading));

        Game.flooded = flooded_at(this.basin, middle);
        if Game.flooded && this.last_wash != Game.season {
            this.last_wash = Game.season;
            wash_crate();
        }
        Game.ground = ground_of(surface_at(this.basin, middle));
        Game.going = going_at(middle);
        let most = this.top_speed * lightness;
        Game.top_speed = most * Game.going;

        let target = Game.throttle * Game.top_speed;
        let rate = this.acceleration * lightness;
        if this.speed < target {
            this.speed = min(target, this.speed + rate * dt);
        } else {
            this.speed = max(target, this.speed - rate * 1.5 * dt);
        }

        // Treads bite harder the faster they turn, but a crawler can still
        // pivot slowly on the spot.
        let grip = 0.35 + 0.65 * min(1.0, this.speed / 1.5);
        this.transform.rotation_z += Game.rudder * this.turn_rate * grip * dt;

        // Run aground at brine or a cliff: the bow will not go there, so the
        // crawler stops where it is.
        let next = middle + forward * (this.speed * dt);
        Game.blocked = Game.flooded || !passable(middle, next + forward * this.reach);
        if Game.blocked {
            this.speed = 0.0;
        } else {
            this.transform.position = Vec3(next.x, next.y, this.transform.position.z);
        }
        let at = this.transform.position;

        // The shadow falls the same way whichever way the crawler faces, which
        // is half of what makes the turning read.
        if this.shadow != null {
            this.shadow.transform.position = Vec3(at.x + 0.4, at.y - 0.4, 0.08);
            this.shadow.transform.rotation_z = this.transform.rotation_z;
        }

        Game.crawler_x = at.x;
        Game.crawler_y = at.y;
        Game.heading = this.transform.rotation_z;
        Game.speed = this.speed;
    }

    // How much the ground under a point holds the crawler back.
    fn going_at(at: Vec2) -> f32 {
        if tagged_at(this.basin, at, "rough") {
            return this.rough_going;
        }
        if tagged_at(this.basin, at, "soft") {
            return this.soft_going;
        }
        return 1.0;
    }

    // Whether the bow may go to `bow` from a crawler standing at `middle`.
    fn passable(middle: Vec2, bow: Vec2) -> bool {
        if wet_at(this.basin, bow) || surface_at(this.basin, bow) == "" {
            return false;
        }
        return height_at(this.basin, bow) - height_at(this.basin, middle) <= this.climb;
    }

    // A resource bundle carried aboard goes into the first free place in the
    // hold. The crew does not bring one when the hold is full.
    fn stow(kind: Resource) {
        for i in 0..this.hold_columns.length {
            let column = this.hold_columns[i];
            let row = this.hold_rows[i];
            if Grid.tile(this.deck, column, row) == 0.0 {
                Grid.set_tile(this.deck, column, row, cargo_tile(kind));
                Game.crates += 1.0;
                cargo_change(kind, 1.0);
                Game.salvaged += 1.0;
                return;
            }
        }
    }

    // One unsecured crate per flood season, even if the crawler stays trapped.
    fn wash_crate() {
        for i in 0..this.hold_columns.length {
            let column = this.hold_columns[i];
            let row = this.hold_rows[i];
            if tile_cargo(Grid.tile(this.deck, column, row)) != Resource.None {
                jettison(column, row);
                Game.washed += 1.0;
                return;
            }
        }
    }

    // Over the side with it: lighter, and poorer.
    fn jettison(column: f32, row: f32) {
        if tile_cargo(Grid.tile(this.deck, column, row)) != Resource.None {
            let kind = tile_cargo(Grid.tile(this.deck, column, row));
            Grid.set_tile(this.deck, column, row, 0.0);
            Game.crates -= 1.0;
            cargo_change(kind, -1.0);
        }
    }
}
