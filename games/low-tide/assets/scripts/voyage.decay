// What every script shares about the voyage, and how the Basin is read.
//
// The crawler, the crew and the view each keep their own part of `Game`.
// The Basin is a voxel world viewed as a map: a column's X is the plane's X,
// and its row runs down the map, so a point (x, y) is column floor(x), row
// floor(-y). `Grid.surface` and `Grid.height` say what is on top there.

// What the hint line should say, decided by the crew, worded by the HUD.
enum Hint { None, TakeHelm, AtHelm, Salvage, Harvest, Empty, HoldFull, Carrying, Jettison, Ashore, LeftBehind, Brine, Workbench, Building, DiveStart, DiveReturn, DiveSalvage, DiveSwim }

// The kinds of ground the Basin is made of, by what the crawler and the HUD
// make of them.
enum Ground { Salt, Crust, Mud, Sand, Reef, Kelp, Rock, Island, Brine, Nothing }

enum DiveReport { None, Recovered, Returned, Rescued, Full, NoSite }

enum Blueprint { Extension, Bunk, Engine }
enum BuildResult { None, Built, Missing, Limit, Already }

enum Resource { None, Wood, Stone, Ore, Scrap, Fibre, Salt }

enum TidePhase { Low, Rising, High, Falling }

state Game {
    var discard_armed: bool = false;
    var discard_left: f32 = 0.0;
    var focus_kind: Resource = Resource.None;
    var focus_x: f32 = -1.0;
    var focus_y: f32 = -1.0;
    var tide_duration: f32 = 180.0;
    var diving: bool = false;
    var dive_air: f32 = 30.0;
    var dive_x: f32 = -1.5;
    var dive_y: f32 = 0.0;
    var dive_loot: bool = false;
    var dive_empty: bool = false;
    var dive_notice: f32 = 0.0;
    var dive_report: DiveReport = DiveReport.None;
    var tide_time: f32 = 0.0;
    var tide_level: f32 = -17.0;
    var tide_phase: TidePhase = TidePhase.Low;
    var tide_left: f32 = 180.0;
    var season: f32 = 0.0;
    var flooded: bool = false;
    var washed: f32 = 0.0;
    // The crawler.
    var crawler_x: f32 = 0.0;
    var crawler_y: f32 = 0.0;
    var heading: f32 = 0.0;
    var speed: f32 = 0.0;
    var top_speed: f32 = 0.0;
    var throttle: f32 = 0.0;
    var rudder: f32 = 0.0;
    var crates: f32 = 0.0;
    var capacity: f32 = 0.0;
    var hull_left: f32 = 2.0;
    var hull_right: f32 = 9.0;
    var hull_top: f32 = 3.0;
    var hull_bottom: f32 = 12.0;
    var structure_mass: f32 = 0.0;
    var extensions: f32 = 0.0;
    var building: bool = false;
    var blueprint: Blueprint = Blueprint.Extension;
    var build_result: BuildResult = BuildResult.None;
    var has_bunk: bool = false;
    var engine_level: f32 = 0.0;
    // What the crawler is driving on, and how much it holds it back: one is
    // a clear run, less is soft or rough going.
    var ground: Ground = Ground.Salt;
    var going: f32 = 1.0;
    // Whether the last move was refused: brine or a cliff ahead.
    var blocked: bool = false;
    // The crew.
    var aboard: bool = true;
    var at_helm: bool = false;
    var crew_x: f32 = 0.0;
    var crew_y: f32 = 0.0;
    var hint: Hint = Hint.None;
    // Scrap hauled aboard over the voyage, and how much is still aboard.
    var wood: f32 = 0.0;
    var stone: f32 = 0.0;
    var ore: f32 = 0.0;
    var fibre: f32 = 0.0;
    var salt: f32 = 0.0;
    var carried_kind: Resource = Resource.None;
    var gather_kind: Resource = Resource.None;
    var scrap: f32 = 0.0;
    var salvaged: f32 = 0.0;
    // The view: how far the camera is rolled, and whether the player asked
    // for the map to stay north-up.
    var view_rot: f32 = 0.0;
    var prefer_north: bool = false;
    // Whether a finger has touched the screen: the phone's controls show
    // from then on, and the hints talk about them instead of keys.
    var touch: bool = false;
}

// The Basin's block on top at a point in the plane.
shared fn surface_at(basin: Entity, at: Vec2) -> String {
    return Grid.surface(basin, floor(at.x), floor(-at.y));
}

// How high the top is at a point, or very low where nothing stands.
shared fn height_at(basin: Entity, at: Vec2) -> f32 {
    return Grid.height(basin, floor(at.x), floor(-at.y)) ?? -1000.0;
}

// Whether the top at a point carries one of the block set's tags.
shared fn tagged_at(basin: Entity, at: Vec2, tag: String) -> bool {
    let column = floor(at.x);
    let row = floor(-at.y);
    let top = Grid.height(basin, column, row);
    if top == null {
        return false;
    }
    return Grid.tagged(basin, column, row, ceil(top) - 1.0, tag);
}

// What kind of ground a block is.
shared fn ground_of(block: String) -> Ground {
    if block == "salt" { return Ground.Salt; }
    if block == "crust" { return Ground.Crust; }
    if block == "mud" { return Ground.Mud; }
    if block == "sand" { return Ground.Sand; }
    if block == "reef" { return Ground.Reef; }
    if block == "kelp" { return Ground.Kelp; }
    if block == "rock" { return Ground.Rock; }
    if block == "brine" { return Ground.Brine; }
    if block == "" { return Ground.Nothing; }
    return Ground.Island;
}
