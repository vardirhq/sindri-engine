// The voyage: what every script shares, and how it ends.
//
// The crawler, the crew, the Tide and the view each keep their own part of
// `Game`; this script only reads it, decides whether the voyage is won or
// lost, and offers another one once it is over.

shared const RISE_Y: f32 = 250.0;
// The part of the Basin the crawler may drive in; the rest is margin, so a
// turned view never shows past the edge of the map.
shared const PLAY_LEFT: f32 = 14.0;
shared const PLAY_RIGHT: f32 = 58.0;
shared const BASIN_ROWS: f32 = 270.0;

// What the hint line should say, decided by the crew, worded by the HUD.
enum Hint { None, TakeHelm, AtHelm, Salvage, Empty, HoldFull, Carrying, Jettison, Ashore, LeftBehind }

state Game {
    // The crawler.
    var crawler_x: f32 = 36.0;
    var crawler_y: f32 = 14.0;
    var heading: f32 = 0.0;
    var speed: f32 = 0.0;
    var top_speed: f32 = 0.0;
    var throttle: f32 = 0.0;
    var rudder: f32 = 0.0;
    var crates: f32 = 0.0;
    var capacity: f32 = 0.0;
    var on_dunes: bool = false;
    // The crew.
    var aboard: bool = true;
    var at_helm: bool = false;
    var crew_x: f32 = 36.0;
    var crew_y: f32 = 14.0;
    var hint: Hint = Hint.None;
    // Scrap hauled aboard over the voyage, and how much is still aboard.
    var scrap: f32 = 0.0;
    var salvaged: f32 = 0.0;
    // The Tide's leading edge.
    var tide_y: f32 = -4.0;
    // The view: how far the camera is rolled, and whether the player asked
    // for the map to stay north-up.
    var view_rot: f32 = 0.0;
    var prefer_north: bool = false;
    // How it ended.
    var won: bool = false;
    var lost: bool = false;
}

script Voyage {
    fn start() {
        Game.won = false;
        Game.lost = false;
        Game.scrap = 0.0;
        Game.salvaged = 0.0;
    }

    fn update(dt: f32) {
        if Game.won || Game.lost {
            if Action.pressed("use") {
                Scene.go(Scene.current());
            }
            return;
        }
        if Game.crawler_y >= RISE_Y {
            Game.won = true;
            return;
        }
        // The water has the crawler once it is past the middle of the deck,
        // and has a crew member left on the salt as soon as it reaches them.
        if Game.tide_y >= Game.crawler_y {
            Game.lost = true;
        }
        if !Game.aboard && Game.tide_y >= Game.crew_y {
            Game.lost = true;
        }
    }
}
