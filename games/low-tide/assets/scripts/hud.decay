// What the player needs at a glance: scrap, speed, the ground underfoot,
// and one line of what to do here. Narrow enough for a phone
// held upright, and worded for keys or for the touch buttons, whichever the
// player is using.

script Hud {
    var hint: Entity = null;
    var panel: Entity = null;
    var seen_washed: f32 = 0.0;
    var washed_notice: f32 = 0.0;

    fn start() {
        this.hint = World.find("Hint");
        this.panel = World.find("Instrument panel");
    }

    fn update(dt: f32) {
        this.washed_notice = max(0.0, this.washed_notice - dt);
        if Game.washed > this.seen_washed {
            this.seen_washed = Game.washed;
            this.washed_notice = 5.0;
        }
        var status = "Hold " + Game.crates + "/" + Game.capacity + "   Speed " + Game.speed.fixed(1);
        if Game.at_helm { status += "   " + round(Game.throttle * 100.0) + "%"; }
        status += "\n" + match Game.tide_phase {
            TidePhase.Low => "LOW TIDE  /  rises in ",
            TidePhase.Rising => "RISING  /  high in ",
            TidePhase.High => "HIGH TIDE  /  ebb in ",
            TidePhase.Falling => "RECEDING  /  low in ",
        } + ceil(Game.tide_left) + "s";
        status += "\n" + ground_words();
        if Game.blocked { status += "  /  AGROUND"; }
        if Game.flooded { status += "\nDive from aboard at the ramp"; }
        if this.washed_notice > 0.0 { status += "\nCargo washed away by the tide"; }
        if Game.diving {
            status = "LOW TIDE / DIVING\nAir " + ceil(Game.dive_air) + "s\nDepth " + max(0.0, -Game.dive_y).fixed(1);
            if Game.dive_loot { status += "\nCarrying ore + scrap\nHeavy salvage: swim slower"; }
            else if Game.dive_empty { status += "\nThis wreck cache is empty"; }
            else { status += "\nFind the sealed salvage"; }
            status += "\nReturn up the yellow line";
        } else if Game.dive_notice > 0.0 {
            status += "\n" + match Game.dive_report {
                DiveReport.Recovered => "Recovered: 1 ore + 1 scrap",
                DiveReport.Rescued => "Recalled safely; salvage left below",
                DiveReport.Full => "Diving needs two free cargo slots",
                DiveReport.NoSite => "Park near a flooded wreck to dive",
                _ => "Back aboard",
            };
        }
        Ui.set_text(this.entity, status);
        // Width follows the viewport so the header stays readable on phones.
        let width = min(1.5, Viewport.aspect * 1.8);
        var height = 0.24;
        if Game.flooded { height += 0.05; }
        if Game.dive_notice > 0.0 { height += 0.05; }
        if this.washed_notice > 0.0 { height += 0.05; }
        if Game.diving { height = 0.39; }
        this.panel.transform.scale = Vec3(width, height, 1.0);
        this.panel.transform.position = Vec3(0.04 + width * 0.5, -0.02 - height * 0.5, 0.0);
        World.find("Hint panel").transform.scale.x = min(2.4, Viewport.aspect * 1.8);

        if Game.touch {
            Ui.set_text(this.hint, touch_words());
        } else {
            Ui.set_text(this.hint, key_words());
        }
    }

    // What the crawler is driving on, and what it costs.
    fn ground_words() -> String {
        let name = match Game.ground {
            Ground.Salt => "Salt flats",
            Ground.Crust => "Salt crust",
            Ground.Mud => "Mud flats",
            Ground.Sand => "Dunes",
            Ground.Reef => "Dead reef",
            Ground.Kelp => "Kelp beds",
            Ground.Rock => "Bare rock",
            Ground.Island => "Old island",
            Ground.Brine => "Brine",
            _ => "",
        };
        if Game.going < 0.5 {
            return name + " (rough)";
        }
        if Game.going < 1.0 {
            return name + " (soft)";
        }
        return name;
    }

    fn key_words() -> String {
        return match Game.hint {
            Hint.DiveStart => "E  dive from the ramp",
            Hint.DiveReturn => "E  climb aboard     X / Esc  recall",
            Hint.DiveSalvage => "E  recover salvage     X / Esc  recall",
            Hint.DiveSwim => "WASD  swim     X / Esc  recall",
            Hint.Workbench => "E  open the workbench",
            Hint.Building => "Q  next plan     E  build     X / Esc  close",
            Hint.TakeHelm => "E  take the helm",
            Hint.AtHelm => "W/S  throttle     A/D  steer     E  leave the helm",
            Hint.Salvage => "E  salvage a crate of scrap",
            Hint.Harvest => "E  gather " + cargo_name(Game.gather_kind),
            Hint.Jettison => "X  throw this crate over the side",
            _ => shared_words("WASD  walk     Tab  keep the map north-up"),
        };
    }

    fn touch_words() -> String {
        return match Game.hint {
            Hint.DiveStart => "Dive from the ramp into a nearby wreck",
            Hint.DiveReturn => "Climb brings your salvage aboard",
            Hint.DiveSalvage => "Recover the sealed salvage",
            Hint.DiveSwim => "Drag to swim; Recall leaves salvage below",
            Hint.Workbench => "Workbench to build onto your crawler",
            Hint.Building => "Choose a blueprint, then Build; Close returns",
            Hint.TakeHelm => "Helm to take the wheel",
            Hint.AtHelm => "Push up for throttle, sideways to steer",
            Hint.Salvage => "Salvage to take a crate",
            Hint.Harvest => "Gather to take " + cargo_name(Game.gather_kind),
            Hint.Jettison => "Drop throws this crate overboard",
            _ => shared_words("Drag anywhere to walk"),
        };
    }

    // What reads the same on keys and on glass.
    fn shared_words(idle: String) -> String {
        return match Game.hint {
            Hint.Empty => "This wreck is picked clean",
            Hint.HoldFull => "The hold is full: drop a crate first",
            Hint.Carrying => "Carry " + cargo_name(Game.carried_kind) + " aboard up the ramp",
            Hint.Ashore => "Gather nearby, or back up the ramp",
            Hint.LeftBehind => "The crawler is a long way off",
            Hint.Brine => "Brine: stay dry or wade out slowly",
            _ => idle,
        };
    }
}
