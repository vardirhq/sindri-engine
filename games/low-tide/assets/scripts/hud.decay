// What the player needs at a glance: scrap, speed, the ground underfoot,
// and one line of what to do here. Narrow enough for a phone
// held upright, and worded for keys or for the touch buttons, whichever the
// player is using.

script Hud {
    var hint: Entity = null;
    var panel: Entity = null;
    var seen_washed: f32 = 0.0;
    var washed_notice: f32 = 0.0;

    fn start() {
        this.hint = World.find("Hint");
        this.panel = World.find("Instrument panel");
    }

    fn update(dt: f32) {
        this.washed_notice = max(0.0, this.washed_notice - dt);
        if Game.washed > this.seen_washed { this.seen_washed = Game.washed; this.washed_notice = 5.0; }
        instruments();
        context();
        var notice = "";
        if this.washed_notice > 0.0 { notice = "Cargo washed away by the tide"; }
        if Game.flooded && !Game.diving { notice = "Flooded flats: swim out or wait for the ebb"; }
        if Game.dive_notice > 0.0 {
            notice = match Game.dive_report {
                DiveReport.Recovered => "Ore on a float: swim it back up the ramp",
                DiveReport.Rescued => "Surfaced safely; salvage left below",
                DiveReport.Full => "Make one free cargo slot before diving",
                DiveReport.NoSite => "Swim to a golden float in permanent water",
                _ => "Back at the surface",
            };
        }
        World.set_active(World.find("Notice panel"), notice != "" && !Game.building);
        World.set_active(World.find("Notice"), notice != "" && !Game.building);
        Ui.set_text(World.find("Notice"), notice);
        Ui.set_text(this.hint, key_words());
        if Game.touch { Ui.set_text(this.hint, touch_words()); }
        let width = min(2.4, Viewport.aspect * 1.85);
        World.find("Hint panel").transform.scale.x = width;
        World.find("Context panel").transform.scale.x = min(1.7, width);
        World.find("Notice panel").transform.scale.x = min(1.7, width);
    }

    fn instruments() {
        let width = min(1.45, Viewport.aspect * 1.45);
        this.panel.transform.scale = Vec3(width, 0.38, 1.0);
        this.panel.transform.position = Vec3(0.02 + width * 0.5, -0.21, 0.0);
        Ui.set_text(World.find("Hold readout"), "Hold " + Game.crates + "/" + Game.capacity);
        Ui.set_text(World.find("Speed readout"), "Speed " + Game.speed.fixed(1));
        let tide = match Game.tide_phase {
            TidePhase.Low => "LOW / rises ", TidePhase.Rising => "RISING / high ",
            TidePhase.High => "HIGH / ebb ", TidePhase.Falling => "EBB / low ",
        };
        Ui.set_text(World.find("Tide readout"), tide + ceil(Game.tide_left) + "s");
        var status = ground_words();
        if Game.blocked { status += " / aground"; }
        if !Game.aboard {
            status = "On foot";
            if Game.carried_kind != Resource.None { status += " / carrying " + cargo_name(Game.carried_kind); }
            if Game.hint == Hint.Brine || Game.hint == Hint.WaterCargo { status = "Shallow water / wading"; }
            if Game.swimming { status = "Swimming"; }
            if Game.hint == Hint.DiveStart { status += " / submerged wreck"; }
        }
        this.transform.position = Vec3(0.12, -0.33, 0.0);
        if Game.diving {
            status = "Air " + ceil(Game.dive_air) + "s / Depth " + max(0.0, -Game.dive_y).fixed(1);
            this.transform.position.y = -0.14;
            if Game.dive_loot { status += "\nOre secured to your float"; }
            else if Game.dive_empty { status += "\nWreck cache empty"; }
            else { status += "\nFind the sealed salvage"; }
            status += "\nSurface up the yellow line";
            this.panel.transform.scale.y = 0.32;
            this.panel.transform.position.y = -0.18;
        }
        Ui.set_text(this.entity, status);
        for name in ["hold-icon", "speed-icon", "tide-icon", "terrain-icon", "Hold readout", "Speed readout", "Tide readout", "Speed track", "Speed fill", "Tide track", "Tide fill"] {
            World.set_active(World.find(name), !Game.diving);
        }
        meter("Speed track", "Speed fill", width * 0.60, -0.211, width * 0.30, Game.speed / max(0.01, Game.top_speed));
        meter("Tide track", "Tide fill", 0.12, -0.302, width - 0.18, Game.tide_left / max(1.0, Game.tide_duration));
        for i in 0..16 {
            let span = width * 0.30;
            let gap = 0.004;
            let size = max(0.001, span / max(1.0, Game.capacity) - gap);
            let x = width * 0.60 + i * (size + gap) + size * 0.5;
            for prefix in ["Cargo empty ", "Cargo fill ", "Cargo full "] {
                let cell = World.find(prefix + i);
                cell.transform.position = Vec3(x, -0.156, 0.0);
                cell.transform.scale.x = size;
                var show = i < Game.capacity && !Game.diving;
                if prefix != "Cargo empty " { show = show && i < Game.crates; }
                if prefix == "Cargo full " { show = show && Game.crates >= Game.capacity; }
                World.set_active(cell, show);
            }
        }
    }

    fn meter(track: String, fill: String, x: f32, y: f32, width: f32, fraction: f32) {
        let back = World.find(track);
        let bar = World.find(fill);
        let amount = clamp(fraction, 0.0, 1.0);
        back.transform.scale.x = width;
        back.transform.position = Vec3(x + width * 0.5, y, 0.0);
        bar.transform.scale.x = max(0.0001, width * amount);
        bar.transform.position = Vec3(x + width * amount * 0.5, y, 0.0);
    }

    fn context() {
        var title = "";
        var detail = "";
        if Game.hint == Hint.Jettison {
            title = cargo_name(Game.focus_kind).uppercase + " CRATE";
            detail = "Stored aboard / takes one hold slot";
            if Game.discard_armed { detail = "Discard this crate? Press again to confirm"; }
        } else if Game.hint == Hint.Workbench { title = "WORKBENCH"; detail = "Expand the deck or install an upgrade"; }
        else if Game.hint == Hint.TakeHelm { title = "CRAWLER HELM"; detail = "Take the wheel and explore the seabed"; }
        else if Game.hint == Hint.AtHelm { title = "AT THE HELM"; detail = "Throttle " + round(Game.throttle * 100.0) + "% / steer left or right"; }
        else if Game.hint == Hint.Harvest { title = cargo_name(Game.gather_kind).uppercase; detail = "Gather a bundle and carry it aboard"; }
        else if Game.hint == Hint.Salvage { title = cargo_name(Game.focus_kind).uppercase + " CRATE"; detail = "Pick up this crate and carry it aboard"; }
        else if Game.hint == Hint.Carrying { title = "CARRYING " + cargo_name(Game.carried_kind).uppercase; detail = "Drop sets it down; pick it up again later"; }
        else if Game.hint == Hint.DiveStart { title = "SUBMERGED WRECK"; detail = "Shallow dive / ore cache below the float"; }
        else if Game.hint == Hint.Swimming && Game.carried_kind != Resource.None { title = "ORE ON A FLOAT"; detail = "Swim back up the ramp to stow it"; }
        else if Game.diving { title = "UNDERWATER"; detail = "Follow the yellow line back to the surface"; }
        let visible = title != "" && !Game.building;
        for name in ["Context panel", "Context title", "Context detail", "context-icon"] { World.set_active(World.find(name), visible); }
        World.set_active(World.find("context-icon"), visible && (Game.hint == Hint.Jettison || Game.hint == Hint.Salvage || Game.hint == Hint.Carrying));
        var height = 0.20;
        var centre = 0.40;
        if Game.touch { height = 0.34; centre = 0.335; }
        World.find("Context panel").transform.scale.y = height;
        World.find("Context panel").transform.position.y = centre;
        Ui.set_text(World.find("Context title"), title);
        Ui.set_text(World.find("Context detail"), detail);
    }

    // What the crawler is driving on, and what it costs.
    fn ground_words() -> String {
        let name = match Game.ground {
            Ground.Salt => "Salt flats",
            Ground.Crust => "Salt crust",
            Ground.Mud => "Mud flats",
            Ground.Sand => "Dunes",
            Ground.Reef => "Dead reef",
            Ground.Kelp => "Kelp beds",
            Ground.Rock => "Bare rock",
            Ground.Island => "Old island",
            Ground.Brine => "Brine",
            _ => "",
        };
        if Game.going < 0.5 {
            return name + " (rough)";
        }
        if Game.going < 1.0 {
            return name + " (soft)";
        }
        return name;
    }

    fn key_words() -> String {
        return match Game.hint {
            Hint.DiveStart => "E  dive beneath the wreck float",
            Hint.DiveReturn => "E  surface with salvage     X / Esc  abandon dive",
            Hint.DiveSalvage => "E  recover ore     X / Esc  abandon dive",
            Hint.DiveSwim => "WASD  swim     X / Esc  surface without salvage",
            Hint.Workbench => "E  open the workbench",
            Hint.Building => "Q  next plan     E  build     X / Esc  close",
            Hint.TakeHelm => "E  take the helm",
            Hint.AtHelm => "W/S  throttle     A/D  steer     E  leave the helm",
            Hint.Salvage => "E  pick up " + cargo_name(Game.focus_kind) + " crate",
            Hint.Carrying => "Carry aboard / X  set down",
            Hint.Harvest => "E  gather " + cargo_name(Game.gather_kind),
            Hint.Jettison => "X twice  discard crate / Esc cancel",
            _ => shared_words("WASD  walk     Tab  keep the map north-up"),
        };
    }

    fn touch_words() -> String {
        return match Game.hint {
            Hint.DiveStart => "Dive beneath the float into the submerged wreck",
            Hint.DiveReturn => "Surface brings ore onto your float; swim home",
            Hint.DiveSalvage => "Recover the sealed ore bundle",
            Hint.DiveSwim => "Drag to swim; Abort leaves salvage below",
            Hint.Workbench => "Workbench to build onto your crawler",
            Hint.Building => "Choose a blueprint, then Build; Close returns",
            Hint.TakeHelm => "Helm to take the wheel",
            Hint.AtHelm => "Push up for throttle, sideways to steer",
            Hint.Salvage => "Pick up the highlighted " + cargo_name(Game.focus_kind) + " crate",
            Hint.Carrying => "Carry aboard; Drop sets the crate down",
            Hint.Harvest => "Gather to take " + cargo_name(Game.gather_kind),
            Hint.Jettison => "Drop, then Discard confirms; moving away cancels",
            _ => shared_words("Drag anywhere to walk"),
        };
    }

    // What reads the same on keys and on glass.
    fn shared_words(idle: String) -> String {
        if Game.swimming && Game.carried_kind != Resource.None { return "Float the ore home; Drop leaves it in the water"; }
        return match Game.hint {
            Hint.Empty => "This wreck is picked clean",
            Hint.HoldFull => "The hold is full: drop a crate first",
            Hint.Carrying => "Carry " + cargo_name(Game.carried_kind) + " aboard up the ramp",
            Hint.Ashore => "Gather nearby, or back up the ramp",
            Hint.LeftBehind => "The crawler is a long way off",
            Hint.Swimming => "Swimming: look for golden wreck floats, or swim home",
            Hint.WaterCargo => "Crates are too bulky to swim with; wade out or Drop",
            Hint.Brine => "Shallow water: wade toward dry ground",
            _ => idle,
        };
    }
}
