// What the player needs at a glance: scrap, speed, the Rise and the Tide,
// one line of what to do here, and the ending. Narrow enough for a phone
// held upright, and worded for keys or for the touch buttons, whichever the
// player is using.

script Hud {
    var tide: Entity = null;
    var hint: Entity = null;
    var banner: Entity = null;

    fn start() {
        this.tide = World.find("Tide gap");
        this.hint = World.find("Hint");
        this.banner = World.find("Banner");
    }

    fn update(dt: f32) {
        var status = "Scrap " + Game.scrap + "/" + Game.capacity;
        status = status + "   Throttle " + round(Game.throttle * 100.0) + "%";
        status = status + "\nSpeed " + Game.speed.fixed(1) + " of " + Game.top_speed.fixed(1);
        if Game.on_dunes {
            status = status + "  (soft sand)";
        }
        status = status + "\nThe Rise " + max(0.0, RISE_Y - Game.crawler_y).fixed(0) + " m ahead";
        Ui.set_text(this.entity, status);

        let gap = Game.crawler_y - Game.tide_y;
        if gap < 10.0 {
            Ui.set_text(this.tide, "Tide " + max(0.0, gap).fixed(0) + " m!");
        } else {
            Ui.set_text(this.tide, "Tide " + gap.fixed(0) + " m");
        }

        if Game.touch {
            Ui.set_text(this.hint, touch_words());
        } else {
            Ui.set_text(this.hint, key_words());
        }

        World.set_active(this.banner, Game.won || Game.lost);
        var again = "E to sail again";
        if Game.touch {
            again = "Tap to sail again";
        }
        if Game.won {
            Ui.set_text(this.banner, "You reached the Rise\nwith " + Game.scrap + " scrap\n" + again);
        } else if Game.lost {
            Ui.set_text(this.banner, "The Tide took\nthe crawler\n" + again);
        }
    }

    fn key_words() -> String {
        return match Game.hint {
            Hint.TakeHelm => "E  take the helm",
            Hint.AtHelm => "W/S  throttle     A/D  steer     E  leave the helm",
            Hint.Salvage => "E  salvage a crate of scrap",
            Hint.Jettison => "X  throw this crate over the side",
            _ => shared_words("WASD  walk     Tab  keep the map north-up"),
        };
    }

    fn touch_words() -> String {
        return match Game.hint {
            Hint.TakeHelm => "Helm to take the wheel",
            Hint.AtHelm => "Push up for throttle, sideways to steer",
            Hint.Salvage => "Salvage to take a crate",
            Hint.Jettison => "Drop throws this crate overboard",
            _ => shared_words("Drag anywhere to walk"),
        };
    }

    // What reads the same on keys and on glass.
    fn shared_words(idle: String) -> String {
        return match Game.hint {
            Hint.Empty => "This wreck is picked clean",
            Hint.HoldFull => "The hold is full: drop a crate first",
            Hint.Carrying => "Carry it back aboard up the ramp",
            Hint.Ashore => "Walk to a wreck, or back up the ramp",
            Hint.LeftBehind => "The crawler is leaving without you!",
            _ => idle,
        };
    }
}
