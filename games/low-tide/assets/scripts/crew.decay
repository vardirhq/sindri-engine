// The crew member you play: walks the deck while it moves, takes the helm,
// goes ashore to salvage and carries scrap home.
//
// Aboard, the crew is a child of the deck tilemap, so their position is
// measured in the crawler's own floor plan: one unit a tile, x across from the
// port side and y down from the bow. Walking and walls are worked out there as
// if the crawler never moved, and the parent does the rest. Stepping off the
// ramp re-parents them to the world; stepping back on re-parents them to the
// deck. Those two moments are the only places the crawler's motion matters.
//
// Controls are screen-relative: up is up on screen whichever way the view is
// turned, so the stick is turned into the frame it is walking in. Keys, the
// d-pad and a thumb on the touch stick all arrive through `steering()`.

const DECK_COLUMNS: f32 = 11.0;
const DECK_ROWS: f32 = 14.0;
const HELM_X: f32 = 5.5;
const HELM_Y: f32 = -4.5;
const RAMP: f32 = 10.0;

script Crew {
    @export let walk_speed: f32 = 3.4;
    @export let radius: f32 = 0.3;
    @export let reach: f32 = 3.8;

    var deck: Entity = null;
    var crawler: Entity = null;
    var carried: Entity = null;
    var basin: Entity = null;
    var workbench: Entity = null;
    var wading: bool = false;
    var use_button: Entity = null;
    var drop_button: Entity = null;
    var carrying: bool = false;
    var view: String = "down";
    var flip: f32 = 1.0;

    fn start() {
        this.deck = World.find("Deck");
        this.crawler = World.find("Crawler");
        this.carried = World.find("Carried");
        this.basin = World.find("Basin");
        this.workbench = World.find("Workbench");
        this.use_button = World.find("Use button");
        this.drop_button = World.find("Drop button");
        Game.aboard = true;
        Game.at_helm = false;
    }

    fn update(dt: f32) {
        if Game.diving { return; }
        Game.discard_left = max(0.0, Game.discard_left - dt);
        if Game.discard_left <= 0.0 || Action.pressed("cancel") { Game.discard_armed = false; }
        let stick = steering();
        if Action.pressed("use") || Ui.is_pressed(this.use_button) {
            use();
        }
        if Action.pressed("drop") || Ui.is_pressed(this.drop_button) {
            drop();
        }
        if Game.building {
            pose(Vec2(0.0, 0.0));
            Game.hint = Hint.Building;
            return;
        }
        if Game.at_helm {
            Game.throttle = clamp(Game.throttle + stick.y * 0.5 * dt, 0.0, 1.0);
            Game.rudder = -stick.x;
            this.view = "up";
            pose(Vec2(0.0, 0.0));
            Game.hint = Hint.AtHelm;
            return;
        }
        if Game.aboard {
            walk_aboard(stick, dt);
        } else {
            walk_ashore(stick, dt);
        }
        pose(stick);
        let at = this.transform.world_position;
        Game.crew_x = at.x;
        Game.crew_y = at.y;
        decide_hint();
    }

    // E: the helm when standing at it, salvage when standing by a wreck.
    fn use() {
        if Game.aboard {
            if Game.building { Workbench.on(this.workbench).craft(); return; }
            if Game.at_helm {
                Game.at_helm = false;
                Game.rudder = 0.0;
            } else if near_helm() {
                Game.at_helm = true;
                this.transform.position = Vec3(HELM_X, HELM_Y, 0.1);
            } else if near_dive_ramp() {
                Dive.on(World.find("Dive controller")).enter();
            } else if near_workbench() {
                Workbench.on(this.workbench).open();
            }
            return;
        }
        let at = this.transform.world_position;
        if this.carrying || Game.crates >= Game.capacity || wet_at(this.basin, Vec2(at.x, at.y)) {
            return;
        }
        let wreck = nearby_wreck();
        if wreck != null && Wreck.on(wreck).scrap > 0.0 {
            let wreck_at = wreck.transform.world_position;
            if !wet_at(this.basin, Vec2(wreck_at.x, wreck_at.y)) {
                Wreck.on(wreck).take();
                carry(Resource.Scrap);
                return;
            }
        }
        let target = harvest_target(this.basin, Vec2(at.x, at.y));
        if target == null { return; }
        let top = Grid.height(this.basin, target.x, target.y);
        if top == null { return; }
        let kind = resource_at(this.basin, target.x, target.y);
        Grid.set_block(this.basin, target.x, target.y, ceil(top) - 1.0, "");
        carry(kind);
    }

    fn carry(kind: Resource) {
        this.carrying = true;
        Game.carried_kind = kind;
        show_carried();
    }

    // X: throw the nearest crate in the hold over the side.
    fn drop() {
        if Game.building { Game.building = false; return; }
        if !Game.aboard || Game.at_helm {
            return;
        }
        let cell = nearby_crate();
        if cell != null {
            if Game.discard_armed && cell.x == Game.focus_x && cell.y == Game.focus_y {
                Crawler.on(this.crawler).jettison(cell.x, cell.y);
                Game.discard_armed = false;
            } else {
                Game.focus_x = cell.x;
                Game.focus_y = cell.y;
                Game.discard_armed = true;
                Game.discard_left = 4.0;
            }
        }
    }

    fn walk_aboard(stick: Vec2, dt: f32) {
        // Screen up, turned into the floor plan's frame.
        let way = turned(stick, Game.view_rot - Game.heading) * this.walk_speed * dt;
        var at = this.transform.position;
        // Somebody already overlapping a wall may always move: refusing every
        // step that does not end in the clear would leave them stuck there.
        let stuck = !open_at(at.x, at.y);
        if stuck || open_at(at.x + way.x, at.y) {
            at.x += way.x;
        }
        if stuck || open_at(at.x, at.y + way.y) {
            at.y += way.y;
        }
        this.transform.position = at;
        if at.x >= Game.hull_right {
            go_ashore();
        }
    }

    fn walk_ashore(stick: Vec2, dt: f32) {
        var at = this.transform.position;
        let caught = wet_at(this.basin, Vec2(at.x, at.y));
        if caught && this.carrying {
            this.carrying = false;
            Game.carried_kind = Resource.None;
            Game.washed += 1.0;
            show_carried();
        }
        var pace = this.walk_speed;
        if caught { pace *= 0.35; }
        let way = turned(stick, Game.view_rot) * pace * dt;
        let next = Vec2(at.x + way.x, at.y + way.y);
        this.wading = wet_at(this.basin, next);
        // Dry feet will not enter brine. Caught feet can always wade out,
        // including across a flat flooded shelf: no invisible prison or death.
        if caught || !this.wading {
            at.x = next.x;
            at.y = next.y;
        }
        this.transform.position = at;
        // The only way aboard is up the ramp.
        let local = on_deck(Vec2(at.x, at.y));
        if Grid.tile(this.deck, floor(local.x), floor(-local.y)) == RAMP {
            come_aboard(local);
        }
    }

    fn go_ashore() {
        let at = this.transform.world_position;
        World.set_parent(this.entity, null);
        this.transform.position = Vec3(at.x, at.y, 0.3);
        Game.aboard = false;
        // Nobody is left aboard to drive, so stepping off drops the anchor:
        // the throttle comes back to nothing and the crawler rolls to a stop
        // rather than leaving without you.
        Game.throttle = 0.0;
    }

    fn come_aboard(local: Vec2) {
        World.set_parent(this.entity, this.deck);
        // Onto the middle of the ramp, whichever corner of it was stepped on:
        // its edges touch the treads, which nobody can stand in.
        let row = floor(-local.y);
        let across = min(local.x, Game.hull_right - 1.0 + this.radius + 0.05);
        this.transform.position = Vec3(across, -row - 0.5, 0.1);
        Game.aboard = true;
        if this.carrying {
            Crawler.on(this.crawler).stow(Game.carried_kind);
            this.carrying = false;
            Game.carried_kind = Resource.None;
            show_carried();
        }
    }

    // A point in the world, in the deck's floor plan.
    fn on_deck(world: Vec2) -> Vec2 {
        let from_middle = world - Vec2(Game.crawler_x, Game.crawler_y);
        let local = turned(from_middle, -Game.heading);
        return Vec2(local.x + DECK_COLUMNS / 2.0, local.y - DECK_ROWS / 2.0);
    }

    // Whether the crew, centred here, fits between the walls.
    fn open_at(x: f32, y: f32) -> bool {
        let r = this.radius;
        return walkable(x - r, y - r) && walkable(x + r, y - r) && walkable(x - r, y + r) && walkable(x + r, y + r);
    }

    // Deck, doors, the hatch, the helm and the ramp can be walked on; walls,
    // treads, furniture and crates cannot. Off the plan is the open salt,
    // which only the ramp reaches.
    fn walkable(x: f32, y: f32) -> bool {
        let tile = Grid.tile(this.deck, floor(x), floor(-y));
        if x >= Game.hull_right && floor(-y) == 7.0 {
            return true;
        }
        return tile == 0.0 || tile == 3.0 || tile == 4.0 || tile == 5.0 || tile == 10.0;
    }

    fn near_dive_ramp() -> bool {
        let at = this.transform.position;
        return Game.flooded && Game.tide_phase == TidePhase.High && Vec2(at.x, at.y).distance(Vec2(7.5, -7.5)) < 1.3;
    }

    fn near_workbench() -> bool {
        let at = this.transform.position;
        return Vec2(at.x, at.y).distance(Vec2(4.5, -6.5)) < 1.15;
    }

    fn near_helm() -> bool {
        let at = this.transform.position;
        return Vec2(at.x, at.y).distance(Vec2(HELM_X, HELM_Y)) < 1.1;
    }

    fn nearby_wreck() -> Entity {
        let at = this.transform.world_position;
        let wreck = World.nearest("wreck", at);
        if wreck == null {
            return null;
        }
        if wreck.transform.world_position.distance(at) > this.reach {
            return null;
        }
        return wreck;
    }

    // The crate cell next to the crew, if there is one.
    fn nearby_crate() -> Vec2? {
        let at = this.transform.position;
        let column = floor(at.x);
        let row = floor(-at.y);
        for dy in 0..3 {
            for dx in 0..3 {
                let c = column + dx - 1.0;
                let r = row + dy - 1.0;
                if tile_cargo(Grid.tile(this.deck, c, r)) != Resource.None {
                    return Vec2(c, r);
                }
            }
        }
        return null;
    }

    fn decide_hint() {
        if !Game.aboard {
            let wreck = nearby_wreck();
            let at = this.transform.world_position;
            let target = harvest_target(this.basin, Vec2(at.x, at.y));
            Game.gather_kind = Resource.None;
            if target != null { Game.gather_kind = resource_at(this.basin, target.x, target.y); }
            if wet_at(this.basin, Vec2(at.x, at.y)) {
                Game.hint = Hint.Brine;
            } else if this.carrying {
                Game.hint = Hint.Carrying;
            } else if wreck != null && Wreck.on(wreck).scrap <= 0.0 && target == null {
                Game.hint = Hint.Empty;
            } else if (wreck != null || target != null) && Game.crates >= Game.capacity {
                Game.hint = Hint.HoldFull;
            } else if wreck != null && Wreck.on(wreck).scrap > 0.0 && !wet_at(this.basin, Vec2(wreck.transform.world_position.x, wreck.transform.world_position.y)) {
                Game.hint = Hint.Salvage;
            } else if target != null {
                Game.hint = Hint.Harvest;
            } else if this.wading {
                Game.hint = Hint.Brine;
            } else if Vec2(Game.crew_x, Game.crew_y).distance(Vec2(Game.crawler_x, Game.crawler_y)) > 12.0 {
                Game.hint = Hint.LeftBehind;
            } else {
                Game.hint = Hint.Ashore;
            }
        } else if near_helm() {
            Game.hint = Hint.TakeHelm;
        } else if near_dive_ramp() {
            Game.hint = Hint.DiveStart;
        } else if near_workbench() {
            Game.hint = Hint.Workbench;
        } else if nearby_crate() != null {
            Game.hint = Hint.Jettison;
        } else {
            Game.hint = Hint.None;
        }
        sync_focus();
    }

    fn sync_focus() {
        let marker = World.find("Crate focus");
        let visible = Game.hint == Hint.Jettison && Game.aboard;
        World.set_active(marker, visible);
        if visible {
            let cell = nearby_crate();
            if cell != null {
                if cell.x != Game.focus_x || cell.y != Game.focus_y { Game.discard_armed = false; }
                Game.focus_x = cell.x;
                Game.focus_y = cell.y;
                Game.focus_kind = tile_cargo(Grid.tile(this.deck, cell.x, cell.y));
                marker.transform.position = Vec3(cell.x + 0.5, -cell.y - 0.5, 0.2);
            }
        } else {
            Game.focus_kind = Resource.None;
            Game.discard_armed = false;
        }
    }

    // Paper-doll facing, chosen from the way the crew moves on screen, and
    // turned against the crawler and the camera so it always stands upright.
    fn pose(stick: Vec2) {
        let moving = stick.length > 0.1;
        if moving {
            if abs(stick.x) > abs(stick.y) {
                this.view = "side";
                this.flip = sign(stick.x);
            } else if stick.y > 0.0 {
                this.view = "up";
            } else {
                this.view = "down";
            }
            Animation.play(this.entity, this.view);
        } else {
            Animation.play(this.entity, this.view + "-still");
        }
        if this.view == "side" {
            this.transform.scale.x = 1.1 * this.flip;
        } else {
            this.transform.scale.x = 1.1;
        }
        if Game.aboard {
            this.transform.rotation_z = Game.view_rot - Game.heading;
        } else {
            this.transform.rotation_z = Game.view_rot;
        }
    }

    fn show_carried() {
        if this.carried != null {
            World.set_active(this.carried, this.carrying);
            if this.carrying { Animation.play(this.carried, cargo_name(Game.carried_kind)); }
        }
    }
}

// A vector turned anticlockwise by an angle in radians.
shared fn turned(v: Vec2, angle: f32) -> Vec2 {
    let c = cos(angle);
    let s = sin(angle);
    return Vec2(v.x * c - v.y * s, v.x * s + v.y * c);
}
