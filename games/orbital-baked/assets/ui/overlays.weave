/* Pause and results: a heading column with the actions, and a second column
   of detail (the field manual, the run's breakdown). Stacked on a phone. */

.pause-panel { width: 124vh; max-width: 96vw; height: 72vh; y: 0vh; }
.pause-kicker { width: 44vh; height: 2.6vh; x: -31vh; y: 24vh; anchor: center; }
.pause-title { width: 44vh; height: 7vh; x: -31vh; y: 17vh; anchor: center; }
.pause-resume { width: 44vh; height: 10vh; x: -31vh; y: 1vh; }
.pause-quit { width: 44vh; height: 7.5vh; x: -31vh; y: -11vh; }
.pause-manual-title { width: 52vh; height: 2.6vh; x: 31vh; y: 28vh; anchor: center; }
/* The mixer: a label and a slider per bus, under the actions. The slider is
   the track; its fill is an image the mixer script fills to the value. */
.mix-label {
    width: 10vh; height: 2.6vh; x: -46vh; anchor: center;
    font-weight: 700; font-size: 1.8vh; line-height: 2.2vh; letter-spacing: 0.3vh;
    color: var(--muted); text-align: start;
}
.mix-track {
    width: 30vh; height: 3vh; x: -24vh; anchor: center;
    background: #0a1726; border-color: #1f3349; border-width: 1px; border-radius: 0.6vh;
}
.mix-track:hover { border-color: #3f6384; }
.mix-track:focus { border-color: var(--cyan); border-width: 2px; }
.mix-fill { width: 30vh; height: 3vh; x: 0px; y: 0px; }
.mix-master { y: -19vh; }
.mix-music { y: -25vh; }
.mix-effects { y: -31vh; }
.manual {
    width: 52vh; height: 50vh; x: 31vh; y: -1vh;
    padding: 1vh; gap: 0.8vh;
    background: var(--well); border-color: #1b2e45; border-width: 1px; border-radius: 10px;
}
.manual-row {
    width: 100%; height: 6.4vh; padding: 0px 1.6vh; flex-shrink: 0;
    direction: row; justify-content: space-between; align-items: center;
    background: #0a1627; border-color: #152538; border-width: 1px; border-radius: 8px;
}
.manual-row .row-key { width: 34%; color: var(--accent); }
.manual-row .row-value { width: 62%; font-size: 1.9vh; color: var(--ink); text-align: start; }

.result-panel { width: 124vh; max-width: 96vw; height: 80vh; y: 0vh; }
.result-kicker { width: 44vh; height: 2.6vh; x: -31vh; y: 30vh; anchor: center; }
.result-pilot {
    width: 44vh; height: 3.4vh; x: -31vh; y: 25vh; anchor: center;
    font-size: 2.4vh; line-height: 3vh; letter-spacing: 0.3vh; color: var(--muted); text-align: start;
}
.result-score-kicker { width: 44vh; height: 2.6vh; x: -31vh; y: 15vh; anchor: center; color: var(--faint); }
.result-score {
    width: 44vh; height: 11vh; x: -31vh; y: 7vh; anchor: center;
    font-size: 9vh; line-height: 10vh; color: var(--ink); text-align: start;
}
.result-again { width: 44vh; height: 10vh; x: -31vh; y: -12vh; }
.result-rush { width: 44vh; height: 7.5vh; x: -31vh; y: -24vh; }
.result-breakdown { width: 52vh; height: 2.6vh; x: 31vh; y: 30vh; anchor: center; }
.result-stats {
    width: 52vh; height: 50vh; x: 31vh; y: 1vh;
    direction: column; gap: 1.2vh; justify-content: start; align-items: center;
}
.stat-row {
    width: 100%; height: 8vh; padding: 0px 2vh;
    direction: row; justify-content: space-between; align-items: center;
    background: #0a1627; border-color: #152538; border-width: 1px; border-radius: 8px;
}
.stat-row .row-value { font-size: 2.8vh; line-height: 3.2vh; height: 3.4vh; }

@media (orientation: portrait) {
    .pause-panel { width: 48vh; max-width: 94vw; height: 88vh; }
    .pause-kicker { width: 44vh; max-width: 84vw; x: 0px; y: 39vh; }
    .pause-title { width: 44vh; max-width: 84vw; height: 5.6vh; x: 0px; y: 34vh; font-size: 4.4vh; }
    .pause-resume { width: 44vh; max-width: 84vw; height: 8vh; x: 0px; y: 25vh; }
    .pause-quit { width: 44vh; max-width: 84vw; height: 6.4vh; x: 0px; y: 16.4vh; }
    .pause-manual-title { width: 44vh; max-width: 84vw; x: 0px; y: -3.6vh; }
    .manual { width: 44vh; max-width: 84vw; height: 34vh; x: 0px; y: -22.5vh; }
    .mix-label { x: -14vh; }
    .mix-track, .mix-fill { width: 26vh; max-width: 50vw; }
    .mix-track { x: 8vh; }
    .mix-master { y: 10vh; }
    .mix-music { y: 5.6vh; }
    .mix-effects { y: 1.2vh; }
    .manual-row { height: 6vh; }
    .manual-row .row-value { font-size: 1.6vh; }

    .result-panel { width: 48vh; max-width: 94vw; height: 92vh; }
    .result-kicker { width: 44vh; max-width: 84vw; x: 0px; y: 41vh; }
    .result-pilot { width: 44vh; max-width: 84vw; x: 0px; y: 37vh; font-size: 2vh; }
    .result-score-kicker { width: 44vh; max-width: 84vw; x: 0px; y: 31vh; }
    .result-score { width: 44vh; max-width: 84vw; height: 8vh; x: 0px; y: 25.6vh; font-size: 6.4vh; line-height: 7vh; }
    .result-breakdown { width: 44vh; max-width: 84vw; x: 0px; y: 18vh; }
    .result-stats { width: 44vh; max-width: 84vw; height: 36vh; x: 0px; y: -1.4vh; gap: 0.9vh; }
    .stat-row { height: 6.4vh; }
    .stat-row .row-value { font-size: 2.2vh; }
    .result-again { width: 44vh; max-width: 84vw; height: 8vh; x: 0px; y: -27vh; }
    .result-rush { width: 44vh; max-width: 84vw; height: 6.4vh; x: 0px; y: -36.4vh; }
}
