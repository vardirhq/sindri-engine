/* The run's HUD: where you are and for how long across the top, your ship
   along the bottom left, and a boss only when there is one. Pixel-sized on
   a desktop, width-sized on a phone. Compact mode hides the panels and
   captions (everything tagged hud-chrome) and keeps the readings. */

.hud-text { color: var(--ink); text-transform: uppercase; }
.hud-panel {
    background: #06101ed9;
    border-color: #1b2e45;
    border-width: 1px;
    border-radius: 10px;
}
.hud-kicker { height: 14px; font-size: 11px; line-height: 13px; letter-spacing: 2px; color: var(--muted); }

/* Sector, top left. */
.hud-sector-back { width: 240px; height: 58px; x: 136px; y: -45px; anchor: top_left; }
.hud-sector-kicker { width: 210px; x: 30px; y: -25px; anchor: top_left; text-align: start; }
.hud-sector {
    width: 210px; height: 24px; x: 30px; y: -40px; anchor: top_left;
    font-size: 18px; line-height: 22px; letter-spacing: 2px; color: var(--accent); text-align: start;
}

/* Survival clock, top centre. */
.hud-clock-back { width: 170px; height: 58px; x: 0px; y: -45px; anchor: top; }
.hud-clock-kicker { width: 150px; x: 0px; y: -25px; anchor: top; text-align: center; }
.hud-clock {
    width: 150px; height: 32px; x: 0px; y: -38px; anchor: top;
    font-size: 28px; line-height: 30px; letter-spacing: 3px; color: var(--ink); text-align: center;
}

/* Pilot, score and level, top right. */
.hud-stats-back { width: 240px; height: 58px; x: -136px; y: -45px; anchor: top_right; }
.hud-pilot { width: 150px; x: -96px; y: -25px; anchor: top_right; text-align: end; }
.hud-score {
    width: 150px; height: 26px; x: -96px; y: -39px; anchor: top_right;
    font-size: 22px; line-height: 24px; letter-spacing: 1px; color: var(--ink); text-align: end;
}
.hud-level {
    width: 64px; height: 24px; x: -28px; y: -34px; anchor: top_right;
    font-size: 16px; line-height: 20px; letter-spacing: 1px; color: var(--accent); text-align: end;
}

/* Hull and XP, bottom left: each label on its own line above its meter.
   Panels and meters are placed by their centre; text by its anchor. Kept
   narrow, about a quarter of a 960-wide screen, because the field is the
   game: the original carries these readings in one small top cluster. */
.hud-vitals-back { width: 260px; height: 74px; x: 146px; y: 53px; anchor: bottom_left; }
.hud-meter-label {
    width: 232px; height: 14px; x: 30px; anchor: bottom_left;
    font-size: 12px; line-height: 14px; letter-spacing: 2px; text-align: start;
}
.hud-health-label { y: 64px; color: var(--ink); }
.hud-xp-label { y: 35px; color: var(--cyan); }
.hud-player-meter { width: 232px; x: 146px; anchor: bottom_left; }
.health-meter { height: 12px; y: 54px; }
.cores-meter { height: 6px; y: 27px; }

/* Boss: a warm strip under the clock that no other reading uses. Kept slim,
   because a boss enters from the top and the original names it in one thin
   line rather than a panel over the field. */
.hud-boss-frame {
    width: 360px; height: 50px; x: 0px; y: -101px; anchor: top;
    background: #1a0710cc; border-color: #9f2c43; border-width: 1px; border-radius: 8px;
}
.hud-boss-kicker { width: 330px; x: 0px; y: -80px; color: #f59e0b; text-align: center; }
.hud-boss-name {
    width: 330px; height: 18px; x: 0px; y: -93px; anchor: top;
    font-size: 14px; line-height: 16px; letter-spacing: 4px; color: var(--danger); text-align: center;
}
.hud-boss-meter { width: 320px; height: 6px; x: 0px; y: -116px; anchor: top; }

/* Event: the original's sector event banner, a cool strip under the boss
   strip so the two can show together. */
.hud-event-frame {
    width: 360px; height: 56px; x: 0px; y: -159px; anchor: top;
    border-width: 1px; border-radius: 8px;
}
.hud-event-title {
    width: 340px; height: 16px; x: 0px; y: -139px; anchor: top;
    font-size: 13px; line-height: 15px; letter-spacing: 3px; text-align: center;
}
.hud-event-text {
    width: 340px; height: 14px; x: 0px; y: -160px; anchor: top;
    font-size: 12px; line-height: 14px; letter-spacing: 0px; text-align: center;
}

@media (max-width: 700px) {
    .hud-kicker { height: 3.2vw; font-size: 2.5vw; line-height: 3vw; letter-spacing: 0.4vw; }
    .hud-sector-back { width: 45vw; height: 14vw; x: 25.5vw; y: -10vw; }
    .hud-sector-kicker { width: 40vw; x: 5.5vw; y: -5vw; }
    .hud-sector { width: 40vw; height: 5vw; x: 5.5vw; y: -8.6vw; font-size: 3.8vw; line-height: 4.6vw; letter-spacing: 0.4vw; }
    .hud-stats-back { width: 45vw; height: 14vw; x: -25.5vw; y: -10vw; }
    .hud-pilot { width: 36vw; x: -5vw; y: -5vw; }
    .hud-score { width: 22vw; height: 5.4vw; x: -18vw; y: -8.4vw; font-size: 4.4vw; line-height: 5vw; }
    .hud-level { width: 12vw; height: 4.6vw; x: -4vw; y: -7.6vw; font-size: 3.4vw; line-height: 4.2vw; }
    .hud-clock-back { width: 34vw; height: 13vw; y: -25.5vw; }
    .hud-clock-kicker { width: 30vw; y: -21vw; }
    .hud-clock { width: 30vw; height: 7vw; y: -24vw; font-size: 6vw; line-height: 6.6vw; letter-spacing: 0.6vw; }
    .hud-vitals-back { width: 94vw; height: 22vw; x: 50vw; y: 14vw; }
    .hud-meter-label { width: 86vw; height: 3.8vw; x: 7vw; font-size: 3vw; line-height: 3.6vw; letter-spacing: 0.4vw; }
    .hud-health-label { y: 18.4vw; }
    .hud-xp-label { y: 9.4vw; }
    .hud-player-meter { width: 86vw; x: 50vw; }
    .health-meter { height: 3.8vw; y: 15.5vw; }
    .cores-meter { height: 2vw; y: 7vw; }
    .hud-boss-frame { width: 80vw; height: 12vw; y: -39.5vw; }
    .hud-boss-kicker { width: 74vw; y: -34.6vw; }
    .hud-boss-name { width: 74vw; height: 4vw; y: -37.6vw; font-size: 3.2vw; line-height: 3.8vw; letter-spacing: 0.8vw; }
    .hud-boss-meter { width: 74vw; height: 1.6vw; y: -43.2vw; }
    .hud-event-frame { width: 80vw; height: 14vw; y: -54vw; }
    .hud-event-title { width: 74vw; height: 3.6vw; y: -48.6vw; font-size: 3vw; line-height: 3.4vw; letter-spacing: 0.6vw; }
    .hud-event-text { width: 74vw; height: 7vw; y: -52.6vw; font-size: 3vw; line-height: 3.5vw; }
}
