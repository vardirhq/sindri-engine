    .port-option { width: 84vw; height: 5.5vh; x: 0px; }
    .port-option-0 { y: 0px; }
    .port-option-1 { y: -7vh; }
    .port-option-2 { y: -14vh; }
    .port-controls { width: 82vw; height: 15vh; y: -26vh; font-size: 1.2vh; line-height: 1.7vh; }
    .port-lab { width: 82vw; height: 5.4vh; x: 0px; y: -34vh; }
    .port-lab .port-button-label { width: 90%; height: 3vh; font-size: 1.5vh; }
    .result-reward { width: 84vw; height: 5vh; x: 0px; y: 19vh; font-size: 1.4vh; line-height: 2vh; }
    .result-breakdown { y: 14vh; }
    .result-stats { y: -4vh; height: 32vh; }
    .flight-pause { width: 72px; height: 44px; x: -50px; y: 39px; }
    .flight-dash { width: 108px; height: 48px; x: -150px; y: 41px; }
    .flight-mission { width: 88vw; height: 18px; y: -17vh; font-size: 11px; }
    .flight-guide { width: 88vw; height: 40px; y: 100px; font-size: 11px; line-height: 16px; }
