    .upgrade-hint { y: -46.5vh; font-size: 1.2vh; }
}

.pause-settings { width: 44vh; height: 5vh; x: -31vh; y: 9vh; }
@media (orientation: portrait) {
    .pause-settings { width: 84vw; height: 5.4vh; x: 0px; y: -40vh; }
    .pause-manual-title { y: -3vh; }
    .manual { height: 29vh; y: -20vh; }
}

.action-primary .port-button-label { color: #092a24; }
.port-ship-button { width: 16vh; }
.port-ship-button-0 { x: -66vh; }
.port-ship-button-1 { x: -49vh; }
.port-ship-button-2 { x: -32vh; }
.port-ship-button-3 { x: -15vh; }
@media (orientation: portrait) {
    .title-start-sub { font-size: 1.35vh; line-height: 1.8vh; }
    .port-tab .port-button-label { font-size: 1.35vh; }
    .title-hangar .port-button-label, .title-archive .port-button-label, .title-records .port-button-label, .title-settings .port-button-label { font-size: 1.35vh; }
    .port-ship-button { width: 20vw; }
    .port-ship-button-0 { x: -33vw; }
    .port-ship-button-1 { x: -11vw; }
    .port-ship-button-2 { x: 11vw; }
    .port-ship-button-3 { x: 33vw; }
    .port-ship-button .port-button-label { font-size: 1.3vh; }
    .archive-mode .port-button-label { font-size: 1.3vh; }
    .port-mix-track, .port-mix-fill { height: 5.4vh; }
    .port-controls { height: 16vh; y: -25vh; font-size: 1.45vh; line-height: 1.9vh; }
}

@media (orientation: portrait) {
    .port-ship-status { y: -31vh; height: 2vh; font-size: 1.3vh; }
}

.port-rebind { width: 58vh; height: 6vh; x: 34vh; y: -14vh; }
.port-controls { width: 66vh; height: 20vh; x: -34vh; y: -22vh; font-size: 1.65vh; line-height: 2.3vh; text-align: start; }
.port-settings-back { width: 48vh; height: 6vh; x: 0px; y: -38vh; }
@media (orientation: portrait) {
    .port-rebind { width: 84vw; height: 5.5vh; x: 0px; y: -22vh; }
    .port-rebind .port-button-label { font-size: 1.3vh; }
    .port-controls { width: 84vw; height: 6vh; x: 0px; y: -31vh; font-size: 1.45vh; line-height: 2vh; text-align: center; }
    .port-lab { width: 40vw; height: 5.5vh; x: -22vw; y: -41vh; }
    .port-settings-back { width: 40vw; height: 5.5vh; x: 22vw; y: -41vh; }
    .port-settings-back .port-button-label, .port-lab .port-button-label { font-size: 1.3vh; letter-spacing: 0px; }
}

.port-mix-fill { height: 1.2vh; }
.upgrade-card-copy { height: 15vh; y: -1vh; font-size: 2vh; line-height: 2.6vh; }
.upgrade-card-kicker { color: var(--amber); }
@media (orientation: portrait) {
    .port-mix-fill { height: 1.5vh; }
    .upgrade-card-copy { height: 5.4vh; y: -2vh; font-size: 1.45vh; line-height: 1.9vh; }
}

.archive-mode { width: 33vh; }
.archive-mode-0 { x: -54vh; }
.archive-mode-1 { x: -18vh; }
.archive-mode-2 { x: 18vh; }
.archive-mode-3 { x: 54vh; }
@media (orientation: portrait) {
    .archive-mode { width: 20vw; }
    .archive-mode-0 { x: -33vw; }
    .archive-mode-1 { x: -11vw; }
    .archive-mode-2 { x: 11vw; }
    .archive-mode-3 { x: 33vw; }
    .archive-mode .port-button-label { font-size: 1.2vh; }
}

.flight-guide { y: 110px; }
@media (orientation: portrait) and (max-width: 700px) {
    .flight-dash, .flight-pause { y: 35vw; }
    .flight-guide { y: 48vw; }
    .flight-dash .port-button-label { height: 36px; font-size: 12px; line-height: 16px; }
}
@media (orientation: portrait) and (min-width: 701px) {
    .flight-pause { width: 100px; height: 44px; x: -72px; y: 44px; }
    .flight-dash { width: 150px; height: 54px; x: -214px; y: 49px; }
    .flight-guide { width: 500px; height: 22px; y: 110px; font-size: 13px; }
    .flight-mission { width: 420px; height: 20px; y: -94px; font-size: 12px; }
}

@media (orientation: portrait) {
    .port-back { y: -42vh; height: 5.5vh; }
    .upgrade-grid { height: 67vh; y: -3vh; }
    .upgrade-card { height: 15.5vh; }
}

@media (orientation: portrait) {
    .pause-settings { max-width: 44vh; }
}
@media (orientation: landscape) and (max-height: 550px) {
    .port-ship-button, .port-lab, .archive-prev, .archive-next,
    .port-mix-track, .pause-settings, .upgrade-reroll { min-height: 20px; }
    .port-button-label { height: 14px; font-size: 10px; line-height: 12px; letter-spacing: 0px; }
    .port-ship-button .port-button-label { font-size: 8px; }
    .title-difficulty .port-button-label { font-size: 9px; }
    .title-start-sub { font-size: 8px; line-height: 10px; }
    .title-hint { font-size: 8px; line-height: 10px; }
    .port-heading, .port-ship-kicker { font-size: 9px; }
    .port-credits, .port-ship-status { font-size: 8px; }
    .port-ship-copy { height: 26vh; font-size: 10px; line-height: 11px; }
    .archive-copy { font-size: 11px; line-height: 14px; }
    .archive-status { font-size: 8px; }
    .port-record { font-size: 8px; line-height: 11px; }
    .port-controls { font-size: 8px; line-height: 10px; }
}
