/* The title and the module chooser. Landscape is laid out in vh so a 540p
   window and a 1440p one see the same composition; portrait stacks it. */

/* ---- Title: identity and progress on the left, play on the right. ---- */
.title-panel { width: 124vh; max-width: 96vw; height: 80vh; y: 2vh; }
.title-logo { width: 50vh; height: 25vh; x: -31vh; y: 22vh; anchor: center; }
.title-best {
    width: 50vh; height: 3.6vh; x: -31vh; y: 6vh;
    font-size: 2.6vh; line-height: 3vh; letter-spacing: 0.5vh; color: var(--muted); text-align: center;
}
.title-pilot-label { width: 50vh; height: 2.6vh; x: -31vh; y: -3vh; }
.title-callsign { width: 50vh; height: 8vh; x: -31vh; y: -9.5vh; }
.title-divider { width: 1px; height: 64vh; x: 0px; y: 2vh; background: var(--panel-edge); }
.title-launch-label { width: 50vh; height: 2.6vh; x: 31vh; y: 32vh; }
.title-start { width: 50vh; height: 14vh; x: 31vh; y: 22vh; border-radius: 14px; }
.title-start-label { height: 4.6vh; y: 2vh; font-size: 3.8vh; line-height: 4.4vh; letter-spacing: 0.6vh; }
.title-start-sub { width: 100%; height: 2.6vh; y: -3.2vh; font-size: 1.8vh; line-height: 2.2vh; color: #0b4a43; text-align: center; }
.title-rush { width: 50vh; height: 8vh; x: 31vh; y: 9vh; }
.title-pick { width: 50vh; height: 6vh; x: 31vh; y: 0.5vh; }
.title-compact { width: 50vh; height: 7vh; x: 31vh; y: -10.5vh; }
/* The boss picker opens a scrolling list of the roster under itself. */
.picker:open { background: #0d1c2e; border-color: var(--accent); }
.picker:open .action-ghost-label { color: var(--accent); }
.pick-list {
    width: 100%; height: 30vh; x: 0px; y: -18.6vh;
    padding: 0.6vh; gap: 0.4vh;
    background: #071120; border-color: var(--accent); border-width: 1px; border-radius: 10px;
    box-shadow: 0px 14px 32px #000000c0;
}
.pick-option { width: 100%; height: 4.4vh; flex-shrink: 0; background: transparent; border-radius: 6px; }
.pick-option:hover, .pick-option:focus { background: #14304a; }
.pick-option:checked { background: var(--accent-deep); }
.pick-option-label {
    width: 90%; height: 2.6vh; font-size: 1.9vh; line-height: 2.3vh; letter-spacing: 0.3vh;
    color: var(--muted); text-align: start;
}
.pick-option:checked .pick-option-label { color: var(--accent); }
.title-hint {
    width: 50vh; height: 8vh; x: 31vh; y: -23vh;
    font-size: 1.9vh; line-height: 2.6vh; color: var(--muted); text-align: start;
}
.title-notice {
    width: 50vh; height: 7vh; x: -31vh; y: -23vh;
    font-size: 1.9vh; line-height: 2.6vh; color: #fda4af; text-align: start;
}

/* ---- Module chooser: three or four cards in a row. ---- */
.upgrade-panel { width: 152vh; max-width: 96vw; height: 86vh; y: 0vh; }
.upgrade-kicker { width: 60vh; height: 2.6vh; x: 0px; y: 35vh; anchor: center; text-align: center; }
.upgrade-heading { width: 100vh; height: 6.4vh; x: 0px; y: 29vh; anchor: center; text-align: center; }
.upgrade-hint {
    width: 100vh; height: 3vh; x: 0px; y: -37vh; anchor: center;
    font-size: 1.9vh; line-height: 2.4vh; color: var(--muted); text-align: center;
}
.upgrade-grid {
    width: 142vh; max-width: 92vw; height: 56vh; x: 0px; y: -3vh;
    direction: row; gap: 2.4vh; justify-content: center; align-items: center;
}
.upgrade-card {
    width: 33vh; height: 52vh;
    background: #0a1729; border-color: #22384f; border-width: 1px; border-radius: 14px;
}
.upgrade-card:hover { background: #0f2238; border-color: var(--accent); }
.upgrade-card:active { background: var(--accent-deep); border-color: #a7f3e6; }
.upgrade-card:focus { border-color: var(--cyan); border-width: 3px; }
.upgrade-accent { width: 27vh; height: 0.6vh; x: 0px; y: 23vh; background: var(--accent); border-radius: 0.3vh; }
.upgrade-card:hover .upgrade-accent { background: var(--cyan); }
.upgrade-card-kicker { width: 27vh; height: 2.4vh; x: 0px; y: 18.6vh; color: var(--faint); }
.upgrade-card-name {
    width: 27vh; height: 8vh; x: 0px; y: 12vh;
    font-size: 3.1vh; line-height: 3.6vh; letter-spacing: 0.1vh; color: var(--ink); text-align: start;
}
.upgrade-card-copy {
    width: 27vh; height: 10vh; x: 0px; y: 1.5vh;
    font-size: 2.1vh; line-height: 2.9vh; color: var(--muted); text-align: start;
}
.upgrade-card-cta {
    width: 27vh; height: 2.6vh; x: 0px; y: -21.5vh;
    font-size: 1.8vh; letter-spacing: 0.4vh; color: var(--accent); text-align: start;
}
.upgrade-card:hover .upgrade-card-cta { color: var(--cyan); }

@media (max-height: 600px) and (orientation: landscape) {
    .title-hint, .title-notice, .upgrade-hint { font-size: 11px; line-height: 14px; }
    .pick-option-label { font-size: 11px; }
    .title-start-sub { font-size: 9px; line-height: 11px; }
    .title-start-label { y: 1.4vh; }
    .upgrade-card-copy { font-size: 12px; line-height: 16px; }
    .upgrade-card-cta, .upgrade-card-kicker { font-size: 10px; letter-spacing: 2px; }
}

/* ---- Portrait: one column, sized by height and held inside the width. ---- */
@media (orientation: portrait) {
    .title-panel { width: 48vh; max-width: 92vw; height: 90vh; y: 0vh; }
    .title-logo { width: 40vh; max-width: 76vw; height: 17vh; max-height: 38vw; x: 0px; y: 34vh; }
    .title-best { width: 44vh; max-width: 84vw; height: 3.4vh; x: 0px; y: 23.5vh; font-size: 2.3vh; }
    .title-pilot-label { width: 44vh; max-width: 84vw; height: 2.4vh; x: 0px; y: 19.5vh; }
    .title-callsign { width: 44vh; max-width: 84vw; height: 6.4vh; x: 0px; y: 14.6vh; }
    .title-divider { width: 44vh; max-width: 84vw; height: 1px; x: 0px; y: 9.6vh; }
    .title-launch-label { width: 44vh; max-width: 84vw; height: 2.4vh; x: 0px; y: 6.6vh; }
    .title-start { width: 44vh; max-width: 84vw; height: 10vh; x: 0px; y: 0vh; }
    .title-start-label { height: 3.8vh; y: 1.4vh; font-size: 3vh; }
    .title-start-sub { y: -2.6vh; font-size: 1.5vh; }
    .title-rush { width: 44vh; max-width: 84vw; height: 6.4vh; x: 0px; y: -9.4vh; }
    .title-pick { width: 44vh; max-width: 84vw; height: 5.4vh; x: 0px; y: -16.2vh; }
    .title-compact { width: 44vh; max-width: 84vw; height: 6vh; x: 0px; y: -23.2vh; }
    .pick-list { height: 26vh; y: -16.2vh; }
    .pick-option { height: 3.8vh; }
    .pick-option-label { font-size: 1.6vh; }
    .title-hint { width: 44vh; max-width: 84vw; height: 7vh; x: 0px; y: -31.6vh; font-size: 1.6vh; line-height: 2.2vh; }
    .title-notice { width: 44vh; max-width: 84vw; height: 4vh; x: 0px; y: -38.6vh; font-size: 1.6vh; line-height: 2.1vh; }
    .action-label { font-size: 2.3vh; }
    .action-ghost-label { font-size: 1.7vh; }
    .switch-label, .row-key { font-size: 1.6vh; }
    .row-value { font-size: 1.8vh; }
    .kicker { font-size: 1.6vh; }

    .upgrade-panel { width: 50vh; max-width: 94vw; height: 94vh; }
    .upgrade-kicker { width: 44vh; max-width: 84vw; y: 42vh; }
    .upgrade-heading { width: 44vh; max-width: 84vw; height: 5vh; y: 37.5vh; font-size: 3.6vh; line-height: 4.2vh; }
    .upgrade-hint { width: 44vh; max-width: 84vw; height: 2.6vh; y: -43vh; font-size: 1.5vh; }
    .upgrade-grid { width: 46vh; max-width: 88vw; height: 72vh; y: -4.4vh; direction: column; gap: 1.2vh; }
    .upgrade-card { width: 100%; height: 16.6vh; }
    .upgrade-accent { width: 0.6vh; height: 13vh; x: -18.5vh; y: 0vh; }
    .upgrade-card-kicker { width: 36vh; max-width: 70vw; height: 2vh; x: 1.5vh; y: 6vh; }
    .upgrade-card-name { width: 36vh; max-width: 70vw; height: 3.6vh; x: 1.5vh; y: 2.8vh; font-size: 2.5vh; line-height: 3vh; }
    .upgrade-card-copy { width: 36vh; max-width: 70vw; height: 5.4vh; x: 1.5vh; y: -2vh; font-size: 1.6vh; line-height: 2.2vh; }
    .upgrade-card-cta { width: 36vh; max-width: 70vw; height: 2vh; x: 1.5vh; y: -6.6vh; font-size: 1.4vh; }
}
