// The title screen, which is the one place a damaged save is worth mentioning:
// before anything writes over it.
script Title {

    // Found by the name the scene gave them. An entity cannot be an
    // authored property — a runtime handle is not a scene ID and
    // `docs/scripting.md` says why — so a script that needs to name
    // another entity looks it up once and keeps it.
    var best: Entity = null;
    var notice: Entity = null;
    var pick_label: Entity = null;
    var pick: Entity = null;
    var hint: Entity = null;
    var callsign: Entity = null;
    var callsign_text: Entity = null;
    var compact: Entity = null;
    var shown_pick: number = -1.0;


    fn start() {
        this.best = World.find("TitleBest");
        this.notice = World.find("TitleNotice");
        this.pick_label = World.find("TitlePickText");
        this.pick = World.find("TitlePick");
        this.hint = World.find("TitleHint");
        this.callsign = World.find("TitleCallsign");
        this.callsign_text = World.find("TitleCallsignText");
        this.compact = World.find("TitleCompact");
        // Remembered between sessions, and read by the HUD when a run starts.
        Ui.set_checked(this.compact, Save.flag("compact_hud", false));
        // A run started from the title is an ordinary run unless the rush
        // button says otherwise, and the button sets this the moment it is
        // pressed. Clearing it here means quitting a rush and pressing START
        // gives you a game rather than another rush.
        Game.mode = 0.0;
        Ui.set_input_text(this.callsign, Save.text("callsign", ""));
        World.set_active(this.notice, Save.is_damaged());
        Ui.set_text(this.hint, "Hold the evacuation corridor for ten minutes. Collect salvage. Build something impossible.");
    }

    fn update(dt: number) {
        if Game.run_state != 0.0 {
            return;
        }
        Ui.set_number(this.best, Save.number("best_score", 0.0));
        if Ui.changed(this.compact) {
            Save.set_flag("compact_hud", Ui.is_checked(this.compact));
        }
        show_callsign();
        if Ui.changed(this.callsign) { Save.set_text("callsign", Ui.input_text(this.callsign)); }

        // The boss picker is a dropdown of the roster; choosing from it is
        // where a rush opens.
        if Ui.changed(this.pick) {
            Audio.play("audio/click.wav", 0.3);
            Game.rush_from = Ui.selected(this.pick);
        }
        // Only when it changes: `Ui.set_text` every frame is work for nothing,
        // and the label is a button's worth of state rather than a readout.
        let pick = Game.rush_from;
        if pick != this.shown_pick {
            this.shown_pick = pick;
            Ui.set_selected(this.pick, pick);
            name_pick(pick);
        }
    }
    /// The callsign as typed, with a caret while the field has the keyboard,
    /// and the placeholder while it is empty and not being edited.
    fn show_callsign() {
        let name = Ui.input_text(this.callsign);
        if !Ui.is_focused(this.callsign) {
            if name == "" { Ui.set_text(this.callsign_text, "Unnamed pilot"); }
            else { Ui.set_text(this.callsign_text, name); }
            return;
        }
        // A caret where the pilot is typing, or the selection in brackets.
        let start = Ui.selection_start(this.callsign);
        let end = Ui.selection_end(this.callsign);
        let before = name.slice(0, start);
        let after = name.slice(end, name.length);
        if start == end {
            Ui.set_text(this.callsign_text, before + "|" + after);
        } else {
            Ui.set_text(this.callsign_text, before + "[" + name.slice(start, end) + "]" + after);
        }
    }


    /// The roster, in the order a rush walks it: the Warden, then the eleven
    /// bosses, each of which is now its own prefab.
    fn name_pick(pick: number) {
        if pick == 0.0 { Ui.set_text(this.pick_label, "OPENS ON  /  WARDEN"); }
        else if pick == 1.0 { Ui.set_text(this.pick_label, "OPENS ON  /  HARROWER"); }
        else if pick == 2.0 { Ui.set_text(this.pick_label, "OPENS ON  /  PRISM"); }
        else if pick == 3.0 { Ui.set_text(this.pick_label, "OPENS ON  /  SINGULARITY"); }
        else if pick == 4.0 { Ui.set_text(this.pick_label, "OPENS ON  /  CROWN"); }
        else if pick == 5.0 { Ui.set_text(this.pick_label, "OPENS ON  /  BROOD"); }
        else if pick == 6.0 { Ui.set_text(this.pick_label, "OPENS ON  /  MIRROR"); }
        else if pick == 7.0 { Ui.set_text(this.pick_label, "OPENS ON  /  ARCHITECT"); }
        else if pick == 8.0 { Ui.set_text(this.pick_label, "OPENS ON  /  SPINE"); }
        else if pick == 9.0 { Ui.set_text(this.pick_label, "OPENS ON  /  LEVIATHAN"); }
        else if pick == 10.0 { Ui.set_text(this.pick_label, "OPENS ON  /  LAST LIGHT"); }
        else { Ui.set_text(this.pick_label, "OPENS ON  /  AEGIS"); }
    }
}
