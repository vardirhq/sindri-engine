// A boss's outline drawn again a little outside its hull and turning on its
// own, as the original draws every boss: the second, cream polygon that says
// "this one is a boss" before the name bar does. It thickens once the boss is
// past half its health, which is when the original's boss changes phase.
script BossRing {
    // Turns per second, in radians; negative turns the other way.
    @export let spin: number = 1.0;
    // How wide the outline is while the boss is whole, and past its phase.
    @export let width: number = 0.03;

    var clock: number = 0.0;

    fn update(dt: number) {
        if Game.run_state == 1.0 { this.clock += dt; }
        this.transform.rotation_z = this.clock * this.spin;
        var share: number = 1.0;
        if Game.boss_max > 0.0 { share = max(0.0, Game.boss_hp) / Game.boss_max; }
        let pulse = 0.5 + 0.5 * sin(this.clock * 5.0);
        if share < 0.5 {
            this.shape.stroke_width = this.width * (1.5 + pulse * 0.3);
            this.shape.stroke.a = 0.85 + pulse * 0.15;
        } else {
            this.shape.stroke_width = this.width;
            this.shape.stroke.a = 0.6 + pulse * 0.15;
        }
    }
}
