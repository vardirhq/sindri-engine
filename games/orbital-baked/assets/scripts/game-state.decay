    var grave_echo_time: number = 0.0;
    var hp: number = 5.0;
    var kills: number = 0.0;
    var kills_since_repair: number = 0.0;
    var lab_active: number = 0.0;
    var lab_attack_count: number = 0.0;
    var lab_autoplay: number = 0.0;
