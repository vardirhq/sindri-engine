// An authored area hit. Its collider is the damage radius and its stroked ring
// is the same radius, so what the player sees is what the simulation tests.
script Nova {
    @export let damage: number = 0.3;
    @export let impact: number = 0.26;
    @export let life: number = 0.13;
    var age: number = 0.0;
    var retiring: bool = false;
    var initial_x: number = 1.0;
    var initial_y: number = 1.0;

    fn start() {
        this.initial_x = this.transform.scale.x;
        this.initial_y = this.transform.scale.y;
        if !Game.reduced_flashes { Effects.burst(this.entity); }
        flight_impact(this.impact);
    }

    fn update(dt: number) {
        if this.retiring {
            World.despawn(this.entity);
            return;
        }
        this.age += dt;
        let t = min(1.0, this.age / max(0.01, this.life));
        this.shape.stroke.a = 1.0 - t;
        this.shape.fill.a = (1.0 - t) * 0.12;
        this.shape.dashes = 4.0 + t * 12.0;
        this.shape.sweep_start = t * 0.4;
        this.transform.scale.x = this.initial_x * (1.0 + t * 0.22);
        this.transform.scale.y = this.initial_y * (1.0 + t * 0.22);
        if !Game.reduced_motion { this.transform.rotation_z += dt * 3.2; }
        if this.age >= this.life {
            // Do not invalidate a collision another script has yet to consume.
            this.retiring = true;
        }
    }
}
