// Shared implementation for the non-charging Last Stand roster. `kind` is the
// reference archetype index; keeping the common combat/death path here avoids
// twelve scripts differing mostly by arithmetic.
script Drifter {
    @export let kind: number = 0.0;
    @export let speed: number = 1.5;
    @export let health: number = 2.0;
    @export let worth: number = 1.0;
    @export let touch_damage: number = 1.0;
    @export let elite: number = 0.0;
    @export let elite_trait: number = 0.0;
    @export let hazard_damage: number = 0.0;
    @export let core: Prefab;
    @export let death_burst: Prefab;
    @export let shot: Prefab;
    @export let drop_roll: Prefab;
    @export let elite_shell: Prefab;
    @export let elite_ring: Prefab;
    @export let arc_mark: Prefab;
    @export let phaser_mark: Prefab;
    @export let prong_mark: Prefab;

    var hp: number = 0.0;
    var death_burst_damage: number = 0.0;
    var attack: number = 1.2;
    var clock: number = 0.0;
    var phase_offset: number = 0.0;
    var burrow: number = 0.0;
    // The body is a filled polygon in the archetype's own colour, as the
    // original draws it. A hit whitens it for a moment; burrowing and phasing
    // fade it. Everything that changes how it looks writes these, and `paint`
    // turns them into the shape once a frame.
    var sides: number = 5.0;
    var body_r: number = 1.0;
    var body_g: number = 0.5;
    var body_b: number = 0.4;
    var body_alpha: number = 1.0;
    var flash: number = 0.0;

    fn start() {
        let late = max(0.0, Game.elapsed - 180.0);
        this.hp = this.health * (1.0 + late * 0.0014);
        this.attack = Random.range(0.35, 1.1);
        this.clock = 0.0;
        this.phase_offset = Random.range(0.0, 6.2831853);
        this.transform.rotation_z = this.phase_offset;
        apply_reference_visual();
        spawn_reference_mark();
        spawn_elite_visuals();
    }

    fn update(dt: number) {
        if Game.run_state != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }
        this.clock += dt;
        // Physics owns translation but the reference owns the visual heading:
        // every enemy spins at 0.6 rad/s with a per-instance phase offset.
        this.transform.rotation_z = this.phase_offset + this.clock * 0.6;
        this.flash = max(0.0, this.flash - dt * 9.0);
        paint();
        if this.hazard_damage > 0.0 {
            this.hp -= this.hazard_damage;
            this.hazard_damage = 0.0;
            if this.hp <= 0.0 {
                die();
                return;
            }
        }
        let player = World.find("Player");
        if player == null {
            return;
        }
        let dx = player.transform.position.x - this.transform.position.x;
        let dy = player.transform.position.y - this.transform.position.y;
        let far = sqrt(dx * dx + dy * dy);
        press_on(far);

        let visible = is_visible();
        if this.kind == 3.0 {
            steer_range(dx, dy, far, 2.95, 0.18);
        } else if this.kind == 4.0 {
            steer_range(dx, dy, far, 3.56, 0.72);
        } else if this.kind == 5.0 {
            steer_range(dx, dy, far, 3.77, 0.05);
            if visible { radial_fire(dt, 2.65, 8.0, 3.1); }
        } else if this.kind == 6.0 {
            steer_range(dx, dy, far, 4.68, 0.58);
            if visible { aimed_fire(dt, dx, dy, far, 1.95, 3.5); }
        } else if this.kind == 7.0 {
            wobble_chase(dx, dy, far, 1.35);
        } else if this.kind == 8.0 {
            steer_range(dx, dy, far, 4.28, 0.65);
            if visible { aimed_fire(dt, dx, dy, far, 1.6, 3.7); }
        } else if this.kind == 9.0 {
            steer_range(dx, dy, far, 7.0, 0.12);
            if visible { aimed_fire(dt, dx, dy, far, 2.1, 5.2); }
        } else if this.kind == 10.0 {
            steer_range(dx, dy, far, 4.38, 0.92);
            if visible { paired_fire(dt, dx, dy, far, 1.75, 3.8); }
        } else if this.kind == 11.0 {
            burrow_move(dt, dx, dy, far);
        } else if this.kind == 12.0 {
            steer_range(dx, dy, far, 2.75, 0.82);
            if visible { paired_fire(dt, dx, dy, far, 1.7, 4.0); }
        } else if this.kind == 13.0 {
            steer_range(dx, dy, far, 5.8, 0.08);
            if visible { fan_fire(dt, dx, dy, far, 2.15, 4.0); }
        } else if this.kind == 14.0 {
            phaser_move(dt, dx, dy, far, player, visible);
        } else {
            chase(dx, dy, far, 1.0);
        }

        receive_hits(player);
        if this.hp <= 0.0 { die(); }
    }

    fn chase(dx: number, dy: number, far: number, scale: number) {
        if far > 0.001 {
            Physics.set_velocity(this.entity, dx / far * this.speed * scale * Game.event_enemy_speed,
                                 dy / far * this.speed * scale * Game.event_enemy_speed);
        }
    }

    fn wobble_chase(dx: number, dy: number, far: number, scale: number) {
        if far <= 0.001 { return; }
        let tangent = sin(this.clock * 5.0) * 0.42;
        Physics.set_velocity(this.entity,
            (dx / far - dy / far * tangent) * this.speed * scale * Game.event_enemy_speed,
            (dy / far + dx / far * tangent) * this.speed * scale * Game.event_enemy_speed);
    }

    fn steer_range(dx: number, dy: number, far: number, target: number, tangent: number) {
        if far <= 0.001 { return; }
        var radial: number = 0.0;
        if far > target + 0.5 { radial = 1.0; }
        if far < target - 0.5 { radial = -0.65; }
        let nx = dx / far;
        let ny = dy / far;
        Physics.set_velocity(this.entity,
            (nx * radial - ny * tangent) * this.speed * Game.event_enemy_speed,
            (ny * radial + nx * tangent) * this.speed * Game.event_enemy_speed);
    }

    fn aimed_fire(dt: number, dx: number, dy: number, far: number, gap: number, velocity: number) {
        this.attack -= dt;
        if this.attack > 0.0 || far <= 0.001 { return; }
        fire(dx / far, dy / far, velocity);
        this.attack = gap;
    }

    fn paired_fire(dt: number, dx: number, dy: number, far: number, gap: number, velocity: number) {
        this.attack -= dt;
        if this.attack > 0.0 || far <= 0.001 { return; }
        let a = atan2(dy, dx);
        fire(cos(a - 0.18), sin(a - 0.18), velocity);
        fire(cos(a + 0.18), sin(a + 0.18), velocity);
        this.attack = gap;
    }

    fn fan_fire(dt: number, dx: number, dy: number, far: number, gap: number, velocity: number) {
        this.attack -= dt;
        if this.attack > 0.0 || far <= 0.001 { return; }
        let base = atan2(dy, dx);
        var slot: number = -2.0;
        while slot <= 2.0 {
            let a = base + slot * 0.16;
            fire(cos(a), sin(a), velocity);
            slot += 1.0;
        }
        this.attack = gap;
    }

    fn radial_fire(dt: number, gap: number, count: number, velocity: number) {
        this.attack -= dt;
        if this.attack > 0.0 { return; }
        var slot: number = 0.0;
        while slot < count {
            let a = slot / count * 6.2831853 + this.clock * 0.12;
            fire(cos(a), sin(a), velocity);
            slot += 1.0;
        }
        this.attack = gap;
    }

    fn fire(nx: number, ny: number, velocity: number) {
        let bolt = World.spawn(this.shot);
        bolt.transform.position.x = this.transform.position.x;
        bolt.transform.position.y = this.transform.position.y;
        bolt.transform.rotation_z = atan2(ny, nx);
        World.set_property(bolt, "speed", velocity);
        // The original's regular enemies fire 9 to 15 of 100 hull, taken at
        // Normal's 1.08: about 0.6 of this ship's five.
        World.set_property(bolt, "damage", 0.6);
    }

    fn burrow_move(dt: number, dx: number, dy: number, far: number) {
        this.burrow += dt;
        if this.burrow >= 3.4 { this.burrow = 0.0; }
        if this.burrow < 1.7 {
            this.body_alpha = 0.2;
            chase(dx, dy, far, 1.55);
        } else {
            this.body_alpha = 1.0;
            chase(dx, dy, far, 0.82);
        }
    }

    fn phaser_move(dt: number, dx: number, dy: number, far: number, player: Entity, visible: bool) {
        wobble_chase(dx, dy, far, 1.05);
        this.body_alpha = 0.6 + sin(this.clock * 12.0) * 0.25;
        this.attack -= dt;
        if this.attack > 0.0 || !visible { return; }
        let a = Random.range(0.0, 6.2831853);
        let r = Random.range(3.2, 5.0);
        this.transform.position.x = player.transform.position.x + cos(a) * r;
        this.transform.position.y = player.transform.position.y + sin(a) * r;
        Effects.burst(this.entity);
        this.attack = Random.range(2.7, 3.5);
    }

    // Contact hurts for as long as it lasts, as in the original: the ship's
    // short mercy window is what spaces the hits, not the moment of touching.
    fn press_on(far: number) {
        if far < CONTACT_REACH {
            Game.player_damage_taken = max(Game.player_damage_taken, this.touch_damage);
        }
    }

    fn receive_hits(player: Entity) {
        for hit in Physics.sensor_entered() {
            if hit == player {
                Game.player_damage_taken = max(Game.player_damage_taken, this.touch_damage);
                continue;
            }
            if !World.exists(hit) { continue; }
            if this.hp > 0.0 {
                let damage = damage_from(hit);
                this.hp -= damage;
                if damage > 0.0 { this.flash = 1.0; }
                if this.hp <= 0.0 && World.property_number(hit, "nova", 0.0) > 0.0 {
                    this.death_burst_damage = damage * 0.3;
                }
            }
        }
    }

    fn is_visible() -> bool {
        let aspect = max(Viewport.aspect, 0.001);
        var half_x: number = 5.5;
        var half_y: number = 5.5;
        if aspect >= 1.0 { half_x *= aspect; } else { half_y /= aspect; }
        let radius = max(abs(this.transform.scale.x), abs(this.transform.scale.y)) * 0.5;
        return this.transform.position.x + radius >= -half_x &&
               this.transform.position.x - radius <= half_x &&
               this.transform.position.y + radius >= -half_y &&
               this.transform.position.y - radius <= half_y;
    }

    fn apply_reference_visual() {
        // Reference renderer side counts and colours, translated to our numeric
        // roster order. The colours are the original's sRGB hex values in the
        // linear space the renderer blends in, so they arrive on screen as
        // the same hex.
        if this.kind == 0.0 { set_visual(5.0, 1.0000, 0.2307, 0.1144); }
        else if this.kind == 1.0 { set_visual(5.0, 1.0000, 0.1590, 0.1022); }
        else if this.kind == 3.0 { set_visual(6.0, 1.0000, 0.1144, 0.1746); }
        else if this.kind == 4.0 { set_visual(4.0, 0.6795, 0.1529, 1.0000); }
        else if this.kind == 5.0 { set_visual(6.0, 0.3864, 0.2016, 1.0000); }
        else if this.kind == 6.0 { set_visual(6.0, 0.1779, 0.6795, 1.0000); }
        else if this.kind == 7.0 { set_visual(3.0, 0.2664, 1.0000, 0.6240); }
        else if this.kind == 8.0 { set_visual(7.0, 0.1221, 0.9047, 0.6308); }
        else if this.kind == 9.0 { set_visual(6.0, 1.0000, 0.8631, 0.2270); }
        else if this.kind == 10.0 { set_visual(7.0, 0.2832, 0.3613, 1.0000); }
        else if this.kind == 11.0 { set_visual(4.0, 1.0000, 0.3140, 0.1470); }
        else if this.kind == 12.0 { set_visual(5.0, 1.0000, 0.1683, 0.4678); }
        else if this.kind == 13.0 { set_visual(6.0, 0.1301, 0.8796, 1.0000); }
        else { set_visual(3.0, 0.6867, 0.3515, 1.0000); }
    }

    fn set_visual(sides: number, r: number, g: number, b: number) {
        this.sides = sides;
        this.shape.count = sides;
        this.body_r = r;
        this.body_g = g;
        this.body_b = b;
        paint();
    }

    // The fill is the archetype's colour, whitened by a hit; the rim is the
    // same colour lifted towards white, so the silhouette holds its edge
    // against a bright explosion behind it.
    fn paint() {
        var white = this.flash;
        if Game.reduced_flashes { white *= 0.15; }
        this.shape.fill.r = this.body_r + (1.0 - this.body_r) * white;
        this.shape.fill.g = this.body_g + (1.0 - this.body_g) * white;
        this.shape.fill.b = this.body_b + (1.0 - this.body_b) * white;
        this.shape.fill.a = this.body_alpha;
        this.shape.stroke.r = this.body_r + (1.0 - this.body_r) * 0.45;
        this.shape.stroke.g = this.body_g + (1.0 - this.body_g) * 0.45;
        this.shape.stroke.b = this.body_b + (1.0 - this.body_b) * 0.45;
        this.shape.stroke.a = this.body_alpha * 0.9;
    }

    fn spawn_reference_mark() {
        if this.kind == 3.0 {
            spawn_arc_mark(4.0);
        } else if this.kind == 5.0 {
            spawn_radial_prongs(1.0, 4.0);
        } else if this.kind == 8.0 {
            spawn_arc_mark(1.0);
        } else if this.kind == 11.0 {
            spawn_arc_mark(2.0);
        } else if this.kind == 12.0 {
            spawn_arc_mark(0.0);
        } else if this.kind == 13.0 {
            spawn_radial_prongs(0.0, 3.0);
        } else if this.kind == 14.0 {
            let mark = World.spawn(this.phaser_mark);
            World.set_parent(mark, this.entity);
        }
    }

    fn spawn_arc_mark(mode: number) {
        let mark = World.spawn(this.arc_mark);
        World.set_property(mark, "mode", mode);
        World.set_parent(mark, this.entity);
    }

    fn spawn_radial_prongs(mode: number, count: number) {
        var slot: number = 0.0;
        while slot < count {
            let mark = World.spawn(this.prong_mark);
            World.set_property(mark, "mode", mode);
            World.set_parent(mark, this.entity);
            let angle = slot / count * 6.2831853;
            mark.transform.rotation_z = angle;
            if mode == 0.0 {
                mark.transform.position.x = cos(angle) * 1.2;
                mark.transform.position.y = sin(angle) * 1.2;
            } else {
                mark.transform.position.x = cos(angle) * 0.72;
                mark.transform.position.y = sin(angle) * 0.72;
                mark.transform.scale.x = 0.9;
            }
            slot += 1.0;
        }
    }

    fn spawn_elite_visuals() {
        if this.elite <= 0.0 { return; }
        let shell = World.spawn(this.elite_shell);
        World.set_property(shell, "sides", this.sides);
        World.set_property(shell, "trait", this.elite_trait);
        World.set_parent(shell, this.entity);
        let ring = World.spawn(this.elite_ring);
        World.set_property(ring, "sides", this.sides);
        World.set_property(ring, "trait", this.elite_trait);
        World.set_parent(ring, this.entity);
    }

    fn damage_from(hit: Entity) -> number {
        if World.has_tag(hit, "player_damage") {
            return World.property_number(hit, "damage", 0.0);
        }
        return 0.0;
    }

    fn die() {
        burst_on_death();
        Effects.burst(this.entity);
        Audio.play("audio/kill.wav", 0.3);
        Game.kills = Game.kills + 1.0;
        Game.score = Game.score + (20.0 + this.worth) * Game.event_score;
        let drop = World.spawn(this.core);
        drop.transform.position.x = this.transform.position.x;
        drop.transform.position.y = this.transform.position.y;
        World.set_property(drop, "worth", this.worth);
        let roll = World.spawn(this.drop_roll);
        roll.transform.position.x = this.transform.position.x;
        roll.transform.position.y = this.transform.position.y;
        World.set_property(roll, "elite", this.elite);
        World.despawn(this.entity);
    }

    fn burst_on_death() {
        if this.death_burst_damage <= 0.0 { return; }
        let wave = World.spawn(this.death_burst);
        wave.transform.position.x = this.transform.position.x;
        wave.transform.position.y = this.transform.position.y;
        World.set_property(wave, "damage", this.death_burst_damage);
    }
}
