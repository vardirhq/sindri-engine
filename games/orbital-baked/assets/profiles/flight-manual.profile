{
  "format_version": 1,
  "name": "Orbital Flight Manual",
  "type": "flight_manual",
  "values": {
    "entries": [
      {
        "name": "SCOUT",
        "description": "The first pursuit craft. Keep moving and let your automatic fire find an opening.",
        "discovery": "enemy_seen_0"
      },
      {
        "name": "BRUTE",
        "description": "A slow, durable hull. Circle it; do not let its mass close off your exit.",
        "discovery": "enemy_seen_1"
      },
      {
        "name": "DART",
        "description": "Stops, heats up, then commits to a dash. Change direction after the tell.",
        "discovery": "enemy_seen_2"
      },
      {
        "name": "BULWARK",
        "description": "A defensive presence that supports nearby threats. Open space is your advantage.",
        "discovery": "enemy_seen_3"
      },
      {
        "name": "WISP",
        "description": "A light, fast pursuer. Avoid turning into a group while collecting salvage.",
        "discovery": "enemy_seen_4"
      },
      {
        "name": "ANCHOR",
        "description": "Controls space around itself. Keep an escape route outside its reach.",
        "discovery": "enemy_seen_5"
      },
      {
        "name": "SPITTER",
        "description": "Fires hostile projectiles. Move across its line of fire, not along it.",
        "discovery": "enemy_seen_6"
      },
      {
        "name": "SWARM",
        "description": "Arrives in numbers. Clear a lane before diving for a core.",
        "discovery": "enemy_seen_7"
      },
      {
        "name": "RELAY",
        "description": "A support craft: do not leave it alive behind a growing crowd.",
        "discovery": "enemy_seen_8"
      },
      {
        "name": "SNIPER",
        "description": "Watch the aim tell and step sideways before the shot commits.",
        "discovery": "enemy_seen_9"
      },
      {
        "name": "ORBITER",
        "description": "Sweeps around you rather than simply following. Avoid being encircled.",
        "discovery": "enemy_seen_10"
      },
      {
        "name": "BURROWER",
        "description": "Alternates submerged and surfaced states. Its outer ring reveals when it is exposed.",
        "discovery": "enemy_seen_11"
      },
      {
        "name": "LEECH",
        "description": "Pressures the pilot at close range. Keep its outer arc away from your hull.",
        "discovery": "enemy_seen_12"
      },
      {
        "name": "SENTINEL",
        "description": "A deliberate threat with three radial prongs. Preserve space around it.",
        "discovery": "enemy_seen_13"
      },
      {
        "name": "PHASER",
        "description": "Its pulsing triangle marks the phase cycle. Time your approach.",
        "discovery": "enemy_seen_14"
      },
      {
        "name": "WARDEN",
        "description": "Read the expanding firing pattern and cross the gaps, not the projectiles.",
        "discovery": "boss_seen_0"
      },
      {
        "name": "HARROWER",
        "description": "Stay mobile through its committed attack lanes. Its opening tell is your warning.",
        "discovery": "boss_seen_1"
      },
      {
        "name": "PRISM",
        "description": "Watch the prismatic attack angles. A burst can carry you through a closing lane.",
        "discovery": "boss_seen_2"
      },
      {
        "name": "SINGULARITY",
        "description": "Gravity changes the space available. Move early; do not wait until you are trapped.",
        "discovery": "boss_seen_3"
      },
      {
        "name": "CROWN",
        "description": "Radial pressure rewards patient circles and a clear route between patterns.",
        "discovery": "boss_seen_4"
      },
      {
        "name": "BROOD",
        "description": "A summoner. Deal with the growing crowd without losing sight of its core.",
        "discovery": "boss_seen_5"
      },
      {
        "name": "MIRROR",
        "description": "Its reflected geometry can disguise the safe lane. Read the pattern before committing.",
        "discovery": "boss_seen_6"
      },
      {
        "name": "ARCHITECT",
        "description": "Builds dangerous zones. Leave the marked area before it becomes a wall.",
        "discovery": "boss_seen_7"
      },
      {
        "name": "SPINE",
        "description": "Segmented armor changes as it breaks. Keep the chain in view and avoid the body.",
        "discovery": "boss_seen_8"
      },
      {
        "name": "LEVIATHAN",
        "description": "A large hull with wide area pressure. Find space before the next attack begins.",
        "discovery": "boss_seen_9"
      },
      {
        "name": "LAST LIGHT",
        "description": "The final light is a test of your whole build. Save a burst for a narrowing escape.",
        "discovery": "boss_seen_10"
      },
      {
        "name": "AEGIS",
        "description": "Shield plates protect its core. Work around the shield and exploit exposed windows.",
        "discovery": "boss_seen_11"
      }
    ],
    "medals": [
      {
        "key": "first_flight",
        "name": "First Light",
        "description": "Survive a full minute in any sortie.\n\nFirst completion awards 30 salvage. Commendations are permanent."
      },
      {
        "key": "hunter",
        "name": "Centurion",
        "description": "Destroy 100 hostiles in a single sortie.\n\nFirst completion awards 30 salvage. Commendations are permanent."
      },
      {
        "key": "breaker",
        "name": "Pattern Breaker",
        "description": "Defeat a boss in a sortie.\n\nFirst completion awards 30 salvage. Commendations are permanent."
      },
      {
        "key": "explorer",
        "name": "Beyond the Belt",
        "description": "Reach the third sector.\n\nFirst completion awards 30 salvage. Commendations are permanent."
      },
      {
        "key": "engineer",
        "name": "Systems Architect",
        "description": "Install eight modules in one sortie.\n\nFirst completion awards 30 salvage. Commendations are permanent."
      },
      {
        "key": "evacuation",
        "name": "Hold the Line",
        "description": "Complete the ten-minute evacuation.\n\nFirst completion awards 30 salvage. Commendations are permanent."
      },
      {
        "key": "gauntlet",
        "name": "Twelve Signals",
        "description": "Defeat all twelve bosses in one Boss Rush.\n\nFirst completion awards 30 salvage. Commendations are permanent."
      },
      {
        "key": "veteran",
        "name": "Against All Odds",
        "description": "Complete a sortie on Veteran difficulty.\n\nFirst completion awards 30 salvage. Commendations are permanent."
      }
    ]
  }
}
