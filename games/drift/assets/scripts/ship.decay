// What the ship's scripts share: the airlock's pressure, and where the diver
// is. The airlock writes the pressure; the diver writes where they are.
state Ship {
    // The airlock chamber's pressure: 1 is the cabin's, 0 is vacuum.
    var chamber_pressure: number = 1.0;
    // Whether the diver is in the ship's gravity, and whether they breathe
    // the ship's air.
    var in_gravity: bool = true;
    var pressurized: bool = true;
    // Whether the diver is at the shuttle's controls.
    var piloting: bool = false;
    // The cabin recycler can refill the suit's oxygen once repaired.
    var recycler_repaired: bool = false;
    // Whether the suit has a thruster pack. It starts without one: the way
    // across to the ruin is the guide cable, hand over hand.
    var thrusters: bool = false;
}
