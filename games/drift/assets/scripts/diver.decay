// The diver: walking aboard the ship, floating outside it.
//
// The diver's body is an upright capsule that physics moves but never turns.
// Which way they face is the Eye's (the camera under the body), kept as a
// quaternion. Inside the ship's hull its gravity holds: the diver walks, and
// the view rights itself and keeps the deck below. Outside there is no up: the
// view turns about its own axes, so looking past straight up never flips it,
// and the diver moves by thrusters, handholds and momentum. The same body does
// both, so stepping through the outer door is the whole change.
//
// The suit carries oxygen and power. Both drain in vacuum and refill in the
// ship's air; out of air, the diver blacks out and wakes in the cabin.
//
// Controls, aboard:
//   mouse            look (click to capture the cursor)
//   W / S, A / D     walk; Space jumps
//   E                at an airlock panel, cycle the airlock
// Outside:
//   Q / E            roll (E works the airlock at a panel)
//   W / S, A / D     thrust forward/back, left/right
//   Space / C        thrust up/down (Space pushes off while holding on)
//   X                brake: thrust against the drift
//   F or right mouse hold on to a handhold in reach; keep holding to catch the next
//   Space or left mouse, while holding on: push off the way you look

// Quaternion product a * b: b's turn, then a's.
fn qmul(a: Quat, b: Quat) -> Quat {
    return Quat(
        x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
        y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
        z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
        w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
    );
}

// Partway from a to b, the short way round; the transform normalizes it.
fn qblend(a: Quat, b: Quat, t: number) -> Quat {
    var sign = 1.0;
    if a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w < 0.0 {
        sign = -1.0;
    }
    return Quat(
        x: a.x + (b.x * sign - a.x) * t,
        y: a.y + (b.y * sign - a.y) * t,
        z: a.z + (b.z * sign - a.z) * t,
        w: a.w + (b.w * sign - a.w) * t,
    );
}

// A vector turned by a unit quaternion.
fn qrot(q: Quat, v: Vec3) -> Vec3 {
    let t = Vec3(
        2.0 * (q.y * v.z - q.z * v.y),
        2.0 * (q.z * v.x - q.x * v.z),
        2.0 * (q.x * v.y - q.y * v.x)
    );
    return Vec3(
        v.x + q.w * t.x + (q.y * t.z - q.z * t.y),
        v.y + q.w * t.y + (q.z * t.x - q.x * t.z),
        v.z + q.w * t.z + (q.x * t.y - q.y * t.x)
    );
}

// The opposite turn.
fn qinv(q: Quat) -> Quat {
    return Quat(x: -q.x, y: -q.y, z: -q.z, w: q.w);
}

// A turn of `angle` radians about a unit axis.
fn qturn(x: number, y: number, z: number, angle: number) -> Quat {
    let s = sin(angle * 0.5);
    return Quat(x: x * s, y: y * s, z: z * s, w: cos(angle * 0.5));
}

script Diver {
    // How fast the suit's thrusters change the diver's speed, in m/s².
    @export let thrust: number = 2.2;
    // How fast a push off a handhold sends the diver, in m/s.
    @export let push_speed: number = 3.2;
    // How far a hand reaches from the eye, in metres.
    @export let reach: number = 1.1;
    // Radians of turn per unit of pointer movement, and per second of roll.
    @export let look_speed: number = 0.0025;
    @export let roll_speed: number = 1.6;
    // Propellant, as a percentage of a full tank, and how fast thrusting burns it.
    @export let burn_rate: number = 4.0;
    // Aboard: walking speed in m/s, how fast feet take it up, jump speed, gravity.
    @export let walk_speed: number = 2.6;
    @export let footing: number = 12.0;
    @export let jump_speed: number = 3.2;
    @export let gravity: number = 9.81;
    // Suit oxygen and power use in vacuum, and refill aboard, in % per second.
    @export let breathe_rate: number = 0.8;
    @export let power_rate: number = 0.3;
    @export let refill_rate: number = 12.0;
    // How near an airlock panel a hand must be to work it.
    @export let panel_reach: number = 1.6;

    var propellant: number = 100.0;
    var eye: Entity = null;
    var hold: Entity = null;
    // The handhold last pushed off from: not caught again until out of reach.
    var left_behind: Entity = null;
    // Where the diver's body hangs while holding on.
    var anchor: Vec3 = Vec3(0.0, 0.0, 0.0);
    var warned_low: bool = false;
    var warned_empty: bool = false;
    var oxygen: number = 100.0;
    var power: number = 100.0;
    var warned_air: bool = false;
    var spawn: Vec3 = Vec3(0.0, 0.0, 0.0);
    // Aboard, the view is a heading and a tilt, kept upright.
    var yaw: number = 0.0;
    var pitch: number = 0.0;
    var aboard: bool = true;
    // The hull the diver is aboard, and where they stood in its own space and
    // in the world at the last step: how far that spot has moved since is how
    // the hull carries them, its spin included.
    var hull: Entity = null;
    var held_local: Vec3 = Vec3(0.0, 0.0, 0.0);
    var held_world: Vec3 = Vec3(0.0, 0.0, 0.0);
    var frame_velocity: Vec3 = Vec3(0.0, 0.0, 0.0);
    // Whether `held_local` and `held_world` were taken last step.
    var held: bool = false;
    // Seated at a ship's controls: the keys fly the ship, not the diver.
    var seated: bool = false;

    fn start() {
        this.eye = World.find("Eye");
        // Where the diver wakes after a blackout: by the bunk, whatever the start.
        this.spawn = World.find("Spawn").transform.world_position;
        place();
        if this.aboard {
            print("Drift: awake in the cabin");
        } else {
            print("Drift: floating in the hold");
            // Starting by the aft handhold, the diver is already holding on.
            let start = World.find("StartHold");
            if start.transform.world_position.distance(this.eye.transform.world_position) <= this.reach {
                grab(start);
            }
        }
        upright_from_view();
    }

    fn update(dt: number) {
        if Pointer.just_pressed("Left") && !Pointer.locked {
            Pointer.lock();
        }
        let was_aboard = this.aboard;
        let was_hull = this.hull;
        place();
        carried(dt, was_hull);
        if this.aboard && !was_aboard {
            upright_from_view();
            this.hold = null;
            print("Drift: gravity");
        }
        if !this.aboard && was_aboard {
            // Feet leave the deck with the walk's speed and the hull's own
            // motion, not the push of the floor holding them up a moment ago.
            if was_hull != null {
                let up = was_hull.transform.up;
                let velocity = Physics3d.velocity(this.entity);
                let relative = velocity - this.frame_velocity;
                let lift = relative.dot(up);
                if abs(lift) < 1.0 {
                    Physics3d.set_velocity(this.entity, velocity - up * lift);
                }
            }
            print("Drift: weightless");
        }
        let reached = nearest_hold();
        seat(dt);
        if this.seated {
            sit();
        } else if this.aboard {
            look_upright(dt);
            walk(dt);
        } else {
            look(dt);
            if this.hold != null {
                holding(reached);
            } else {
                if wants_hold() && reached != null {
                    grab(reached);
                } else {
                    fly(dt);
                }
            }
        }
        suit(dt);
        if this.left_behind != null && this.left_behind != reached {
            let away = this.left_behind.transform.world_position - this.eye.transform.world_position;
            if away.length > this.reach * 1.5 {
                this.left_behind = null;
            }
        }
        for other in Physics3d.collision_started() {
            if World.has_tag(other, "cargo") {
                print("Drift: bumped cargo");
            }
        }
        hud(reached);
    }

    fn look(dt: number) {
        let delta = Pointer.delta + Vec2(Controls.look_x, Controls.look_y);
        var turn = this.eye.transform.rotation;
        if delta.x != 0.0 {
            turn = qmul(turn, qturn(0.0, 1.0, 0.0, -delta.x * this.look_speed));
        }
        if delta.y != 0.0 {
            turn = qmul(turn, qturn(1.0, 0.0, 0.0, -delta.y * this.look_speed));
        }
        var roll = Input.Keyboard.axis("E", "Q") - Controls.roll;
        // At an airlock panel, E works the airlock rather than rolling.
        if at_panel() && Input.Keyboard.is_down("E") {
            roll = 0.0;
        }
        if roll != 0.0 {
            turn = qmul(turn, qturn(0.0, 0.0, 1.0, roll * this.roll_speed * dt));
        }
        this.eye.transform.rotation = turn;
    }

    // Where the diver is: which hull, if any, and whether in its air.
    fn place() {
        let at = this.transform.world_position;
        this.hull = null;
        var breathable = false;
        for candidate in World.with_tag("hull") {
            let hull = Hull.on(candidate);
            let local = candidate.transform.to_local(at);
            let within = local.x >= hull.min_x && local.x <= hull.max_x
                && local.y >= hull.min_y && local.y <= hull.max_y
                && local.z >= hull.min_z && local.z <= hull.max_z;
            if within && this.hull == null {
                this.hull = candidate;
                if hull.airlock {
                    breathable = Ship.chamber_pressure > 0.5;
                } else {
                    breathable = hull.air;
                }
                if !hull.gravity {
                    this.hull = null;
                }
            }
        }
        this.aboard = this.hull != null;
        Ship.in_gravity = this.aboard;
        Ship.pressurized = breathable;
    }

    // How the hull is moving where the diver stands: the spot they stood on
    // last step, carried to where the hull has put it now.
    fn carried(dt: number, was_hull: Entity?) {
        let at = this.transform.world_position;
        if this.hull == null || dt <= 0.0 {
            this.frame_velocity = Vec3(0.0, 0.0, 0.0);
            this.held = false;
            return;
        }
        if was_hull == this.hull && this.held {
            let moved = this.hull.transform.to_world(this.held_local) - this.held_world;
            this.frame_velocity = moved / dt;
        } else {
            this.frame_velocity = Vec3(0.0, 0.0, 0.0);
        }
        this.held_local = this.hull.transform.to_local(at);
        this.held_world = at;
        this.held = true;
    }

    fn at_panel() -> bool {
        let hand = this.eye.transform.world_position;
        return World.within_radius("airlock-panel", hand, this.panel_reach).len > 0;
    }

    // The hull's turn in the world: none outside one.
    fn hull_turn() -> Quat {
        if this.hull == null {
            return Quat(x: 0.0, y: 0.0, z: 0.0, w: 1.0);
        }
        return this.hull.transform.rotation;
    }

    // The heading and tilt, in the hull's own space, that keep the present
    // view, with the hull's deck below.
    fn upright_from_view() {
        let f = qrot(qinv(hull_turn()), this.eye.transform.forward);
        this.yaw = atan2(-f.x, -f.z);
        this.pitch = atan2(f.y, sqrt(f.x * f.x + f.z * f.z));
    }

    // Aboard, the mouse turns the heading about the hull's up and tilts the
    // view, which rights itself over a moment after coming in from outside,
    // and turns with the hull as it turns.
    fn look_upright(dt: number) {
        let delta = Pointer.delta + Vec2(Controls.look_x, Controls.look_y);
        this.yaw -= delta.x * this.look_speed;
        this.pitch = clamp(this.pitch - delta.y * this.look_speed, -1.45, 1.45);
        let local = qmul(qturn(0.0, 1.0, 0.0, this.yaw), qturn(1.0, 0.0, 0.0, this.pitch));
        let upright = qmul(hull_turn(), local);
        let settle = 1.0 - exp(-10.0 * dt);
        this.eye.transform.rotation = qblend(this.eye.transform.rotation, upright, settle);
    }

    // Aboard: feet on the hull's deck, its gravity down, walking where the
    // view faces, all relative to the hull as it moves and turns.
    fn walk(dt: number) {
        let turn = hull_turn();
        let up = qrot(turn, Vec3(0.0, 1.0, 0.0));
        let ground = Physics3d.raycast(this.transform.world_position, up * -1.0, 0.86, 1, false, this.entity);
        let grounded = ground != null;
        let forward = qrot(turn, Vec3(-sin(this.yaw), 0.0, -cos(this.yaw)));
        let right = qrot(turn, Vec3(cos(this.yaw), 0.0, -sin(this.yaw)));
        var wanted = forward * (Input.Keyboard.axis("S", "W") + Controls.move_y)
            + right * (Input.Keyboard.axis("A", "D") + Controls.move_x);
        // A key is all the way; a thumb on the stick can ask for a stroll.
        if wanted.length > 1.0 {
            wanted = wanted.normalized;
        }
        wanted = wanted * this.walk_speed;
        var grip = 1.5;
        if grounded {
            grip = this.footing;
        }
        let take = min(1.0, grip * dt);
        // Everything is worked out relative to the hull, then the hull's own
        // motion where the diver stands is added back.
        let relative = Physics3d.velocity(this.entity) - this.frame_velocity;
        var lift = relative.dot(up);
        let across = relative - up * lift;
        let walked = across + (wanted - across) * take;
        lift -= this.gravity * dt;
        if grounded && (Input.Keyboard.just_pressed("Space") || Controls.up_pressed) {
            lift = this.jump_speed;
        }
        Physics3d.set_velocity(this.entity, this.frame_velocity + walked + up * lift);
    }

    // F at a ship's seat sits at its controls; F again stands up.
    fn seat(dt: number) {
        let chair = World.find("Seat");
        let asked = Input.Keyboard.just_pressed("F") || Controls.grab_pressed || Controls.use_pressed;
        if chair == null || !asked {
            return;
        }
        if this.seated {
            this.seated = false;
            Ship.piloting = false;
            print("Drift: left the controls");
            return;
        }
        let near = chair.transform.world_position.distance(this.transform.world_position) < 1.6;
        if this.aboard && near {
            this.seated = true;
            Ship.piloting = true;
            this.hold = null;
            print("Drift: at the controls");
        }
    }

    // Seated: held in the seat as the ship moves, looking over the console at
    // its nose. The mouse and keys are the pilot's.
    fn sit() {
        let chair = World.find("Seat");
        let up = chair.transform.up;
        this.transform.world_position = chair.transform.world_position + up * 0.75;
        // Moving with the ship: the spot under the seat keeps being measured,
        // so standing up mid-flight keeps the ship's speed.
        Physics3d.set_velocity(this.entity, this.frame_velocity);
        // Facing the ship's nose (its -X): a quarter turn of heading.
        this.yaw = 1.5707963;
        this.pitch = -0.1;
        let local = qmul(qturn(0.0, 1.0, 0.0, this.yaw), qturn(1.0, 0.0, 0.0, this.pitch));
        this.eye.transform.rotation = qmul(hull_turn(), local);
    }

    // The suit: air and power run down in vacuum and fill up in the ship's air.
    fn suit(dt: number) {
        if Ship.pressurized {
            this.oxygen = min(100.0, this.oxygen + this.refill_rate * dt);
            this.power = min(100.0, this.power + this.refill_rate * dt);
            this.propellant = min(100.0, this.propellant + this.refill_rate * dt);
            this.warned_air = false;
            this.warned_low = false;
            this.warned_empty = false;
        } else {
            this.oxygen = max(0.0, this.oxygen - this.breathe_rate * dt);
            this.power = max(0.0, this.power - this.power_rate * dt);
        }
        World.find("HelmetLamp").light.enabled = this.power > 0.0;
        if this.oxygen < 25.0 && !this.warned_air {
            this.warned_air = true;
            print("Drift: oxygen low");
        }
        if this.oxygen <= 0.0 {
            blackout();
        }
    }

    // Out of air: the diver blacks out and wakes in the cabin, the suit refilled.
    fn blackout() {
        print("Drift: out of air");
        this.hold = null;
        this.transform.world_position = this.spawn;
        this.held = false;
        Physics3d.set_velocity(this.entity, Vec3(0.0, 0.0, 0.0));
        this.oxygen = 100.0;
        this.power = 100.0;
        this.warned_air = false;
        this.aboard = true;
        upright_from_view();
    }

    fn wants_hold() -> bool {
        return Input.Keyboard.is_down("F") || Pointer.is_down("Right") || Controls.grab;
    }

    // The closest handhold a hand can reach, other than the one just pushed off.
    fn nearest_hold() -> Entity? {
        let from = this.eye.transform.world_position;
        for candidate in World.within_radius("handhold", from, this.reach) {
            if candidate != this.left_behind {
                return candidate;
            }
        }
        return null;
    }

    fn grab(handhold: Entity) {
        this.hold = handhold;
        this.anchor = this.transform.world_position;
        Physics3d.set_velocity(this.entity, Vec3(0.0, 0.0, 0.0));
        if handhold == World.find("FarHold") {
            print("Drift: caught the far handhold");
        } else {
            print("Drift: holding on");
        }
    }

    fn holding(reached: Entity?) {
        let push = Input.Keyboard.just_pressed("Space") || Controls.up_pressed
            || Pointer.just_pressed("Left") && Pointer.locked;
        if push {
            this.left_behind = this.hold;
            this.hold = null;
            Physics3d.set_velocity(this.entity, this.eye.transform.forward * this.push_speed);
            print("Drift: pushed off");
            return;
        }
        if !wants_hold() && !holds_by_itself() {
            this.hold = null;
            print("Drift: let go");
            return;
        }
        // The arm takes up the slack: drawn back to where the hand closed.
        let pull = (this.anchor - this.transform.world_position) * 6.0;
        Physics3d.set_velocity(this.entity, pull);
    }

    // At the start the diver is already holding on without a key held.
    fn holds_by_itself() -> bool {
        return this.hold == World.find("StartHold") && this.left_behind == null;
    }

    fn fly(dt: number) {
        var push = Vec3(0.0, 0.0, 0.0);
        let forward = this.eye.transform.forward;
        let right = this.eye.transform.right;
        let up = this.eye.transform.up;
        push = push + forward * (Input.Keyboard.axis("S", "W") + Controls.move_y);
        push = push + right * (Input.Keyboard.axis("A", "D") + Controls.move_x);
        push = push + up * (Input.Keyboard.axis("C", "Space") + rise());
        let braking = Input.Keyboard.is_down("X") || Controls.brake;
        var velocity = Physics3d.velocity(this.entity);
        if braking && velocity.length > 0.01 {
            push = push - velocity.normalized;
        }
        if push.length < 0.001 {
            return;
        }
        if this.propellant <= 0.0 {
            if !this.warned_empty {
                this.warned_empty = true;
                print("Drift: propellant empty");
            }
            return;
        }
        let change = push.normalized * this.thrust * dt;
        // A brake never overshoots into thrusting the other way.
        if braking && change.length > velocity.length && push.length < 1.01 {
            velocity = Vec3(0.0, 0.0, 0.0);
        } else {
            velocity = velocity + change;
        }
        Physics3d.set_velocity(this.entity, velocity);
        this.propellant = max(0.0, this.propellant - this.burn_rate * dt);
        if this.propellant < 20.0 && !this.warned_low {
            this.warned_low = true;
            print("Drift: propellant low");
        }
    }

    // The touch buttons for up and down, as one axis the way C and Space are.
    fn rise() -> number {
        var amount = 0.0;
        if Controls.up { amount += 1.0; }
        if Controls.down { amount -= 1.0; }
        return amount;
    }

    fn hud(reached: Entity?) {
        Ui.set_number(World.find("hud-propellant"), round(this.propellant));
        Ui.set_number(World.find("hud-oxygen"), round(this.oxygen));
        Ui.set_number(World.find("hud-power"), round(this.power));
        let alert = World.find("hud-alert");
        if this.oxygen < 25.0 {
            Ui.set_text(alert, "OXYGEN LOW");
        } else {
            Ui.set_text(alert, "");
        }
        let speed = Physics3d.velocity(this.entity).length;
        Ui.set_number(World.find("hud-velocity"), round(speed * 10.0) / 10.0);
        let prompt = World.find("hud-prompt");
        if at_panel() {
            Ui.set_text(prompt, "E / ACTION  cycle airlock");
        } else if this.hold != null {
            Ui.set_text(prompt, "SPACE / JUMP  push off");
        } else {
            if reached != null {
                Ui.set_text(prompt, "F / hold ACTION  hold on");
            } else {
                Ui.set_text(prompt, "");
            }
        }
    }
}
