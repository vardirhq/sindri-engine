// A power-up: a signpost that drops out of the sky and sticks in the grass.
// Its shadow marks where it will land, growing as it falls. Once it has
// landed, whoever walks into it gets what the sign shows; left alone it goes
// after a while.
//
// Grow (the Enlarger): the player grows, and reaches the ball from further away.
// Boost (Push Boost): the player's kicks go much further.
// Wind: the pitch tilts towards the other team's goal.
// Fire (the Fireball): the ball catches fire, and sets alight any opponent it touches.
//
// This entity is the spot on the ground where the sign lands. The shadow and
// the sign are its children, so they stand where it stands and go with it; the
// sign only has to be told how high above the spot it still is.
script PowerUp {
    @export let kind = Power.Grow;
    @export let sign: Prefab;
    @export let shadow: Prefab;
    @export let drop_height: f32 = 12.0;
    @export let gravity: f32 = 30.0;
    @export let life: f32 = 10.0;
    @export let reach: f32 = 1.2;

    var height: f32 = 12.0;
    var falling: f32 = 0.0;
    var landed: f32 = -1.0;
    var shown: Entity = null;
    var ground: Entity = null;

    fn start() {
        this.height = this.drop_height;
        this.ground = World.spawn_child(this.shadow, this.entity);
        let shown = World.spawn_child(this.sign, this.entity);
        let clip = match this.kind {
            Power.Grow => "enlarger",
            Power.Boost => "push",
            Power.Wind => "wind",
            Power.Fire => "fireball",
        };
        Animation.play(shown, clip);
        this.shown = shown;
        place();
    }

    fn update(dt: f32) {
        if this.landed < 0.0 {
            fall(dt);
            return;
        }
        this.landed += dt;
        if this.landed > this.life {
            World.despawn(this.entity);
            return;
        }
        for player in World.with_tag("player") {
            let dx = player.transform.position.x - this.transform.position.x;
            let dy = player.transform.position.y - 1.1 * player.transform.scale.y / 3.2 - this.transform.position.y;
            if sqrt(dx * dx + dy * dy) < this.reach && World.exists(this.entity) {
                give(player);
                World.despawn(this.entity);
                return;
            }
        }
    }

    fn fall(dt: f32) {
        this.falling += this.gravity * dt;
        this.height -= this.falling * dt;
        if this.height <= 0.0 {
            this.height = 0.0;
            this.landed = 0.0;
            Audio.play("audio/hit.wav", 0.7);
            Camera.add_trauma(0.15);
        }
        place();
    }

    // The sign above the spot, and the shadow as wide as the sign is near.
    fn place() {
        let near = 1.0 - this.height / this.drop_height;
        var clip: String = "s5";
        if near < 0.2 { clip = "s0"; } else if near < 0.4 { clip = "s1"; } else if near < 0.6 { clip = "s2"; } else if near < 0.8 { clip = "s3"; } else if near < 1.0 { clip = "s4"; }
        let ground = this.ground;
        if ground != null && Animation.clip(ground) != clip {
            Animation.play(ground, clip);
        }
        let shown = this.shown;
        if shown != null {
            shown.transform.position.y = 0.68 + this.height;
            // In front of whatever stands further up the pitch.
            shown.transform.position.z = 0.6 - this.transform.position.y * 0.01;
        }
    }

    fn give(player: Entity) {
        Audio.play("audio/run.wav", 0.8);
        let picker = Player.on(player);
        if picker == null { return; }
        match this.kind {
            Power.Grow | Power.Boost => { picker.power_up(this.kind); }
            Power.Wind => {
                // Blue attack the right goal, so their wind blows right.
                var blow: f32 = -1.0;
                if picker.team == 1.0 { blow = 1.0; }
                WindPicked.emit(blow);
            }
            Power.Fire => { FirePicked.emit(picker.team); }
        }
    }
}
