// One player: walks with the left stick, sprints with the left bumper, picks a
// skin and readies up in the lobby, and charges a kick with the right bumper,
// aimed with the right stick.
//
// A player is made by the match when a pad joins, and told which slot it is.
// Odd slots play for Blue, who defend the left goal; even slots for Red.
//
// A bot is a player with no pad: the match makes one on slot 11 or 12 when
// Select is pressed in the lobby, and it steers itself (see `think`). Bots
// choose intentions, but use the same sprint, kick and aftertouch mechanics.
script Player {
    @export let slot: number = 1.0;
    @export let bot: bool = false;
    // How long a bot takes to notice what changed, and how far off it aims.
    @export let reaction: number = 0.22;
    @export let aim_noise: number = 0.7;
    @export let arrow: Prefab;
    @export let speed: number = 10.0;
    @export let sprint_speed: number = 1.45;
    @export let sprint_animation_speed: number = 4.0;
    @export let kick_speed: number = 22.0;
    @export let charged_kick: number = 34.0;
    @export let boost_kick: number = 36.0;
    @export let charged_boost_kick: number = 48.0;
    @export let charge_time: number = 0.85;
    @export let aftertouch_time: number = 0.42;
    @export let aftertouch_strength: number = 8.0;
    // How big a player is drawn: an unready player stands tall in the lobby,
    // and the Enlarger makes one bigger for a while.
    @export let normal: number = 3.2;
    @export let big: number = 1.75;
    @export let grown: number = 1.6;
    @export let power_time: number = 20.0;
    @export let burn_time: number = 5.0;

    var team: number = 1.0;
    var skin: number = 0.0;
    var ready: bool = false;
    var size: number = 1.75;
    var grow_timer = Timer(0.0);
    var boost_timer = Timer(0.0);
    var burn_timer = Timer(0.0);
    var burn_turn: number = 0.0;
    var burn_x: number = 0.0;
    var burn_y: number = 0.0;
    var fire_clock: number = 0.0;
    var vx: number = 0.0;
    var vy: number = 0.0;
    var face_right: bool = true;
    var face_down: bool = true;
    var moving: bool = false;
    var sprinting: bool = false;
    var charge: number = 0.0;
    var charge_fx: number = 0.0;
    var aftertouch_timer = Timer(0.0);
    var ball: Ball = null;
    // A bot's plan: where it is heading, and a kick it has decided on.
    var plan_timer = Timer(0.0);
    var want_x: number = 0.0;
    var want_y: number = 0.0;
    var kick_left: number = -1.0;
    var aim: Vec2 = Vec2(0.0, 0.0);
    var kick_now: bool = false;
    var seen_bx: number = 0.0;
    var seen_by: number = 0.0;
    var ball_vx: number = 0.0;
    var ball_vy: number = 0.0;
    var sprint_timer = Timer(0.0);
    var bot_shot_charge: number = 0.0;
    var bot_curve: Vec2 = Vec2(0.0, 0.0);

    fn start() {
        if this.slot % 2.0 == 1.0 {
            this.team = 1.0;
            this.skin = 0.0;
        } else {
            this.team = 2.0;
            this.skin = 1.0;
            this.face_right = false;
        }
        this.ball = Ball.on(World.find("Ball"));
        let marker = World.spawn_child(this.arrow, this.entity);
        Animation.play(marker, marker_clip());
        if this.bot {
            this.ready = true;
            this.size = 1.0;
        }
        show();
    }

    fn update(dt: number) {
        let phase = Game.phase;
        if this.bot {
            think(dt, phase);
        } else {
            lobby(phase);
        }
        move(dt, phase);
        try_kick(dt, phase);
        aftertouch(dt, phase);
        grow(dt);
        burn(dt);
        show();
    }

    // A power-up this player walked into that acts on them alone.
    fn power_up(kind: Power) {
        match kind {
            Power.Grow => { this.grow_timer = Timer(this.power_time); }
            Power.Boost => { this.boost_timer = Timer(this.power_time); }
            _ => { }
        }
    }

    // The ball, on fire, touched this player from the other team.
    fn catch_fire() {
        if this.burn_timer.done {
            this.burn_timer = Timer(this.burn_time);
            this.burn_turn = 0.0;
            Audio.play("audio/hit.wav", 0.8);
        }
    }

    fn lobby(phase: Phase) {
        if !this.ready && (Gamepad.just_pressed(this.slot, "dpad_up") || Gamepad.just_pressed(this.slot, "dpad_down")) {
            this.skin = 1.0 - this.skin;
        }
        if Gamepad.just_pressed(this.slot, "north") {
            if !this.ready {
                this.ready = true;
                Audio.play("audio/run.wav", 0.6);
            } else if phase != Phase.Play {
                this.ready = false;
            }
        }
    }

    fn move(dt: number, phase: Phase) {
        var tx: number = 0.0;
        var ty: number = 0.0;
        this.sprinting = false;
        if !this.burn_timer.done {
            tx = this.burn_x * this.speed;
            ty = this.burn_y * this.speed;
        } else if this.bot && phase == Phase.Play {
            var pace: number = this.speed;
            if !this.sprint_timer.done && (abs(this.want_x) > 0.1 || abs(this.want_y) > 0.1) {
                pace = this.speed * this.sprint_speed;
                this.sprinting = true;
            }
            tx = this.want_x * pace;
            ty = this.want_y * pace;
        } else if this.ready && phase == Phase.Play {
            var x: number = Gamepad.axis(this.slot, "left_x");
            var y: number = Gamepad.axis(this.slot, "left_y");
            if Gamepad.is_down(this.slot, "dpad_left") { x = -1.0; }
            if Gamepad.is_down(this.slot, "dpad_right") { x = 1.0; }
            if Gamepad.is_down(this.slot, "dpad_up") { y = -1.0; }
            if Gamepad.is_down(this.slot, "dpad_down") { y = 1.0; }
            var pace: number = this.speed;
            if Gamepad.is_down(this.slot, "left_bumper") && (abs(x) > 0.1 || abs(y) > 0.1) {
                pace = this.speed * this.sprint_speed;
                this.sprinting = true;
            }
            tx = x * pace;
            ty = -y * pace;
        }
        tx += Game.wind * 0.4;
        let ease = min(1.0, dt * 12.0);
        this.vx += (tx - this.vx) * ease;
        this.vy += (ty - this.vy) * ease;
        Physics.set_velocity(this.entity, this.vx, this.vy);

        this.moving = abs(this.vx) > 1.0 || abs(this.vy) > 1.0;
        if this.vx > 1.0 { this.face_right = true; }
        if this.vx < -1.0 { this.face_right = false; }
        if this.vy < -1.0 { this.face_down = true; }
        if this.vy > 1.0 { this.face_down = false; }
        this.transform.position.x = max(-15.8, min(15.8, this.transform.position.x));
        this.transform.position.y = max(-6.4, min(7.0, this.transform.position.y));
        this.transform.position.z = 1.0 - this.transform.position.y * 0.01;
    }

    fn try_kick(dt: number, phase: Phase) {
        if phase != Phase.Play || !this.burn_timer.done || Game.holder != this.slot {
            this.charge = 0.0;
            this.charge_fx = 0.0;
            return;
        }
        var aim = Vec2(0.0, 0.0);
        var shot_charge: number = 0.0;
        if this.bot {
            if !this.kick_now { return; }
            this.kick_now = false;
            aim = this.aim;
            shot_charge = this.bot_shot_charge;
        } else {
            if Gamepad.is_down(this.slot, "right_bumper") {
                this.charge = min(1.0, this.charge + dt / this.charge_time);
                this.charge_fx -= dt;
                if this.charge > 0.12 && this.charge_fx <= 0.0 {
                    this.charge_fx = 0.11 - this.charge * 0.045;
                    Effects.burst(this.ball);
                }
                return;
            }
            if !Gamepad.just_released(this.slot, "right_bumper") { return; }
            shot_charge = this.charge;
            this.charge = 0.0;
            this.charge_fx = 0.0;
            aim = Vec2(Gamepad.axis(this.slot, "right_x"), -Gamepad.axis(this.slot, "right_y"));
        }
        // A stick barely pushed says nothing about direction: kick the way the
        // player faces instead.
        if aim.length < 0.3 {
            aim = Vec2(-1.0, 0.0);
            if this.face_right { aim.x = 1.0; }
        } else {
            aim = aim.normalized;
        }
        var force = this.kick_speed + (this.charged_kick - this.kick_speed) * shot_charge;
        if !this.boost_timer.done {
            force = this.boost_kick + (this.charged_boost_kick - this.boost_kick) * shot_charge;
        }
        let kick = aim * force;
        this.ball.kick(kick, this.slot);
        this.aftertouch_timer = Timer(this.aftertouch_time);
        Audio.play("audio/hit.wav", min(1.0, 0.72 + shot_charge * 0.28));
    }

    // Both humans and bots use the same short aftertouch window. Humans supply
    // right-stick intent; a bot supplies the imperfect correction it chose
    // while planning the shot. The ball still owns the live velocity change.
    fn aftertouch(dt: number, phase: Phase) {
        if this.aftertouch_timer.done || phase != Phase.Play {
            this.aftertouch_timer = Timer(0.0);
            return;
        }
        var pull = this.bot_curve;
        if !this.bot {
            pull = Vec2(Gamepad.axis(this.slot, "right_x"), -Gamepad.axis(this.slot, "right_y"));
        }
        if pull.length < 0.2 { return; }
        let fade = this.aftertouch_timer.left / this.aftertouch_time;
        let push = pull.normalized * this.aftertouch_strength * fade * dt;
        this.ball.nudge(push);
    }

    fn grow(dt: number) {
        var target: number = 1.0;
        if !this.ready { target = this.big; }
        else if !this.grow_timer.done { target = this.grown; }
        this.size += (target - this.size) * min(1.0, dt * 3.0);
        this.transform.scale.x = this.normal * this.size;
        this.transform.scale.y = this.normal * this.size;
    }

    fn burn(dt: number) {
        if this.burn_timer.done { return; }
        this.burn_turn -= dt;
        if this.burn_turn <= 0.0 {
            this.burn_turn = 1.0;
            this.burn_x = Random.range(-1.5, 1.5);
            this.burn_y = Random.range(-1.5, 1.5);
        }
        this.fire_clock -= dt;
        if this.fire_clock <= 0.0 {
            this.fire_clock = 0.07;
            Effects.burst(this.entity);
        }
    }

    fn show() {
        let clip = clip_name();
        if Animation.clip(this.entity) != clip { Animation.play(this.entity, clip); }
        var animation_speed: number = 1.0;
        if this.sprinting && this.moving { animation_speed = this.sprint_animation_speed; }
        Animation.set_speed(this.entity, animation_speed);
    }

    fn clip_name() -> String {
        if this.skin == 0.0 {
            if this.moving {
                if this.face_right {
                    if this.face_down { return "ginger-walk-rd"; }
                    return "ginger-walk-ru";
                }
                if this.face_down { return "ginger-walk-ld"; }
                return "ginger-walk-lu";
            }
            if this.face_right {
                if this.face_down { return "ginger-idle-rd"; }
                return "ginger-idle-ru";
            }
            if this.face_down { return "ginger-idle-ld"; }
            return "ginger-idle-lu";
        }
        if this.moving {
            if this.face_right {
                if this.face_down { return "yellow-walk-rd"; }
                return "yellow-walk-ru";
            }
            if this.face_down { return "yellow-walk-ld"; }
            return "yellow-walk-lu";
        }
        if this.face_right {
            if this.face_down { return "yellow-idle-rd"; }
            return "yellow-idle-ru";
        }
        if this.face_down { return "yellow-idle-ld"; }
        return "yellow-idle-lu";
    }

    fn marker_clip() -> String {
        if this.slot == 1.0 { return "p1"; }
        if this.slot == 2.0 { return "p2"; }
        if this.slot == 3.0 { return "p3"; }
        if this.slot == 11.0 { return "p1"; }
        if this.slot == 12.0 { return "p2"; }
        return "p4";
    }

    // A bot observes only a few times a second. It chooses player-like actions
    // from that stale picture: when to sprint, how much to charge a shot, and
    // whether to add a little aftertouch. Physics and possession stay shared.
    fn think(dt: number, phase: Phase) {
        if this.kick_left >= 0.0 {
            this.kick_left -= dt;
            if this.kick_left < 0.0 { this.kick_now = true; }
        }
        if phase != Phase.Play || !this.plan_timer.done { return; }
        let look = this.reaction * Random.range(0.7, 1.3);
        this.plan_timer = Timer(look);
        let ball = this.ball;
        let bx = ball.transform.position.x;
        let by = ball.transform.position.y;
        this.ball_vx = (bx - this.seen_bx) / look;
        this.ball_vy = (by - this.seen_by) / look;
        this.seen_bx = bx;
        this.seen_by = by;

        let holder = Game.holder;
        if holder == this.slot {
            attack(bx, by);
        } else if holder > 0.0 && holder % 2.0 == this.slot % 2.0 {
            support(bx, by);
        } else if holder > 0.0 {
            defend(bx, by, true);
        } else if first_to(bx, by) {
            maybe_sprint(distance(this.entity, bx, by), 0.65);
            head_to(bx + this.ball_vx * 0.4 - attack_way() * 0.3, by + this.ball_vy * 0.4, 1.0);
        } else {
            defend(bx, by, false);
        }
    }

    fn attack(bx: number, by: number) {
        let way = attack_way();
        let goal_x = 14.9 * way;
        let near = nearest_opponent(bx, by);
        var ox: number = 100.0;
        var oy: number = 100.0;
        if near != null {
            ox = near.transform.position.x;
            oy = feet(near);
        }
        let ahead = (ox - bx) * way;
        let pressed = abs(ox - bx) < 2.0 && abs(oy - by) < 2.0;
        let range = abs(goal_x - bx);
        maybe_sprint(range, 0.45);
        if this.kick_left < 0.0 && (range < 9.0 || (pressed && range < 15.0 && ahead > 0.0)) {
            var side: number = 1.4;
            if oy > 0.0 { side = -1.4; }
            let aim_y = side + Random.range(-this.aim_noise, this.aim_noise);
            this.aim = Vec2(goal_x + way - bx, aim_y - by).normalized;
            // Nearby finishes are often snapped off; distance gives the bot a
            // reason to hold the same charge control a human would.
            this.bot_shot_charge = min(1.0, max(0.0, (range - 3.0) / 9.0 + Random.range(-0.15, 0.15)));
            this.bot_curve = Vec2(0.0, 0.0);
            if Random.range(0.0, 1.0) > 0.35 {
                this.bot_curve.y = (aim_y - by) * 0.35 + Random.range(-0.25, 0.25);
            }
            // Charging takes time too: longer wind-up for a harder shot.
            this.kick_left = Random.range(0.05, 0.14) + this.bot_shot_charge * this.charge_time;
        }
        var move_y: number = (0.0 - by) * 0.15;
        if ahead > 0.0 && ahead < 4.5 && abs(oy - by) < 2.5 {
            move_y = 0.9;
            if oy > by || by > 4.5 { move_y = -0.9; }
            if by < -4.5 { move_y = 0.9; }
        }
        steer(way, move_y, 1.0);
    }

    fn support(bx: number, by: number) {
        maybe_sprint(distance(this.entity, bx, by), 0.3);
        head_to(bx + attack_way() * 5.0, 0.0 - by * 0.6, 0.9);
    }

    fn defend(bx: number, by: number, pressing: bool) {
        let own_x = -14.9 * attack_way();
        let x = this.transform.position.x;
        let y = feet(this.entity);
        let dx = bx - x;
        let dy = by - y;
        let range = sqrt(dx * dx + dy * dy);
        let goal_side = (x - bx) * attack_way() < 0.0;
        if pressing && goal_side && range < 3.5 {
            maybe_sprint(range, 0.55);
            head_to(bx, by, 1.0);
            return;
        }
        if pressing { maybe_sprint(range, 0.28); }
        head_to(bx + (own_x - bx) * 0.35, by * 0.65, 1.0);
    }

    // Sprint is a burst decision, not a permanent AI speed multiplier. A bot
    // may choose it when there is real ground to cover, then has to reconsider.
    fn maybe_sprint(range: number, chance: number) {
        if !this.sprint_timer.done || range < 3.0 { return; }
        if Random.range(0.0, 1.0) < chance {
            this.sprint_timer = Timer(Random.range(0.35, 0.85));
        }
    }

    fn first_to(bx: number, by: number) -> bool {
        let mine = distance(this.entity, bx, by);
        let near = nearest_opponent(bx, by);
        if near == null { return true; }
        return mine < distance(near, bx, by) + 1.5;
    }

    fn nearest_opponent(bx: number, by: number) -> Entity {
        var best: Entity = null;
        var best_distance: number = 1000.0;
        for someone in World.with_tag("player") {
            let slot = World.property_number(someone, "slot", 0.0);
            if slot % 2.0 != this.slot % 2.0 {
                let d = distance(someone, bx, by);
                if d < best_distance {
                    best_distance = d;
                    best = someone;
                }
            }
        }
        return best;
    }

    fn head_to(x: number, y: number, pace: number) {
        let dx = x - this.transform.position.x;
        let dy = y - feet(this.entity);
        let length = sqrt(dx * dx + dy * dy);
        if length < 0.2 {
            steer(0.0, 0.0, 0.0);
            return;
        }
        steer(dx, dy, pace * min(1.0, length / 1.5));
    }

    fn steer(dx: number, dy: number, pace: number) {
        let length = sqrt(dx * dx + dy * dy);
        if length < 0.001 {
            this.want_x = 0.0;
            this.want_y = 0.0;
            return;
        }
        this.want_x = dx / length * pace;
        this.want_y = dy / length * pace;
    }

    fn distance(someone: Entity, x: number, y: number) -> number {
        let dx = x - someone.transform.position.x;
        let dy = y - feet(someone);
        return sqrt(dx * dx + dy * dy);
    }

    fn feet(someone: Entity) -> number {
        return someone.transform.position.y - 1.1 * someone.transform.scale.x / 3.2;
    }

    fn attack_way() -> number {
        if this.team == 1.0 { return 1.0; }
        return -1.0;
    }
}
