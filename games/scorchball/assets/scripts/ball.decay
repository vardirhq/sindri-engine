// The ball: whoever touches it has it, the right bumper kicks it, and it
// scores by crossing a goal mouth.
//
// Held, it sits at the holder's feet on the side they face. Loose, it rolls
// and slows. Touching a held ball steals it, as it always did. Hard strikes
// build heat in the ball, which cools over time and throws increasingly lively
// flecks. Human shots accept a brief, fading right-stick aftertouch window.
// On fire it cannot be held: it bounces off whoever touches it, and sets alight
// anyone on the other team from the player who lit it.
//
// Possession is decided by distance rather than by a collider, so an enlarged
// player reaches further without a body of a different size.
script Ball {
    @export let friction: f32 = 2.2;
    @export let reach: f32 = 0.9;
    @export let goal_line: f32 = 14.9;
    @export let mouth: f32 = 2.1;
    @export let post_radius: f32 = 0.42;
    @export let fire_time: f32 = 20.0;
    @export let heat_threshold: f32 = 24.0;
    @export let heat_gain: f32 = 24.0;
    @export let heat_cool: f32 = 0.055;

    var velocity: Vec2 = Vec2(0.0, 0.0);
    var holder: Entity = null;
    var holder_right: bool = true;
    var kicker: Entity = null;
    var kicked_ago: f32 = 1.0;
    var fire_left: f32 = 0.0;
    var fire_team: f32 = 0.0;
    var fire_clock: f32 = 0.0;
    var heat: f32 = 0.0;
    var heat_clock: f32 = 0.0;
    var aftertouch_slot: f32 = 0.0;
    var zone: Entity = null;

    fn start() {
        this.zone = World.find("Ball Ring");
        Game.set("holder", 0.0);
    }

    fn update(dt: f32) {
        if Game.get("phase", 0.0) < 2.0 {
            // Waiting at the centre spot for kickoff.
            reset();
            return;
        }
        this.kicked_ago += dt;
        touches();
        if this.holder != null && World.exists(this.holder) {
            dribble();
        } else {
            this.holder = null;
            roll(dt);
        }
        burn(dt);
        scorch(dt);
        scored();
        mark();
    }

    // A player kicked it: off it goes, and whoever kicked it may bend the
    // shot for a moment.
    fn kick(velocity: Vec2, slot: f32) {
        this.velocity = velocity;
        this.kicker = this.holder;
        this.kicked_ago = 0.0;
        this.holder = null;
        this.aftertouch_slot = slot;
        let speed = this.velocity.length;
        if speed > this.heat_threshold {
            let added = (speed - this.heat_threshold) / this.heat_gain;
            this.heat = min(1.0, this.heat + added);
            Effects.burst(this.entity);
            Camera.add_trauma(min(0.32, (speed - 24.0) / 55.0));
        }
    }

    // The player sends tiny frame-scaled nudges for only a short time, so
    // aftertouch bends a shot instead of becoming ball steering.
    fn nudge(push: Vec2) {
        if this.aftertouch_slot > 0.0 && this.holder == null {
            this.velocity += push;
        }
    }

    on FirePicked(team) {
        this.fire_left = this.fire_time;
        this.fire_team = team;
        this.holder = null;
        this.aftertouch_slot = 0.0;
    }

    fn touches() {
        for player in World.with_tag("player") {
            let scale = player.transform.scale.x / 3.2;
            // Measured from the player's feet, where the ball sits when held.
            let feet = player.transform.position - Vec3(0.0, 1.1 * scale, 0.0);
            let away = this.transform.position - feet;
            let offset = Vec2(away.x, away.y);
            let distance = offset.length;
            // The one who just kicked it does not take it straight back.
            let fresh = player == this.kicker && this.kicked_ago < 0.3;
            if distance < this.reach * scale && player != this.holder && !fresh {
                if this.fire_left > 0.0 {
                    bounce(player, offset, distance);
                } else {
                    this.holder = player;
                    this.aftertouch_slot = 0.0;
                    this.velocity = Vec2(0.0, 0.0);
                    Audio.play("audio/run.wav", 0.5);
                }
            }
        }
    }

    fn bounce(player: Entity, offset: Vec2, distance: f32) {
        this.velocity = offset / max(0.01, distance) * 12.0;
        this.kicker = player;
        this.kicked_ago = 0.0;
        this.aftertouch_slot = 0.0;
        if team(player) != this.fire_team {
            Player.on(player).catch_fire();
        }
    }

    fn dribble() {
        let holder = this.holder;
        let scale = holder.transform.scale.x / 3.2;
        let moving = Physics.velocity_x(holder);
        if moving > 1.0 { this.holder_right = true; }
        if moving < -1.0 { this.holder_right = false; }
        var side: f32 = -0.5;
        if this.holder_right { side = 0.5; }
        this.transform.position.x = holder.transform.position.x + side * scale;
        this.transform.position.y = holder.transform.position.y - 1.1 * scale;
        Game.set("holder", World.property_number(holder, "slot", 0.0));
    }

    fn roll(dt: f32) {
        Game.set("holder", 0.0);
        this.velocity.x += Game.get("wind", 0.0) * dt;
        this.velocity *= max(0.0, 1.0 - this.friction * dt);
        let step = this.velocity * dt;
        this.transform.position += Vec3(step.x, step.y, 0.0);
    }

    fn burn(dt: f32) {
        if this.fire_left <= 0.0 {
            return;
        }
        this.fire_left -= dt;
        this.fire_clock -= dt;
        if this.fire_clock <= 0.0 {
            this.fire_clock = 0.06;
            Effects.burst(this.entity);
        }
    }

    // Scorch is deliberately not the Fireball power-up. Repeated hard shots
    // make the ordinary ball look hotter and more violent, but do not change
    // possession or hurt players. Stop hammering it and it cools back down.
    fn scorch(dt: f32) {
        this.heat = max(0.0, this.heat - this.heat_cool * dt);
        if this.fire_left > 0.0 || this.heat < 0.2 {
            return;
        }
        this.heat_clock -= dt;
        if this.heat_clock <= 0.0 {
            this.heat_clock = 0.22 - this.heat * 0.14;
            Effects.burst(this.entity);
        }
    }

    // Across a goal line between the posts is a goal for the side attacking
    // that end. A near miss clips a real post and rebounds instead of being
    // swallowed by the out-of-bounds reset.
    fn scored() {
        let x = this.transform.position.x;
        let y = this.transform.position.y;
        if abs(y) < this.mouth && x > this.goal_line {
            GoalScored.emit(1.0);
            reset();
        } else if abs(y) < this.mouth && x < -this.goal_line {
            GoalScored.emit(2.0);
            reset();
        } else if abs(x) >= this.goal_line && abs(y) < this.mouth + this.post_radius {
            hit_post();
        } else if abs(x) > this.goal_line + 0.6 || y > 6.4 || y < -6.6 {
            reset();
        }
    }

    fn hit_post() {
        let speed = this.velocity.length;
        this.aftertouch_slot = 0.0;
        if this.transform.position.x > 0.0 {
            this.transform.position.x = this.goal_line - 0.02;
            this.velocity.x = -abs(this.velocity.x) * 0.72;
        } else {
            this.transform.position.x = 0.02 - this.goal_line;
            this.velocity.x = abs(this.velocity.x) * 0.72;
        }
        // Glancing shots keep some vertical motion, so posts create useful
        // rebounds instead of reflecting every miss straight backwards.
        this.velocity.y *= 0.82;
        Effects.burst(this.entity);
        Audio.play("audio/hit.wav", min(1.0, 0.45 + speed / 45.0));
        Camera.add_trauma(min(0.5, 0.12 + speed / 70.0));
    }

    fn reset() {
        this.transform.position.x = 0.0;
        this.transform.position.y = 0.0;
        this.velocity = Vec2(0.0, 0.0);
        this.holder = null;
        this.heat = 0.0;
        this.heat_clock = 0.0;
        this.aftertouch_slot = 0.0;
        Game.set("holder", 0.0);
        mark();
    }

    // The ring under the ball says whose it is.
    fn mark() {
        let slot = Game.get("holder", 0.0);
        var clip: String = "none";
        if slot == 1.0 { clip = "p1"; }
        if slot == 2.0 { clip = "p2"; }
        if slot == 3.0 { clip = "p3"; }
        if slot == 4.0 { clip = "p4"; }
        if slot == 11.0 { clip = "p1"; }
        if slot == 12.0 { clip = "p2"; }
        let zone = this.zone;
        if zone == null {
            return;
        }
        if Animation.clip(zone) != clip {
            Animation.play(zone, clip);
        }
    }

    fn team(player: Entity) -> f32 {
        if World.property_number(player, "slot", 1.0) % 2.0 == 1.0 {
            return 1.0;
        }
        return 2.0;
    }
}