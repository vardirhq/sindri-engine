// The match: players join from their pads, ready up, and after a countdown
// it kicks off. It keeps the score, throws power-ups onto the pitch, and
// holds the wind.
//
// The phase is on the board for everyone, as `Game.phase`. The title screen
// chooses local or bot play without owning gameplay.
script Match {
    @export let player: Prefab;
    @export let powerup: Prefab;
    @export let title: Prefab;
    @export let countdown_time: f32 = 3.5;
    @export let power_min: f32 = 5.0;
    @export let power_max: f32 = 15.0;
    @export let wind_speed: f32 = 15.0;
    @export let wind_time: f32 = 20.0;
    @export let sprint_fx_time: f32 = 0.12;
    @export let goal_fx_time: f32 = 0.1;

    var phase = Phase.Lobby;
    var countdown: f32 = 0.0;
    var kickoff_banner = Timer(0.0);
    var goal_banner = Timer(0.0);
    var sprint_fx_clock: f32 = 0.0;
    var goal_fx_clock: f32 = 0.0;
    var next_power: f32 = 5.0;
    var wind_left: f32 = 0.0;
    var joins: f32 = 0.0;
    var blue_digit: Entity = null;
    var red_digit: Entity = null;
    var hint: Entity = null;
    var count_text: Entity = null;
    var kickoff_text: Entity = null;
    var goal_text: Entity = null;

    fn start() {
        this.blue_digit = World.find("Blue Score");
        this.red_digit = World.find("Red Score");
        this.hint = World.find("Hint");
        this.count_text = World.find("Countdown");
        this.kickoff_text = World.find("Kickoff");
        this.goal_text = World.find("Goal");
        Game.phase = Phase.Lobby;
        Game.score_blue = 0.0;
        Game.score_red = 0.0;
        Game.wind = 0.0;
        Game.menu_done = false;
        Game.versus_bot = false;
        this.next_power = this.power_min;
        World.spawn(this.title);
    }

    fn update(dt: f32) {
        // Counted before anyone new joins, so every player counted has
        // started and has a `ready` to read.
        var ready: f32 = 0.0;
        for someone in World.with_tag("player") {
            let player = Player.on(someone);
            if player != null && player.ready { ready += 1.0; }
        }
        players();
        match this.phase {
            Phase.Lobby => {
                if ready >= 2.0 {
                    this.phase = Phase.Countdown;
                    this.countdown = this.countdown_time;
                }
            }
            Phase.Countdown => {
                if ready < 2.0 {
                    // Someone unreadied or left: back to waiting.
                    this.phase = Phase.Lobby;
                } else {
                    count_down(dt);
                }
            }
            Phase.Play => {
                powerups(dt);
                wind(dt);
                match_fx(dt);
            }
        }
        Game.phase = this.phase;
        World.set_active(this.hint, this.phase == Phase.Lobby);
        World.set_active(this.count_text, this.phase == Phase.Countdown);
        World.set_active(this.kickoff_text, !this.kickoff_banner.done);
        World.set_active(this.goal_text, !this.goal_banner.done);
        digit(this.blue_digit, Game.score_blue);
        digit(this.red_digit, Game.score_red);
    }

    // A pad that joins gets a player on its side of the pitch; a pad that is
    // unplugged takes its player with it. In versus-bot mode the first human
    // gets one opponent on the other side automatically.
    //
    // Select in the lobby still adds a bot to the side with fewer players, one
    // bot a side, so local play keeps the original quick bot toggle too.
    fn players() {
        let joined = Gamepad.joined();
        if joined > 0.0 {
            place(joined, false);
            if Game.versus_bot {
                if joined % 2.0 == 1.0 {
                    place(12.0, true);
                } else {
                    place(11.0, true);
                }
                Game.versus_bot = false;
            }
        }
        if this.phase == Phase.Lobby && Gamepad.just_pressed(0.0, "select") {
            var blue: f32 = 0.0;
            var red: f32 = 0.0;
            var bot_blue: bool = false;
            var bot_red: bool = false;
            for someone in World.with_tag("player") {
                let slot = World.property_number(someone, "slot", 0.0);
                if slot % 2.0 == 1.0 { blue += 1.0; } else { red += 1.0; }
                if slot == 11.0 { bot_blue = true; }
                if slot == 12.0 { bot_red = true; }
            }
            if !bot_red && (red <= blue || bot_blue) {
                place(12.0, true);
            } else if !bot_blue {
                place(11.0, true);
            }
        }
        let left = Gamepad.left();
        if left > 0.0 {
            for someone in World.with_tag("player") {
                if World.property_number(someone, "slot", 0.0) == left {
                    World.despawn(someone);
                }
            }
        }
    }

    // Blue on the left, Red on the right, a second player on a side lower down.
    fn place(slot: f32, bot: bool) {
        var x: f32 = -7.0;
        if slot % 2.0 == 0.0 { x = 7.0; }
        var y: f32 = 1.0;
        for someone in World.with_tag("player") {
            if World.property_number(someone, "slot", 0.0) % 2.0 == slot % 2.0 {
                y = -3.5;
            }
        }
        let made = World.spawn(this.player);
        World.set_property(made, "slot", slot);
        World.set_property(made, "bot", bot);
        made.transform.position.x = x;
        made.transform.position.y = y;
        this.joins += 1.0;
        Game.joins = this.joins;
    }

    on GoalScored(team) {
        if this.phase != Phase.Play { return; }
        if team == 1.0 {
            Game.score_blue += 1.0;
        } else {
            Game.score_red += 1.0;
        }
        this.goal_banner = Timer(2.0);
        this.goal_fx_clock = 0.0;
        Camera.add_trauma(0.6);
        Audio.play("audio/hit.wav", 1.0);
    }

    // Sprinting and scoring should read even before dedicated character action
    // art exists. Human sprinters throw grass flecks while moving at speed; a
    // goal briefly turns every player into part of the celebration burst.
    fn match_fx(dt: f32) {
        this.sprint_fx_clock -= dt;
        if this.sprint_fx_clock <= 0.0 {
            this.sprint_fx_clock = this.sprint_fx_time;
            for someone in World.with_tag("player") {
                let slot = World.property_number(someone, "slot", 0.0);
                let vx = Physics.velocity_x(someone);
                let vy = Physics.velocity_y(someone);
                let speed = sqrt(vx * vx + vy * vy);
                if slot < 10.0 && Gamepad.is_down(slot, "left_bumper") && speed > 11.0 {
                    Effects.burst(someone);
                }
            }
        }
        if this.goal_banner.done {
            return;
        }
        this.goal_fx_clock -= dt;
        if this.goal_fx_clock <= 0.0 {
            this.goal_fx_clock = this.goal_fx_time;
            for someone in World.with_tag("player") {
                Effects.burst(someone);
            }
        }
    }

    // Every few seconds a signpost drops somewhere on the pitch with one of
    // the four powers in it.
    // Three, two, one: shown as it runs, and kickoff when it runs out.
    fn count_down(dt: f32) {
        this.countdown -= dt;
        Ui.set_number(this.count_text, this.countdown - this.countdown % 1.0 + 1.0);
        if this.countdown <= 0.0 {
            this.phase = Phase.Play;
            this.kickoff_banner = Timer(2.0);
            Audio.play("audio/hit.wav", 1.0);
        }
    }

    fn powerups(dt: f32) {
        this.next_power -= dt;
        if this.next_power > 0.0 {
            return;
        }
        this.next_power = Random.range(this.power_min, this.power_max);
        let made = World.spawn(this.powerup);
        let roll = Random.int(1.0, 4.0);
        var power = Power.Grow;
        if roll == 2.0 { power = Power.Boost; }
        if roll == 3.0 { power = Power.Wind; }
        if roll == 4.0 { power = Power.Fire; }
        PowerUp.on(made).kind = power;
        made.transform.position.x = Random.range(-12.0, 12.0);
        made.transform.position.y = Random.range(-5.0, 4.5);
    }

    // Wind blows towards the goal of whoever did not pick it up.
    on WindPicked(blow) {
        this.wind_left = this.wind_time;
        Game.wind = blow * this.wind_speed;
    }

    fn wind(dt: f32) {
        if this.wind_left > 0.0 {
            this.wind_left -= dt;
            if this.wind_left <= 0.0 {
                Game.wind = 0.0;
            }
        }
    }

    fn digit(shown: Entity, score: f32) {
        let clip = "d" + score % 10.0;
        if Animation.clip(shown) != clip {
            Animation.play(shown, clip);
        }
    }
}
