// Something on the ground worth taking: deadwood, a flint, a drop of resin, a
// sprig of berries. Wick takes it by walking over it, and it goes into his pack
// (`Game.wood`, `Game.stone`, `Game.resin`, `Game.berries`). Taken, it is gone for good: the scatter that
// made it remembers.
script Pickup {
    // What it is ("wood", "stone", "resin" or "berries"), how many it is worth, and how
    // near Wick must come to take it.
    @export let kind: String = "wood";
    @export let worth: number = 1.0;
    @export let reach: number = 0.9;

    var wick: Entity = null;

    fn start() {
        this.wick = World.find("Wick");
    }

    fn update(dt: number) {
        if this.wick == null || !World.exists(this.wick) || Game.lost {
            return;
        }
        let dx = this.wick.transform.world_position.x - this.transform.world_position.x;
        let dy = this.wick.transform.world_position.y - this.transform.world_position.y;
        if sqrt(dx * dx + dy * dy) > this.reach {
            return;
        }
        if this.kind == "wood" {
            Game.wood += this.worth;
        } else if this.kind == "stone" {
            Game.stone += this.worth;
        } else if this.kind == "berries" {
            Game.berries += this.worth;
        } else {
            Game.resin += this.worth;
        }
        Game.gathered += this.worth;
        World.despawn(this.entity);
    }
}
