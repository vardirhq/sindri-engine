// The square's ground: lush grass, with packed-earth roads in from the west, across the square and
// out to the east, a way north to the chapel and one south to a lane, and a path to each door,
// laid corner by corner on the `dirt` terrain of the ground sheet as the Dim Fields' path is. On
// layers above it: cobblestones over the square, flagstones round each lamp and at each doorstep,
// and tilled soil where the gardens are. Painted once, as the scene opens; the layers are only
// walked where they reach, so the script stays inside the VM's budget.
script VillageGround {
    // The world position of the map's top-left corner.
    @export let left: number = -23.0;
    @export let top: number = 19.0;
    // How far the flagstones reach from a lamp.
    @export let pad: number = 1.7;

    // The roads and paths as rectangles: left, right, bottom and top of each. They are in
    // `village_scene.py` too (the houses stand at their ends): a change to one is a change to both.
    var rx0: List<number> = [-24.0, 5.0, -6.0, -1.3, -1.3, -15.0, 9.8, -11.2, 9.8, -11.2];
    var rx1: List<number> = [-5.0, 24.0, 6.0, 1.3, 1.3, 15.0, 11.2, -9.8, 11.2, -9.8];
    var ry0: List<number> = [-1.3, -1.3, -6.0, 0.0, -13.0, -12.8, 0.0, 0.0, -10.2, -10.2];
    var ry1: List<number> = [1.3, 1.3, 6.0, 13.5, 0.0, -10.2, 3.2, 3.2, -8.8, -8.8];

    var lamp_x: List<number> = [-3.5, 3.5, -3.5, 3.5];
    var lamp_y: List<number> = [3.5, 3.5, -3.5, -3.5];
    // The doorsteps: where each door is.
    var door_x: List<number> = [10.5, -10.5, 10.5, -10.5];
    var door_y: List<number> = [3.0, 3.0, -9.0, -9.0];

    fn start() {
        let ground = this.entity;
        let columns = Grid.columns(ground);
        let rows = Grid.rows(ground);
        for row in 0..rows + 1.0 {
            for column in 0..columns + 1.0 {
                if on_road(this.left + column, this.top - row) {
                    Grid.set_terrain_corner(ground, column, row, "dirt", true);
                }
            }
        }
        // Cobblestones over the square, its corners rounded.
        let cobble = World.find("cobble");
        for row in row_of(5.6)..row_of(-5.6) + 1.0 {
            for column in column_of(-5.6)..column_of(5.6) + 1.0 {
                let x = this.left + column;
                let y = this.top - row;
                if abs(x) <= 5.2 && abs(y) <= 5.2 && (abs(x) < 3.6 || abs(y) < 3.6 || sqrt((abs(x) - 3.6) * (abs(x) - 3.6) + (abs(y) - 3.6) * (abs(y) - 3.6)) <= 1.7) {
                    Grid.set_terrain_corner(cobble, column, row, "cobble", true);
                }
            }
        }
        // Flagstones round each lamp, and a step before each door.
        let flag = World.find("flag");
        for i in 0..this.lamp_x.length {
            for row in row_of(this.lamp_y[i] + this.pad)..row_of(this.lamp_y[i] - this.pad) + 1.0 {
                for column in column_of(this.lamp_x[i] - this.pad)..column_of(this.lamp_x[i] + this.pad) + 1.0 {
                    let dx = this.left + column - this.lamp_x[i];
                    let dy = this.top - row - this.lamp_y[i];
                    if sqrt(dx * dx + dy * dy) <= this.pad {
                        Grid.set_terrain_corner(flag, column, row, "flag", true);
                    }
                }
            }
            for row in row_of(this.door_y[i] + 0.2)..row_of(this.door_y[i] - 1.4) + 1.0 {
                for column in column_of(this.door_x[i] - 1.4)..column_of(this.door_x[i] + 1.4) + 1.0 {
                    Grid.set_terrain_corner(flag, column, row, "flag", true);
                }
            }
        }
        // Tilled soil where the garden is, by the child's house.
        let soil = World.find("soil");
        for row in row_of(7.4)..row_of(4.3) + 1.0 {
            for column in column_of(-20.4)..column_of(-14.6) + 1.0 {
                Grid.set_terrain_corner(soil, column, row, "soil", true);
            }
        }
    }

    // The map row and column a world y and x fall on.
    fn row_of(y: number) -> number {
        return max(0.0, floor(this.top - y));
    }

    fn column_of(x: number) -> number {
        return max(0.0, floor(x - this.left));
    }

    // On a road: the west and east roads, the square, the north way to the chapel, the south way
    // down to the lane the south houses face, the lane, or a path from a door to the road.
    fn on_road(x: number, y: number) -> bool {
        for i in 0..this.rx0.length {
            if x >= this.rx0[i] && x <= this.rx1[i] && y >= this.ry0[i] && y <= this.ry1[i] {
                return true;
            }
        }
        return false;
    }
}
