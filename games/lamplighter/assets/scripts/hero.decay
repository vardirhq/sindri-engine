// Wick runs, jumps, gathers embers, lights lanterns and reaches the beacon.
// Its four sounds were made in the Sindri Sound Lab; each `audio/*.sindrisfx`
// beside its WAV reopens there to be reshaped and sent back.
//
// Controller support grants standing only above a walkable surface.
// Body and foot sensors handle pickups; overlapping a plank from below never grants
// a jump. Coyote time and a jump buffer keep jumps forgiving.
// Down/S/d-pad down drops through one-way planks onto the painted floor.
//
// Keyboard and gamepad share the run/jump path. Touch screens use the drawn
// controls so the actions remain visible and reachable.
script Hero {
    @export let speed: number = 6.5;
    @export let acceleration: number = 120.0;
    @export let deceleration: number = 90.0;
    @export let air_acceleration: number = 90.0;
    @export let jump_speed: number = 14.0;
    @export let gravity: number = 30.0;
    @export let terminal_speed: number = 30.0;
    @export let coyote: number = 0.1;
    @export let buffer: number = 0.12;
    @export let fall_limit: number = -3.0;
    @export let spawn_x: number = 2.5;
    @export let spawn_y: number = 4.0;

    // Supporting ground beneath the feet, rather than a sensor overlap.
    var ground: number = 0.0;
    var horizontal: number = 0.0;
    var rise: number = 0.0;
    var drop_left: number = 0.0;
    var on_one_way: bool = false;
    var since_ground: number = 1.0;
    var since_press: number = 1.0;
    var facing: number = 1.0;
    var jump_held: bool = false;
    // 0 idle, 1 run, 2 jump, 3 fall: which clip is showing.
    var shown: number = 0.0;
    var touch_jump_button: Entity = null;

    fn start() {
        Game.coins = 0.0;
        Game.coins_total = World.with_tag("coin").length;
        Game.won = false;
        Game.falls = 0.0;
        Game.checkpoint_x = this.spawn_x;
        Game.checkpoint_y = this.spawn_y;
        Game.checkpoint_index = 0.0;
        Game.touch = false;
        this.touch_jump_button = World.find("touch-jump");
    }

    fn update(dt: number) {
        this.drop_left = max(0.0, this.drop_left - dt);
        if Touch.count > 0.0 { Game.touch = true; }
        touch();
        probe_ground();
        if Game.won {
            this.horizontal = 0.0;
            move(dt);
            show(0.0);
            return;
        }
        if this.transform.position.y < this.fall_limit {
            respawn();
            return;
        }

        // Keyboard and gamepad input comes from the scene's actions. Once
        // touch is detected, the left stick and right jump button take over.
        var run: number = Action.axis("run");
        var touch_jump: bool = false;
        if Game.touch {
            run = 0.0;
            if Stick.held && Stick.anchor_x < 0.0 { run = Stick.x; }
            touch_jump = Ui.is_held(this.touch_jump_button);
        } else if Stick.held && abs(Stick.x) > abs(run) {
            run = Stick.x;
        }
        run = max(-1.0, min(1.0, run));
        let holding_jump = Action.held("jump") || touch_jump;
        let pressed_jump = Action.pressed("jump") || (touch_jump && !this.jump_held);
        if pressed_jump {
            this.since_press = 0.0;
        } else {
            this.since_press += dt;
        }
        if this.ground > 0.0 {
            this.since_ground = 0.0;
        } else {
            this.since_ground += dt;
        }

        var rise: number = this.rise;
        if Action.pressed("drop") && this.on_one_way && this.ground > 0.0 {
            Physics.drop_through(this.entity, 0.35);
            this.drop_left = 0.35;
            this.ground = 0.0;
            this.since_ground = 1.0;
            this.since_press = 1.0;
            rise = -2.0;
        }
        if this.drop_left <= 0.0 && this.since_press <= this.buffer && this.since_ground <= this.coyote {
            rise = this.jump_speed;
            Audio.play("audio/jump.wav", 0.35);
            this.since_press = 1.0;
            this.since_ground = 1.0;
        }
        // Letting go early cuts the rise short, so a tap is a hop on every
        // input device, including lifting the second touch finger.
        if this.jump_held && !holding_jump && rise > 0.0 {
            rise = rise * 0.45;
        }
        this.jump_held = holding_jump;

        // Build and shed horizontal speed instead of snapping straight to the
        // target. The short ramp preserves the showcase's established jump
        // timing while still making starts, stops and reversals feel physical.
        var horizontal: number = this.horizontal;
        let target = run * this.speed;
        var rate: number = this.air_acceleration;
        if this.ground > 0.0 {
            if run == 0.0 {
                rate = this.deceleration;
            } else {
                rate = this.acceleration;
            }
        }
        let step = rate * dt;
        if horizontal < target {
            horizontal = min(target, horizontal + step);
        } else if horizontal > target {
            horizontal = max(target, horizontal - step);
        }
        this.horizontal = horizontal;
        this.rise = rise;
        move(dt);

        if run != 0.0 {
            this.facing = run;
            if run > 0.0 {
                this.transform.scale.x = 1.0;
            } else {
                this.transform.scale.x = -1.0;
            }
        }
        if this.ground > 0.0 {
            if run != 0.0 {
                show(1.0);
            } else {
                show(0.0);
            }
        } else if rise > 0.0 {
            show(2.0);
        } else {
            show(3.0);
        }
    }

    // Velocity, gravity and snap permission are gameplay decisions. The scene
    // applies this displacement once at the next fixed step, after platform carry.
    fn move(dt: number) {
        this.rise = max(-this.terminal_speed, this.rise - this.gravity * dt);
        Physics.move_character(this.entity, Vec2(this.horizontal * dt, this.rise * dt), this.ground > 0.0 && this.drop_left <= 0.0);
    }

    // The ray measures clearance; controller support grants jump permission.
    // Discrete sensor contacts stay for pickups, never for solid grounding.
    fn probe_ground() {
        let p = this.transform.world_position;
        let hit = Physics.raycast(Vec2(p.x, p.y), Vec2(0.0, -1.0), 12.0, Physics.layer("ground"), false, this.entity);
        Game.ground_found = hit != null;
        let was_grounded = this.ground > 0.0;
        this.ground = 0.0;
        this.on_one_way = false;
        if hit != null {
            Game.ground_clearance = max(0.0, hit.distance - 0.5);
        }
        let motion = Physics.character_motion(this.entity);
        if motion == null { return; }
        if motion.grounded && this.drop_left <= 0.0 {
            // A landing kicks up a puff of the dust a run trails.
            if !was_grounded && this.rise < -4.0 {
                Effects.emit(this.entity, 8.0);
                Audio.play("audio/land.wav", 0.4);
            }
            this.ground = 1.0;
            this.rise = 0.0;
            let support = motion.ground;
            if support != null {
                this.on_one_way = World.has_tag(support.entity, "one-way");
            }
        }
        // Keep intended horizontal speed at obstacles: the controller clips
        // displacement and can use the next request to clear a low step.
        for contact in motion.collisions {
            if contact.normal.y < -0.5 && this.rise > 0.0 { this.rise = 0.0; }
        }
    }

    // What the capsule and the foot sensor touched this step. A coin taken
    // earlier in the step, or on an earlier one, can still be reported by the
    // other sensor or as it leaves, so nothing is asked of one that is gone.
    fn touch() {
        for other in Physics.sensor_entered() {
            if !World.exists(other) {
                // Already taken.
            } else if World.has_tag(other, "coin") {
                World.despawn(other);
                Game.coins += 1.0;
                Audio.play("audio/coin.wav", 0.45);
            } else if World.has_tag(other, "lantern") {
                CheckpointLantern.on(other).light();
            } else if World.has_tag(other, "goal") {
                // A goal can be touched again; it only cheers the first time.
                if !Game.won {
                    Audio.play("audio/goal.wav", 0.55);
                }
                Game.won = true;
            }
        }
    }

    fn respawn() {
        this.transform.position.x = Game.checkpoint_x;
        this.transform.position.y = Game.checkpoint_y;
        this.horizontal = 0.0;
        this.rise = 0.0;
        this.drop_left = 0.0;
        this.on_one_way = false;
        this.since_ground = 1.0;
        this.since_press = 1.0;
        Physics.drop_through(this.entity, 0.0);
        Physics.move_character(this.entity, Vec2(0.0, 0.0), false);
        this.ground = 0.0;
        Game.falls += 1.0;
    }

    fn show(state: number) {
        if state == this.shown {
            return;
        }
        this.shown = state;
        // Dust trails a run and nothing else.
        if state == 1.0 {
            Effects.play(this.entity);
        } else {
            Effects.stop(this.entity);
        }
        if state == 0.0 {
            Animation.play(this.entity, "idle");
        } else if state == 1.0 {
            Animation.play(this.entity, "run");
        } else if state == 2.0 {
            Animation.play(this.entity, "jump");
        } else {
            Animation.play(this.entity, "fall");
        }
    }
}
