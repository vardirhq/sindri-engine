// The ground is grass until this paints a dirt path on it: from where Wick
// starts, past each lantern, to the last. The path is laid corner by corner
// on the sheet's `dirt` terrain, so a tile on its edge draws the corner
// pattern the neighbouring corners call for. Each lamp then gets a pad of
// paving on the `road` layer above, the beacon a wider one. Painted once, as
// the world opens.
script Ground {
    // The world position of the map's top-left corner.
    @export let left: number = -26.0;
    @export let top: number = 18.0;
    // How far from the walk between lanterns the path reaches, and around a lantern.
    @export let width: number = 1.6;
    @export let plaza: number = 2.6;

    // How far the paving reaches from a lamp, and from the last, the beacon.
    @export let pad: number = 1.5;
    @export let beacon_pad: number = 2.3;

    var path_x: List<number> = [0.0, 8.0, 17.0, 22.0];
    var path_y: List<number> = [0.0, 0.0, -3.0, 8.0];

    fn start() {
        let map = this.entity;
        let columns = Grid.columns(map);
        let rows = Grid.rows(map);
        for row in 0..rows + 1.0 {
            for column in 0..columns + 1.0 {
                if near_path(this.left + column, this.top - row) {
                    Grid.set_terrain_corner(map, column, row, "dirt", true);
                }
            }
        }
        pave(World.find("road"), columns, rows);
    }

    // A pad of paving round each lamp; the first point on the path is where
    // Wick starts, which has no lamp. Only the corners within a lamp's reach are
    // visited, not the whole map, which is also what keeps the script inside the
    // VM's budget for one call.
    fn pave(road: Entity, columns: number, rows: number) {
        for i in 1..this.path_x.length {
            var reach: number = this.pad;
            if i + 1.0 == this.path_x.length {
                reach = this.beacon_pad;
            }
            let lx = this.path_x[i];
            let ly = this.path_y[i];
            let first_column = max(0.0, floor(lx - this.left - reach));
            let last_column = min(columns, ceil(lx - this.left + reach));
            let first_row = max(0.0, floor(this.top - ly - reach));
            let last_row = min(rows, ceil(this.top - ly + reach));
            for row in first_row..last_row + 1.0 {
                for column in first_column..last_column + 1.0 {
                    let dx = this.left + column - lx;
                    let dy = this.top - row - ly;
                    if sqrt(dx * dx + dy * dy) <= reach {
                        Grid.set_terrain_corner(road, column, row, "stone", true);
                    }
                }
            }
        }
    }

        // Whether a world point is on the path or in a lantern's plaza.
    fn near_path(x: number, y: number) -> bool {
        for i in 0..this.path_x.length {
            let ax = this.path_x[i];
            let ay = this.path_y[i];
            if sqrt((x - ax) * (x - ax) + (y - ay) * (y - ay)) <= this.plaza {
                return true;
            }
            if i + 1.0 < this.path_x.length {
                let dx = this.path_x[i + 1.0] - ax;
                let dy = this.path_y[i + 1.0] - ay;
                let along = max(0.0, min(1.0, ((x - ax) * dx + (y - ay) * dy) / (dx * dx + dy * dy)));
                let px = ax + along * dx;
                let py = ay + along * dy;
                if sqrt((x - px) * (x - px) + (y - py) * (y - py)) <= this.width {
                    return true;
                }
            }
        }
        return false;
    }
}
