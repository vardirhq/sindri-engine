// A gloom: a patch of the dark that has learned to stand up, and wants Wick's
// light. It lurks where it was left, creeps through the dark toward him, holds
// where a light begins (it will not walk into one), and from the edge of the
// light winds up and pounces. A pounce that lands scorches his lantern; one that
// misses leaves it wilted and open to the sword.
//
// Light is its undoing. It moves slowly, and a gloom caught in a strong light (the
// beam of Wick's lantern swung onto it) stops where it is, drops whatever it was
// about to do, and burns: its health drains for as long as the light is on it, and
// it goes out if the light stays. The sword does the same, faster.
//
// It uses cover: where a tree or a boulder stands between it and Wick it cannot be
// seen, and then it is bold, creeping on even into the light and fading into the
// shadow, and held back only once it steps out where Wick can see it.
//
// A brute is the other kind: it has lived in light and does not fear it. It is bigger,
// takes more blows, walks through a lantern's glow at the same pace as the dark, and
// light does not burn it or thin it; only the sword puts it out. `fears_light` and
// `size` are what set the two apart.
//
// A lit lamp post is a safe pool, `pool` units wide round it: a gloom will not hunt Wick
// while he stands in one, and one that is in one is driven out of it, brute or not,
// and cannot wind up there.
//
// Its states: lurk, stalk, wind, lunge, recover.
script Gloom {
    // How many blows put it out.
    @export let health: number = 3.0;
    // How hard a blow throws it back, and how long it stays squashed by one.
    @export let knockback: number = 9.0;
    @export let flinch_for: number = 0.12;
    // How little light it is bold in, how much light thins it, how fast it
    // creeps through the dark, and how far off it notices Wick.
    @export let dark: number = 0.2;
    @export let bright: number = 0.6;
    @export let creep: number = 0.8;
    @export let notice: number = 11.0;
    // How close to Wick it must be to wind up, how long the wind-up and the
    // pounce take, how fast the pounce is, and how long it is spent after.
    @export let pounce_range: number = 7.0;
    @export let wind_for: number = 0.9;
    @export let lunge_for: number = 0.5;
    @export let lunge_speed: number = 6.5;
    @export let recover_for: number = 1.1;
    // How much health a second in a strong light burns off it, and whether light
    // bothers it at all (1 does, 0 does not).
    @export let burn: number = 1.2;
    @export let fears_light: number = 1.0;
    // How big it is drawn, in units.
    @export let size: number = 2.0;
    // How far a lit lamp's safe pool reaches, and how fast it drives a gloom out of it.
    @export let pool: number = 5.0;
    @export let driven: number = 2.6;
    // How long it waits before it will wind up again.
    @export let rest_for: number = 1.0;
    // The emitter that burns while it winds up and pounces.
    @export let surge_name: String = "";

    var flinch: number = 0.0;
    var left: number = 0.0;
    var age: number = 0.0;
    var shown: number = 1.0;
    var wick: Entity = null;
    var surge: Entity = null;
    var hit_burst: Entity = null;
    var out_burst: Entity = null;
    var struck_for: number = 0.0;
    var state: String = "lurk";
    var in_state: number = 0.0;
    var rest: number = 0.0;
    var aim_x: number = 0.0;
    var aim_y: number = 0.0;
    var struck: bool = false;
    var burning: bool = false;

    fn start() {
        this.left = this.health;
        this.wick = World.find("Wick");
        this.surge = World.find(this.surge_name);
        this.hit_burst = World.find("fx-gloom-hit");
        this.out_burst = World.find("fx-gloom-out");
        // Each one a little out of step with the rest.
        this.age = this.transform.world_position.x * 0.7;
    }

    fn enter(next: String) {
        this.state = next;
        this.in_state = 0.0;
        // The surge burns for the wind-up and the pounce, and goes out after.
        if this.surge != null {
            if next == "wind" || next == "lunge" {
                Effects.play(this.surge);
            } else {
                Effects.stop(this.surge);
            }
        }
    }

    fn update(dt: number) {
        // Drawn in front of what stands further up the screen, behind what is below.
        this.transform.position.z = 0.5 - this.transform.world_position.y * 0.01;
        this.age += dt;
        this.in_state += dt;
        this.rest = max(0.0, this.rest - dt);
        this.flinch = max(0.0, this.flinch - dt);
        this.struck_for = max(0.0, this.struck_for - dt);

        let here = Vec2(this.transform.world_position.x, this.transform.world_position.y);
        var to_x: number = 0.0;
        var to_y: number = 0.0;
        var apart: number = 99.0;
        if this.wick != null && World.exists(this.wick) {
            to_x = this.wick.transform.world_position.x - here.x;
            to_y = this.wick.transform.world_position.y - here.y;
            apart = sqrt(to_x * to_x + to_y * to_y);
        }
        let level = Lighting.level(here);
        // Wick's eyes are a little above his feet, and the gloom's middle above its own.
        var covered: bool = false;
        if apart < this.notice {
            let eyes = Vec2(this.wick.transform.world_position.x, this.wick.transform.world_position.y + 0.5);
            covered = !Lighting.visible(eyes, Vec2(here.x, here.y + 0.4));
        }
        // Wick in the pool of a lit lamp, or this gloom in one, and which way is out of it.
        var sheltered: bool = false;
        var inside: bool = false;
        var out_x: number = 0.0;
        var out_y: number = 0.0;
        for lamp in World.with_tag("lantern") {
            let post = Lantern.on(lamp);
            if post != null && this.age > 0.1 && post.lit {
                let lamp_x = lamp.transform.world_position.x;
                let lamp_y = lamp.transform.world_position.y;
                let from_x = here.x - lamp_x;
                let from_y = here.y - lamp_y;
                let gap = sqrt(from_x * from_x + from_y * from_y);
                if gap < this.pool {
                    inside = true;
                    out_x = from_x / max(gap, 0.01);
                    out_y = from_y / max(gap, 0.01);
                }
                if this.wick != null && World.exists(this.wick) {
                    let wx = this.wick.transform.world_position.x - lamp_x;
                    let wy = this.wick.transform.world_position.y - lamp_y;
                    if sqrt(wx * wx + wy * wy) < this.pool {
                        sheltered = true;
                    }
                }
            }
        }
        let hunting = apart < this.notice && !Game.lost && !Game.won && Game.truce < 0.5 && Game.moved && !sheltered;

        var squash_x: number = 1.0 + 0.04 * sin(this.age * 2.6);
        var squash_y: number = 1.0 / squash_x;

        // Caught in a strong light, and not under a truce: it stops and burns. A pounce
        // already under way is not stopped by it.
        let afraid = this.fears_light > 0.5;
        let caught = afraid && level > this.bright && Game.truce < 0.5 && this.state != "lunge";
        if caught {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            if this.state == "wind" || this.state == "lunge" {
                enter("recover");
            }
            this.left -= this.burn * dt;
            squash_x = 1.0 + 0.1 * sin(this.age * 40.0);
            squash_y = 1.0 - 0.1 * sin(this.age * 40.0);
            if this.left <= 0.0 {
                put_out();
                return;
            }
        }
        if caught != this.burning {
            this.burning = caught;
            if this.surge != null {
                if caught { Effects.play(this.surge); } else { Effects.stop(this.surge); }
            }
        }

        if caught {
            // Held where it is.
        } else if inside && Game.truce < 0.5 && this.state != "lunge" {
            // Driven out of a lit lamp's pool, and no wind-up while it is in one.
            Physics.set_velocity(this.entity, out_x * this.driven, out_y * this.driven);
            if this.state == "wind" {
                enter("recover");
            }
        } else if this.state == "lurk" {
            // It drifts a little where it is, until Wick is near enough to notice.
            if this.flinch <= 0.0 && Game.truce < 0.5 {
                Physics.set_velocity(this.entity, 0.25 * cos(this.age * 0.8), 0.18 * sin(this.age * 0.6));
            }
            if hunting {
                enter("stalk");
            }
        } else if this.state == "stalk" {
            // It creeps through the dark and holds where a light begins; from the
            // edge, in range and rested, it winds up.
            if !hunting {
                enter("lurk");
            } else if this.flinch <= 0.0 {
                if (!afraid || level < this.dark || covered) && apart > 1.2 {
                    Physics.set_velocity(this.entity, to_x / apart * this.creep, to_y / apart * this.creep);
                }
                // A crawl: it rocks as it goes.
                squash_x = 1.0 + 0.1 * sin(this.age * 8.0);
                squash_y = 1.0 - 0.1 * sin(this.age * 8.0);
                // From cover it waits to pounce until it is close, an ambush.
                var range: number = this.pounce_range;
                if covered {
                    range = 3.5;
                }
                if apart < range && this.rest <= 0.0 {
                    enter("wind");
                }
            }
        } else if this.state == "wind" {
            // It crouches and shakes, which is the warning: it is low and wide.
            Physics.set_velocity(this.entity, 0.0, 0.0);
            let t = min(1.0, this.in_state / this.wind_for);
            squash_x = 1.0 + 0.3 * t + 0.04 * sin(this.age * 55.0);
            squash_y = 1.0 - 0.4 * t;
            if apart > 0.5 {
                this.aim_x = to_x / apart;
                this.aim_y = to_y / apart;
            }
            if this.in_state >= this.wind_for {
                this.struck = false;
                enter("lunge");
            }
        } else if this.state == "lunge" {
            // The pounce goes where Wick was when it left: he can step out of it.
            Physics.set_velocity(this.entity, this.aim_x * this.lunge_speed, this.aim_y * this.lunge_speed);
            squash_x = 1.35;
            squash_y = 0.75;
            if !this.struck && apart < 1.0 {
                this.struck = true;
                Wick.on(this.wick).scorch(this.aim_x, this.aim_y);
            }
            if this.in_state >= this.lunge_for {
                if this.struck {
                    // It has what it came for, and falls back.
                    Physics.set_velocity(this.entity, -this.aim_x * 3.0, -this.aim_y * 3.0);
                }
                enter("recover");
            }
        } else if this.state == "recover" {
            // Spent: it sags and is slow, which is when a blade finds it.
            squash_x = 1.0 + 0.2 * (1.0 - min(1.0, this.in_state / this.recover_for));
            squash_y = 1.0 - 0.3 * (1.0 - min(1.0, this.in_state / this.recover_for));
            if this.in_state >= this.recover_for {
                this.rest = this.rest_for;
                enter("stalk");
            }
        }

        if this.flinch > 0.0 {
            squash_x += 0.35 * (this.flinch / this.flinch_for);
            squash_y -= 0.2 * (this.flinch / this.flinch_for);
        }
        this.transform.scale.x = this.size * squash_x;
        this.transform.scale.y = this.size * squash_y;

        // Thinned where a light is strong, and flushed when it is about to pounce.
        var want: number = 1.0;
        if afraid && level > this.bright {
            want = 0.55;
        }
        if covered {
            // Behind cover it is only a darker patch of the dark.
            want = 0.45;
        }
        if this.state == "lunge" {
            want = 1.0;
        }
        this.shown += (want - this.shown) * min(1.0, dt * 4.0);
        // A blow lights it up white for a moment.
        let flare = this.struck_for / 0.12;
        this.sprite.tint = Color(1.0 + flare, 1.0 + flare, 1.0 + flare, this.shown);
    }

    // It is gone: a blow or the light has used up its health.
    fn put_out() {
        Game.gloom_out += 1.0;
        Effects.burst_at(this.out_burst, this.transform.world_position.x, this.transform.world_position.y + 0.5);
        Camera.add_trauma(0.3);
        World.despawn(this.entity);
    }

    // A blow in a direction (the way Wick faced as it landed): thrown along it,
    // not away from some point, so a gloom that is a little off to one side still
    // goes straight back, and put out at the end of its health. A blow breaks a
    // wind-up or a pounce.
    fn hurt(push_x: number, push_y: number) {
        this.left -= 1.0;
        Game.gloom_hits += 1.0;
        this.struck_for = 0.12;
        Effects.burst_at(this.hit_burst, this.transform.world_position.x, this.transform.world_position.y + 0.5);
        if this.left <= 0.0 {
            put_out();
            return;
        }
        this.flinch = this.flinch_for;
        enter("recover");
        Physics.set_velocity(this.entity, push_x * this.knockback, push_y * this.knockback);
    }
}
