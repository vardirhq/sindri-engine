// What a run shares: the lanterns lit and whether the way is open.
state Game {
    var lit: number = 0.0;
    var total: number = 0.0;
    var won: bool = false;
    var gloom_hits: number = 0.0;
    var gloom_out: number = 0.0;
    // How scorched Wick's lantern is, 0 to 1: a gloom's pounce adds to it, time takes it off.
    var scorch: number = 0.0;
    var scorched: number = 0.0;
    var lost: bool = false;
    // Above zero, the gloom lurk and never hunt: for testing the sword on one that holds still.
    var truce: number = 0.0;
    // Set once Wick first walks: until then the gloom only lurk, so the field opens calm.
    var moved: bool = false;
    // How hard Wick has just been hit, 1 at the blow and fading: the red over the screen.
    var hit: number = 0.0;
    // Set by a door as Wick goes through it: the scene he comes back to starts its scripts again,
    // and this tells him that what the run has counted is to stay.
    var through: bool = false;
}
