// What the run shares, declared once: the hero keeps it, the HUD shows it.
state Game {
    var coins: number = 0.0;
    var coins_total: number = 0.0;
    var falls: number = 0.0;
    var won: bool = false;
    var ground_found: bool = false;
    var ground_clearance: number = 0.0;
    var crate_impacts: number = 0.0;
    var touch: bool = false;
}
