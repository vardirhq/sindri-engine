// What a run shares: the lanterns lit and whether the way is open.
state Game {
    var lit: number = 0.0;
    var total: number = 0.0;
    var won: bool = false;
    var gloom_hits: number = 0.0;
    var gloom_out: number = 0.0;
    // How scorched Wick's lantern is, 0 to 1: a gloom's pounce adds to it, time takes it off.
    var scorch: number = 0.0;
    var scorched: number = 0.0;
    var lost: bool = false;
    // Above zero, the gloom lurk and never hunt: for testing the sword on one that holds still.
    var truce: number = 0.0;
    // Set once Wick first walks: until then the gloom only lurk, so the field opens calm.
    var moved: bool = false;
    // How hard Wick has just been hit, 1 at the blow and fading: the red over the screen.
    var hit: number = 0.0;
    // Set by a door as Wick goes through it: the scene he comes back to starts its scripts again,
    // and this tells him that what the run has counted is to stay.
    var through: bool = false;
    // How found Wick is by a Seeker, 1 while one has him and fading after: the gloom hear
    // it from further off.
    var found: number = 0.0;
    // What Wick has gathered, in his pack, and how much he has gathered and built in all.
    var wood: number = 0.0;
    var stone: number = 0.0;
    var resin: number = 0.0;
    var gathered: number = 0.0;
    var built: number = 0.0;
    // How much oil is in Wick's lantern, 0 to 1. Where the lantern burns
    // (`burn` on Wick), it runs down; resin from the pack feeds it, and a lit
    // lamp or a fire tops it up. Low, the flame gutters; empty, it is an ember.
    var oil: number = 1.0;
    // How many times he has fed it.
    var fed: number = 0.0;
    // Wick's courage, 0 to 1, and how afraid that leaves him, 0 to 1
    // (`courage.decay`). Where nothing runs it, he is never afraid.
    var courage: number = 1.0;
    var fear: number = 0.0;
    // How fed Wick is, 0 to 1, and the berries in his pack. Where he hungers
    // (`hunger` on Wick) it runs down, and he eats a berry when it is below
    // half; empty, he is starving.
    var food: number = 1.0;
    // Whether Wick has stood by a fire long enough for the screen to let go
    // of him (`pack.decay`).
    var resting: bool = false;
    var berries: number = 0.0;
    var eaten: number = 0.0;
    // How many brutes Seekers have called down on him.
    var brutes: number = 0.0;
    // How many hamlet folk have come out to thank Wick for their lamp.
    var helped: number = 0.0;
    // Where the pause screen goes back to.
    var paused_in: Place = Place.Fields;
}

// The places a run is played in, which the pause screen returns to.
enum Place {
    Fields,
    Wilds,
}
