// A sunfall: cracklight falling through the Lid. The Lid's plates shift, so it
// never stays: it wanders slowly round where it first fell, and now and then the
// crack closes and the shaft fades to nothing, to open again a while later.
// While it is open, Wick standing in its pool cannot be found by a Seeker
// (`seeker.decay` reads how bright its pool is).
script Sunfall {
    // How far it wanders from where it fell, and how long one wander round takes.
    @export let wander: number = 4.0;
    @export let wander_for: number = 150.0;
    // How long the crack stays open and shut, and how long it takes to open or close.
    @export let open_for: number = 50.0;
    @export let shut_for: number = 18.0;
    @export let fade_for: number = 4.0;
    // How bright its pool is at its fullest.
    @export let glow: number = 2.0;

    var home_x: number = 0.0;
    var home_y: number = 0.0;
    var age: number = 0.0;
    // How open the crack is, 0 shut to 1 open.
    var open: number = 1.0;
    var dusting: bool = true;

    fn start() {
        this.home_x = this.transform.position.x;
        this.home_y = this.transform.position.y;
        // Each sunfall in its own time, from where it fell.
        this.age = abs(this.home_x * 3.7 + this.home_y * 5.3);
    }

    fn update(dt: number) {
        this.age += dt;
        let turn = this.age / this.wander_for * 6.2832;
        this.transform.position.x = this.home_x + this.wander * sin(turn);
        this.transform.position.y = this.home_y + this.wander * 0.6 * sin(turn * 1.7 + 1.3);

        // Where it is in its cycle: opening, open, closing, then shut.
        let cycle = this.open_for + this.shut_for;
        let at = this.age - floor(this.age / cycle) * cycle;
        var want: number = 0.0;
        if at < this.open_for {
            want = min(1.0, min(at, this.open_for - at) / this.fade_for);
        }
        this.open = want * want * (3.0 - 2.0 * want);
        this.sprite.shader_params.x = this.open;
        this.light2d.intensity = this.glow * this.open;
        let dust = this.open > 0.3;
        if dust != this.dusting {
            this.dusting = dust;
            if dust { this.particles.play(); } else { this.particles.stop(); }
        }
    }

}
