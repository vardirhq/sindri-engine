// The lantern's flame wavers a little, so the light is a flame and not a lamp.
// A gloom's pounce scorches it: it shrinks and gutters, and comes back as the
// scorch wears off (`wick.decay` wears it off). The lantern is two of these, a
// beam and a halo.
script Flame {
    // How bright and how far this flame burns unscorched.
    @export let base_intensity: number = 1.3;
    @export let base_radius: number = 8.0;

    var age: number = 0.0;

    fn update(dt: number) {
        this.age += dt;
        let low = Game.scorch;
        var wobble: number = 0.08 * sin(this.age * 9.0) + 0.05 * sin(this.age * 23.0);
        // A scorched flame stutters.
        wobble += low * 0.25 * sin(this.age * 31.0);
        this.light2d.intensity = (this.base_intensity + wobble) * (1.0 - 0.55 * low);
        this.light2d.radius = this.base_radius * (1.0 - 0.4 * low);
        if Game.lost {
            this.light2d.intensity = 0.12;
            this.light2d.radius = 2.5;
        }
    }
}
