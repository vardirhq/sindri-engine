// The lantern's flame wavers a little, so the light is a flame and not a lamp.
// A gloom's pounce scorches it: it shrinks and gutters, and comes back as the
// scorch wears off (`wick.decay` wears it off). Low on oil (`Game.oil`) it
// gutters the same way, and dry it is an ember that lights only Wick's feet.
// The lantern runs two of these: its own for the beam, and one attached as
// `#halo`, whose `this.light2d` is the lantern's `#halo` light.
script Flame {
    // How bright and how far this flame burns unscorched.
    @export let base_intensity: number = 1.3;
    @export let base_radius: number = 8.0;

    var age: number = 0.0;

    fn update(dt: number) {
        this.age += dt;
        // The last fifth of the oil is where it starts to gutter.
        let dry = clamp(1.0 - Game.oil / 0.2, 0.0, 1.0);
        let low = max(Game.scorch, 0.85 * dry);
        var wobble: number = 0.08 * sin(this.age * 9.0) + 0.05 * sin(this.age * 23.0);
        // A scorched flame stutters.
        wobble += low * 0.25 * sin(this.age * 31.0);
        this.light2d.intensity = (this.base_intensity + wobble) * (1.0 - 0.55 * low);
        this.light2d.radius = this.base_radius * (1.0 - 0.4 * low);
        if Game.lost {
            this.light2d.intensity = 0.12;
            this.light2d.radius = 2.5;
        } else if Game.oil <= 0.0 {
            // Dry: an ember, enough to see his feet by and no more.
            this.light2d.intensity = 0.3 + 0.1 * sin(this.age * 5.0);
            this.light2d.radius = 3.0;
        }
    }
}
