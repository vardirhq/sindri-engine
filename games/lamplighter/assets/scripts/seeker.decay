// A Seeker: one of the things that come down from the Lid looking for warmth. It
// hangs high over the land and sweeps the ground with a circle of cold red light,
// round and round where it was set. Caught in that circle, Wick is found: the
// circle locks onto him and follows, brighter and pulsing, and while he is found
// the gloom hear it from much further off (`Game.found`, read by `gloom.decay`).
// Worse, it calls them: while it holds him a gloom rises out of the ground near
// him every few seconds, and when it loses him a wave of them rises where he was
// last seen, to hunt him from there. Never more than `most` gloom are about.
// Held for `brute_after` seconds at a stretch, it calls down a brute, which does
// not fear light, once each time it finds him (`Game.brutes`).
// It is slower than Wick, so he can outrun it; a lit lamp's pool, a fire he has
// built or an open sunfall hides him from it at once. Lost, it hangs where it lost him a moment,
// then goes back to sweeping.
//
// The entity is where the circle falls; its sprites draw the Seeker high above
// it and the beam down to it. Its states: sweep, found, lost.
script Seeker {
    // How wide it sweeps round where it was set, and how fast the circle moves.
    @export let sweep: number = 9.0;
    @export let sweep_speed: number = 2.6;
    // How near the circle's middle Wick must be to be found, how far he must get
    // to be lost, and how fast it follows him.
    @export let catch: number = 2.2;
    @export let lose: number = 4.5;
    @export let chase: number = 3.6;
    // How long it hangs after losing him, and how far a lit lamp's pool reaches.
    @export let linger_for: number = 2.5;
    @export let pool: number = 5.0;
    // How far an open sunfall's pool hides him, and how bright its light must be
    // to count as open.
    @export let sunfall_pool: number = 3.0;
    @export let open_glow: number = 1.0;
    // How bright its circle is sweeping, and found.
    @export let calm: number = 2.8;
    @export let fierce: number = 5.0;
    // The gloom it calls, how often one rises while it holds him, how many rise
    // where it loses him, how far from him they rise, and how many may be about.
    @export let gloom: Prefab;
    @export let call_every: number = 3.0;
    @export let wave: number = 2.0;
    @export let rise_at: number = 4.5;
    @export let most: number = 6.0;
    // And held that long without a break, it calls down a brute, which does
    // not fear light: once each time it finds him.
    @export let brute: Prefab;
    @export let brute_after: number = 8.0;

    var home_x: number = 0.0;
    var home_y: number = 0.0;
    var turn: number = 0.0;
    var age: number = 0.0;
    var state: String = "sweep";
    var in_state: number = 0.0;
    var wick: Entity = null;
    var calling: number = 0.0;
    // Where it last saw him.
    var mark_x: number = 0.0;
    var mark_y: number = 0.0;
    var rising: Entity = null;
    // How long it has held him this time, and whether this finding's brute has come.
    var held_for: number = 0.0;
    var brute_called: bool = false;

    fn start() {
        this.home_x = this.transform.position.x;
        this.home_y = this.transform.position.y;
        this.wick = World.find("Wick");
        this.rising = World.find("fx-gloom-out");
    }

    fn update(dt: number) {
        this.age += dt;
        this.in_state += dt;
        // The lamps it asks about have started by the second frame.
        if this.age < 0.1 {
            return;
        }
        let here_x = this.transform.position.x;
        let here_y = this.transform.position.y;
        var wx: number = 9999.0;
        var wy: number = 9999.0;
        if this.wick != null && World.exists(this.wick) {
            wx = this.wick.transform.world_position.x;
            wy = this.wick.transform.world_position.y;
        }
        let to_x = wx - here_x;
        let to_y = wy - here_y;
        let apart = sqrt(to_x * to_x + to_y * to_y);
        let hidden = sheltered(wx, wy);

        if this.state == "sweep" {
            // Round and round, wavering, so its path is never quite the same.
            this.turn += this.sweep_speed / this.sweep * dt;
            let reach = this.sweep * (0.75 + 0.25 * sin(this.turn * 2.3));
            let aim_x = this.home_x + reach * cos(this.turn);
            let aim_y = this.home_y + reach * 0.7 * sin(this.turn);
            go(aim_x, aim_y, this.sweep_speed * 1.5, dt);
            if apart < this.catch && !hidden && !Game.lost {
                enter("found");
            }
        } else if this.state == "found" {
            go(wx, wy, this.chase, dt);
            Game.found = 1.0;
            this.mark_x = wx;
            this.mark_y = wy;
            this.calling += dt;
            this.held_for += dt;
            if this.held_for >= this.brute_after && !this.brute_called {
                this.brute_called = true;
                call_brute(wx, wy);
            }
            if this.calling >= this.call_every {
                this.calling = 0.0;
                rise(wx, wy, this.age * 2.3);
            }
            if apart > this.lose || hidden || Game.lost {
                enter("lost");
                // The ones it calls now hunt where he was, not where he is.
                var n: number = 0.0;
                while n < this.wave {
                    rise(this.mark_x, this.mark_y, this.age + n * 6.2832 / this.wave);
                    n += 1.0;
                }
            }
        } else {
            // Hanging where it lost him, then back to its round.
            if this.in_state > this.linger_for {
                this.turn = atan2((here_y - this.home_y) / 0.7, here_x - this.home_x);
                enter("sweep");
            } else if apart < this.catch * 0.8 && !hidden && !Game.lost {
                enter("found");
            }
        }
        if this.state != "found" {
            Game.found = max(0.0, Game.found - dt * 0.4);
        }

        // Its circle: steady while it sweeps, fierce and pulsing once it has him.
        var bright: number = this.calm + 0.15 * sin(this.age * 2.0);
        if this.state == "found" {
            bright = this.fierce + 0.6 * sin(this.age * 9.0);
        } else if this.state == "lost" {
            bright = this.calm + 0.5 * sin(this.age * 5.0);
        }
        this.light2d.intensity = bright;
    }

    // A brute comes down near him, out of the circle's light.
    fn call_brute(x: number, y: number) {
        if this.brute == null {
            return;
        }
        let at = this.age * 1.7;
        let come = World.spawn(this.brute);
        come.transform.position.x = x + this.rise_at * cos(at);
        come.transform.position.y = y + this.rise_at * sin(at);
        Game.brutes += 1.0;
        Camera.add_trauma(0.3);
        if this.rising != null {
            Effects.burst_at(this.rising, come.transform.position.x, come.transform.position.y);
        }
    }

    fn enter(next: String) {
        if next == "found" && this.state != "found" {
            this.held_for = 0.0;
            this.brute_called = false;
        }
        // Being found is heard: a cold call from above.
        if next == "found" && this.state != "found" {
            Audio.play("audio/found.wav", 0.35);
        }
        this.state = next;
        this.in_state = 0.0;
        this.calling = 0.0;
    }

    // A gloom rises out of the ground `rise_at` from a point, the way `turn`
    // points, unless there are gloom enough about.
    fn rise(x: number, y: number, turn: number) {
        if this.gloom == null || World.with_tag("gloom").length >= this.most {
            return;
        }
        let at_x = x + this.rise_at * cos(turn);
        let at_y = y + this.rise_at * sin(turn);
        let risen = World.spawn(this.gloom);
        risen.transform.position.x = at_x;
        risen.transform.position.y = at_y;
        Effects.burst_at(this.rising, at_x, at_y + 0.5);
    }

    // Moves the circle toward a point, no faster than `speed`.
    fn go(x: number, y: number, speed: number, dt: number) {
        let dx = x - this.transform.position.x;
        let dy = y - this.transform.position.y;
        let gap = sqrt(dx * dx + dy * dy);
        let step = min(gap, speed * dt);
        if gap > 0.001 {
            this.transform.position.x += dx / gap * step;
            this.transform.position.y += dy / gap * step;
        }
    }

    // Whether a point is hidden from it: in a lit lamp's pool, a burning fire's, or
    // an open sunfall's.
    fn sheltered(x: number, y: number) -> bool {
        for lamp in World.with_tag("lantern") {
            let post = Lantern.on(lamp);
            if post != null && post.lit {
                let dx = x - lamp.transform.world_position.x;
                let dy = y - lamp.transform.world_position.y;
                if sqrt(dx * dx + dy * dy) < this.pool {
                    return true;
                }
            }
        }
        // A fire Wick has built, while it burns.
        for fire in World.with_tag("fire") {
            if fire.light2d.intensity > 0.5 {
                let dx = x - fire.transform.world_position.x;
                let dy = y - fire.transform.world_position.y;
                if sqrt(dx * dx + dy * dy) < this.pool {
                    return true;
                }
            }
        }
        for fall in World.with_tag("sunfall") {
            // Read from its light, which is there before its script starts: a
            // sunfall's pool is as bright as its crack is open.
            if fall.light2d.intensity > this.open_glow {
                let dx = x - fall.transform.world_position.x;
                let dy = y - fall.transform.world_position.y;
                if sqrt(dx * dx + dy * dy) < this.sunfall_pool {
                    return true;
                }
            }
        }
        return false;
    }
}
