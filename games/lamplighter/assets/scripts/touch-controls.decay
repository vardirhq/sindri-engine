// The left thumb steers with Sindri's virtual stick; a second finger can
// hold the jump button on the right at the same time.
const KNOB_TRAVEL: number = 0.11;

script TouchControls {
    var ring: Entity = null;
    var knob: Entity = null;
    var home_x: number = -0.75;
    var home_y: number = 0.24;

    fn start() {
        this.ring = World.find("touch-stick-ring");
        this.knob = World.find("touch-stick-knob");
        World.set_active(this.ring, false);
        World.set_active(this.knob, false);
    }

    fn update(dt: number) {
        let steering = Game.touch && Stick.held && Stick.anchor_x < 0.0;
        World.set_active(this.ring, Game.touch);
        World.set_active(this.knob, Game.touch);
        if Game.touch {
            let anchor_x = this.home_x;
            let anchor_y = this.home_y;
            if steering {
                anchor_x = Stick.anchor_x;
                anchor_y = Stick.anchor_y;
            }
            this.ring.transform.position = Vec3(anchor_x, anchor_y, 0.0);
            let push = Vec2(0.0, 0.0);
            if steering { push = Vec2(Stick.x, -Stick.y) * KNOB_TRAVEL; }
            this.knob.transform.position = Vec3(anchor_x + push.x, anchor_y + push.y, 0.0);
        }
    }
}
