// Wick walks the dim fields in the four directions and the diagonals, at one
// speed whichever way, easing into and out of a walk, and faces the way the
// walk is mostly going. The lantern Wick carries is the light on a child
// entity, which moves with Wick; touching a lantern lights it.
//
// The sword is the attack button: a slash that takes `swing` seconds, slows
// Wick to a crawl, and lands once, at `strike_at`, on whatever stands in the
// circle in front of him on the target layer.
script Wick {
    @export let speed: number = 5.0;
    // How quickly the walk reaches the speed asked for, per second.
    @export let ease: number = 14.0;
    // The slash's length, when in it the blade lands, and how fast Wick moves meanwhile.
    @export let swing: number = 0.56;
    @export let strike_at: number = 0.25;
    @export let swing_pace: number = 0.2;
    // Where the blow lands: how far ahead of Wick's middle, and how wide.
    @export let reach: number = 1.3;
    @export let blade: number = 1.1;

    var vx: number = 0.0;
    var vy: number = 0.0;
    var facing_x: number = 0.0;
    var facing_y: number = -1.0;
    var sprite: Entity = null;
    var clip: String = "";
    var swinging: bool = false;
    var swung_for: number = 0.0;
    var struck: bool = false;
    // Thrown back by a pounce: for how long input is ignored, and how long a
    // second one is forgiven.
    var stagger: number = 0.0;
    var grace: number = 0.0;
    var lost_for: number = 0.0;

    fn start() {
        Game.scorch = 0.0;
        Game.scorched = 0.0;
        Game.lost = false;
        Game.lit = 0.0;
        Game.total = World.with_tag("lantern").length;
        Game.won = false;
        Game.gloom_hits = 0.0;
        Game.gloom_out = 0.0;
        this.sprite = World.find("wick-sprite");
    }

    fn update(dt: number) {
        this.grace = max(0.0, this.grace - dt);
        if Game.lost {
            // The lantern is out: Wick stands in the dark a moment, then the field starts over.
            Physics.set_velocity(this.entity, 0.0, 0.0);
            this.lost_for += dt;
            if this.lost_for >= 1.6 {
                Scene.restart("world.scene");
            }
            return;
        }
        if this.stagger > 0.0 {
            // Thrown back: the walk is not Wick's to steer, and eases to a stop.
            this.stagger = max(0.0, this.stagger - dt);
            this.vx -= this.vx * min(1.0, dt * 9.0);
            this.vy -= this.vy * min(1.0, dt * 9.0);
            Physics.set_velocity(this.entity, this.vx, this.vy);
            this.transform.position.z = 0.5 - this.transform.world_position.y * 0.01;
            show(false);
            return;
        }
        var x: number = Action.axis("move_x");
        var y: number = Action.axis("move_y");
        // A finger's stick and a controller's stick both read down as positive,
        // as the screen does, and the world has up positive.
        let pad_y = -Gamepad.axis(0, "left_y");
        if abs(pad_y) > abs(y) {
            y = pad_y;
        }
        if Stick.held && abs(Stick.x) + abs(Stick.y) > abs(x) + abs(y) {
            x = Stick.x;
            y = -Stick.y;
        }
        // A diagonal is no faster than a straight walk.
        let length = sqrt(x * x + y * y);
        if length > 1.0 {
            x = x / length;
            y = y / length;
        }
        if Action.pressed("attack") && !this.swinging && !Game.won {
            this.swinging = true;
            this.swung_for = 0.0;
            this.struck = false;
        }
        var pace: number = 1.0;
        if this.swinging {
            // Wick keeps the way he faced when the blade came out.
            pace = this.swing_pace;
            this.swung_for += dt;
            if !this.struck && this.swung_for >= this.strike_at {
                this.struck = true;
                strike();
            }
            if this.swung_for >= this.swing {
                this.swinging = false;
                this.clip = "";
            }
        } else if length > 0.1 {
            this.facing_x = x;
            this.facing_y = y;
        }
        let blend = min(1.0, dt * this.ease);
        this.vx += (x * pace * this.speed - this.vx) * blend;
        this.vy += (y * pace * this.speed - this.vy) * blend;
        Physics.set_velocity(this.entity, this.vx, this.vy);
        // Further down the screen is nearer, so Wick walks behind a tree and in
        // front of the stone below it.
        this.transform.position.z = 0.5 - this.transform.world_position.y * 0.01;

        show(length > 0.1);

        for other in Physics.sensor_entered() {
            if World.exists(other) && World.has_tag(other, "lantern") {
                Lantern.on(other).ignite();
            }
        }
        if Action.pressed("pause") && !Game.won {
            Scene.go("pause.scene");
        }
    }

    // A gloom's pounce lands, from the direction given: Wick is thrown the way
    // it was going, the lantern is scorched, and a few of them in a row put it
    // out. A second pounce straight after the first is forgiven.
    fn scorch(push_x: number, push_y: number) {
        if this.grace > 0.0 || Game.won || Game.lost {
            return;
        }
        this.grace = 1.4;
        this.stagger = 0.3;
        this.swinging = false;
        this.vx = push_x * 8.0;
        this.vy = push_y * 8.0;
        Game.scorch = min(1.0, Game.scorch + 0.45);
        Game.scorched += 1.0;
        if Game.scorch >= 1.0 {
            Game.lost = true;
        }
    }

    // The way Wick faces, as the four the art draws. The sideways directions
    // win a tie, so a diagonal shows a profile.
    fn way() -> String {
        if abs(this.facing_x) >= abs(this.facing_y) {
            if this.facing_x > 0.0 { return "east"; }
            return "west";
        }
        if this.facing_y > 0.0 { return "north"; }
        return "south";
    }

    // The blade lands: everything on the target layer in the circle ahead of
    // Wick, which is where the sprite faces rather than where the stick points.
    fn strike() {
        var ahead_x: number = 0.0;
        var ahead_y: number = 0.0;
        let facing = way();
        if facing == "east" { ahead_x = 1.0; }
        if facing == "west" { ahead_x = -1.0; }
        if facing == "north" { ahead_y = 1.0; }
        if facing == "south" { ahead_y = -1.0; }
        let p = this.transform.world_position;
        // Wick's middle is about half a unit above his feet.
        let middle = Vec2(p.x + ahead_x * this.reach, p.y + 0.5 + ahead_y * this.reach);
        for hit in Physics.overlap_circle(middle, this.blade, Physics.layer("target"), false, this.entity) {
            if World.exists(hit) && World.has_tag(hit, "gloom") {
                Gloom.on(hit).hurt(ahead_x, ahead_y);
            }
        }
    }

    // The clip for what Wick is doing: slashing, walking while moving, or
    // standing still.
    fn show(moving: bool) {
        var name: String = "idle-" + way();
        if this.swinging {
            name = "slash-" + way();
        } else if moving {
            name = "walk-" + way();
        }
        if name != this.clip {
            this.clip = name;
            Animation.play(this.sprite, name);
        }
    }
}
