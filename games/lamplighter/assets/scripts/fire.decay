// A fire Wick has built: a campfire that burns down, or a lamp that burns for
// good. While it burns its light is a safe pool, as a lit lamp post's is: the
// gloom will not hunt Wick in it and are driven out of it, and a Seeker cannot
// find him there (`gloom.decay` and `seeker.decay` read how bright its light is,
// which is there before this script starts). A campfire fades over its last
// moments and goes out, and its embers with it.
script Fire {
    // How bright it burns, and how long; zero burns for good.
    @export let glow: number = 1.8;
    @export let burn_for: number = 90.0;
    @export let fade_for: number = 10.0;

    var age: number = 0.0;
    var out: bool = false;

    fn update(dt: number) {
        this.age += dt;
        var left: number = 1.0;
        if this.burn_for > 0.0 {
            left = clamp((this.burn_for - this.age) / this.fade_for, 0.0, 1.0);
        }
        // A flame is never still.
        let flicker = 0.08 * sin(this.age * 9.0) + 0.05 * sin(this.age * 23.0);
        this.light2d.intensity = (this.glow + flicker) * left;
        if left <= 0.0 && !this.out {
            this.out = true;
            this.light2d.intensity = 0.0;
            // Only a fire that burns down has embers to put out.
            this.particles.stop();
        }
    }
}
