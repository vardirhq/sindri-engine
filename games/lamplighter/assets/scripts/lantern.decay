// A lamp post is dark until Wick touches it, then it swaps to its lit sprite and
// the light up at the lantern flares and burns on. The goal lamp is the last:
// lighting it opens the way. A lit lamp is also a safe pool: the gloom will not hunt
// Wick while he stands in it, and are driven out of it (`gloom.decay` reads `lit`).
script Lantern {
    // The name of the entity that carries this lamp's light, up at the lantern.
    @export let light_name: String = "";

    var lit: bool = false;
    var flare: number = 0.0;
    var light: Entity = null;
    var sparks: Entity = null;

    fn start() {
        this.light = World.find(this.light_name);
        this.sparks = World.find("fx-spark");
    }

    fn update(dt: number) {
        if !this.lit {
            return;
        }
        this.flare = max(0.0, this.flare - dt);
        this.light.light2d.intensity = 1.1 + 2.4 * (this.flare / 0.8);
    }

    fn ignite() {
        if this.lit {
            return;
        }
        this.lit = true;
        this.flare = 0.8;
        Animation.play(this.entity, "lit");
        // Sparks off the flame, and a small shake: it caught.
        Effects.burst_at(this.sparks, this.transform.world_position.x, this.transform.world_position.y + 2.6);
        Camera.add_trauma(0.18);
        Game.lit += 1.0;
        if World.has_tag(this.entity, "goal") {
            Game.won = true;
        }
    }
}
