/* Lamplighter's palette: warm lamplight on night blue. Light is safe, so what
   the player can use glows amber; what is spent goes grey. */

:root {
    --ink: #f4e7c8;
    --muted: #b5a789;
    --faint: #6b6355;
    --ember: #f2a65a;
    --ember-deep: #3a2412;
    --panel: #0c0e18d9;
    --panel-edge: #3b3426;
    --well: #05060ccc;
    --danger: #e0614a;
}

.panel {
    background: var(--panel);
    border-color: var(--panel-edge);
    border-width: 1px;
    border-radius: 12px;
    box-shadow: 0px 8px 22px #00000088;
}

/* Every label wraps inside the box it is given, so `text-align` means
   something. */
sindri.ui.text { text-wrap: word; }

.kicker {
    color: var(--muted);
    font-size: 11px;
    line-height: 13px;
    letter-spacing: 2px;
    text-align: start;
}
