// Shared run state for the Flappy showcase.
state Game {
    var score: number = 0.0;
    var best: number = 0.0;
    var started: bool = false;
    var dead: bool = false;
    // Seconds since the crash, so a panicked tap does not restart instantly.
    var dead_time: number = 0.0;
    // Bumped on every restart; scrolling pieces watch it to go home.
    var run: number = 0.0;
    // World units per second; ramps up with the score.
    var speed: number = 3.2;
}
