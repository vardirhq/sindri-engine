// One-button flight. Physics supplies gravity; the script supplies the flap.
script Bird {
    @export let flap_speed: f32 = 7.2;
    @export let spawn_x: f32 = -1.5;
    @export let spawn_y: f32 = 0.5;
    @export let floor_y: f32 = -4.45;
    @export let ceiling_y: f32 = 6.4;
    @export let restart_delay: f32 = 0.6;

    var look: Entity = null;
    var wing: Entity = null;
    var clock: f32 = 0.0;
    var tilt: f32 = 0.0;

    fn start() {
        this.look = World.find("BirdLook");
        this.wing = World.find("BirdWing");
        reset();
    }

    fn update(dt: f32) {
        this.clock += dt;
        let flap = Input.just_pressed("Space") || Input.just_pressed("W") || Input.just_pressed("ArrowUp")
            || Pointer.just_pressed("Left");

        if Game.dead {
            Game.dead_time += dt;
            // Tip over and drop to the ground after a crash.
            this.tilt = max(this.tilt - 6.0 * dt, -1.5);
            this.look.transform.rotation_z = this.tilt;
            if this.transform.position.y > this.floor_y {
                Physics.set_velocity(this.entity, 0.0, min(Physics.velocity_y(this.entity), 0.0) - 30.0 * dt);
            } else {
                Physics.set_velocity(this.entity, 0.0, 0.0);
                this.transform.position.y = this.floor_y;
            }
            if flap && Game.dead_time > this.restart_delay {
                reset();
            }
            return;
        }

        if flap {
            Game.started = true;
            Physics.set_velocity(this.entity, 0.0, this.flap_speed);
        }

        if !Game.started {
            // Hover on the title screen.
            Physics.set_velocity(this.entity, 0.0, 0.0);
            this.transform.position.y = this.spawn_y + sin(this.clock * 4.0) * 0.25;
            this.tilt = 0.0;
            this.wing.transform.scale.y = 0.3 * (0.6 + 0.4 * abs(sin(this.clock * 9.0)));
        } else {
            // Nose follows velocity; the wing beats faster while climbing.
            let vy = Physics.velocity_y(this.entity);
            let target = max(min(vy * 0.09, 0.45), -1.3);
            this.tilt += (target - this.tilt) * min(dt * 10.0, 1.0);
            var beat = 9.0;
            if vy > 0.0 { beat = 22.0; }
            this.wing.transform.scale.y = 0.3 * (0.4 + 0.6 * abs(sin(this.clock * beat)));
        }
        this.look.transform.rotation_z = this.tilt;

        for other in Physics.sensor_entered() {
            if World.has_tag(other, "hazard") {
                die();
                return;
            } else if World.has_tag(other, "score") {
                Game.score += 1.0;
                Game.speed = min(3.2 + Game.score * 0.08, 5.5);
                if Game.score > Game.best {
                    Game.best = Game.score;
                }
            }
        }

        if this.transform.position.y < this.floor_y || this.transform.position.y > this.ceiling_y {
            die();
        }
    }

    fn die() {
        Game.dead = true;
        Game.dead_time = 0.0;
        Physics.set_velocity(this.entity, 0.0, 0.0);
    }

    fn reset() {
        this.transform.position.x = this.spawn_x;
        this.transform.position.y = this.spawn_y;
        Physics.set_velocity(this.entity, 0.0, 0.0);
        this.tilt = 0.0;
        this.look.transform.rotation_z = 0.0;
        Game.score = 0.0;
        Game.speed = 3.2;
        Game.started = false;
        Game.dead = false;
        Game.run += 1.0;
    }
}
