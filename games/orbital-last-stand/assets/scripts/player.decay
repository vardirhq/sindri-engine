// The Strider. Movement stays simple; the module catalog is allowed to make the
// weapon system gloriously unreasonable.
script Player {
    @export let bullet: Prefab;
    @export let mine: Prefab;
    @export let muzzle_fx: Prefab;
    @export let invulnerable_for: f32 = 0.9;
    @export let view_size: f32 = 11.0;
    @export let edge_padding: f32 = 0.28;

    var hurt: Entity = null;
    var target: Entity = null;
    var cooldown: f32 = 0.0;
    var mercy: f32 = 0.0;
    var mine_cooldown: f32 = 0.0;
    var facing: f32 = 1.5707963;
    var volley: f32 = 0.0;
    var broadside: f32 = 2.5;
    var pulse: f32 = 4.0;
    var devour: f32 = 0.0;
    var blade_spawned: f32 = 0.0;
    var shield_spawned: f32 = 0.0;
    var ember_spawned: f32 = 0.0;
    var wisp_spawned: f32 = 0.0;
    var drone_spawned: f32 = 0.0;
    var wrecking_spawned: f32 = 0.0;

    fn start() {
        this.hurt = World.find("PlayerHurt");
        World.set_shape_point(0.0, 0.0, 0.5);
        World.set_shape_point(1.0, 0.304, -0.328);
        World.set_shape_point(2.0, 0.1, -0.248);
        World.set_shape_point(3.0, 0.0, -0.392);
        World.set_shape_point(4.0, -0.1, -0.248);
        World.set_shape_point(5.0, -0.304, -0.328);
        this.shape.count = 6.0;
        this.shape.fill.r = 0.470588;
        this.shape.fill.g = 0.921569;
        this.shape.fill.b = 1.0;
        this.shape.fill.a = 1.0;
        this.shape.stroke.r = 0.913725;
        this.shape.stroke.g = 0.992157;
        this.shape.stroke.b = 1.0;
        this.transform.rotation_z = 0.0;
    }

    fn update(dt: f32) {
        if Game.player_reset > 0.0 {
            Game.player_reset = 0.0;
            reset_runtime();
        }
        if Game.run_state != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            this.transform.rotation_z = this.facing - 1.5707963;
            return;
        }

        move(dt);
        tick_overdrive(dt);
        take_hits();
        track_target();
        sync_companions();
        shoot(dt);
        drop_mine(dt);
        special_attacks(dt);

        if this.mercy > 0.0 {
            this.mercy -= dt;
            this.shape.stroke.a = 0.45;
        } else {
            this.shape.stroke.a = 1.0;
        }
    }

    fn reset_runtime() {
        this.transform.position.x = 0.0;
        this.transform.position.y = 0.0;
        this.facing = 1.5707963;
        this.transform.rotation_z = 0.0;
        this.mercy = 0.0;
        this.cooldown = 0.0;
        this.mine_cooldown = 0.0;
        this.volley = 0.0;
        this.broadside = 2.5;
        this.pulse = 4.0;
        this.devour = 0.0;
        this.blade_spawned = 0.0;
        this.shield_spawned = 0.0;
        this.ember_spawned = 0.0;
        this.wisp_spawned = 0.0;
        this.drone_spawned = 0.0;
        this.wrecking_spawned = 0.0;
        Game.shield_impact = 0.0;
        Physics.set_velocity(this.entity, 0.0, 0.0);
    }

    fn move(dt: f32) {
        let speed = Game.move_speed;
        var dx: f32 = Input.axis("A", "D") + Input.axis("ArrowLeft", "ArrowRight");
        var dy: f32 = Input.axis("S", "W") + Input.axis("ArrowDown", "ArrowUp");
        if dx == 0.0 && dy == 0.0 && Stick.held && !Pointer.over_ui {
            dx = Stick.x;
            dy = -Stick.y;
        }
        let length = sqrt(dx * dx + dy * dy);
        if length >= 0.08 {
            let desired = atan2(dy, dx);
            let delta = atan2(sin(desired - this.facing), cos(desired - this.facing));
            let blend = 1.0 - exp(-12.0 * max(0.0, dt));
            this.facing += delta * blend;
        }
        if length > 1.0 { dx /= length; dy /= length; }
        this.transform.rotation_z = this.facing - 1.5707963;
        Game.player_facing = this.facing;
        Game.player_thrust = min(1.0, length);
        let edge_x = max(0.0, visible_half_x(this.view_size) - this.edge_padding);
        let edge_y = max(0.0, visible_half_y(this.view_size) - this.edge_padding);
        var velocity_x: f32 = dx * speed;
        var velocity_y: f32 = dy * speed;
        if this.transform.position.x <= -edge_x {
            this.transform.position.x = -edge_x;
            if velocity_x < 0.0 { velocity_x = 0.0; }
        } else if this.transform.position.x >= edge_x {
            this.transform.position.x = edge_x;
            if velocity_x > 0.0 { velocity_x = 0.0; }
        }
        if this.transform.position.y <= -edge_y {
            this.transform.position.y = -edge_y;
            if velocity_y < 0.0 { velocity_y = 0.0; }
        } else if this.transform.position.y >= edge_y {
            this.transform.position.y = edge_y;
            if velocity_y > 0.0 { velocity_y = 0.0; }
        }
        Physics.set_velocity(this.entity, velocity_x, velocity_y);
    }

    fn take_hits() {
        let raw = Game.player_damage_taken;
        if raw <= 0.0 { return; }
        Game.player_damage_taken = 0.0;
        if this.mercy > 0.0 { return; }
        if Game.special_ghost_protocol > 0.0 && Random.value() < 0.12 {
            this.mercy = 0.18;
            return;
        }
        var damage: f32 = raw * (1.0 - Game.armor);
        if Game.special_mutual_defense > 0.0 {
            damage *= 1.0 - min(0.2, companion_count() * 0.04);
        }
        let hp = Game.hp;
        if Game.special_last_bulkhead > 0.0 && Game.last_bulkhead_used <= 0.0 && damage >= hp {
            damage = max(0.0, hp - 0.05);
            Game.last_bulkhead_used = 1.0;
            this.mercy = 2.0;
        } else {
            this.mercy = this.invulnerable_for;
        }
        Game.hp = hp - damage;
        if damage > 0.0 && Game.special_revenge_relay > 0.0 {
            Game.overdrive = max(4.0, Game.overdrive);
        }
        Game.shield_impact = 1.0;
        Game.screen_trauma = max(Game.screen_trauma, 0.72);
        Effects.burst(this.hurt);
        Audio.play("audio/hurt.wav", 0.5);
    }

    fn shoot(dt: f32) {
        this.cooldown -= dt;
        if Game.nullified > 0.0 || this.cooldown > 0.0 { return; }
        let target = this.target;
        if target == null { return; }
        if Game.overdrive > 0.0 { this.cooldown = Game.fire_gap * 0.55; }
        else { this.cooldown = Game.fire_gap; }
        let to = target.transform.position - this.transform.position;
        let flat = Vec2(to.x, to.y);
        if flat.length <= 0.0 { return; }
        let forward = flat.normalized;
        let count = max(1.0, Game.shots);
        this.volley += 1.0;
        let echo = Game.special_echo_chamber > 0.0 && this.volley % 6.0 == 0.0;
        var made: f32 = 0.0;
        while made < count {
            let spread = (made - (count - 1.0) * 0.5) * 0.16;
            // Fanned out sideways from straight ahead, then made unit length again.
            let aim = forward + Vec2(-forward.y, forward.x) * spread;
            let shot = aim.normalized;
            var damage = Game.damage * special_damage_multiplier();
            let crit = Random.value() < Game.crit;
            if crit { damage *= Game.crit_power; }
            fire_one(this.transform.position.x, this.transform.position.y, shot.x, shot.y, damage, crit, 1.0);
            if echo {
                let angle = atan2(aim.y, aim.x) + 0.12;
                fire_one(this.transform.position.x, this.transform.position.y, cos(angle), sin(angle), damage * 0.6, false, 0.9);
            }
            if Game.grave_echo_time > 0.0 {
                let angle = atan2(aim.y, aim.x) - 0.14;
                fire_one(this.transform.position.x, this.transform.position.y, cos(angle), sin(angle), damage * 0.5, false, 0.8);
            }
            this.devour += 1.0;
            if Game.special_devouring_moon > 0.0 && this.devour >= 8.0 {
                this.devour = 0.0;
                fire_one(this.transform.position.x, this.transform.position.y, shot.x, shot.y, damage * 4.0, false, 1.8);
            }
            made += 1.0;
        }
        muzzle_flash(forward.x, forward.y);
        Audio.play("audio/shot.wav", 0.18);
    }

    fn muzzle_flash(dx: f32, dy: f32) {
        let flash = World.spawn(this.muzzle_fx);
        flash.transform.position.x = this.transform.position.x + dx * 0.42;
        flash.transform.position.y = this.transform.position.y + dy * 0.42;
        World.set_property(flash, "style", if_number(Game.nova > 0.0) * 2.0);
        World.set_property(flash, "start_size", 0.12);
        World.set_property(flash, "end_size", 0.7 + min(0.45, Game.shots * 0.08));
        World.set_property(flash, "duration", 0.14);
        World.set_property(flash, "spin", 8.0);
    }

    fn fire_one(x: f32, y: f32, dx: f32, dy: f32, damage: f32, crit: bool, size_scale: f32) {
        // Typed: a misspelt field is a compile error, not a property the
        // bullet never reads.
        let shot = Bullet.on(World.spawn(this.bullet));
        shot.transform.position.x = x;
        shot.transform.position.y = y;
        let size = Game.bullet_size * size_scale;
        shot.transform.scale.x *= size;
        shot.transform.scale.y *= size;
        shot.dir_x = dx;
        shot.dir_y = dy;
        shot.speed = Game.bullet_speed;
        shot.damage = damage;
        shot.pierce = Game.pierce;
        shot.missile = Game.missile;
        shot.arc = Game.arc;
        shot.nova = Game.nova;
        shot.beam = Game.beam;
        shot.crit_hit = if_number(crit);
    }

    fn special_damage_multiplier() -> f32 {
        var factor: f32 = 1.0;
        if Game.synergy_mass_driver > 0.0 { factor *= 1.22; }
        if Game.special_kill_switch > 0.0 && Game.hp / max(0.05, Game.max_hp) < 0.35 { factor *= 1.45; }
        if Game.special_terminal_velocity > 0.0 {
            factor *= 1.0 + min(0.4, max(0.0, Game.bullet_speed / 9.0 - 1.0) * 0.7);
        }
        if Game.special_fork_tax > 0.0 { factor *= 1.0 + min(0.32, max(0.0, Game.shots - 1.0) * 0.08); }
        if Game.special_crowded_orbit > 0.0 { factor *= 1.0 + min(0.3, companion_count() * 0.05); }
        return factor;
    }

    fn special_attacks(dt: f32) {
        if Game.special_broadside_protocol > 0.0 {
            this.broadside -= dt;
            if this.broadside <= 0.0 {
                this.broadside = 3.4;
                let left = -visible_half_x(this.view_size) + 0.2;
                let right = visible_half_x(this.view_size) - 0.2;
                var lane: f32 = -1.0;
                while lane <= 1.0 {
                    fire_one(left, lane * visible_half_y(this.view_size) * 0.55, 1.0, 0.0, Game.damage * 0.72, false, 0.9);
                    fire_one(right, lane * visible_half_y(this.view_size) * 0.55, -1.0, 0.0, Game.damage * 0.72, false, 0.9);
                    lane += 1.0;
                }
            }
        }
        if Game.special_pulse_heart > 0.0 {
            this.pulse -= dt;
            if this.pulse <= 0.0 {
                this.pulse = 4.8;
                var slot: f32 = 0.0;
                while slot < 10.0 {
                    let angle = slot / 10.0 * 6.2831853 + Game.elapsed * 0.4;
                    fire_one(this.transform.position.x, this.transform.position.y, cos(angle), sin(angle), Game.damage * 0.55, false, 0.75);
                    slot += 1.0;
                }
            }
        }
    }

    fn sync_companions() {
        while this.blade_spawned < Game.comp_blade { spawn_companion(1.0, this.blade_spawned); this.blade_spawned += 1.0; }
        while this.shield_spawned < Game.comp_shield { spawn_companion(2.0, this.shield_spawned); this.shield_spawned += 1.0; }
        while this.ember_spawned < Game.comp_ember { spawn_companion(3.0, this.ember_spawned); this.ember_spawned += 1.0; }
        while this.wisp_spawned < Game.comp_wisp { spawn_companion(4.0, this.wisp_spawned); this.wisp_spawned += 1.0; }
        while this.drone_spawned < Game.comp_drone { spawn_companion(5.0, this.drone_spawned); this.drone_spawned += 1.0; }
        while this.wrecking_spawned < Game.comp_wrecking { spawn_companion(6.0, this.wrecking_spawned); this.wrecking_spawned += 1.0; }
    }

    fn spawn_companion(kind: f32, slot: f32) {
        let companion = World.spawn(this.bullet);
        companion.transform.position.x = this.transform.position.x;
        companion.transform.position.y = this.transform.position.y;
        World.set_property(companion, "companion_kind", kind);
        World.set_property(companion, "companion_slot", slot);
        World.set_property(companion, "life", 9999.0);
        var damage = Game.damage * companion_damage(kind);
        if kind == 1.0 && Game.synergy_heavy_orbit > 0.0 { damage *= 1.22; }
        World.set_property(companion, "damage", damage);
        World.set_property(companion, "pierce", 999.0);
        if kind == 3.0 || kind == 4.0 { World.set_property(companion, "arc", Game.arc); }
        if kind == 2.0 && Game.synergy_static_aegis > 0.0 { World.set_property(companion, "arc", 1.0); }
        if kind == 2.0 || kind == 4.0 { World.set_property(companion, "nova", Game.nova); }
        if kind == 1.0 { World.set_property(companion, "beam", Game.beam); }
    }

    fn companion_damage(kind: f32) -> f32 {
        if kind == 1.0 { return 0.7; }
        if kind == 2.0 { return 0.25; }
        if kind == 3.0 { return 0.48; }
        if kind == 4.0 { return 0.42; }
        if kind == 5.0 { return 0.55; }
        return 1.0;
    }

    fn companion_count() -> f32 {
        return Game.comp_blade + Game.comp_shield + Game.comp_ember + Game.comp_wisp + Game.comp_drone + Game.comp_wrecking;
    }

    fn tick_overdrive(dt: f32) {
        let left = Game.overdrive;
        if left > 0.0 { Game.overdrive = max(0.0, left - dt); }
    }

    fn track_target() {
        this.target = nearest();
        let target = this.target;
        if target == null {
            Game.target_live = 0.0;
            return;
        }
        Game.target_live = 1.0;
        Game.target_x = target.transform.position.x;
        Game.target_y = target.transform.position.y;
    }

    fn drop_mine(dt: f32) {
        if Game.nullified > 0.0 || Game.mines <= 0.0 { return; }
        this.mine_cooldown -= dt;
        if this.mine_cooldown > 0.0 { return; }
        this.mine_cooldown = 2.4;
        let mine = World.spawn(this.mine);
        mine.transform.position.x = this.transform.position.x;
        mine.transform.position.y = this.transform.position.y;
        World.set_property(mine, "damage", Game.damage * 0.65);
    }

    fn nearest() -> Entity {
        var best: Entity = null;
        var best_distance: f32 = 0.0;
        for enemy in World.with_tag("enemy") {
            if !World.exists(enemy) || !on_screen(enemy, this.view_size) { continue; }
            let dx = enemy.transform.position.x - this.transform.position.x;
            let dy = enemy.transform.position.y - this.transform.position.y;
            let distance = dx * dx + dy * dy;
            if best == null || distance < best_distance { best = enemy; best_distance = distance; }
        }
        return best;
    }

    fn if_number(value: bool) -> f32 { if value { return 1.0; } return 0.0; }
}
