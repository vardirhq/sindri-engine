// A data-driven Last Stand module chooser. Adding a module changes the profile,
// not this script: pools, rarity, requirements, text and ownership are data.

// One offer slot on screen: the card, and the name and blurb it shows.
struct OfferCard { card: Entity, name: Entity, blurb: Entity }

script UpgradeChooser {
    @export let catalog: Profile;
    @export let offers: f32 = 3.0;

    var cards: List<Entity> = [];
    var screen: Entity = null;
    // One per offer slot, in order.
    var slots: List<OfferCard> = [];
    var showing: bool = false;

    fn start() {
        this.cards = World.with_tag("upgrade");
        this.screen = World.find("Upgrades");
        for card in ["Guidance Kernel", "Arc Imprint", "Nova Imprint", "Gravity Anchor"] {
            this.slots.push(OfferCard(
                card: World.find(card),
                name: World.find(card + " Name"),
                blurb: World.find(card + " Blurb"),
            ));
        }
        hide();
    }

    fn update(dt: f32) {
        if Game.get("modules_reset", 0.0) > 0.0 {
            Game.set("modules_reset", 0.0);
            clear_owned();
            Game.set("black_modules_taken", 0.0);
        }
        let choosing = Game.get("run_state", 0.0) == 2.0;
        if choosing == this.showing { return; }
        this.showing = choosing;
        if choosing { show(); }
        else { hide(); }
    }

    fn clear_owned() {
        for index in 0..Profiles.count(this.catalog, "modules") {
            Game.set(Profiles.text_at(this.catalog, "modules", index, "owned_key", ""), 0.0);
        }
    }

    fn hide() {
        for card in this.cards { World.set_active(card, false); }
        World.set_active(this.screen, false);
    }

    // Three offers always, and a fourth when Second Opinion asks for it, none
    // of them a module already on offer.
    fn show() {
        for card in this.cards { World.set_active(card, false); }
        World.set_active(this.screen, true);
        let pool = Game.get("module_pool", 0.0);
        var taken: List<f32> = [];
        for slot in 0..this.slots.length {
            var index = -1.0;
            if slot < 3.0 || offer_count() > 3.0 { index = choose(pool, taken); }
            taken.push(index);
            offer(slot, index);
        }
    }

    fn offer(slot: f32, index: f32) {
        Game.set("offer_" + slot, index);
        let shown = this.slots[slot];
        if index < 0.0 { World.set_active(shown.card, false); return; }
        Ui.set_text(shown.name, Profiles.text_at(this.catalog, "modules", index, "name", "Unknown Module"));
        Ui.set_text(shown.blurb, Profiles.text_at(this.catalog, "modules", index, "description", ""));
        World.set_active(shown.card, true);
    }

    fn offer_count() -> f32 {
        if Game.get("special_second_opinion", 0.0) > 0.0 { return 4.0; }
        return this.offers;
    }

    fn choose(pool: f32, taken: List<f32>) -> f32 {
        var total: f32 = 0.0;
        let count = Profiles.count(this.catalog, "modules");
        for index in 0..count {
            if available(index, pool, taken) {
                total += Profiles.number_at(this.catalog, "modules", index, "weight", 1.0);
            }
        }
        if total <= 0.0 { return -1.0; }
        var cursor = Random.range(0.0, total);
        for index in 0..count {
            if available(index, pool, taken) {
                cursor -= Profiles.number_at(this.catalog, "modules", index, "weight", 1.0);
                if cursor <= 0.0 { return index; }
            }
        }
        return first_available(pool, taken);
    }

    fn first_available(pool: f32, taken: List<f32>) -> f32 {
        for index in 0..Profiles.count(this.catalog, "modules") {
            if available(index, pool, taken) { return index; }
        }
        return -1.0;
    }

    fn available(index: f32, pool: f32, taken: List<f32>) -> bool {
        if taken.contains(index) { return false; }
        let owned_key = Profiles.text_at(this.catalog, "modules", index, "owned_key", "");
        if Game.get(owned_key, 0.0) > 0.0 { return false; }
        let required = Profiles.text_at(this.catalog, "modules", index, "requires_key", "");
        if required != "" {
            let minimum = Profiles.number_at(this.catalog, "modules", index, "requires_min", 0.0);
            if Game.get(required, 0.0) < minimum { return false; }
        }
        let mask = Profiles.number_at(this.catalog, "modules", index, "pool_mask", 0.0);
        return has_pool(mask, pool);
    }

    fn has_pool(mask: f32, pool: f32) -> bool {
        var bit: f32 = 1.0;
        if pool == 1.0 { bit = 2.0; }
        else if pool == 2.0 { bit = 4.0; }
        else if pool == 3.0 { bit = 8.0; }
        let whole = (mask - mask % bit) / bit;
        return whole % 2.0 >= 1.0;
    }
}
