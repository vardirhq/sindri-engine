// What a run shares on the board, declared once: each value's name, and what
// it reads as before anything has set it. `Game.kills` is checked when the
// project compiles, where `Game.get("kils", 0.0)` read the fallback silently.
state Game {
    var aegis_reservoir: f32 = 0.0;
    var arc: f32 = 0.0;
    var armor: f32 = 0.0;
    var beam: f32 = 0.0;
    var black_modules_taken: f32 = 0.0;
    var boss_count: f32 = 0.0;
    var boss_hp: f32 = 0.0;
    var boss_kind: f32 = 0.0;
    var boss_max: f32 = 0.0;
    var boss_pool: f32 = 0.0;
    var bullet_size: f32 = 1.0;
    var bullet_speed: f32 = 9.0;
    var comp_blade: f32 = 0.0;
    var comp_drone: f32 = 0.0;
    var comp_ember: f32 = 0.0;
    var comp_shield: f32 = 0.0;
    var comp_wisp: f32 = 0.0;
    var comp_wrecking: f32 = 0.0;
    var companion_spawn_reset: f32 = 0.0;
    var constellation_count: f32 = 0.0;
    var cores: f32 = 0.0;
    var crit: f32 = 0.0;
    var crit_power: f32 = 2.0;
    var damage: f32 = 1.0;
    var damage_mul: f32 = 1.0;
    var elapsed: f32 = 0.0;
    var elite_bonus: f32 = 0.0;
    var elite_kills: f32 = 0.0;
    var elite_spawned: f32 = 0.0;
    var fire_gap: f32 = 0.42;
    var fire_rate: f32 = 2.38;
    var grave_echo_time: f32 = 0.0;
    var hp: f32 = 5.0;
    var kills: f32 = 0.0;
    var kills_since_repair: f32 = 0.0;
    var last_bulkhead_used: f32 = 0.0;
    var level: f32 = 1.0;
    var magnet: f32 = 2.2;
    var max_hp: f32 = 5.0;
    var max_hp_add: f32 = 0.0;
    var mines: f32 = 0.0;
    var missile: f32 = 0.0;
    var module_pool: f32 = 0.0;
    var modules_reset: f32 = 0.0;
    var move_speed: f32 = 5.2;
    var next_level: f32 = 35.0;
    var nova: f32 = 0.0;
    var nullified: f32 = 0.0;
    var orbit_loom_dps: f32 = 0.0;
    var overdrive: f32 = 0.0;
    var picked_module: f32 = 0.0;
    var pierce: f32 = 0.0;
    var player_aura_dps: f32 = 0.0;
    var player_aura_radius: f32 = 0.0;
    var player_damage_taken: f32 = 0.0;
    var player_facing: f32 = 1.5707963;
    var player_reset: f32 = 0.0;
    var player_thrust: f32 = 0.0;
    var powerups_dropped: f32 = 0.0;
    var regen: f32 = 0.0;
    var request_start: f32 = 0.0;
    var run_state: f32 = 0.0;
    var score: f32 = 0.0;
    var sector: f32 = 1.0;
    var shield_impact: f32 = 0.0;
    var shots: f32 = 1.0;
    var special_aegis_reservoir: f32 = 0.0;
    var special_anchor_clock: f32 = 0.0;
    var special_arc_battery: f32 = 0.0;
    var special_black_sun: f32 = 0.0;
    var special_blood_battery: f32 = 0.0;
    var special_broadside_protocol: f32 = 0.0;
    var special_constellation_engine: f32 = 0.0;
    var special_critical_arc: f32 = 0.0;
    var special_critical_reboot: f32 = 0.0;
    var special_crowded_orbit: f32 = 0.0;
    var special_dead_god_circuit: f32 = 0.0;
    var special_devouring_moon: f32 = 0.0;
    var special_echo_chamber: f32 = 0.0;
    var special_familiar_guidance: f32 = 0.0;
    var special_fork_tax: f32 = 0.0;
    var special_funeral_star: f32 = 0.0;
    var special_ghost_protocol: f32 = 0.0;
    var special_grave_echo: f32 = 0.0;
    var special_homing_instinct: f32 = 0.0;
    var special_kill_switch: f32 = 0.0;
    var special_last_bulkhead: f32 = 0.0;
    var special_mutual_defense: f32 = 0.0;
    var special_orbit_loom: f32 = 0.0;
    var special_phase_memory: f32 = 0.0;
    var special_prism_mirror: f32 = 0.0;
    var special_pulse_heart: f32 = 0.0;
    var special_revenge_relay: f32 = 0.0;
    var special_reversal_chamber: f32 = 0.0;
    var special_scrap_feast: f32 = 0.0;
    var special_second_opinion: f32 = 0.0;
    var special_split_horizon: f32 = 0.0;
    var special_terminal_velocity: f32 = 0.0;
    var special_white_noise: f32 = 0.0;
    var stats_reset: f32 = 0.0;
    var synergy_count: f32 = 0.0;
    var synergy_critical_conduction: f32 = 0.0;
    var synergy_heavy_orbit: f32 = 0.0;
    var synergy_hunters_spark: f32 = 0.0;
    var synergy_mass_driver: f32 = 0.0;
    var synergy_static_aegis: f32 = 0.0;
    var target_live: f32 = 0.0;
    // Where the player's nearest target is; meaningful only while
    // `target_live` is 1.
    var target_x: f32 = 0.0;
    var target_y: f32 = 0.0;
    var transform_critical_mass: f32 = 0.0;
    var transform_rail_prism: f32 = 0.0;
    var transform_recursive: f32 = 0.0;
    var transform_storm: f32 = 0.0;
    var victory: f32 = 0.0;
    var xp_gain: f32 = 1.0;
}
