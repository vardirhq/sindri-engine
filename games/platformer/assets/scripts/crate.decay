// A wooden crate carried by a gentle wind. K or the west pad button tosses
// it when the hero is nearby; hitting above its centre makes it tumble.
script Crate {
    fn start() {
        Physics.set_angular_velocity(this.entity, 0.0);
    }

    fn update(dt: f32) {
        let p = this.transform.world_position;
        if p.y < -3.0 {
            this.transform.position = Vec3(4.0, 4.0, 0.3);
            Physics.set_velocity(this.entity, 0.0, 0.0);
            Physics.set_angular_velocity(this.entity, 0.0);
            return;
        }
        // Reapply each fixed update: a force is consumed by just one step.
        Physics.apply_force(this.entity, Vec2(0.3, 0.0));
        if abs(Physics.velocity_y(this.entity)) > 0.2 {
            Physics.apply_torque(this.entity, 0.03);
        }
        let spin = Physics.angular_velocity(this.entity);
        if abs(spin) > 3.0 {
            Physics.set_angular_velocity(this.entity, max(-3.0, min(3.0, spin)));
        }
        if Action.pressed("kick") {
            for hero in World.with_tag("hero") {
                let h = hero.transform.world_position;
                if abs(h.x - p.x) < 2.2 && abs(h.y - p.y) < 2.0 {
                    var direction: f32 = 1.0;
                    if h.x > p.x { direction = -1.0; }
                    Physics.apply_impulse_at_point(this.entity, Vec2(direction, 2.0), Vec2(p.x + 0.3, p.y + 0.55));
                    Physics.apply_angular_impulse(this.entity, direction * 0.02);
                }
            }
        }
    }
}
