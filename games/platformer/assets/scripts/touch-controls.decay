// The on-screen controls, always shown: a stick ring on the left and the jump
// button on the right. The left thumb steers from wherever it lands on the
// left half, and the ring follows it there; any thumb can hold jump.
const KNOB_TRAVEL: number = 0.11;
// Where the ring rests while no thumb is on it.
const REST_X: number = -0.75;
const REST_Y: number = -0.64;

script TouchControls {
    var ring: Entity = null;
    var knob: Entity = null;

    fn start() {
        this.ring = World.find("touch-stick-ring");
        this.knob = World.find("touch-stick-knob");
    }

    fn update(dt: number) {
        var at: Vec2 = Vec2(REST_X, REST_Y);
        var push: Vec2 = Vec2(0.0, 0.0);
        if Stick.held && Stick.anchor.x < 0.0 {
            at = Stick.anchor;
            push = Vec2(Stick.x, -Stick.y) * KNOB_TRAVEL;
        }
        this.ring.transform.position = Vec3(at.x, at.y, 0.0);
        this.knob.transform.position = Vec3(at.x + push.x, at.y + push.y, 0.0);
    }
}
