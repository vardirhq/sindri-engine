// A powered axle reverses every two seconds. Physics turns the rotor.
script Windmill {
    var age: f32 = 0.0;
    var posing: bool = false;
    var direction: f32 = 1.0;
    fn start() {
        restore_motor();
    }
    fn restore_motor() {
        if this.posing {
            Physics.set_hinge_position_motor(this.entity, 0.6, 5.0, 1.0, 1.0);
        } else {
            Physics.set_hinge_motor(this.entity, this.direction * 2.0, 1.0);
        }
    }
    fn update(dt: f32) {
        if Input.just_pressed("P") {
            this.posing = !this.posing;
            restore_motor();
        }
        if this.posing { return; }
        this.age += dt;
        if this.age >= 2.0 {
            this.age = 0.0;
            this.direction = -this.direction;
            Physics.set_hinge_motor(this.entity, this.direction * 2.0, 1.0);
        }
    }
}
