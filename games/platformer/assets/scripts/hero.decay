// The hero: runs, jumps, picks up coins and reaches the flag.
//
// Solved support contacts grant standing only above a surface while descending.
// The foot sensor handles pickups; overlapping a plank from below never grants
// a jump. Coyote time and a jump buffer keep jumps forgiving.
// Down/S/d-pad down drops through one-way planks onto the painted floor.
//
// Keyboard, gamepad and touch all feed the same run/jump path. Touch uses
// Sindri's virtual Stick for movement; a second finger is the jump button.
script Hero {
    @export let speed: f32 = 6.5;
    @export let acceleration: f32 = 120.0;
    @export let deceleration: f32 = 90.0;
    @export let air_acceleration: f32 = 90.0;
    @export let jump_speed: f32 = 14.0;
    @export let coyote: f32 = 0.1;
    @export let buffer: f32 = 0.12;
    @export let fall_limit: f32 = -3.0;
    @export let spawn_x: f32 = 2.5;
    @export let spawn_y: f32 = 4.0;

    // Supporting ground beneath the feet, rather than a sensor overlap.
    var ground: f32 = 0.0;
    var drop_left: f32 = 0.0;
    var on_one_way: bool = false;
    var since_ground: f32 = 1.0;
    var since_press: f32 = 1.0;
    var facing: f32 = 1.0;
    var jump_held: bool = false;
    // 0 idle, 1 run, 2 jump, 3 fall: which clip is showing.
    var shown: f32 = 0.0;

    fn start() {
        Physics.set_continuous_collision(this.entity, true);
        Game.coins = 0.0;
        Game.coins_total = World.with_tag("coin").length;
        Game.won = false;
        Game.falls = 0.0;
    }

    fn update(dt: f32) {
        this.drop_left = max(0.0, this.drop_left - dt);
        touch();
        probe_ground();
        if Game.won {
            Physics.set_velocity(this.entity, 0.0, Physics.velocity_y(this.entity));
            show(0.0);
            return;
        }
        if this.transform.position.y < this.fall_limit {
            respawn();
            return;
        }

        // What the player means, from the scene's input actions: `run` is
        // A/D, the arrows, the stick or the d-pad, and `jump` Space, W, Up or
        // South, whichever is being used. A finger steers and jumps besides.
        var run: f32 = Action.axis("run");
        if Stick.held && abs(Stick.x) > abs(run) { run = Stick.x; }
        run = max(-1.0, min(1.0, run));

        let touch_jump = Touch.count > 1.0;
        let holding_jump = Action.held("jump") || touch_jump;
        let pressed_jump = Action.pressed("jump") || (touch_jump && !this.jump_held);
        if pressed_jump {
            this.since_press = 0.0;
        } else {
            this.since_press += dt;
        }
        if this.ground > 0.0 {
            this.since_ground = 0.0;
        } else {
            this.since_ground += dt;
        }

        var rise: f32 = Physics.velocity_y(this.entity);
        if Action.pressed("drop") && this.on_one_way && this.ground > 0.0 {
            Physics.drop_through(this.entity, 0.35);
            this.drop_left = 0.35;
            this.ground = 0.0;
            this.since_ground = 1.0;
            this.since_press = 1.0;
            rise = -2.0;
        }
        if this.drop_left <= 0.0 && this.since_press <= this.buffer && this.since_ground <= this.coyote {
            rise = this.jump_speed;
            this.since_press = 1.0;
            this.since_ground = 1.0;
        }
        // Letting go early cuts the rise short, so a tap is a hop on every
        // input device, including lifting the second touch finger.
        if this.jump_held && !holding_jump && rise > 0.0 {
            rise = rise * 0.45;
        }
        this.jump_held = holding_jump;

        // Build and shed horizontal speed instead of snapping straight to the
        // target. The short ramp preserves the showcase's established jump
        // timing while still making starts, stops and reversals feel physical.
        var horizontal: f32 = Physics.velocity_x(this.entity);
        let target = run * this.speed;
        var rate: f32 = this.air_acceleration;
        if this.ground > 0.0 {
            if run == 0.0 {
                rate = this.deceleration;
            } else {
                rate = this.acceleration;
            }
        }
        let step = rate * dt;
        if horizontal < target {
            horizontal = min(target, horizontal + step);
        } else if horizontal > target {
            horizontal = max(target, horizontal - step);
        }
        Physics.set_velocity(this.entity, horizontal, rise);

        if run != 0.0 {
            this.facing = run;
            if run > 0.0 {
                this.transform.scale.x = 1.0;
            } else {
                this.transform.scale.x = -1.0;
            }
        }
        if this.ground > 0.0 {
            if run != 0.0 {
                show(1.0);
            } else {
                show(0.0);
            }
        } else if rise > 0.0 {
            show(2.0);
        } else {
            show(3.0);
        }
    }

    // The ray measures clearance; actual solved contacts grant jump permission.
    // Sleeping support remains present, and sensors never become solid ground.
    fn probe_ground() {
        let p = this.transform.world_position;
        let hit = Physics.raycast(Vec2(p.x, p.y), Vec2(0.0, -1.0), 12.0, Physics.layer("ground"), false, this.entity);
        Game.ground_found = hit != null;
        this.ground = 0.0;
        this.on_one_way = false;
        if hit != null {
            Game.ground_clearance = max(0.0, hit.distance - 0.5);
        }
        for contact in Physics.contacts(this.entity) {
            if contact.normal.y > 0.5 && contact.point.y < p.y && Physics.velocity_y(this.entity) <= 0.1 && this.drop_left <= 0.0 {
                this.ground = 1.0;
                if World.has_tag(contact.entity, "one-way") { this.on_one_way = true; }
            }
        }
    }

    // What the capsule and the foot sensor touched this step. A coin taken
    // earlier in the step, or on an earlier one, can still be reported by the
    // other sensor or as it leaves, so nothing is asked of one that is gone.
    fn touch() {
        for other in Physics.sensor_entered() {
            if !World.exists(other) {
                // Already taken.
            } else if World.has_tag(other, "coin") {
                World.despawn(other);
                Game.coins += 1.0;
            } else if World.has_tag(other, "goal") {
                Game.won = true;
            }
        }
    }

    fn respawn() {
        this.transform.position.x = this.spawn_x;
        this.transform.position.y = this.spawn_y;
        Physics.set_velocity(this.entity, 0.0, 0.0);
        this.ground = 0.0;
        Game.falls += 1.0;
    }

    fn show(state: f32) {
        if state == this.shown {
            return;
        }
        this.shown = state;
        if state == 0.0 {
            Animation.play(this.entity, "idle");
        } else if state == 1.0 {
            Animation.play(this.entity, "run");
        } else if state == 2.0 {
            Animation.play(this.entity, "jump");
        } else {
            Animation.play(this.entity, "fall");
        }
    }
}
