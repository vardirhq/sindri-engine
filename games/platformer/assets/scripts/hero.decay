// The hero: runs, jumps, picks up coins and reaches the flag.
//
// Standing is decided by the foot sensor, the small sensor box under the
// capsule: it touches the ground and nothing else, so walls and ceilings never
// count as floor. A jump is forgiving in the two ways players expect: pressed
// a moment before landing it still happens (the buffer), and pressed a moment
// after running off a ledge it still counts (coyote time).
//
// Keyboard, gamepad and the screen buttons all feed the same run/jump path.
script Hero {
    @export let speed: f32 = 6.5;
    @export let acceleration: f32 = 42.0;
    @export let deceleration: f32 = 55.0;
    @export let air_acceleration: f32 = 28.0;
    @export let jump_speed: f32 = 14.0;
    @export let coyote: f32 = 0.1;
    @export let buffer: f32 = 0.12;
    @export let fall_limit: f32 = -3.0;
    @export let spawn_x: f32 = 2.5;
    @export let spawn_y: f32 = 4.0;
    @export let left_button: Entity = null;
    @export let right_button: Entity = null;
    @export let jump_button: Entity = null;

    // Ground contacts the foot sensor is in, over every box it overlaps.
    var ground: f32 = 0.0;
    var since_ground: f32 = 1.0;
    var since_press: f32 = 1.0;
    var facing: f32 = 1.0;
    var jump_held: bool = false;
    // 0 idle, 1 run, 2 jump, 3 fall: which clip is showing.
    var shown: f32 = 0.0;

    fn start() {
        Game.coins = 0.0;
        Game.coins_total = World.with_tag("coin").length;
        Game.won = false;
        Game.falls = 0.0;
    }

    fn update(dt: f32) {
        touch();
        if Game.won {
            Physics.set_velocity(this.entity, 0.0, Physics.velocity_y(this.entity));
            show(0.0);
            return;
        }
        if this.transform.position.y < this.fall_limit {
            respawn();
            return;
        }

        var run: f32 = Input.axis("A", "D") + Input.axis("ArrowLeft", "ArrowRight");
        let stick = Gamepad.axis(0.0, "left_x");
        if abs(stick) > abs(run) { run = stick; }
        if Gamepad.is_down(0.0, "dpad_left") { run = -1.0; }
        if Gamepad.is_down(0.0, "dpad_right") { run = 1.0; }
        if this.left_button != null && Ui.is_held(this.left_button) { run = -1.0; }
        if this.right_button != null && Ui.is_held(this.right_button) { run = 1.0; }
        run = max(-1.0, min(1.0, run));

        let keyboard_jump = Input.is_down("Space") || Input.is_down("W") || Input.is_down("ArrowUp");
        let pad_jump = Gamepad.is_down(0.0, "south");
        var screen_jump: bool = false;
        if this.jump_button != null { screen_jump = Ui.is_held(this.jump_button); }
        let holding_jump = keyboard_jump || pad_jump || screen_jump;
        let pressed_jump = Input.just_pressed("Space") || Input.just_pressed("W") || Input.just_pressed("ArrowUp") || Gamepad.just_pressed(0.0, "south") || (this.jump_button != null && Ui.is_pressed(this.jump_button));
        if pressed_jump {
            this.since_press = 0.0;
        } else {
            this.since_press += dt;
        }
        if this.ground > 0.0 {
            this.since_ground = 0.0;
        } else {
            this.since_ground += dt;
        }

        var rise: f32 = Physics.velocity_y(this.entity);
        if this.since_press <= this.buffer && this.since_ground <= this.coyote {
            rise = this.jump_speed;
            this.since_press = 1.0;
            this.since_ground = 1.0;
        }
        // Letting go early cuts the rise short, so a tap is a hop on every
        // input device, including a finger lifting from the on-screen button.
        if this.jump_held && !holding_jump && rise > 0.0 {
            rise = rise * 0.45;
        }
        this.jump_held = holding_jump;

        // Build and shed horizontal speed instead of snapping straight to the
        // target. Ground movement stays responsive while the lower air control
        // makes a committed jump feel different from running on solid ground.
        var horizontal: f32 = Physics.velocity_x(this.entity);
        let target = run * this.speed;
        var rate: f32 = this.air_acceleration;
        if this.ground > 0.0 {
            if run == 0.0 {
                rate = this.deceleration;
            } else {
                rate = this.acceleration;
            }
        }
        let step = rate * dt;
        if horizontal < target {
            horizontal = min(target, horizontal + step);
        } else if horizontal > target {
            horizontal = max(target, horizontal - step);
        }
        Physics.set_velocity(this.entity, horizontal, rise);

        if run != 0.0 {
            this.facing = run;
            if run > 0.0 {
                this.transform.scale.x = 1.0;
            } else {
                this.transform.scale.x = -1.0;
            }
        }
        if this.ground > 0.0 {
            if run != 0.0 {
                show(1.0);
            } else {
                show(0.0);
            }
        } else if rise > 0.0 {
            show(2.0);
        } else {
            show(3.0);
        }
    }

    // What the capsule and the foot sensor touched this step.
    fn touch() {
        for other in Physics.sensor_entered() {
            if World.has_tag(other, "solid") {
                this.ground += 1.0;
            } else if World.has_tag(other, "coin") && World.exists(other) {
                World.despawn(other);
                Game.coins += 1.0;
            } else if World.has_tag(other, "goal") {
                Game.won = true;
            }
        }
        for other in Physics.sensor_exited() {
            if World.has_tag(other, "solid") {
                this.ground = max(0.0, this.ground - 1.0);
            }
        }
    }

    fn respawn() {
        this.transform.position.x = this.spawn_x;
        this.transform.position.y = this.spawn_y;
        Physics.set_velocity(this.entity, 0.0, 0.0);
        this.ground = 0.0;
        Game.falls += 1.0;
    }

    fn show(state: f32) {
        if state == this.shown {
            return;
        }
        this.shown = state;
        if state == 0.0 {
            Animation.play(this.entity, "idle");
        } else if state == 1.0 {
            Animation.play(this.entity, "run");
        } else if state == 2.0 {
            Animation.play(this.entity, "jump");
        } else {
            Animation.play(this.entity, "fall");
        }
    }
}
