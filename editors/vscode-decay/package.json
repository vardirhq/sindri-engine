{
  "name": "sindri-decay",
  "displayName": "Sindri Decay",
  "description": "Decay language support for Sindri projects",
  "version": "0.1.0",
  "publisher": "vardir",
  "repository": {
    "type": "git",
    "url": "https://github.com/vardirhq/sindri-engine.git",
    "directory": "editors/vscode-decay"
  },
  "license": "MIT OR Apache-2.0",
  "files": [
    "extension.js",
    "server.js",
    "language-configuration.json",
    "syntaxes/decay.tmLanguage.json",
    "bin/decay-lsp",
    "bin/decay-lsp.exe",
    "README.md"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:decay"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "decay",
        "aliases": ["Decay", "decay"],
        "extensions": [".decay"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "decay",
        "scopeName": "source.decay",
        "path": "./syntaxes/decay.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Decay",
      "properties": {
        "decay.server.path": {
          "type": "string",
          "default": "decay-lsp",
          "description": "Optional path to a decay-lsp executable. Packaged extensions use their bundled server by default; changing this setting overrides it."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check server.js && node test.js",
    "package": "npx --no-install @vscode/vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2"
  }
}
