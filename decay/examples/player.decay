script PlayerController {
    @export
    let speed: number = 6.0;

    @export
    let jump_force: number = 8.0;

    fn update(dt: number) {
        let movement = Input.axis("move_left", "move_right");
        this.transform.position.x += movement * speed * dt;

        if Input.just_pressed("jump") {
            this.rigidbody.add_impulse(vec3(0.0, jump_force, 0.0));
        }
    }
}
