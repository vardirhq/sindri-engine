// How the world looks: the sun, the sky, the fog, the grade, the sea, the
// lamps and what drifts in the air. Each island has its own mood -- a clear
// morning on Saltmarsh, mist over The Fold, a hot gold afternoon on Quarry
// Rise, night at The Lighthouse -- and the title has its dusk. Asking for a
// mood eases everything there, so nothing about the light ever jumps.
//
// It lives on the Environment entity and is told which mood to show by the
// battle and the title; it never decides that itself.

enum Drift { Nothing, Pollen, Dust, Fireflies, Mist }

struct Mood {
    sun: Color,
    sun_intensity: number,
    // Radians below the horizon the sun shines from, and from which way.
    sun_pitch: number,
    sun_yaw: number,
    ambient: Color,
    ambient_intensity: number,
    sky: Color,
    // The deep water's color, and how much swell, foam and glitter it has.
    sea: Color,
    swell: number,
    foam: number,
    glints: number,
    fog: Color,
    fog_start: number,
    fog_distance: number,
    fog_density: number,
    mist: number,
    exposure: number,
    contrast: number,
    saturation: number,
    vignette: number,
    glow_threshold: number,
    glow: number,
    lantern: number,
    beacon: number,
    // Light in the houses' windows, and round where the Hollow climb out.
    windows: number,
    rift: number,
    drift: Drift,
    embers: bool,
    // The weather: how hard it rains (0..1), how hard the wind pushes the
    // rain and everything in the air, and how often lightning comes (0..1).
    rain: number,
    wind: number,
    storm: number,
}

shared const TITLE_MOOD: number = 4.0;

shared fn mood_of(index: number) -> Mood {
    if index == 1.0 {
        // The Fold: overcast and still, mist lying in the hollows, rain.
        return Mood(
            sun: Color(0.82, 0.87, 0.95), sun_intensity: 1.15, sun_pitch: -1.1, sun_yaw: -0.1,
            ambient: Color(0.62, 0.68, 0.78), ambient_intensity: 0.72,
            sky: Color(0.2, 0.25, 0.28),
            sea: Color(0.035, 0.11, 0.13), swell: 0.5, foam: 1.0, glints: 0.08,
            fog: Color(0.5, 0.57, 0.6), fog_start: 48.0, fog_distance: 26.0,
            fog_density: 0.0, mist: 0.12,
            exposure: -0.05, contrast: 0.98, saturation: 0.78, vignette: 0.4,
            glow_threshold: 0.9, glow: 0.35,
            lantern: 3.2, beacon: 4.5, windows: 1.4, rift: 1.0,
            drift: Drift.Mist, embers: false,
            rain: 0.45, wind: 0.8, storm: 0.0,
        );
    }
    if index == 2.0 {
        // Quarry Rise: late afternoon, a low gold sun and long shadows, dust
        // hanging in the air and the sea throwing back the glare.
        return Mood(
            sun: Color(1.0, 0.66, 0.38), sun_intensity: 2.3, sun_pitch: -0.55, sun_yaw: -0.85,
            ambient: Color(0.72, 0.58, 0.6), ambient_intensity: 0.52,
            sky: Color(0.32, 0.2, 0.16),
            sea: Color(0.04, 0.13, 0.19), swell: 0.9, foam: 0.7, glints: 1.0,
            fog: Color(0.9, 0.6, 0.38), fog_start: 58.0, fog_distance: 30.0,
            fog_density: 0.0, mist: 0.0,
            exposure: 0.0, contrast: 1.14, saturation: 1.15, vignette: 0.4,
            glow_threshold: 0.72, glow: 0.75,
            lantern: 2.6, beacon: 4.0, windows: 0.9, rift: 0.8,
            drift: Drift.Dust, embers: false,
            rain: 0.0, wind: 0.5, storm: 0.0,
        );
    }
    if index == 3.0 {
        // The Lighthouse: night and a storm coming in off the sea. A cold
        // moon, the sea black under it, rain driving across, lightning, and
        // the beacon and lanterns burning against it all.
        return Mood(
            sun: Color(0.5, 0.62, 1.0), sun_intensity: 0.5, sun_pitch: -0.8, sun_yaw: 0.35,
            ambient: Color(0.22, 0.28, 0.55), ambient_intensity: 0.42,
            sky: Color(0.01, 0.02, 0.05),
            sea: Color(0.008, 0.03, 0.07), swell: 0.9, foam: 0.6, glints: 0.55,
            fog: Color(0.04, 0.07, 0.14), fog_start: 40.0, fog_distance: 24.0,
            fog_density: 0.03, mist: 0.2,
            exposure: 0.1, contrast: 1.12, saturation: 0.95, vignette: 0.55,
            glow_threshold: 0.55, glow: 1.1,
            lantern: 6.0, beacon: 14.0, windows: 4.5, rift: 3.5,
            drift: Drift.Nothing, embers: true,
            rain: 0.85, wind: 2.2, storm: 1.0,
        );
    }
    if index == TITLE_MOOD {
        // The title: dusk at The Lighthouse, the lamps just lit.
        return Mood(
            sun: Color(1.0, 0.46, 0.26), sun_intensity: 1.35, sun_pitch: -0.33, sun_yaw: -0.4,
            ambient: Color(0.34, 0.34, 0.7), ambient_intensity: 0.42,
            sky: Color(0.03, 0.05, 0.1),
            sea: Color(0.03, 0.1, 0.17), swell: 0.8, foam: 0.6, glints: 0.7,
            fog: Color(0.3, 0.22, 0.32), fog_start: 44.0, fog_distance: 28.0,
            fog_density: 0.02, mist: 0.1,
            exposure: 0.0, contrast: 1.06, saturation: 1.0, vignette: 0.4,
            glow_threshold: 0.68, glow: 0.8,
            lantern: 4.5, beacon: 9.0, windows: 3.0, rift: 1.8,
            drift: Drift.Fireflies, embers: true,
            rain: 0.0, wind: 0.3, storm: 0.0,
        );
    }
    // Saltmarsh: a clear, bright morning, a little haze far out.
    return Mood(
        sun: Color(1.0, 0.88, 0.7), sun_intensity: 2.4, sun_pitch: -1.0, sun_yaw: -0.4,
        ambient: Color(0.58, 0.7, 0.9), ambient_intensity: 0.44,
        sky: Color(0.06, 0.15, 0.19),
        sea: Color(0.02, 0.15, 0.22), swell: 0.8, foam: 0.8, glints: 0.6,
        fog: Color(0.6, 0.74, 0.8), fog_start: 50.0, fog_distance: 34.0,
        fog_density: 0.0, mist: 0.0,
        exposure: 0.0, contrast: 1.04, saturation: 0.98, vignette: 0.3,
        glow_threshold: 0.85, glow: 0.55,
        lantern: 2.6, beacon: 4.0, windows: 0.0, rift: 0.6,
        drift: Drift.Pollen, embers: false,
        rain: 0.0, wind: 0.4, storm: 0.0,
    );
}

// Everything numeric in a mood, blended.
shared fn blend(a: Mood, b: Mood, t: number) -> Mood {
    var drift = b.drift;
    var embers = b.embers;
    if t < 0.5 {
        drift = a.drift;
        embers = a.embers;
    }
    return Mood(
        sun: a.sun.lerp(b.sun, t), sun_intensity: lerp(a.sun_intensity, b.sun_intensity, t),
        sun_pitch: lerp(a.sun_pitch, b.sun_pitch, t), sun_yaw: lerp(a.sun_yaw, b.sun_yaw, t),
        ambient: a.ambient.lerp(b.ambient, t),
        ambient_intensity: lerp(a.ambient_intensity, b.ambient_intensity, t),
        sky: a.sky.lerp(b.sky, t),
        sea: a.sea.lerp(b.sea, t), swell: lerp(a.swell, b.swell, t), foam: lerp(a.foam, b.foam, t),
        glints: lerp(a.glints, b.glints, t),
        fog: a.fog.lerp(b.fog, t), fog_start: lerp(a.fog_start, b.fog_start, t),
        fog_distance: lerp(a.fog_distance, b.fog_distance, t),
        fog_density: lerp(a.fog_density, b.fog_density, t), mist: lerp(a.mist, b.mist, t),
        exposure: lerp(a.exposure, b.exposure, t), contrast: lerp(a.contrast, b.contrast, t),
        saturation: lerp(a.saturation, b.saturation, t), vignette: lerp(a.vignette, b.vignette, t),
        glow_threshold: lerp(a.glow_threshold, b.glow_threshold, t), glow: lerp(a.glow, b.glow, t),
        lantern: lerp(a.lantern, b.lantern, t), beacon: lerp(a.beacon, b.beacon, t),
        windows: lerp(a.windows, b.windows, t), rift: lerp(a.rift, b.rift, t),
        drift: drift, embers: embers,
        rain: lerp(a.rain, b.rain, t), wind: lerp(a.wind, b.wind, t), storm: lerp(a.storm, b.storm, t),
    );
}

// One fleck in the air: where it is, where it is going, how long it has.
struct Fleck {
    x: number,
    y: number,
    z: number,
    vx: number,
    vy: number,
    vz: number,
    age: number,
    life: number,
    seed: number,
    ember: bool,
}

script Atmosphere {
    @export let fleck: Prefab;
    @export let flecks_max: number = 48.0;
    // Streaks of rain at the heaviest; a lighter rain uses fewer.
    @export let rain_max: number = 80.0;
    // Smoke from the chimneys, and the motes rising from the rifts.
    @export let puffs_max: number = 18.0;
    @export let motes_max: number = 16.0;

    var shown: Mood = mood_of(0.0);
    var from: Mood = mood_of(0.0);
    var to: Mood = mood_of(0.0);
    var clock: number = 1.0;
    var seconds: number = 1.0;
    var settled: bool = false;
    // How much of the drift is in the air, faded with each change of mood.
    var drift_amount: number = 0.0;

    var sun: Entity = null;
    var lantern: Entity = null;
    var beacon: Entity = null;
    var house_lights: List<Entity> = [];
    var rift_lights: List<Entity> = [];
    // The air's own random numbers. The battle seeds `Random` so a crossing
    // can be replayed; weather drawing from it would change which Hollow come.
    var dice: number = 0.5;
    var pool: List<Entity> = [];
    var flecks: List<Fleck> = [];
    var rain_pool: List<Entity> = [];
    var drops: List<Fleck> = [];
    var puff_pool: List<Entity> = [];
    var puffs: List<Fleck> = [];
    var mote_pool: List<Entity> = [];
    var motes: List<Fleck> = [];
    // The battle says where each house and rift is and whether it is lit;
    // how lit each one is eases here, so none of them switches on or off.
    var window_at: List<Vec3> = [];
    var window_wanted: List<bool> = [];
    var window_level: List<number> = [];
    var rift_at: List<Vec3> = [];
    var rift_wanted: List<bool> = [];
    var rift_level: List<number> = [];
    // A rift flares as the Hollow climb out of it.
    var rift_flare: List<number> = [];
    var next_puff: number = 0.0;
    var next_mote: number = 0.0;
    // Lightning: how bright the sky is from the last strike (0..1), how long
    // since it struck, when the next comes and when its thunder arrives.
    var flash: number = 0.0;
    var since_strike: number = 10.0;
    var next_strike: number = 6.0;
    var thunder_in: number = -1.0;
    var thunder_volume: number = 0.0;

    fn start() {
        sun = World.find("Sun");
        lantern = World.find("Lantern Light");
        beacon = World.find("Beacon Light");
        for i in 0..3 {
            house_lights.push(World.find("House Light " + i));
            window_at.push(Vec3(0.0, 0.0, 0.0));
            window_wanted.push(false);
            window_level.push(0.0);
        }
        for i in 0..2 {
            rift_lights.push(World.find("Rift Light " + i));
            rift_at.push(Vec3(0.0, 0.0, 0.0));
            rift_wanted.push(false);
            rift_level.push(0.0);
            rift_flare.push(0.0);
        }
        for i in 0..puffs_max {
            let e = World.spawn(fleck);
            World.set_active(e, false);
            puff_pool.push(e);
            puffs.push(Fleck(x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0,
                age: 1.0, life: 0.0, seed: i * 0.618, ember: false));
        }
        for i in 0..motes_max {
            let e = World.spawn(fleck);
            World.set_active(e, false);
            mote_pool.push(e);
            motes.push(Fleck(x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0,
                age: 1.0, life: 0.0, seed: i * 0.618, ember: false));
        }
        for i in 0..flecks_max {
            let e = World.spawn(fleck);
            World.set_active(e, false);
            pool.push(e);
            flecks.push(Fleck(x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0,
                age: 1.0, life: 0.0, seed: i * 0.618, ember: false));
        }
        for i in 0..rain_max {
            let e = World.spawn(fleck);
            World.set_active(e, false);
            rain_pool.push(e);
            drops.push(Fleck(x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0,
                age: 1.0, life: 0.0, seed: i * 0.618, ember: false));
        }
        apply(shown);
    }

    // Eases from whatever is showing now to mood `index` over `over` seconds.
    fn go(index: number, over: number) {
        ease_to(mood_of(index), over);
    }

    // The light going out: whatever is showing drains of color and dims, the
    // lamps go dark and the air empties.
    fn mourn(over: number) {
        var dark = shown;
        dark.saturation = 0.2;
        dark.exposure = -0.8;
        dark.vignette = 0.75;
        dark.lantern = 0.0;
        dark.beacon = 0.0;
        dark.windows = 0.0;
        dark.glow = 0.2;
        dark.drift = Drift.Nothing;
        dark.embers = false;
        ease_to(dark, over);
    }

    // The crossing made: the storm breaks and the beacon flares over the
    // night sea.
    fn celebrate(over: number) {
        var bright = mood_of(3.0);
        bright.rain = 0.0;
        bright.storm = 0.0;
        bright.wind = 0.4;
        bright.drift = Drift.Fireflies;
        bright.beacon = 26.0;
        bright.lantern = 8.0;
        bright.windows = 6.0;
        bright.glow = 1.5;
        bright.exposure = 0.25;
        ease_to(bright, over);
    }

    fn ease_to(mood: Mood, over: number) {
        from = shown;
        to = mood;
        clock = 0.0;
        seconds = max(over, 0.01);
        settled = false;
    }

    fn update(dt: number) {
        if !settled {
            clock += dt;
            let t = min(1.0, clock / seconds);
            shown = blend(from, to, t * t * (3.0 - 2.0 * t));
            apply(shown);
            if t >= 1.0 { settled = true; }
            // The air empties as one mood goes and fills as the next comes.
            drift_amount = abs(t * 2.0 - 1.0);
        } else {
            drift_amount = 1.0;
        }
        storm(dt);
        ease_lights(dt);
        flicker();
        drift(dt);
        rain(dt);
        smoke(dt);
        rise_from_rifts(dt);
    }

    // --- Lights the battle places -------------------------------------------------

    // House `i`'s windows are at `at`; `lit` while somebody still lives there.
    fn window(i: number, at: Vec3, lit: bool) {
        if i >= window_at.length { return; }
        // Somewhere else altogether -- the next island's house -- starts dark
        // rather than sliding across.
        if apart(at, window_at[i]) { window_level[i] = 0.0; }
        window_at[i] = at;
        window_wanted[i] = lit;
    }

    // House `i` is gone from the board: its light goes out where it was.
    fn window_out(i: number) {
        if i < window_wanted.length { window_wanted[i] = false; }
    }

    // Rift `i` is at `at`; `open` while Hollow are about to climb out of it.
    fn rift(i: number, at: Vec3, open: bool) {
        if i >= rift_at.length { return; }
        if apart(at, rift_at[i]) { rift_level[i] = 0.0; }
        rift_at[i] = at;
        rift_wanted[i] = open;
    }

    fn rift_shut(i: number) {
        if i >= rift_wanted.length { return; }
        // Closing as the Hollow come out is a flare, not a fade.
        if rift_wanted[i] && rift_level[i] > 0.5 { rift_flare[i] = 1.0; }
        rift_wanted[i] = false;
    }

    fn apart(a: Vec3, b: Vec3) -> bool {
        return abs(a.x - b.x) + abs(a.y - b.y) + abs(a.z - b.z) > 0.5;
    }

    fn ease_lights(dt: number) {
        for i in 0..window_level.length {
            var target = 0.0;
            if window_wanted[i] { target = 1.0; }
            // On slowly, as a lamp is lit; out faster, as one is put out.
            if target > window_level[i] {
                window_level[i] = min(target, window_level[i] + dt * 0.8);
            } else {
                window_level[i] = max(target, window_level[i] - dt * 1.6);
            }
            let light = house_lights[i];
            World.set_active(light, window_level[i] > 0.0);
            light.transform.position = window_at[i];
        }
        for i in 0..rift_level.length {
            var target = 0.0;
            if rift_wanted[i] { target = 1.0; }
            if target > rift_level[i] {
                rift_level[i] = min(target, rift_level[i] + dt * 1.2);
            } else {
                rift_level[i] = max(target, rift_level[i] - dt * 1.4);
            }
            rift_flare[i] = max(0.0, rift_flare[i] - dt * 1.8);
            let light = rift_lights[i];
            World.set_active(light, rift_level[i] > 0.0 || rift_flare[i] > 0.0);
            light.transform.position = rift_at[i];
        }
    }

    fn apply(m: Mood) {
        // A strike lights the whole sky for a moment, cold and white.
        let f = flash;
        sun.light.color = m.sun.lerp(Color(0.8, 0.86, 1.0), f);
        sun.light.intensity = m.sun_intensity + f * 2.5;
        sun.transform.pitch = m.sun_pitch;
        sun.transform.yaw = m.sun_yaw;
        this.environment.ambient_color = m.ambient;
        this.environment.ambient_intensity = m.ambient_intensity + f * 0.9;
        let sky = m.sky.lerp(Color(0.36, 0.4, 0.55), f * 0.8);
        this.environment.background = Color(sky.r, sky.g, sky.b, 1.0);
        this.environment.fog.enabled = true;
        this.environment.fog.color = m.fog.lerp(Color(0.5, 0.55, 0.7), f * 0.7);
        this.environment.fog.start = m.fog_start;
        this.environment.fog.distance = m.fog_distance;
        this.environment.fog.density = m.fog_density;
        this.environment.fog.height = 1.2;
        this.environment.fog.height_falloff = m.mist;
        this.environment.post_process.exposure = m.exposure + f * 0.6;
        this.environment.post_process.contrast = m.contrast;
        this.environment.post_process.saturation = m.saturation;
        this.environment.post_process.vignette = m.vignette;
        this.environment.bloom.threshold = m.glow_threshold;
        this.environment.bloom.intensity = m.glow;
        for tile in World.with_tag("sea") {
            tile.sprite.tint = Color(m.sea.r, m.sea.g, m.sea.b, 0.88);
            tile.sprite.shader_params.x = m.swell;
            tile.sprite.shader_params.y = m.foam;
            tile.sprite.shader_params.z = m.glints + f * 1.5;
            tile.sprite.shader_params.w = m.rain;
        }
    }

    // Flames are never steady.
    fn flicker() {
        let t = Time.elapsed;
        let wobble = 0.86 + 0.08 * sin(t * 7.3) + 0.06 * sin(t * 13.1 + 1.7);
        lantern.light.intensity = shown.lantern * wobble;
        beacon.light.intensity = shown.beacon * (0.9 + 0.1 * sin(t * 2.1) * sin(t * 5.3));
        for i in 0..house_lights.length {
            var glow = 0.92 + 0.08 * sin(t * (3.0 + i) + i * 2.0);
            // A light going out gutters as it goes.
            if !window_wanted[i] { glow *= 0.6 + 0.4 * sin(t * 31.0 + i); }
            house_lights[i].light.intensity = shown.windows * glow * window_level[i];
        }
        // The rifts pulse, slow and wrong, and flare as they give up the Hollow.
        for i in 0..rift_lights.length {
            let pulse = 0.65 + 0.35 * sin(t * 1.7 + i * 2.4);
            rift_lights[i].light.intensity = shown.rift * (pulse * rift_level[i] + rift_flare[i] * 2.5);
        }
    }

    // --- What drifts in the air ------------------------------------------------

    fn drift(dt: number) {
        let kind = shown.drift;
        for i in 0..flecks.length {
            var f = flecks[i];
            let e = pool[i];
            f.age += dt;
            if f.age >= f.life {
                // A third of the pool is the beacon's embers when it burns.
                let ember = shown.embers && i % 3.0 == 0.0 && World.is_active(beacon);
                if kind == Drift.Nothing && !ember {
                    World.set_active(e, false);
                    flecks[i] = f;
                    continue;
                }
                f = born(i, kind, ember);
            }
            f.x += f.vx * dt;
            f.y += f.vy * dt;
            f.z += f.vz * dt;
            if f.ember {
                // Embers wander as they climb.
                f.vx += sin(Time.elapsed * 2.0 + f.seed * 7.0) * dt * 0.6;
                f.vz += cos(Time.elapsed * 1.7 + f.seed * 5.0) * dt * 0.6;
            } else if kind == Drift.Mist {
                // Mist barely moves of itself; the wind carries it.
                f.vx += sin(Time.elapsed * 0.3 + f.seed * 4.0) * dt * 0.02;
            } else if kind == Drift.Fireflies || kind == Drift.Pollen || kind == Drift.Dust {
                f.vx += sin(Time.elapsed * 1.3 + f.seed * 11.0) * dt * 0.3;
                f.vy += cos(Time.elapsed * 1.1 + f.seed * 3.0) * dt * 0.2;
            }
            flecks[i] = f;
            show(e, f, kind);
        }
    }

    // A new fleck of `kind` somewhere over the island, or an ember at the
    // beacon's flame.
    fn born(i: number, kind: Drift, ember: bool) -> Fleck {
        let r1 = roll();
        let r2 = roll();
        let r3 = roll();
        if ember {
            let p = beacon.transform.world_position;
            return Fleck(x: p.x + (r1 - 0.5) * 0.3, y: p.y - 0.2, z: p.z + (r2 - 0.5) * 0.3,
                vx: (r2 - 0.5) * 0.3, vy: 0.6 + r3 * 0.5, vz: (r1 - 0.5) * 0.3,
                age: 0.0, life: 1.6 + r3 * 1.2, seed: r1 * 10.0, ember: true);
        }
        if kind == Drift.Mist {
            // Wide, low and slow, over the water round the island as well.
            return Fleck(x: 14.0 + r1 * 28.0, y: 0.15 + r3 * 0.9, z: 14.0 + r2 * 28.0,
                vx: -0.1 - shown.wind * 0.12, vy: 0.0, vz: 0.04 + shown.wind * 0.06,
                age: 0.0, life: 9.0 + r3 * 6.0, seed: r1 * 10.0, ember: false);
        }
        let x = 22.0 + r1 * 12.0;
        let z = 22.0 + r2 * 12.0;
        if kind == Drift.Fireflies {
            return Fleck(x: x, y: 1.0 + r3 * 3.5, z: z, vx: (r3 - 0.5) * 0.3, vy: 0.0, vz: (r1 - 0.5) * 0.3,
                age: 0.0, life: 3.0 + r3 * 3.0, seed: r1 * 10.0, ember: false);
        }
        // Pollen and dust drift slowly through the light, with the wind.
        return Fleck(x: x, y: 0.8 + r3 * 4.0, z: z, vx: 0.15 + r3 * 0.2 - shown.wind * 0.2, vy: 0.04,
            vz: -0.08 + shown.wind * 0.12,
            age: 0.0, life: 4.0 + r3 * 4.0, seed: r1 * 10.0, ember: false);
    }

    fn roll() -> number {
        dice = (dice * 9301.0 + 49297.0) % 233280.0;
        return dice / 233280.0;
    }

    fn show(e: Entity, f: Fleck, kind: Drift) {
        // In and out over its life, never popping.
        let k = f.age / max(f.life, 0.01);
        let fade = min(1.0, k * 4.0) * min(1.0, (1.0 - k) * 4.0);
        var color = Color(1.0, 1.0, 1.0);
        var size = 0.06;
        var alpha = 0.5;
        if f.ember {
            color = Color(1.0, 0.62 - k * 0.3, 0.25);
            size = 0.07 * (1.0 - k * 0.5);
            alpha = 1.0;
        } else if kind == Drift.Fireflies {
            let blink = 0.5 + 0.5 * sin(Time.elapsed * 3.0 + f.seed * 6.0);
            color = Color(0.85, 1.0, 0.45);
            size = 0.06;
            alpha = blink;
        } else if kind == Drift.Dust {
            color = Color(1.0, 0.85, 0.6);
            size = 0.035;
            alpha = 0.55;
        } else if kind == Drift.Mist {
            // A broad, faint bank the color of the fog, swelling as it goes.
            color = shown.fog.lerp(Color(1.0, 1.0, 1.0), 0.25);
            size = 1.6 + f.seed * 0.12 + k * 0.8;
            alpha = 0.1;
        } else {
            color = Color(1.0, 0.98, 0.88);
            size = 0.03;
            alpha = 0.45;
        }
        let a = alpha * fade * drift_amount;
        if a < 0.02 {
            World.set_active(e, false);
            return;
        }
        World.set_active(e, true);
        e.transform.position = Vec3(f.x, f.y, f.z);
        e.transform.scale = Vec3(size, size, size);
        e.sprite.tint = Color(color.r, color.g, color.b, a);
    }

    // --- Smoke and rifts ----------------------------------------------------------

    // Smoke from every chimney with somebody home, curling up and bending
    // with the wind. Its grey follows the light, so it is never brighter
    // than the evening it rises into.
    fn smoke(dt: number) {
        next_puff -= dt;
        if next_puff <= 0.0 {
            next_puff = 0.35;
            for i in 0..window_level.length {
                if !window_wanted[i] || window_level[i] < 0.3 { continue; }
                launch_puff(smoke_from(i));
            }
        }
        let shade = clamp(0.3 + shown.sun_intensity * 0.28 + shown.ambient_intensity * 0.3, 0.3, 1.0);
        for i in 0..puffs.length {
            var f = puffs[i];
            let e = puff_pool[i];
            f.age += dt;
            if f.age >= f.life {
                World.set_active(e, false);
                puffs[i] = f;
                continue;
            }
            // Slows as it climbs, and the wind takes more of it.
            f.vy = max(0.12, f.vy - dt * 0.12);
            f.vx += (sin(Time.elapsed * 0.9 + f.seed * 5.0) * 0.08 - shown.wind * 0.18) * dt;
            f.vz += shown.wind * 0.08 * dt;
            f.x += f.vx * dt;
            f.y += f.vy * dt;
            f.z += f.vz * dt;
            puffs[i] = f;
            let k = f.age / f.life;
            let size = 0.07 + k * 0.45;
            // Thin as it leaves the chimney, so the roof shows through.
            let a = 0.22 * min(1.0, k * 3.0) * (1.0 - k) * (1.0 - shown.rain * 0.5);
            World.set_active(e, true);
            e.transform.position = Vec3(f.x, f.y, f.z);
            e.transform.scale = Vec3(size, size, size);
            let grey = 0.62 * shade;
            e.sprite.tint = Color(grey, grey, grey * 1.04, a);
        }
    }

    // A puff of smoke at the top of house `i`'s chimney.
    fn smoke_from(i: number) -> Fleck {
        // The chimney stands at the back corner, above the light inside.
        let w = window_at[i];
        let r = roll();
        return Fleck(x: w.x - 0.22 + (r - 0.5) * 0.04, y: w.y + 0.85, z: w.z + 0.2,
            vx: (r - 0.5) * 0.06, vy: 0.42 + r * 0.12, vz: 0.0,
            age: 0.0, life: 2.6 + r * 1.2, seed: r * 10.0, ember: false);
    }

    // Motes rise from an open rift, turning about it, the violet of its light.
    fn rise_from_rifts(dt: number) {
        next_mote -= dt;
        if next_mote <= 0.0 {
            next_mote = 0.14;
            for i in 0..rift_level.length {
                if !rift_wanted[i] || rift_level[i] < 0.3 { continue; }
                let c = rift_at[i];
                let r1 = roll();
                let r2 = roll();
                let angle = r1 * 6.283;
                launch_mote(Fleck(
                    x: c.x + cos(angle) * 0.32, y: c.y - 0.35, z: c.z + sin(angle) * 0.32,
                    vx: 0.0, vy: 0.35 + r2 * 0.3, vz: 0.0,
                    age: 0.0, life: 1.4 + r2 * 0.8, seed: angle, ember: false));
            }
        }
        for i in 0..motes.length {
            var f = motes[i];
            let e = mote_pool[i];
            f.age += dt;
            if f.age >= f.life {
                World.set_active(e, false);
                motes[i] = f;
                continue;
            }
            // Round the rift's middle as they climb.
            f.seed += dt * 1.6;
            f.x += -sin(f.seed) * 0.25 * dt;
            f.z += cos(f.seed) * 0.25 * dt;
            f.y += f.vy * dt;
            motes[i] = f;
            let k = f.age / f.life;
            let size = 0.1 * (1.0 - k * 0.5);
            let a = min(1.0, k * 6.0) * (1.0 - k);
            World.set_active(e, true);
            e.transform.position = Vec3(f.x, f.y, f.z);
            e.transform.scale = Vec3(size, size, size);
            e.sprite.tint = Color(0.8, 0.55, 1.0, a);
        }
    }

    // Each puts `f` in the first spent slot, if there is one.
    fn launch_puff(f: Fleck) {
        for i in 0..puffs.length {
            if puffs[i].age >= puffs[i].life {
                puffs[i] = f;
                return;
            }
        }
    }

    fn launch_mote(f: Fleck) {
        for i in 0..motes.length {
            if motes[i].age >= motes[i].life {
                motes[i] = f;
                return;
            }
        }
    }

    // --- Weather ---------------------------------------------------------------

    // Lightning, as often as the storm says: the sky flashes once, flickers
    // and fades, and the thunder follows a moment later, nearer or further.
    fn storm(dt: number) {
        since_strike += dt;
        if shown.storm > 0.05 {
            next_strike -= dt * shown.storm;
            if next_strike <= 0.0 {
                since_strike = 0.0;
                next_strike = 5.0 + roll() * 9.0;
                thunder_in = 0.5 + roll() * 1.4;
                thunder_volume = 0.55 - thunder_in * 0.15;
            }
        }
        if thunder_in >= 0.0 {
            thunder_in -= dt;
            if thunder_in < 0.0 { Audio.play("audio/thunder.wav", thunder_volume * shown.storm); }
        }
        // A bright stroke, a dip, a second fainter one, then gone.
        let s = since_strike;
        var lit = 0.0;
        if s < 0.08 {
            lit = 1.0;
        } else if s < 0.16 {
            lit = 0.25;
        } else if s < 0.24 {
            lit = 0.7;
        } else {
            lit = 0.7 * max(0.0, 1.0 - (s - 0.24) / 0.5);
        }
        let was = flash;
        flash = lit * min(1.0, shown.storm * 1.5);
        // The light is set every frame while a strike shows, and once more
        // when it has gone, so it settles back to the mood exactly.
        if settled && (flash > 0.0 || was > 0.0) { apply(shown); }
    }

    // Rain, as heavy as the mood says, driven by the wind. A lighter rain
    // lets streaks run out rather than switching them off, so it thins.
    fn rain(dt: number) {
        let wanted = floor(shown.rain * rain_max + 0.5);
        for i in 0..drops.length {
            var d = drops[i];
            let e = rain_pool[i];
            d.age += dt;
            if d.age >= d.life {
                if i >= wanted {
                    World.set_active(e, false);
                    drops[i] = d;
                    continue;
                }
                let r1 = roll();
                let r2 = roll();
                let r3 = roll();
                // Upwind of the island, so the slant carries it over.
                d = Fleck(x: 18.0 + r1 * 20.0 + shown.wind * 0.6, y: 8.0 + r3 * 3.0, z: 18.0 + r2 * 20.0,
                    vx: -shown.wind * 1.2, vy: -12.0 - r3 * 3.0, vz: shown.wind * 0.5,
                    age: 0.0, life: 0.55 + r3 * 0.25, seed: r1, ember: false);
            }
            d.x += d.vx * dt;
            d.y += d.vy * dt;
            d.z += d.vz * dt;
            drops[i] = d;
            if d.y < -0.2 {
                World.set_active(e, false);
                continue;
            }
            World.set_active(e, true);
            e.transform.position = Vec3(d.x, d.y, d.z);
            // A streak, longer the harder it falls.
            e.transform.scale = Vec3(0.028, 0.32 + shown.rain * 0.2, 0.028);
            let k = d.age / max(d.life, 0.01);
            let a = (0.22 + 0.2 * shown.rain + flash * 0.4) * min(1.0, k * 6.0);
            e.sprite.tint = Color(0.78 + flash * 0.2, 0.85 + flash * 0.15, 0.95, a);
        }
    }
}
