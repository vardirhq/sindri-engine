// The battle director: the one script that holds a battle and shows it.
//
// The rules live in `rules.decay` and never touch the world. This script owns
// the `Board` they act on, turns what the player points at into calls on it,
// and plays back the beats each call leaves so that every change is seen to
// happen: a hop per cell walked, a flash per hit, a splash per Hollow the sea
// takes. While beats play the board is already in its new state; the pictures
// are catching up with it.
//
// Between battles it carries the run: which island, what the Hearth has left,
// and what each warden has earned.

// Where cell (0, 0) of the board is in the world. The island models are
// built round the same point, by `tools/causeway_art.py`.
shared const ORIGIN_X: number = 24.0;
shared const ORIGIN_Z: number = 24.0;
// The island behind the title: the Lighthouse at dusk.
shared const TITLE_ISLAND: number = 3.0;
// The most lanterns the HUD has for the Hearth.
const MOST_HEARTH: number = 12.0;

enum Phase { Title, Muster, Arriving, Resolving, Player, Won, Upgrade, Route, Lost, Crossed }
// What happens once the beats being played have all been shown.
enum After { Plan, Mark, Player, HollowDone, Nothing }
enum Mode { Move, Aim }

script Battle {
    @export let bulwark: Prefab;
    @export let mason: Prefab;
    @export let lamplighter: Prefab;
    @export let husk: Prefab;
    @export let brute: Prefab;
    @export let spitter: Prefab;
    @export let mortar: Prefab;
    @export let colossus: Prefab;
    @export let tidecaller: Prefab;
    @export let harpooner: Prefab;
    @export let shieldback: Prefab;
    @export let imp: Prefab;
    @export let burster: Prefab;
    @export let kiln: Prefab;
    @export let hailer: Prefab;
    @export let rimeback: Prefab;
    @export let house: Prefab;
    @export let beacon: Prefab;
    @export let stone: Prefab;
    @export let vent: Prefab;
    @export let basalt: Prefab;
    @export let water_pool: Prefab;
    @export let lava_pool: Prefab;
    @export let ice_pool: Prefab;
    @export let droplet: Prefab;
    @export let pointer: Prefab;
    @export let mark: Prefab;
    @export let label: Prefab;
    @export let popup: Prefab;
    @export let missile: Prefab;
    @export let spark: Prefab;
    // Seconds a beat of each kind is given before the next begins.
    @export let step_seconds: number = 0.13;
    @export let starting_hearth: number = 7.0;

    var phase: Phase = Phase.Title;
    var after: After = After.Nothing;
    var sea: Entity = null;
    var cursor: Entity = null;
    var islands: List<Entity> = [];
    var lantern: Entity = null;
    var house_lights: List<Entity> = [];
    var rift_lights: List<Entity> = [];
    var fire: Entity = null;

    // The run.
    var island: number = 0.0;
    // The heroes being mustered, by their place in the muster, in the order
    // they were taken.
    var chosen: List<number> = [0.0, 1.0, 2.0];
    // The islands taken so far, one a step, and the islands the road forks
    // to next.
    var path: List<number> = [];
    var roads: List<number> = [];
    // The world the last island was in, so a new world can be met.
    var last_world: number = -1.0;
    // The omen over each island this crossing, and how many boons are still
    // to be chosen before going on.
    var omens: List<number> = [];
    var boons_left: number = 0.0;
    // Spring tides: the harder crossing, opened by making one.
    var spring: bool = false;
    // What this crossing opened for the next, said on its last screen.
    var opened: String = "";
    // Each island's bonus objective this crossing, and how the one in play is
    // going: what it has counted, whether it has failed, and the Hearth it
    // began with. Kept as they stood at the start of the turn too, for a
    // rewind.
    var objectives: List<number> = [];
    var obj_count: number = 0.0;
    var obj_failed: bool = false;
    var obj_hearth: number = 0.0;
    var turn_obj_count: number = 0.0;
    var turn_obj_failed: bool = false;
    // What the run has earned between islands.
    var max_hearth: number = 7.0;
    var extra_rewinds: number = 0.0;
    var offered: List<number> = [0.0, 1.0, 2.0, 3.0];
    // Crossing to an island: the last one sinking, the next rising out of the
    // sea and its people rising onto it, before the Hollow come.
    var shown_island: number = -1.0;
    var leaving_island: number = -1.0;
    var arrival_clock: number = 0.0;
    var arrival_tide: number = 0.0;
    var risen: bool = false;
    var sunk: List<Entity> = [];
    var hearth: number = 7.0;
    var wardens: List<Warden> = [];
    // Who joined on this island, named on its banner.
    var recruited: String = "";
    var rewinds: number = 1.0;

    // The battle.
    var def: IslandDef = island_def(0.0);
    var board: Board = board_of(island_def(0.0), [], 0.0);
    var turn_start: Board = board_of(island_def(0.0), [], 0.0);
    var landing: List<number> = [];

    // What the board looks like.
    var pieces: Map<number, Entity> = [:];
    var pips: Map<number, Entity> = [:];
    var badges: Map<number, Entity> = [:];
    var plan_marks: List<Entity> = [];
    // How visible each mark is and is heading to: the plan's 64, then the
    // threats' 64.
    var mark_alpha: List<number> = [];
    var mark_wanted: List<number> = [];
    var cursor_at: Vec3 = Vec3(0.0, 0.0, 0.0);
    var threat_marks: List<Entity> = [];
    var popups: List<Entity> = [];
    var next_popup: number = 0.0;
    var missiles: List<Entity> = [];
    var next_missile: number = 0.0;
    var sparks: List<Entity> = [];
    var next_spark: number = 0.0;
    var droplets: List<Entity> = [];
    var next_droplet: number = 0.0;
    // What lies on the board besides its figures: a pool on a cell, by cell,
    // and the columns of new ground cooled out of lava and water. `base` is
    // the island's own heights, which a column stands above.
    var water_tiles: Map<number, Entity> = [:];
    var lava_tiles: Map<number, Entity> = [:];
    var ice_tiles: Map<number, Entity> = [:];
    var columns: Map<number, Entity> = [:];
    var base: List<number> = [];
    // The gem over the warden in hand.
    var marker: Entity = null;
    var marker_at: Vec3 = Vec3(0.0, 0.0, 0.0);
    var marker_shown: number = 0.0;
    var shown_tide: number = 0.0;
    var tide_tween = Timer(0.0);
    var tide_from: number = 0.0;

    // Playing beats back.
    var queue: List<Beat> = [];
    var beat_index: number = 0.0;
    var wait = Timer(0.0);

    // The player's hand.
    var selected: number = -1.0;
    var mode: Mode = Mode.Move;
    var cursor_x: number = 3.0;
    var cursor_z: number = 3.0;
    var hover_cell: number = -1.0;
    var preview_cell: number = -2.0;
    var banner_age: number = 0.0;
    var banner_title: String = "";
    var banner_text: String = "";

    var view_drag_start: Vec2 = Vec2(0.0, 0.0);
    var view_drag_used: bool = false;
    var view_pointer_blocked: bool = false;

    fn start() {
        sea = World.find("Sea");
        cursor = World.find("Cursor");
        lantern = World.find("Lantern Light");
        fire = World.find("Beacon Light");
        for i in 0..3 { house_lights.push(World.find("House Light " + i)); }
        for i in 0..2 { rift_lights.push(World.find("Rift Light " + i)); }
        for i in 0..ISLAND_COUNT {
            islands.push(World.find("Island " + i));
        }
        for c in 0..(SIZE * SIZE) {
            let plan = World.spawn(this.mark);
            plan_marks.push(plan);
            let threat = World.spawn(this.mark);
            threat_marks.push(threat);
            World.set_active(plan, false);
            World.set_active(threat, false);
        }
        for i in 0..(SIZE * SIZE * 2.0) {
            mark_alpha.push(0.0);
            mark_wanted.push(0.0);
        }
        for i in 0..10 {
            let p = World.spawn(this.popup);
            World.set_active(p, false);
            popups.push(p);
        }
        for i in 0..4 {
            let m = World.spawn(this.missile);
            World.set_active(m, false);
            missiles.push(m);
        }
        for i in 0..6 {
            let k = World.spawn(this.spark);
            World.set_active(k, false);
            sparks.push(k);
        }
        for i in 0..3 {
            let d = World.spawn(this.droplet);
            World.set_active(d, false);
            droplets.push(d);
        }
        marker = World.spawn(this.pointer);
        World.set_active(marker, false);
        hearth = starting_hearth;
        show_title();
    }

    // --- Where things are ---------------------------------------------------

    fn world_x(x: number) -> number { return ORIGIN_X + x + 0.5; }
    fn world_z(z: number) -> number { return ORIGIN_Z + z + 0.5; }
    fn ground_y(x: number, z: number) -> number {
        if !in_bounds(x, z) { return shown_tide; }
        return max(height_at(board, x, z), shown_tide);
    }
    fn spot(x: number, z: number) -> Vec3 {
        return Vec3(world_x(x), ground_y(x, z), world_z(z));
    }

    // --- The island --------------------------------------------------------

    // Shows the island being played, and only that one.
    fn show_island() {
        for i in 0..islands.length {
            if islands[i] != null {
                World.set_active(islands[i], i == island);
                islands[i].transform.position.y = 0.0;
            }
        }
        shown_island = island;
    }

    fn floor_of(c: number) -> number { return floor(c / SIZE); }

    // --- Pieces --------------------------------------------------------------

    fn prefab_of(kind: Kind) -> Prefab {
        return match kind {
            Kind.Bulwark => this.bulwark,
            Kind.Mason => this.mason,
            Kind.Lamplighter => this.lamplighter,
            Kind.Husk => this.husk,
            Kind.Brute => this.brute,
            Kind.Spitter => this.spitter,
            Kind.Mortar => this.mortar,
            Kind.Colossus => this.colossus,
            Kind.Tidecaller => this.tidecaller,
            Kind.Harpooner => this.harpooner,
            Kind.Shieldback => this.shieldback,
            Kind.Imp => this.imp,
            Kind.Burster => this.burster,
            Kind.Kiln => this.kiln,
            Kind.Hailer => this.hailer,
            Kind.Rimeback => this.rimeback,
            Kind.House => this.house,
            Kind.Beacon => this.beacon,
            Kind.Stone => this.stone,
            Kind.Vent => this.vent,
        };
    }

    fn piece_of(id: number) -> Entity {
        if pieces.contains(id) { return pieces[id]; }
        return null;
    }

    fn spawn_piece(unit: Unit) -> Entity {
        let piece = World.spawn(prefab_of(unit.kind));
        let at = spot(unit.x, unit.z);
        Piece.on(piece).place(at.x, at.y, at.z);
        pieces[unit.id] = piece;
        if !is_fixed(unit.kind) || is_building(unit.kind) || is_giant(unit.kind) || unit.kind == Kind.Kiln {
            let pip = World.spawn(this.label);
            pips[unit.id] = pip;
        }
        if is_hollow(unit.kind) {
            let badge = World.spawn(this.label);
            badges[unit.id] = badge;
        }
        if is_hollow(unit.kind) {
            Piece.on(piece).face_now(3.0);
        } else {
            Piece.on(piece).face_now(1.0);
        }
        return piece;
    }

    fn remove_piece(id: number) {
        if pieces.contains(id) {
            World.despawn(pieces[id]);
            pieces.remove(id);
        }
        if pips.contains(id) {
            World.despawn(pips[id]);
            pips.remove(id);
        }
        if badges.contains(id) {
            World.despawn(badges[id]);
            badges.remove(id);
        }
    }

    fn clear_pieces() {
        for id in pieces.keys() {
            remove_piece(id);
        }
    }

    // Makes every piece agree with the board: the fallen gone, the living
    // where they stand, and their health and order shown.
    fn sync_pieces() {
        var living: List<number> = [];
        for unit in board.units {
            if unit.hp <= 0.0 { continue; }
            living.push(unit.id);
            var piece = piece_of(unit.id);
            if piece == null {
                piece = spawn_piece(unit);
            }
            let at = spot(unit.x, unit.z);
            let p = piece.transform.position;
            if abs(p.x - at.x) + abs(p.y - at.y) + abs(p.z - at.z) > 0.01 {
                Piece.on(piece).place(at.x, at.y, at.z);
            }
            if is_hollow(unit.kind) && unit.dir >= 0.0 {
                Piece.on(piece).face(unit.dir);
            }
        }
        for id in pieces.keys() {
            if !living.contains(id) {
                remove_piece(id);
            }
        }
        refresh_labels();
        sync_ground();
    }

    // --- Pools and new ground -----------------------------------------------

    // Makes the pools and the cooled ground agree with the board.
    fn sync_ground() {
        for c in 0..(SIZE * SIZE) {
            show_pool(c, board.pools[c]);
            show_column(c, board.heights[c]);
        }
    }

    // Shows what pool lies on cell `c`, and takes away one that does not.
    fn show_pool(c: number, pool: number) {
        let x = c % SIZE;
        let z = floor_of(c);
        var wanted = pool;
        if under_level(board, x, z) { wanted = DRY; }
        let at = Vec3(world_x(x), height_at(board, x, z) + 0.035, world_z(z));
        if wanted == WATER {
            if !water_tiles.contains(c) { water_tiles[c] = World.spawn(this.water_pool); }
            water_tiles[c].transform.position = at;
        } else if water_tiles.contains(c) {
            World.despawn(water_tiles[c]);
            water_tiles.remove(c);
        }
        if wanted == LAVA {
            if !lava_tiles.contains(c) { lava_tiles[c] = World.spawn(this.lava_pool); }
            lava_tiles[c].transform.position = at;
        } else if lava_tiles.contains(c) {
            World.despawn(lava_tiles[c]);
            lava_tiles.remove(c);
        }
        if wanted == ICE {
            if !ice_tiles.contains(c) { ice_tiles[c] = World.spawn(this.ice_pool); }
            ice_tiles[c].transform.position = Vec3(at.x, at.y - 0.03, at.z);
        } else if ice_tiles.contains(c) {
            World.despawn(ice_tiles[c]);
            ice_tiles.remove(c);
        }
    }

    // A column of new ground under a cell raised above the island's own,
    // stretched from below the level to the cell's top.
    fn show_column(c: number, height: number) {
        if c >= base.length { return; }
        if height <= base[c] {
            if columns.contains(c) {
                World.despawn(columns[c]);
                columns.remove(c);
            }
            return;
        }
        var fresh = false;
        if !columns.contains(c) {
            columns[c] = World.spawn(this.basalt);
            fresh = true;
        }
        let column = columns[c];
        column.transform.scale = Vec3(1.0, height + 1.0, 1.0);
        Piece.on(column).place(world_x(c % SIZE), -1.0, world_z(floor_of(c)));
        if fresh { Piece.on(column).rise(0.45); }
    }

    // Everything on the board that is not a figure goes, for a new island.
    fn clear_ground() {
        for c in water_tiles.keys() { World.despawn(water_tiles[c]); }
        for c in lava_tiles.keys() { World.despawn(lava_tiles[c]); }
        for c in ice_tiles.keys() { World.despawn(ice_tiles[c]); }
        for c in columns.keys() { World.despawn(columns[c]); }
        water_tiles = [:];
        lava_tiles = [:];
        ice_tiles = [:];
        columns = [:];
    }

    fn pip_text(unit: Unit) -> String {
        var text = "";
        // A ward shows as a pale shield before the health it guards.
        if unit.ward > 0.0 { text += "[color=#9fe6ff]◇[/color] "; }
        text += "[color=#ffd76a]";
        for i in 0..unit.hp { text += "◆"; }
        text += "[/color][color=#40343a]";
        for i in unit.hp..unit.max_hp { text += "◆"; }
        return text + "[/color]";
    }

    // Health over every piece that has some, and the order each Hollow
    // strikes in.
    fn refresh_labels() {
        for unit in board.units {
            if unit.hp <= 0.0 { continue; }
            let piece = piece_of(unit.id);
            if piece == null { continue; }
            let p = piece.transform.position;
            if pips.contains(unit.id) {
                let pip = pips[unit.id];
                Ui.set_text(pip, pip_text(unit));
                pip.transform.position = Vec3(p.x, p.y + label_height(unit.kind), p.z);
            }
            if badges.contains(unit.id) {
                let badge = badges[unit.id];
                if unit.dir >= 0.0 {
                    Ui.set_text(badge, "[color=#ff8a6a]" + unit.order + "[/color]");
                } else {
                    Ui.set_text(badge, "");
                }
                badge.transform.position = Vec3(p.x - 0.36, p.y + label_height(unit.kind) - 0.05, p.z + 0.36);
            }
        }
    }

    fn label_height(kind: Kind) -> number {
        return match kind {
            Kind.Colossus => 2.5,
            Kind.Kiln => 2.4,
            Kind.Rimeback => 2.0,
            Kind.Beacon => 2.3,
            Kind.House => 1.55,
            Kind.Brute => 1.5,
            _ => 1.25,
        };
    }

    // Keeps the labels over pieces that are moving.
    fn follow_labels() {
        for id in pips.keys() {
            let piece = piece_of(id);
            let index = unit_index(board, id);
            if piece == null || index < 0.0 { continue; }
            let p = piece.transform.position;
            let pip = pips[id];
            pip.transform.position = Vec3(p.x, p.y + label_height(board.units[index].kind), p.z);
        }
        for id in badges.keys() {
            let piece = piece_of(id);
            let index = unit_index(board, id);
            if piece == null || index < 0.0 { continue; }
            let p = piece.transform.position;
            let badge = badges[id];
            badge.transform.position = Vec3(p.x - 0.36, p.y + label_height(board.units[index].kind) - 0.05, p.z + 0.36);
        }
    }

    // --- Marks on the ground -----------------------------------------------

    fn set_mark(marks: List<Entity>, c: number, clip: String) {
        let m = marks[c];
        // Which layer this is, by its first mark: comparing whole lists of
        // entities never matched, so threats used to share the plan's slots.
        let threat = marks[0] == threat_marks[0];
        var slot = c;
        if threat { slot = c + SIZE * SIZE; }
        if clip == "" {
            // Faded out by `fade_marks`, which switches it off once it is gone.
            mark_wanted[slot] = 0.0;
            return;
        }
        if !World.is_active(m) {
            World.set_active(m, true);
            mark_alpha[slot] = 0.0;
            m.sprite.tint.a = 0.0;
        }
        mark_wanted[slot] = 1.0;
        let x = c % SIZE;
        let z = floor_of(c);
        var lift = 0.03;
        if threat { lift = 0.05; }
        m.transform.position = Vec3(world_x(x), ground_y(x, z) + lift, world_z(z));
        Animation.play(m, clip);
    }

    // Marks come and go over a few frames rather than in one.
    fn fade_marks(dt: number) {
        for slot in 0..mark_wanted.length {
            let wanted = mark_wanted[slot];
            var alpha = mark_alpha[slot];
            if alpha == wanted { continue; }
            var m = plan_marks[0];
            if slot < SIZE * SIZE {
                m = plan_marks[slot];
            } else {
                m = threat_marks[slot - SIZE * SIZE];
            }
            if alpha < wanted {
                alpha = min(wanted, alpha + dt * 7.0);
            } else {
                alpha = max(wanted, alpha - dt * 7.0);
            }
            mark_alpha[slot] = alpha;
            m.sprite.tint.a = alpha;
            if alpha <= 0.0 { World.set_active(m, false); }
        }
    }

    // The Hollow's intents, the cells they will climb out on, and the cells
    // the tide is about to cover, read from `shown` -- the real board, or a
    // preview of what the player is about to do to it.
    fn show_threats(shown: Board) {
        var clips: List<String> = [];
        for c in 0..(SIZE * SIZE) {
            var clip = "";
            let x = c % SIZE;
            let z = floor_of(c);
            if floods_next(shown, x, z) && !is_wet(shown, x, z) { clip = "tide"; }
            clips.push(clip);
        }
        for s in shown.spawns {
            clips[cell_of(s.x, s.z)] = "spawn";
        }
        for unit in shown.units {
            if unit.hp <= 0.0 || !is_threat(unit.kind) || unit.dir < 0.0 { continue; }
            for c in strike_cells(shown, unit.kind, unit.x, unit.z, unit.dir, unit.reach, unit.id) {
                clips[c] = "danger";
            }
        }
        for c in 0..(SIZE * SIZE) {
            set_mark(threat_marks, c, clips[c]);
        }
    }

    fn clear_plan() {
        for c in 0..(SIZE * SIZE) {
            set_mark(plan_marks, c, "");
        }
    }

    // What the selected warden can do, drawn on the ground.
    fn show_plan() {
        clear_plan();
        if selected < 0.0 { return; }
        let index = unit_index(board, selected);
        if index < 0.0 { return; }
        let unit = board.units[index];
        if mode == Mode.Move && !unit.moved {
            for c in reachable(board, index) {
                set_mark(plan_marks, c, "move");
            }
        }
        if mode == Mode.Aim && !unit.acted {
            for c in skill_targets(board, index) {
                set_mark(plan_marks, c, "aim");
            }
        }
        set_mark(plan_marks, cell_of(unit.x, unit.z), "selected");
    }

    // --- Popups and missiles -------------------------------------------------

    fn pop(x: number, y: number, z: number, text: String) {
        let p = popups[next_popup];
        next_popup = (next_popup + 1.0) % popups.length;
        World.set_active(p, true);
        Popup.on(p).show(x, y, z, text);
    }

    fn burst(at: Vec3) {
        let k = sparks[next_spark];
        next_spark = (next_spark + 1.0) % sparks.length;
        World.set_active(k, true);
        Spark.on(k).show(at);
    }

    fn fly(from: Vec3, to: Vec3, seconds: number, arc: number) {
        let m = missiles[next_missile];
        next_missile = (next_missile + 1.0) % missiles.length;
        World.set_active(m, true);
        Missile.on(m).launch(from, to, seconds, arc);
    }

    // The Tidecaller's water, thrown.
    fn splash(from: Vec3, to: Vec3, seconds: number, arc: number) {
        let d = droplets[next_droplet];
        next_droplet = (next_droplet + 1.0) % droplets.length;
        World.set_active(d, true);
        Missile.on(d).launch(from, to, seconds, arc);
    }

    fn air() -> Atmosphere {
        return Atmosphere.on(World.find("Environment"));
    }

    // --- Playing beats ----------------------------------------------------------

    fn play(next: Board, then: After) {
        tally(next);
        queue = next.beats;
        board = next;
        board.beats.clear();
        beat_index = 0.0;
        wait = Timer(0.0);
        after = then;
        phase = Phase.Resolving;
        clear_plan();
    }

    fn shake(amount: number) {
        Camera.impact(amount);
    }

    fn show_beat(beat: Beat) -> number {
        let piece = piece_of(beat.unit);
        match beat.kind {
            BeatKind.Walk => {
                if piece != null {
                    let at = spot(beat.x, beat.z);
                    Piece.on(piece).hop(at.x, at.y, at.z, step_seconds);
                }
                Audio.play("audio/step.wav", 0.35);
                return step_seconds;
            }
            BeatKind.Strike => {
                if piece != null {
                    Piece.on(piece).lunge(dir_towards(beat.x, beat.z, beat.tx, beat.tz), 0.26);
                }
                Audio.play("audio/swing.wav", 0.55);
                return 0.16;
            }
            BeatKind.Bolt => {
                let distance = steps_between(beat.x, beat.z, beat.tx, beat.tz);
                let seconds = 0.05 + distance * 0.035;
                if piece != null {
                    Piece.on(piece).lunge(dir_towards(beat.x, beat.z, beat.tx, beat.tz), 0.22);
                }
                fly(spot(beat.x, beat.z) + Vec3(0.0, 0.6, 0.0), spot(beat.tx, beat.tz) + Vec3(0.0, 0.5, 0.0), seconds, 0.0);
                Audio.play("audio/bolt.wav", 0.5);
                return seconds;
            }
            BeatKind.Lob => {
                if piece != null {
                    Piece.on(piece).lunge(dir_towards(beat.x, beat.z, beat.tx, beat.tz), 0.3);
                }
                fly(spot(beat.x, beat.z) + Vec3(0.0, 0.7, 0.0), spot(beat.tx, beat.tz) + Vec3(0.0, 0.3, 0.0), 0.5, 2.2);
                Audio.play("audio/heave.wav", 0.5);
                return 0.5;
            }
            BeatKind.Hit => {
                if piece != null {
                    Piece.on(piece).hit();
                    let p = piece.transform.position;
                    pop(p.x, p.y + 1.3, p.z, "[color=#ffcf5a]-" + beat.amount + "[/color]");
                    burst(Vec3(p.x, p.y + 0.55, p.z));
                }
                refresh_hit(beat.unit, beat.amount);
                shake(0.25 + beat.amount * 0.15);
                Audio.play("audio/hit.wav", 0.7);
                return 0.16;
            }
            BeatKind.Push => {
                if piece != null {
                    var at = spot(beat.tx, beat.tz);
                    if !in_bounds(beat.tx, beat.tz) {
                        at = Vec3(world_x(beat.tx), shown_tide, world_z(beat.tz));
                    }
                    Piece.on(piece).slide(at.x, at.y, at.z, 0.16);
                }
                Audio.play("audio/shove.wav", 0.5);
                return 0.17;
            }
            BeatKind.Bump => {
                if piece != null {
                    Piece.on(piece).nudge(dir_towards(beat.x, beat.z, beat.tx, beat.tz), 0.2);
                }
                shake(0.35);
                Audio.play("audio/bump.wav", 0.6);
                return 0.14;
            }
            BeatKind.Fall => {
                shake(0.3);
                Audio.play("audio/bump.wav", 0.45);
                return 0.08;
            }
            BeatKind.Drown => {
                if piece != null {
                    Piece.on(piece).sink(0.6);
                    let p = piece.transform.position;
                    pop(p.x, p.y + 0.6, p.z, "[color=#8fd3ff]drowned[/color]");
                }
                hide_labels(beat.unit);
                Audio.play("audio/splash.wav", 0.7);
                return 0.4;
            }
            BeatKind.Die => {
                if piece != null {
                    Piece.on(piece).crumble(0.45);
                }
                hide_labels(beat.unit);
                shake(0.4);
                Audio.play("audio/crumble.wav", 0.6);
                return 0.3;
            }
            BeatKind.Emerge => {
                let index = unit_index(board, beat.unit);
                if index >= 0.0 {
                    let fresh = spawn_piece(board.units[index]);
                    Piece.on(fresh).rise(0.4);
                    refresh_labels();
                }
                Audio.play("audio/emerge.wav", 0.5);
                return 0.3;
            }
            BeatKind.Smother => {
                let at = spot(beat.x, beat.z);
                pop(at.x, at.y + 0.9, at.z, "[color=#c9a0ff]blocked[/color]");
                return 0.12;
            }
            BeatKind.Raise => {
                let index = unit_index(board, beat.unit);
                if index >= 0.0 {
                    let fresh = spawn_piece(board.units[index]);
                    Piece.on(fresh).rise(0.25);
                }
                shake(0.3);
                Audio.play("audio/crumble.wav", 0.5);
                return 0.2;
            }
            BeatKind.Tide => {
                tide_from = shown_tide;
                tide_tween = Timer(1.4);
                if board.molten {
                    banner("The lava rises", "Anything low is under fire. Only what the mountain made stands in it.");
                    Audio.play("audio/erupt.wav", 0.6);
                } else {
                    banner("The tide rises", "Anything low is under water. Hollow in the sea are gone.");
                    Audio.play("audio/tide.wav", 0.7);
                }
                return 1.5;
            }
            BeatKind.Burn => {
                if piece != null {
                    Piece.on(piece).sink(0.6);
                    let p = piece.transform.position;
                    pop(p.x, p.y + 0.6, p.z, "[color=#ffa04a]burned[/color]");
                    burst(Vec3(p.x, p.y + 0.3, p.z));
                }
                hide_labels(beat.unit);
                Audio.play("audio/sizzle.wav", 0.7);
                return 0.4;
            }
            BeatKind.Scorch => {
                if piece != null {
                    let p = piece.transform.position;
                    pop(p.x, p.y + 1.6, p.z, "[color=#ff8a4a]scorched[/color]");
                }
                Audio.play("audio/sizzle.wav", 0.4);
                return 0.1;
            }
            BeatKind.Erupt => {
                if piece != null { Piece.on(piece).hit(); }
                fly(spot(beat.x, beat.z) + Vec3(0.0, 0.6, 0.0), spot(beat.tx, beat.tz) + Vec3(0.0, 0.2, 0.0), 0.55, 2.8);
                shake(0.5);
                Audio.play("audio/erupt.wav", 0.8);
                return 0.55;
            }
            BeatKind.Pool => {
                show_pool(cell_of(beat.x, beat.z), beat.amount);
                if beat.amount == WATER { Audio.play("audio/splash.wav", 0.4); }
                return 0.08;
            }
            BeatKind.Quench => {
                let lava = spot(beat.x, beat.z);
                let water = spot(beat.tx, beat.tz);
                air().steam(lava);
                air().steam(water);
                Audio.play("audio/sizzle.wav", 0.6);
                return 0.18;
            }
            BeatKind.Basalt => {
                show_column(cell_of(beat.x, beat.z), beat.amount);
                show_pool(cell_of(beat.x, beat.z), DRY);
                let at = Vec3(world_x(beat.x), beat.amount, world_z(beat.z));
                pop(at.x, at.y + 0.5, at.z, "[color=#d8c8ff]new ground[/color]");
                shake(0.25);
                Audio.play("audio/crumble.wav", 0.5);
                return 0.35;
            }
            BeatKind.Steam => {
                let at = spot(beat.x, beat.z);
                air().steam(at);
                pop(at.x, at.y + 0.9, at.z, "[color=#cfefff]hiss[/color]");
                Audio.play("audio/sizzle.wav", 0.5);
                return 0.14;
            }
            BeatKind.Burst => {
                let at = spot(beat.x, beat.z);
                burst(at + Vec3(0.0, 0.4, 0.0));
                shake(0.6);
                Audio.play("audio/erupt.wav", 0.6);
                return 0.22;
            }
            BeatKind.Douse => {
                if piece != null {
                    Piece.on(piece).lunge(dir_towards(beat.x, beat.z, beat.tx, beat.tz), 0.26);
                }
                splash(spot(beat.x, beat.z) + Vec3(0.0, 0.7, 0.0), spot(beat.tx, beat.tz) + Vec3(0.0, 0.2, 0.0), 0.36, 1.3);
                Audio.play("audio/splash.wav", 0.55);
                return 0.36;
            }
            BeatKind.Harpoon => {
                let distance = steps_between(beat.x, beat.z, beat.tx, beat.tz);
                let seconds = 0.08 + distance * 0.04;
                if piece != null {
                    Piece.on(piece).lunge(dir_towards(beat.x, beat.z, beat.tx, beat.tz), 0.3);
                }
                fly(spot(beat.x, beat.z) + Vec3(0.0, 0.75, 0.0), spot(beat.tx, beat.tz) + Vec3(0.0, 0.55, 0.0), seconds, 0.3);
                Audio.play("audio/swing.wav", 0.6);
                return seconds;
            }
            BeatKind.Ward => {
                if piece != null {
                    let p = piece.transform.position;
                    pop(p.x, p.y + 1.5, p.z, "[color=#9fe6ff]warded[/color]");
                }
                let index = unit_index(board, beat.unit);
                if index >= 0.0 && pips.contains(beat.unit) {
                    Ui.set_text(pips[beat.unit], pip_text(board.units[index]));
                }
                Audio.play("audio/boon.wav", 0.35);
                return 0.22;
            }
            BeatKind.Block => {
                if piece != null {
                    Piece.on(piece).nudge(1.0, 0.1);
                    let p = piece.transform.position;
                    pop(p.x, p.y + 1.4, p.z, "[color=#9fe6ff]blocked[/color]");
                    burst(Vec3(p.x, p.y + 0.7, p.z));
                }
                refresh_hit(beat.unit, 0.0);
                shake(0.2);
                Audio.play("audio/bump.wav", 0.7);
                return 0.2;
            }
            BeatKind.Miss => {
                let at = spot(beat.x, beat.z);
                pop(at.x, at.y + 0.6, at.z, "[color=#c7c7c7]miss[/color]");
                return 0.1;
            }
        }
    }

    fn hide_labels(id: number) {
        if pips.contains(id) { Ui.set_text(pips[id], ""); }
        if badges.contains(id) { Ui.set_text(badges[id], ""); }
    }

    // A hit's pips change as the hit lands, not when the turn is over.
    fn refresh_hit(id: number, amount: number) {
        if !pips.contains(id) { return; }
        let index = unit_index(board, id);
        if index < 0.0 { return; }
        var shown = board.units[index];
        Ui.set_text(pips[id], pip_text(shown));
    }

    fn advance_beats() {
        follow_labels();
        if !wait.done { return; }
        if beat_index < queue.length {
            let beat = queue[beat_index];
            beat_index += 1.0;
            wait = Timer(show_beat(beat));
            return;
        }
        if !tide_tween.done { return; }
        sync_pieces();
        finish_beats();
    }

    fn finish_beats() {
        let then = after;
        after = After.Nothing;
        match then {
            After.Plan => {
                // The Hollow move and choose their strikes.
                play(plan_all(board), After.Mark);
            }
            After.Mark => {
                board.arrivals = wave_for(def, board.round, omen_on(island), spring);
                board = mark_spawns(board, landing);
                board.beats.clear();
                begin_player_turn();
            }
            After.Player => {
                phase = Phase.Player;
                if count_alive(board, false) == 0.0 && board.spawns.length == 0.0 {
                    // Nothing left to fight this round.
                }
                show_threats(board);
                show_plan();
                update_hud();
            }
            After.HollowDone => {
                end_round();
            }
            After.Nothing => {
                phase = Phase.Player;
                show_threats(board);
                show_plan();
            }
        }
    }

    // --- The flow of a battle -----------------------------------------------------

    fn roster() -> List<Warden> {
        return [
            Warden(kind: Kind.Bulwark, max_hp: kind_hp(Kind.Bulwark), move: kind_move(Kind.Bulwark), power: 0.0),
            Warden(kind: Kind.Mason, max_hp: kind_hp(Kind.Mason), move: kind_move(Kind.Mason), power: 0.0),
            Warden(kind: Kind.Lamplighter, max_hp: kind_hp(Kind.Lamplighter), move: kind_move(Kind.Lamplighter), power: 0.0),
        ];
    }

    on CrossingBegins() {
        if phase == Phase.Title { new_run(); }
    }

    fn fresh(kind: Kind) -> Warden {
        return Warden(kind: kind, max_hp: kind_hp(kind), move: kind_move(kind), power: 0.0);
    }

    // A crossing begins with the muster: three of the six wardens, the last
    // three taken offered again.
    fn new_run() {
        phase = Phase.Muster;
        chosen = [];
        for i in 0..3 {
            let hero = Save.number("party_" + i, i);
            if hero >= 0.0 && hero < HERO_COUNT && !chosen.contains(hero) { chosen.push(hero); }
        }
        var open: List<number> = [];
        for hero in chosen { if hero_open(hero) { open.push(hero); } }
        chosen = open;
        if chosen.length < 3.0 { chosen = [0.0, 1.0, 2.0]; }
        spring = Save.flag("open_spring", false) && Save.flag("spring", false);
        opened = "";
        show_muster();
        show_screen("Muster", true);
        print("Causeway muster ready");
    }

    fn show_muster() {
        let screens = Screens.on(World.find("Screens"));
        for i in 0..HERO_COUNT {
            let kind = hero_kind(i);
            var about = hero_blurb(kind) + "  [color=#9fb4bf]Health " + kind_hp(kind) + ", move " + kind_move(kind) + ".[/color]";
            var title = kind_name(kind);
            var color = hero_color(kind);
            if !hero_open(i) {
                about = "[color=#9fb4bf]" + hero_calling(i) + "[/color]";
                title = "[color=#8fa3ad]" + title + "[/color]";
                color = Color(0.45, 0.5, 0.55);
            }
            screens.card("Muster", i, hero_mark(kind), title, about, color);
            screens.taken("Muster", i, chosen.contains(i));
            // A warden not yet called shows no face, only a mark.
            if hero_open(i) { screens.face("Muster", i, i); } else { screens.face("Muster", i, -1.0); }
        }
        var line = chosen.length + " of 3 chosen";
        if chosen.length == 3.0 { line += ", ready to set out"; }
        if Save.flag("open_spring", false) {
            if spring { line += "  ·  [color=#ffcf7a]spring tides[/color] (S)"; } else { line += "  ·  calm tides (S)"; }
        }
        screen_words("Muster", "Before the crossing", "Muster three wardens", "", line);
        screens.ready("Muster", chosen.length == 3.0);
    }

    // Takes a hero into the muster, or puts one back. Taking a fourth puts
    // back the first taken, so a keyboard can change its mind in one press.
    fn toggle_hero(hero: number) {
        if !hero_open(hero) {
            Audio.play("audio/bump.wav", 0.4);
            return;
        }
        if chosen.contains(hero) {
            chosen.remove_at(chosen.index_of(hero));
        } else {
            if chosen.length >= 3.0 { chosen.remove_at(0.0); }
            chosen.push(hero);
        }
        Audio.play("audio/select.wav", 0.4);
        show_muster();
    }

    // The muster done: the crossing sets out from the first island, unless
    // a capture or a test asked for another through `start_island`.
    fn set_out() {
        show_screen("Muster", false);
        for i in 0..3 { Save.set_number("party_" + i, chosen[i]); }
        island = clamp(floor(Game.get("start_island", 0.0)), 0.0, ISLAND_COUNT - 1.0);
        hearth = starting_hearth;
        max_hearth = starting_hearth;
        // Spring tides: one more Hollow every round, and a smaller Hearth.
        if spring {
            hearth -= 2.0;
            max_hearth -= 2.0;
        }
        extra_rewinds = 0.0;
        wardens = [];
        for hero in chosen { wardens.push(fresh(hero_kind(hero))); }
        path = [];
        // Starting past a step where a warden joins still brings one: the
        // first of the six not taken.
        for layer in 0..layer_of(island) {
            let first = layer_islands(layer)[0];
            path.push(first);
            if recruits_on(first) { wardens.push(fresh(hero_kind(left_behind()[0]))); }
        }
        last_world = world_of(island);
        Random.seed(Save.number("seed", 1.0) * 7919.0 + 17.0);
        Save.set_number("seed", Save.number("seed", 1.0) + 1.0);
        omens = [];
        for i in 0..ISLAND_COUNT { omens.push(omen_of_roll(i, Random.int(0.0, 99.0))); }
        objectives = [];
        for i in 0..ISLAND_COUNT { objectives.push(Random.int(0.0, OBJECTIVE_COUNT - 1.0)); }
        Audio.play("audio/boon.wav", 0.6);
        print("Causeway crossing set out");
        begin_island();
    }

    // Whether a warden answers the muster yet: four do from the start, and
    // two are called by what a crossing does.
    fn hero_open(hero: number) -> bool {
        if hero == 4.0 { return Save.flag("open_harpooner", false); }
        if hero == 5.0 { return Save.flag("open_shieldback", false); }
        return true;
    }

    fn hero_calling(hero: number) -> String {
        if hero == 4.0 { return "Not yet called. Hold the Lighthouse, and the Harpooner will hear of it."; }
        return "Not yet called. Make a crossing, and the Shieldback will come.";
    }

    // Opens something for the crossings after this one, once.
    fn open_for_next(key: String, news: String) {
        if Save.flag(key, false) { return; }
        Save.set_flag(key, true);
        if opened != "" { opened += "  "; }
        opened += news;
    }

    // The heroes not in the crossing, in muster order.
    fn left_behind() -> List<number> {
        var left: List<number> = [];
        for i in 0..HERO_COUNT {
            var has = false;
            for w in wardens { if w.kind == hero_kind(i) { has = true; } }
            if !has && hero_open(i) { left.push(i); }
        }
        return left;
    }

    // What a warden is for, short enough for its muster card.
    fn hero_blurb(kind: Kind) -> String {
        return match kind {
            Kind.Bulwark => "Bashes a neighbour for 2 and shoves it.",
            Kind.Mason => "Throws stone 2 to 4 cells, shoving all round it.",
            Kind.Lamplighter => "Fires down a line, knocking back the first in the way.",
            Kind.Tidecaller => "Throws water: cools lava into ground, leaves pools.",
            Kind.Harpooner => "Harpoons the first thing in a line and drags it in.",
            _ => "Wards a warden or a building from the next blow. Won't be shoved.",
        };
    }

    // A warden's mark and color, on its muster card and its boons.
    fn hero_mark(kind: Kind) -> String {
        return match kind {
            Kind.Bulwark => "■",
            Kind.Mason => "▲",
            Kind.Lamplighter => "◆",
            Kind.Tidecaller => "▽",
            Kind.Harpooner => "△",
            _ => "◇",
        };
    }

    fn hero_color(kind: Kind) -> Color {
        return match kind {
            Kind.Bulwark => Color(0.62, 0.78, 1.0),
            Kind.Mason => Color(0.9, 0.82, 0.68),
            Kind.Lamplighter => Color(1.0, 0.76, 0.42),
            Kind.Tidecaller => Color(0.5, 0.86, 1.0),
            Kind.Harpooner => Color(1.0, 0.86, 0.45),
            _ => Color(0.72, 0.86, 0.6),
        };
    }

    fn begin_island() {
        // Each island has its own light; `Atmosphere` eases into it.
        Atmosphere.on(World.find("Environment")).go(island, 2.5);
        def = island_def(island);
        landing = landing_of(def);
        // A new world rekindles the Hearth.
        if world_of(island) != last_world { hearth = max_hearth; }
        last_world = world_of(island);
        path.push(island);
        board = board_of(def, wardens, hearth);
        obj_count = 0.0;
        obj_failed = false;
        obj_hearth = hearth;
        base = [];
        for h in board.heights { base.push(h); }
        clear_ground();
        rewinds = 1.0 + extra_rewinds;
        hide_screens();
        show_hud(true);
        clear_plan();
        for c in 0..(SIZE * SIZE) { set_mark(threat_marks, c, ""); }
        // The last island's people go down with it.
        for id in pieces.keys() {
            Piece.on(pieces[id]).sink(0.7);
            sunk.push(pieces[id]);
            pieces.remove(id);
        }
        for id in pips.keys() { World.despawn(pips[id]); }
        for id in badges.keys() { World.despawn(badges[id]); }
        pips = [:];
        badges = [:];
        leaving_island = shown_island;
        if leaving_island == island { leaving_island = -1.0; }
        let next = islands[island];
        World.set_active(next, true);
        next.transform.position.y = -ISLAND_DEPTH;
        shown_island = island;
        arrival_tide = shown_tide;
        arrival_clock = 0.0;
        risen = false;
        phase = Phase.Arriving;
        update_hud();
    }

    // How far below the sea an island waits, and sinks back to.
    let ISLAND_DEPTH: number = 6.0;

    fn advance_arrival(dt: number) {
        arrival_clock += dt;
        // The last island goes down, the tide falls back...
        let sink = clamp(arrival_clock / 1.1, 0.0, 1.0);
        if leaving_island >= 0.0 {
            let old = islands[leaving_island];
            old.transform.position.y = -ISLAND_DEPTH * sink * sink;
            if sink >= 1.0 {
                World.set_active(old, false);
                old.transform.position.y = 0.0;
                leaving_island = -1.0;
            }
        }
        let fall = clamp(arrival_clock / 1.6, 0.0, 1.0);
        shown_tide = arrival_tide * (1.0 - fall * fall * (3.0 - 2.0 * fall));
        place_sea(shown_tide);
        // ...and the next comes up out of it, slowing as it settles.
        let up = clamp((arrival_clock - 0.4) / 1.5, 0.0, 1.0);
        let settle = 1.0 - (1.0 - up) * (1.0 - up) * (1.0 - up);
        islands[island].transform.position.y = -ISLAND_DEPTH * (1.0 - settle);
        if up >= 1.0 && !risen {
            // Its people climb up onto it, one after another.
            risen = true;
            for e in sunk { World.despawn(e); }
            sunk = [];
            sync_pieces();
            var order = 0.0;
            for unit in board.units {
                let piece = piece_of(unit.id);
                if piece == null { continue; }
                Piece.on(piece).rise(0.35 + order * 0.07);
                order += 1.0;
            }
            Audio.play("audio/emerge.wav", 0.4);
        }
        if risen && arrival_clock >= 2.6 {
            if recruited != "" {
                banner(def.name, "The " + recruited + " joins you. " + def.blurb);
                recruited = "";
            } else if omen_line(island) != "" {
                banner(def.name, omen_line(island));
            } else {
                banner(def.name, def.blurb);
            }
            // The first Hollow climb out, then plan, before the wardens' first turn.
            var first = mark_spawns(board, landing);
            first = emerge(first);
            play(first, After.Plan);
        }
    }

    fn begin_player_turn() {
        turn_start = board;
        turn_obj_count = obj_count;
        turn_obj_failed = obj_failed;
        selected = -1.0;
        mode = Mode.Move;
        phase = Phase.Player;
        select_next();
        show_threats(board);
        show_plan();
        update_hud();
    }

    fn end_turn() {
        if phase != Phase.Player { return; }
        selected = -1.0;
        clear_plan();
        banner("The Hollow strike", "");
        play(hollow_turn(board), After.HollowDone);
    }

    fn end_round() {
        hearth = board.hearth;
        if board.hearth <= 0.0 || count_alive(board, true) == 0.0 {
            lose();
            return;
        }
        board.round += 1.0;
        if board.round > board.rounds {
            win_island();
            return;
        }
        board = new_turn(board);
        sync_pieces();
        play(plan_all(board), After.Mark);
    }

    fn rewind() {
        if phase != Phase.Player || rewinds <= 0.0 { return; }
        rewinds -= 1.0;
        board = turn_start;
        obj_count = turn_obj_count;
        obj_failed = turn_obj_failed;
        sync_pieces();
        selected = -1.0;
        select_next();
        show_threats(board);
        show_plan();
        update_hud();
        banner("Rewound", "The turn starts over. Once per island.");
    }

    // --- The player's hand ----------------------------------------------------------

    fn select_next() {
        var first = -1.0;
        var after_current = -1.0;
        var passed = selected < 0.0;
        for unit in board.units {
            if unit.hp <= 0.0 || !is_warden(unit.kind) || unit.acted { continue; }
            if first < 0.0 { first = unit.id; }
            if passed && after_current < 0.0 && unit.id != selected { after_current = unit.id; }
            if unit.id == selected { passed = true; }
        }
        if after_current >= 0.0 { select(after_current); } else { select(first); }
    }

    fn select(id: number) {
        selected = id;
        mode = Mode.Move;
        let index = unit_index(board, id);
        if index >= 0.0 {
            let unit = board.units[index];
            if unit.moved { mode = Mode.Aim; }
            cursor_x = unit.x;
            cursor_z = unit.z;
        }
        preview_cell = -2.0;
        show_plan();
        update_hud();
    }

    // Whatever the player pointed at and confirmed.
    fn press(x: number, z: number) {
        if !in_bounds(x, z) { return; }
        let at = unit_at(board, x, z);
        if at >= 0.0 {
            let unit = board.units[at];
            if is_warden(unit.kind) && !unit.acted && unit.id != selected
                && !(mode == Mode.Aim && selected_targets().contains(cell_of(x, z))) {
                select(unit.id);
                Audio.play("audio/select.wav", 0.4);
                return;
            }
        }
        if selected < 0.0 { return; }
        let index = unit_index(board, selected);
        if index < 0.0 { return; }
        let unit = board.units[index];
        if mode == Mode.Move {
            // Its own cell is where it already is: nothing to do.
            if x == unit.x && z == unit.z {
                return;
            }
            if !unit.moved && reachable(board, index).contains(cell_of(x, z)) {
                var moved = move_warden(board, index, x, z);
                play(moved, After.Nothing);
                mode = Mode.Aim;
                return;
            }
            // A cell it cannot walk to but can strike: strike from here,
            // which is how a warden acts without moving.
            if selected_targets().contains(cell_of(x, z)) {
                let used = use_skill(board, index, x, z);
                selected_after_act();
                play(used, After.Nothing);
            }
            return;
        }
        if selected_targets().contains(cell_of(x, z)) {
            let used = use_skill(board, index, x, z);
            selected_after_act();
            play(used, After.Nothing);
            return;
        }
        if x == unit.x && z == unit.z && !unit.moved {
            mode = Mode.Move;
            show_plan();
            update_hud();
        }
    }

    // Once a warden has acted, the next one that can is taken up.
    fn selected_after_act() {
        let was = selected;
        selected = -1.0;
        for unit in board.units {
            if unit.hp > 0.0 && is_warden(unit.kind) && !unit.acted && unit.id != was {
                selected = unit.id;
                break;
            }
        }
        mode = Mode.Move;
    }

    fn selected_targets() -> List<number> {
        var none: List<number> = [];
        if selected < 0.0 { return none; }
        let index = unit_index(board, selected);
        if index < 0.0 { return none; }
        return skill_targets(board, index);
    }

    fn toggle_aim() {
        if selected < 0.0 { return; }
        let index = unit_index(board, selected);
        if index < 0.0 || board.units[index].acted { return; }
        if mode == Mode.Move {
            mode = Mode.Aim;
        } else if !board.units[index].moved {
            mode = Mode.Move;
        }
        preview_cell = -2.0;
        show_plan();
        update_hud();
    }

    fn cancel() {
        if selected < 0.0 { return; }
        let index = unit_index(board, selected);
        if index < 0.0 { return; }
        let unit = board.units[index];
        if mode == Mode.Aim && unit.moved && !unit.acted {
            board = undo_move(board, index);
            sync_pieces();
            mode = Mode.Move;
            Audio.play("audio/select.wav", 0.3);
        } else if mode == Mode.Aim {
            mode = Mode.Move;
        } else {
            selected = -1.0;
        }
        show_plan();
        show_threats(board);
        update_hud();
    }

    fn undo() {
        if selected < 0.0 { return; }
        let index = unit_index(board, selected);
        if index < 0.0 { return; }
        board = undo_move(board, index);
        sync_pieces();
        mode = Mode.Move;
        show_plan();
        show_threats(board);
        update_hud();
    }

    // The cell under the pointer, or -1: the camera's ray through the
    // pointer, tested against every figure standing on the board and then
    // against the top of every cell, nearest first. A figure is in front of
    // the ground it stands on, so pointing at a figure picks its cell.
    fn pointed_cell() -> number {
        if Pointer.over_ui { return -1.0; }
        let o = Pointer.ray_origin;
        let d = Pointer.ray_direction;
        if d.length < 0.5 || abs(d.y) < 0.0001 { return -1.0; }
        var best = -1.0;
        var nearest = 1000000.0;
        var body = -1.0;
        var nearest_body = 1000000.0;
        let flat = d.x * d.x + d.z * d.z;
        for unit in board.units {
            if unit.hp <= 0.0 { continue; }
            let base = spot(unit.x, unit.z);
            if flat < 0.000001 { continue; }
            let t = ((base.x - o.x) * d.x + (base.z - o.z) * d.z) / flat;
            let px = o.x + d.x * t - base.x;
            let pz = o.z + d.z * t - base.z;
            let py = o.y + d.y * t - base.y;
            if t > 0.0 && px * px + pz * pz < 0.36 * 0.36 && py > 0.0 && py < figure_height(unit.kind) {
                if (!is_fixed(unit.kind) || is_hollow(unit.kind)) && t < nearest_body {
                    nearest_body = t;
                    body = cell_of(unit.x, unit.z);
                }
                if t < nearest {
                    nearest = t;
                    best = cell_of(unit.x, unit.z);
                }
            }
        }
        for c in 0..(SIZE * SIZE) {
            let x = c % SIZE;
            let z = floor_of(c);
            let top = ground_y(x, z);
            let t = (top - o.y) / d.y;
            if t <= 0.0 || t >= nearest { continue; }
            let px = o.x + d.x * t - ORIGIN_X - x;
            let pz = o.z + d.z * t - ORIGIN_Z - z;
            if px >= 0.0 && px < 1.0 && pz >= 0.0 && pz < 1.0 {
                nearest = t;
                best = c;
            }
        }
        if body >= 0.0 { return body; }
        return best;
    }

    fn figure_height(kind: Kind) -> number {
        return match kind {
            Kind.Colossus => 2.0,
            Kind.Kiln => 2.0,
            Kind.Rimeback => 1.6,
            Kind.Vent => 0.7,
            Kind.Beacon => 1.6,
            Kind.House => 1.0,
            Kind.Stone => 0.7,
            _ => 1.2,
        };
    }

    // A gesture belongs to the sea only if it began there. Crossing the
    // board later never converts a selection gesture into a camera gesture.
    fn view_drag_region() -> bool {
        if Input.Touch.count != 1.0 || Pointer.over_ui { return false; }
        let c = pointed_cell();
        if c < 0.0 { return true; }
        let x = c % SIZE;
        let z = floor_of(c);
        return is_wet(board, x, z) && unit_at(board, x, z) < 0.0;
    }

    fn handle_view_drag() {
        if BattlefieldView.turning && Pointer.is_down("Left") { view_pointer_blocked = true; }
        if !Pointer.is_down("Left") && !Pointer.just_released("Left") { view_pointer_blocked = false; }
        if !Pointer.is_down("Left") && !Pointer.just_released("Left") { BattlefieldView.dragging = false; }
        if Input.Touch.count > 1.0 { view_drag_used = true; }
        // The view turns while an island rises too, as it does from the keys.
        if phase != Phase.Player && phase != Phase.Resolving && phase != Phase.Arriving { return; }
        if Pointer.just_pressed("Left") && !BattlefieldView.turning {
            BattlefieldView.dragging = view_drag_region();
            if BattlefieldView.dragging { print("Causeway sea swipe began"); }
            view_drag_start = Pointer.position;
            view_drag_used = false;
        }
        if !BattlefieldView.dragging || view_drag_used || Input.Touch.count != 1.0 { return; }
        let delta = Pointer.position - view_drag_start;
        if abs(delta.x) >= 48.0 && abs(delta.x) > abs(delta.y) * 1.5 {
            view_drag_used = true;
            var direction = 1.0;
            if delta.x < 0.0 { direction = -1.0; }
            CameraRig.on(World.find("World Camera")).rotate(direction);
        }
    }

    fn handle_input() {
        if BattlefieldView.turning || BattlefieldView.dragging || view_pointer_blocked
            || Input.Keyboard.just_pressed("J") || Input.Keyboard.just_pressed("L")
            || Input.Keyboard.just_pressed("T")
            || pressed("RotateLeft") || pressed("RotateRight") || pressed("ViewTop") { return; }
        let c = round(cos(BattlefieldView.angle));
        let s = round(sin(BattlefieldView.angle));
        // Keys move a cursor over the board, a quarter turn apart.
        var moved_cursor = false;
        if Input.Keyboard.just_pressed("ArrowUp") || Input.Keyboard.just_pressed("W") { cursor_x -= s; cursor_z -= c; moved_cursor = true; }
        if Input.Keyboard.just_pressed("ArrowDown") || Input.Keyboard.just_pressed("S") { cursor_x += s; cursor_z += c; moved_cursor = true; }
        if Input.Keyboard.just_pressed("ArrowLeft") || Input.Keyboard.just_pressed("A") { cursor_x -= c; cursor_z += s; moved_cursor = true; }
        if Input.Keyboard.just_pressed("ArrowRight") || Input.Keyboard.just_pressed("D") { cursor_x += c; cursor_z -= s; moved_cursor = true; }
        cursor_x = clamp(cursor_x, 0.0, SIZE - 1.0);
        cursor_z = clamp(cursor_z, 0.0, SIZE - 1.0);

        let pointed = pointed_cell();
        // What the pointer is over, for anybody asking: the tests, and a
        // tutorial one day.
        Game.set("pointed", pointed);
        if pointed >= 0.0 && Pointer.delta.length > 0.0 {
            cursor_x = pointed % SIZE;
            cursor_z = floor_of(pointed);
        }
        hover_cell = cell_of(cursor_x, cursor_z);
        show_cursor();
        update_preview();

        if Gesture.tapped && !Pointer.over_ui {
            if pointed >= 0.0 {
                cursor_x = pointed % SIZE;
                cursor_z = floor_of(pointed);
                press(cursor_x, cursor_z);
            }
            return;
        }
        if Input.Keyboard.just_pressed("Enter") || Input.Keyboard.just_pressed("Space") {
            press(cursor_x, cursor_z);
            return;
        }
        if Input.Keyboard.just_pressed("Tab") {
            select_next();
            Audio.play("audio/select.wav", 0.3);
        }
        if Input.Keyboard.just_pressed("Escape") || Pointer.just_pressed("Right") {
            cancel();
        }
        if Input.Keyboard.just_pressed("Z") || Input.Keyboard.just_pressed("Backspace") {
            undo();
        }
        if Input.Keyboard.just_pressed("E") { end_turn(); }
        // Aim from where the warden stands, or back to walking.
        if Input.Keyboard.just_pressed("Q") || pressed("SkillName") { toggle_aim(); }
        if Input.Keyboard.just_pressed("R") { rewind(); }
        let end_button = World.find("EndTurn");
        if end_button != null && Ui.is_pressed(end_button) { end_turn(); }
        let undo_button = World.find("UndoMove");
        if undo_button != null && Ui.is_pressed(undo_button) { undo(); }
        let rewind_button = World.find("Rewind");
        if rewind_button != null && Ui.is_pressed(rewind_button) { rewind(); }
    }

    fn show_cursor() {
        if cursor == null { return; }
        if hover_cell < 0.0 {
            World.set_active(cursor, false);
            return;
        }
        let x = hover_cell % SIZE;
        let z = floor_of(hover_cell);
        let wanted = Vec3(world_x(x), ground_y(x, z) + 0.07, world_z(z));
        if !World.is_active(cursor) {
            World.set_active(cursor, true);
            cursor_at = wanted;
        }
        // Glides to the cell rather than jumping, quickly enough to keep up.
        cursor_at = cursor_at.lerp(wanted, min(1.0, Time.delta * 22.0));
        cursor.transform.position = cursor_at;
    }

    // While a target is under the cursor, the ground shows what would happen:
    // the Hollow's strikes as they would be after it, which is how a shove that
    // turns one Hollow's strike onto another is seen before it is made.
    fn update_preview() {
        var wanted = -1.0;
        if mode == Mode.Aim && selected >= 0.0 && selected_targets().contains(hover_cell) {
            wanted = hover_cell;
        }
        if wanted == preview_cell { return; }
        preview_cell = wanted;
        if wanted < 0.0 {
            show_threats(board);
            update_hud();
            return;
        }
        let index = unit_index(board, selected);
        let preview = use_skill(board, index, wanted % SIZE, floor_of(wanted));
        show_threats(preview);
        var harm = "";
        for beat in preview.beats {
            if beat.kind == BeatKind.Hit {
                let hit = unit_index(preview, beat.unit);
                if hit >= 0.0 {
                    harm += kind_name(preview.units[hit].kind) + " -" + beat.amount + "  ";
                }
            }
            if beat.kind == BeatKind.Drown { harm += "drowns  "; }
            if beat.kind == BeatKind.Burn { harm += "burns  "; }
            if beat.kind == BeatKind.Raise { harm += "a stone rises  "; }
            if beat.kind == BeatKind.Basalt { harm += "new ground  "; }
            if beat.kind == BeatKind.Steam { harm += "hiss  "; }
            if beat.kind == BeatKind.Pool && beat.amount == WATER { harm += "a pool  "; }
            if beat.kind == BeatKind.Pool && beat.amount == ICE { harm += "ice  "; }
            if beat.kind == BeatKind.Ward { harm += "warded  "; }
        }
        if harm == "" { harm = "No effect."; }
        set_text("Preview", harm);
    }

    // --- Winning, losing and the run ----------------------------------------------

    fn win_island() {
        phase = Phase.Won;
        clear_plan();
        show_threats(new_turn(board));
        for c in 0..(SIZE * SIZE) { set_mark(threat_marks, c, ""); }
        hearth = board.hearth;
        if island == TITLE_ISLAND {
            open_for_next("open_harpooner", "The Harpooner has heard, and will answer the next muster.");
        }
        if omen_on(island) == OMEN_LIT {
            max_hearth += 1.0;
            hearth = min(hearth + 2.0, max_hearth);
        }
        let step = layer_of(island) + 1.0;
        Audio.play("audio/victory.wav", 0.8);
        if step >= LAYER_COUNT {
            phase = Phase.Crossed;
            show_screen("Crossed", true);
            Atmosphere.on(World.find("Environment")).celebrate(3.0);
            Save.set_number("crossings", Save.number("crossings", 0.0) + 1.0);
            let made = Save.number("crossings", 0.0);
            var record = "Your first crossing.";
            if made > 1.0 { record = "Crossings made: " + made; }
            if spring { record += "  In spring tides."; }
            open_for_next("open_shieldback", "The Shieldback will answer the next muster.");
            open_for_next("open_spring", "Spring tides are open at the muster.");
            var body = "The causeway is under the sea behind you, and the beacon burns over open water.";
            if opened != "" { body += " " + opened; }
            opened = "";
            screen_words("Crossed", "The crossing is made", "The lamp is lit", body,
                "Hearth " + hearth + " of " + max_hearth + "  ·  " + record);
            return;
        }
        show_screen("Held", true);
        roads = roads_from(island);
        var why = "High tide. The causeway is under water and the Hollow turn back.";
        if board.molten { why = "The lava has sealed the gate, and the Hollow cannot come through it."; }
        if objective_met() {
            why += " " + objective_name(objective_on(island), def) + ": one more boon.";
        }
        if omen_on(island) == OMEN_LIT { why += " The lit windows rekindle the Hearth."; }
        if opened != "" {
            why += " " + opened;
            opened = "";
        }
        if omen_on(island) == OMEN_HOST { why += " The host is beaten: choose two boons."; }
        if omen_on(island) == OMEN_WRECK { why += " The wreck holds an upgrade."; }
        var next = "next, " + island_def(roads[0]).name;
        if roads.length > 1.0 { next = "next, the road forks"; }
        if world_of(roads[0]) != world_of(island) {
            why += " Beyond the Lighthouse the road divides: into the burning mountain, or north into the ice.";
            next = "next, a new world: the Hearth will be rekindled";
        }
        screen_words("Held", "Step " + step + " of " + LAYER_COUNT + " held", def.name + " holds",
            why, "Hearth " + hearth + " of " + max_hearth + "  ·  " + next);
    }

    // The bonus objective on an island this crossing.
    fn objective_on(index: number) -> number {
        if index < objectives.length { return objectives[index]; }
        return OBJ_HOUSES;
    }

    // Counts what a change did towards the island's objective, from the beats
    // it left: Hollow lost to the sea or the lava, Hollow destroyed, and
    // houses or wardens lost.
    fn tally(next: Board) {
        let objective = objective_on(island);
        for beat in next.beats {
            if beat.kind != BeatKind.Die && beat.kind != BeatKind.Drown && beat.kind != BeatKind.Burn { continue; }
            let at = unit_index(next, beat.unit);
            if at < 0.0 { continue; }
            let kind = next.units[at].kind;
            if is_hollow(kind) {
                if objective == OBJ_SLAY { obj_count += 1.0; }
                if objective == OBJ_DEEP && beat.kind != BeatKind.Die { obj_count += 1.0; }
            }
            if objective == OBJ_HOUSES && kind == Kind.House { obj_failed = true; }
            if objective == OBJ_STAND && is_warden(kind) { obj_failed = true; }
        }
    }

    // Whether the island's objective is met, so far as it can be told yet.
    fn objective_met() -> bool {
        let objective = objective_on(island);
        if obj_failed { return false; }
        if objective == OBJ_EMBER { return obj_hearth - board.hearth <= 1.0; }
        if objective_goal(objective) > 0.0 { return obj_count >= objective_goal(objective); }
        return true;
    }

    // The objective's line for the HUD: its name, how far along it is, and a
    // mark once it is won or lost.
    fn objective_line() -> String {
        let objective = objective_on(island);
        var line = "[color=#9fe6ff]" + objective_name(objective, def) + "[/color]";
        let goal = objective_goal(objective);
        if goal > 0.0 { line += "  " + min(obj_count, goal) + " of " + goal; }
        if objective == OBJ_EMBER { line += "  " + max(0.0, obj_hearth - board.hearth) + " lost"; }
        if obj_failed || (objective == OBJ_EMBER && !objective_met()) {
            line += "  [color=#ff9e80]failed[/color]";
        } else if goal > 0.0 && objective_met() {
            line += "  [color=#c8ff9a]done[/color]";
        }
        return line;
    }

    // The omen over an island on this crossing.
    fn omen_on(index: number) -> number {
        if index < omens.length { return omens[index]; }
        return OMEN_PLAIN;
    }

    // An omen as a line for a card or a banner, or nothing for a plain one.
    fn omen_line(index: number) -> String {
        let omen = omen_on(index);
        if omen == OMEN_PLAIN { return ""; }
        return "[color=#ffcf7a]" + omen_name(omen) + ":[/color] " + omen_text(omen);
    }

    // After the boon: on down the road, or a choice where it forks.
    fn go_on() {
        if roads.length == 1.0 {
            island = roads[0];
            begin_island();
            return;
        }
        phase = Phase.Route;
        let screens = Screens.on(World.find("Screens"));
        for k in 0..2 {
            let road = roads[k];
            let at = island_def(road);
            var waves = "";
            for wave in at.waves { waves += wave; }
            var text = at.blurb + "  " + at.rounds + " rounds, " + (waves.length + at.start.length) + " Hollow.";
            if omen_line(road) != "" { text += "  " + omen_line(road); }
            screens.card("Route", k, "◆", at.name, text, world_color(road));
            screens.taken("Route", k, false);
            screens.face("Route", k, -1.0);
        }
        show_route_map(screens);
        screen_words("Route", "The road forks", "Choose your road", "", "Hearth " + hearth + " of " + max_hearth);
        show_screen("Route", true);
    }

    fn world_color(index: number) -> Color {
        if world_of(index) == 1.0 { return Color(1.0, 0.6, 0.42); }
        if world_of(index) == 2.0 { return Color(0.78, 0.9, 1.0); }
        return Color(0.55, 0.85, 0.95);
    }

    // The whole road on the route screen's map: the islands held, the ones
    // passed by, the fork on offer and the steps beyond it.
    fn show_route_map(screens: Screens) {
        let here = layer_of(roads[0]);
        // What lies beyond the fork: everywhere either road can go on to.
        var ahead: List<number> = roads;
        var shown: List<number> = [];
        for layer in 0..LAYER_COUNT {
            var on: List<number> = [];
            if layer < here {
                // The step taken, with what was passed by in the same world.
                let held = path[layer];
                for i in layer_islands(layer) {
                    if world_of(i) == world_of(held) { on.push(i); }
                }
            } else if layer == here {
                on = roads;
            } else {
                var next: List<number> = [];
                for i in ahead {
                    for r in roads_from(i) {
                        if !next.contains(r) { next.push(r); }
                    }
                }
                ahead = next;
                on = next;
            }
            for k in 0..ROUTE_STOPS {
                if k >= on.length {
                    screens.stop(layer, k, "", STOP_NONE);
                    continue;
                }
                let index = on[k];
                var state = STOP_AHEAD;
                if layer < here {
                    state = STOP_PASSED;
                    if path[layer] == index { state = STOP_HELD; }
                }
                if layer == here { state = STOP_OFFERED; }
                screens.stop(layer, k, island_def(index).name, state);
            }
        }
    }

    fn take_road(k: number) {
        show_screen("Route", false);
        island = roads[k];
        Audio.play("audio/boon.wav", 0.6);
        begin_island();
    }

    fn lose() {
        phase = Phase.Lost;
        clear_plan();
        show_screen("Fallen", true);
        var why = "The last warden fell on " + def.name + ".";
        if board.hearth <= 0.0 { why = "The Hearth went out on " + def.name + "."; }
        Atmosphere.on(World.find("Environment")).mourn(2.5);
        screen_words("Fallen", "The crossing ends", "The light goes out", why,
            "Round " + min(board.round, board.rounds) + " of " + board.rounds + "  ·  step "
                + (layer_of(island) + 1.0) + " of " + LAYER_COUNT);
        Audio.play("audio/defeat.wav", 0.8);
    }

    fn screen_words(screen: String, kicker: String, title: String, body: String, line: String) {
        Screens.on(World.find("Screens")).words(screen, kicker, title, body, line);
    }

    // Four boons drawn from what the party could use: a point of health, a
    // harder skill or a longer stride for each warden, and three for the
    // whole crossing. Drawn from the run's own seeded dice, so a seed still
    // plays the same crossing. A boon is a number: ten a warden plus 0 for
    // health, 1 for its skill and 2 for its stride, or 100 and up for the
    // crossing's.
    fn offer_boons(upgrades_only: bool) {
        var pool: List<number> = [];
        if !upgrades_only { pool = [100.0, 101.0, 102.0]; }
        for w in 0..wardens.length {
            if !upgrades_only {
                for kind in 0..3 { pool.push(w * 10.0 + kind); }
            }
            // An upgrade the warden lacks, twice over: they change how a
            // crossing plays, so they should come up often.
            if !knows(wardens[w].perks, PERK_A) { pool.push(w * 10.0 + 3.0); pool.push(w * 10.0 + 3.0); }
            if !knows(wardens[w].perks, PERK_B) { pool.push(w * 10.0 + 4.0); pool.push(w * 10.0 + 4.0); }
        }
        offered = [];
        for slot in 0..4 {
            if pool.length == 0.0 { break; }
            let pick = Random.int(0.0, pool.length - 1.0);
            let boon = pool[pick];
            offered.push(boon);
            // Every copy of it goes, so a hand never offers one twice.
            var left: List<number> = [];
            for b in pool { if b != boon { left.push(b); } }
            pool = left;
        }
        // An upgrade-only hand short of cards fills out with ordinary boons.
        if offered.length < 4.0 && upgrades_only {
            let had = offered;
            offer_boons(false);
            var mixed = had;
            for b in offered {
                if mixed.length < 4.0 && !mixed.contains(b) { mixed.push(b); }
            }
            offered = mixed;
        }
        show_offers("Before " + next_name(), "Choose a boon");
    }

    // Where the road goes on to, or that it forks.
    fn next_name() -> String {
        if roads.length > 1.0 { return "the fork"; }
        return island_def(roads[0]).name;
    }

    // Entering a new world, a warden joins in place of a boon: one of those
    // left behind at the muster, or none, and the Hearth grows instead.
    fn offer_recruits() {
        offered = [];
        for hero in left_behind() {
            if offered.length < 3.0 { offered.push(200.0 + hero); }
        }
        offered.push(300.0);
        show_offers("Beyond the Lighthouse", "Who joins the crossing?");
    }

    fn show_offers(kicker: String, title: String) {
        let screens = Screens.on(World.find("Screens"));
        for slot in 0..4 {
            let boon = offered[slot];
            screens.card("Upgrade", slot, boon_mark(boon), boon_title(boon), boon_text(boon), boon_color(boon));
            var hero = -1.0;
            if boon < 100.0 || (boon >= 200.0 && boon < 300.0) { hero = hero_index(boon_kind(boon)); }
            screens.face("Upgrade", slot, hero);
        }
        screen_words("Upgrade", kicker, title, "", "Hearth " + hearth + " of " + max_hearth);
    }

    fn boon_kind(boon: number) -> Kind {
        if boon >= 300.0 { return Kind.House; }
        if boon >= 200.0 { return hero_kind(boon - 200.0); }
        if boon >= 100.0 { return Kind.Beacon; }
        return wardens[floor(boon / 10.0)].kind;
    }

    // Which warden a boon is for, by its mark and color. Marks the game's own
    // font has, since a browser has no system font to fall back on.
    fn boon_mark(boon: number) -> String {
        if boon == 100.0 || boon == 300.0 { return "◆"; }
        if boon == 101.0 { return "▽"; }
        if boon == 102.0 { return "△"; }
        return hero_mark(boon_kind(boon));
    }

    fn boon_color(boon: number) -> Color {
        if boon == 100.0 || boon == 300.0 { return Color(1.0, 0.55, 0.38); }
        if boon == 101.0 { return Color(0.5, 0.92, 0.86); }
        if boon == 102.0 { return Color(0.86, 0.9, 0.72); }
        return hero_color(boon_kind(boon));
    }

    fn boon_title(boon: number) -> String {
        if boon == 100.0 { return "Bank the fire"; }
        if boon == 101.0 { return "Second chance"; }
        if boon == 102.0 { return "Stout hearts"; }
        if boon == 300.0 { return "Go on as we are"; }
        let kind = boon_kind(boon);
        if boon >= 200.0 { return kind_name(kind); }
        let part = boon % 10.0;
        if part == 3.0 { return perk_name(kind, PERK_A); }
        if part == 4.0 { return perk_name(kind, PERK_B); }
        if part == 0.0 {
            return match kind {
                Kind.Bulwark => "Thicker plate",
                Kind.Mason => "Broad back",
                Kind.Lamplighter => "Warm coat",
                Kind.Tidecaller => "Salt blood",
                Kind.Harpooner => "Weathered",
                _ => "Iron hide",
            };
        }
        if part == 1.0 {
            return match kind {
                Kind.Bulwark => "Shield wall",
                Kind.Mason => "Heavier stone",
                Kind.Lamplighter => "Hotter flame",
                Kind.Tidecaller => "Colder water",
                Kind.Harpooner => "Barbed head",
                _ => "Double ward",
            };
        }
        return match kind {
            Kind.Bulwark => "Light step",
            Kind.Mason => "Sure feet",
            Kind.Lamplighter => "Longer legs",
            Kind.Tidecaller => "Sea legs",
            Kind.Harpooner => "Quick feet",
            _ => "Steady march",
        };
    }

    fn boon_text(boon: number) -> String {
        if boon == 100.0 { return "The Hearth regains two points, and can hold one more."; }
        if boon == 101.0 { return "Rewind one more turn on every island."; }
        if boon == 102.0 { return "Every warden gains a point of health."; }
        if boon == 300.0 { return "Nobody joins. The Hearth can hold two more."; }
        let kind = boon_kind(boon);
        let name = "The " + kind_name(kind);
        if boon >= 200.0 {
            return hero_blurb(kind) + "  Health " + kind_hp(kind) + ", move " + kind_move(kind) + ".";
        }
        let part = boon % 10.0;
        if part == 3.0 { return perk_text(kind, PERK_A); }
        if part == 4.0 { return perk_text(kind, PERK_B); }
        if part == 0.0 { return name + " gains a point of health."; }
        if part == 2.0 { return name + " moves a cell further."; }
        return match kind {
            Kind.Tidecaller => name + "'s water burns the fire-born 1 harder.",
            Kind.Shieldback => name + "'s ward turns one more blow.",
            _ => name + "'s " + skill_name(kind) + " hits 1 harder.",
        };
    }

    fn take_boon(slot: number) {
        let boon = offered[slot];
        if boon >= 300.0 {
            max_hearth += 2.0;
        } else if boon >= 200.0 {
            let kind = hero_kind(boon - 200.0);
            wardens.push(fresh(kind));
            recruited = kind_name(kind);
        } else if boon == 100.0 {
            max_hearth += 1.0;
            hearth = min(hearth + 2.0, max_hearth);
        } else if boon == 101.0 {
            extra_rewinds += 1.0;
        } else if boon == 102.0 {
            for w in 0..wardens.length { boost(w, 1.0, 0.0, 0.0); }
        } else {
            let part = boon % 10.0;
            let w = floor(boon / 10.0);
            if part == 0.0 { boost(w, 1.0, 0.0, 0.0); }
            if part == 1.0 { boost(w, 0.0, 0.0, 1.0); }
            if part == 2.0 { boost(w, 0.0, 1.0, 0.0); }
            if part == 3.0 { learn(w, PERK_A); }
            if part == 4.0 { learn(w, PERK_B); }
        }
        Audio.play("audio/boon.wav", 0.6);
        boons_left -= 1.0;
        if boons_left > 0.0 {
            offer_boons(false);
            screen_words("Upgrade", "One more", "Choose a boon", "", "Hearth " + hearth + " of " + max_hearth);
            show_screen("Upgrade", true);
            return;
        }
        go_on();
    }

    fn learn(warden: number, perk: number) {
        var w = wardens[warden];
        w.perks += perk;
        wardens[warden] = w;
    }

    fn boost(warden: number, health: number, move: number, power: number) {
        var w = wardens[warden];
        w.max_hp += health;
        w.move += move;
        w.power += power;
        wardens[warden] = w;
    }

    // --- Screens --------------------------------------------------------------------

    fn show_title() {
        phase = Phase.Title;
        hide_screens();
        show_hud(false);
        // The Lighthouse behind the title, its wardens standing ready.
        island = TITLE_ISLAND;
        def = island_def(island);
        board = board_of(def, roster(), starting_hearth);
        shown_tide = 0.0;
        place_sea(0.0);
        clear_pieces();
        base = [];
        for h in board.heights { base.push(h); }
        clear_ground();
        show_island();
        sync_pieces();
        clear_plan();
        for c in 0..(SIZE * SIZE) { set_mark(threat_marks, c, ""); }
        update_hud();
        TitleShown.emit();
    }

    fn hide_screens() {
        for name in ["Title", "Muster", "Held", "Upgrade", "Route", "Fallen", "Crossed"] {
            show_screen(name, false);
        }
    }

    fn show_screen(name: String, on: bool) {
        let screen = World.find(name);
        if screen != null { World.set_active(screen, on); }
        // The HUD is for a battle in progress; any screen over it hides it.
        if on { show_hud(false); }
    }

    fn show_hud(on: bool) {
        let hud = World.find("Hud");
        if hud != null { World.set_active(hud, on); }
        if !on {
            let b = World.find("Banner");
            if b != null { World.set_active(b, false); }
        }
    }

    fn set_text(name: String, text: String) {
        let e = World.find(name);
        if e != null { Ui.set_text(e, text); }
    }

    fn pressed(name: String) -> bool {
        let e = World.find(name);
        return e != null && World.is_active(e) && Ui.is_pressed(e);
    }

    // A line across the top for what just happened, rising in, held and
    // fading away over the board.
    fn banner(title: String, sub: String) {
        banner_title = title;
        banner_text = sub;
        banner_age = 0.0;
        let b = World.find("Banner");
        if b != null { World.set_active(b, true); }
    }

    fn update_banner() {
        let b = World.find("Banner");
        if b == null || !World.is_active(b) { return; }
        banner_age += Time.delta;
        let hold = 2.4;
        let alpha = ramp_at(banner_age, 0.0, 0.4) * (1.0 - ramp_at(banner_age, hold, hold + 0.6));
        fade_image("BannerHalo", alpha);
        fade_words("BannerTitle", banner_title, "f3d79a", alpha);
        fade_words("BannerText", banner_text, "d5e0e5", alpha);
        if banner_age >= hold + 0.6 { World.set_active(b, false); }
    }

    fn update_hud() {
        set_text("IslandName", def.name);
        var round = "Round " + min(board.round, board.rounds) + " of " + board.rounds;
        let omen = omen_on(island);
        if omen != OMEN_PLAIN && phase != Phase.Title { round += "  ·  [color=#ffcf7a]" + omen_name(omen) + "[/color]"; }
        set_text("RoundText", round);
        if phase == Phase.Title {
            set_text("ObjectiveText", "");
        } else {
            set_text("ObjectiveText", objective_line());
        }
        var tide = "Tide " + board.tide;
        if board.molten { tide = "Lava " + board.tide; }
        if rises_this_round(board) {
            tide += "  ·  [color=#ffcf7a]rises this round[/color]";
        } else {
            tide += "  ·  steady";
        }
        set_text("TideText", tide);
        // A lantern for each point the Hearth can hold, lit for each it has.
        for i in 0..MOST_HEARTH {
            let lamp = World.find("HearthLamp" + i);
            if lamp == null { continue; }
            let shown = i < max_hearth;
            if World.is_active(lamp) != shown { World.set_active(lamp, shown); }
            var lit = 0.0;
            if i < board.hearth { lit = 1.0; }
            fade_image("HearthFlame" + i, lit);
        }
        set_text("Preview", "");
        if selected >= 0.0 {
            let index = unit_index(board, selected);
            if index >= 0.0 {
                let unit = board.units[index];
                show_portrait(unit.kind);
                set_text("UnitName", kind_name(unit.kind));
                set_text("UnitStats", pip_text(unit) + "   Move " + unit.move);
                set_text("SkillName", skill_name(unit.kind));
                var skill = skill_text(unit.kind);
                for perk in [PERK_A, PERK_B] {
                    if has_perk(unit, perk) {
                        skill += "  [color=#9fe6ff]" + perk_name(unit.kind, perk) + ":[/color] "
                            + perk_text(unit.kind, perk);
                    }
                }
                set_text("SkillText", skill);
                if unit.acted {
                    set_text("UnitHint", "Done for this turn.");
                } else if mode == Mode.Move {
                    set_text("UnitHint", "Choose where to move, or tap the skill (Q) to strike from here.");
                } else if unit.moved {
                    set_text("UnitHint", "Choose a target. Undo move (Esc) takes the step back.");
                } else {
                    set_text("UnitHint", "Choose a target, or tap the skill (Q) again to move instead.");
                }
                show_card(true);
                return;
            }
        }
        set_text("UnitName", "");
        set_text("UnitStats", "");
        set_text("SkillName", "");
        set_text("SkillText", "");
        if phase == Phase.Player && all_spent(board) {
            set_text("UnitHint", "Every warden has acted. End the turn.");
            show_card(true);
        } else {
            set_text("UnitHint", "");
            // An empty card is just a box over the board.
            show_card(false);
        }
    }

    // The warden in hand's face on the card, and nobody else's.
    fn show_portrait(kind: Kind) {
        for i in 0..HERO_COUNT {
            let hero = hero_kind(i);
            let portrait = World.find("Portrait " + kind_name(hero));
            if portrait == null { continue; }
            let shown = hero == kind;
            if World.is_active(portrait) != shown { World.set_active(portrait, shown); }
        }
    }

    // The turn's plates, lit by whether they would do anything now, and
    // brighter under the pointer.
    fn update_actions() {
        if phase != Phase.Player && phase != Phase.Resolving && phase != Phase.Arriving { return; }
        let ready = phase == Phase.Player;
        var can_undo = false;
        if ready && selected >= 0.0 {
            let index = unit_index(board, selected);
            if index >= 0.0 {
                let unit = board.units[index];
                can_undo = unit.moved && !unit.acted && unit.from_x >= 0.0;
            }
        }
        plate_action("UndoMove", "Undo move", can_undo);
        plate_action("Rewind", "Rewind (" + rewinds + ")", ready && rewinds > 0.0);
        plate_action("EndTurn", "End turn", ready);
    }

    fn plate_action(name: String, label: String, on: bool) {
        var alpha = 0.45;
        if on { alpha = 1.0; }
        fade_plate(name, label, "fff4dc", alpha);
    }

    fn show_card(on: bool) {
        let card = World.find("Card");
        if card != null && World.is_active(card) != on { World.set_active(card, on); }
    }

    // --- The sea -------------------------------------------------------------------

    fn place_sea(level: number) {
        if sea == null { return; }
        sea.transform.position.y = level + 0.08;
    }

    fn update_sea() {
        if tide_tween.done {
            if shown_tide != board.tide {
                shown_tide = board.tide;
                place_sea(shown_tide);
            }
            return;
        }
        let t = tide_tween.progress;
        let eased = t * t * (3.0 - 2.0 * t);
        shown_tide = tide_from + (board.tide - tide_from) * eased;
        place_sea(shown_tide);
    }

    // --- Every frame --------------------------------------------------------------------

    // The lamplighter's lantern and the beacon's fire light what is round
    // them, wherever they are.
    fn update_lights() {
        let air = Atmosphere.on(World.find("Environment"));
        var lamp_on = false;
        var fire_on = false;
        var houses = 0.0;
        for unit in board.units {
            // Every house keeps its own light, standing or fallen, so a light
            // never moves to another house when one falls. It burns inside:
            // walls and thatch face away from it, so it spills out on the
            // ground round the house rather than glaring off its walls.
            if unit.kind == Kind.House {
                let piece = piece_of(unit.id);
                if piece == null {
                    air.window_out(houses);
                } else {
                    let p = piece.transform.position;
                    air.window(houses, Vec3(p.x, p.y + 0.4, p.z), unit.hp > 0.0);
                }
                houses += 1.0;
                continue;
            }
            if unit.hp <= 0.0 { continue; }
            let piece = piece_of(unit.id);
            if piece == null { continue; }
            let p = piece.transform.position;
            if unit.kind == Kind.Lamplighter && lantern != null {
                lantern.transform.position = Vec3(p.x + 0.2, p.y + 1.4, p.z + 0.2);
                lamp_on = true;
            }
            if unit.kind == Kind.Beacon && fire != null {
                fire.transform.position = Vec3(p.x, p.y + 1.6, p.z);
                fire_on = true;
            }
        }
        for i in houses..house_lights.length { air.window_out(i); }
        if lantern != null { World.set_active(lantern, lamp_on); }
        if fire != null { World.set_active(fire, fire_on); }
        // A violet glow where the Hollow are about to climb out.
        var rifts = 0.0;
        for spawn in board.spawns {
            if rifts >= rift_lights.length { break; }
            air.rift(rifts, Vec3(world_x(spawn.x), ground_y(spawn.x, spawn.z) + 0.4, world_z(spawn.z)), true);
            rifts += 1.0;
        }
        for i in rifts..rift_lights.length { air.rift_shut(i); }
    }

    // Opens a screen between islands on request, for captures and the tests
    // that check every screen fits: 1 held, 2 the boons, 3 fallen, 4 the
    // crossing made. Like `start_island`, nothing in play sets it.
    fn preview_screen() {
        let which = Game.get("preview_screen", 0.0);
        if which <= 0.0 || phase != Phase.Player { return; }
        Game.set("preview_screen", 0.0);
        if which == 1.0 || which == 2.0 { win_island(); }
        if which == 2.0 {
            show_screen("Held", false);
            phase = Phase.Upgrade;
            offer_boons(false);
            show_screen("Upgrade", true);
        }
        if which == 3.0 { lose(); }
        if which == 4.0 {
            island = ISLAND_COUNT - 1.0;
            win_island();
        }
        if which == 5.0 {
            hide_screens();
            new_run();
        }
        if which == 6.0 {
            island = 0.0;
            win_island();
            show_screen("Held", false);
            go_on();
        }
    }

    // A gem over the warden in hand, turning and bobbing, so which one is
    // taken up is never in doubt. It glides from warden to warden rather than
    // jumping, and fades when nobody is in hand.
    fn update_marker(dt: number) {
        if marker == null { return; }
        var wanted = 0.0;
        var target = marker_at;
        if phase == Phase.Player && selected >= 0.0 {
            let piece = piece_of(selected);
            let index = unit_index(board, selected);
            if piece != null && index >= 0.0 {
                let p = piece.transform.position;
                target = Vec3(p.x, p.y + label_height(board.units[index].kind) + 0.6, p.z);
                wanted = 1.0;
            }
        }
        if marker_shown <= 0.01 && wanted > 0.0 { marker_at = target; }
        marker_at = marker_at.lerp(target, min(1.0, dt * 14.0));
        if wanted > marker_shown {
            marker_shown = min(wanted, marker_shown + dt * 5.0);
        } else {
            marker_shown = max(wanted, marker_shown - dt * 5.0);
        }
        World.set_active(marker, marker_shown > 0.01);
        if marker_shown <= 0.01 { return; }
        let bob = sin(Time.elapsed * 3.2) * 0.1;
        marker.transform.position = marker_at + Vec3(0.0, bob, 0.0);
        marker.transform.yaw = Time.elapsed * 1.8;
        let size = 1.7 * marker_shown;
        marker.transform.scale = Vec3(size, size, size);
    }

    fn update(dt: number) {
        preview_screen();
        handle_view_drag();
        fade_marks(dt);
        update_banner();
        update_sea();
        update_lights();
        update_marker(dt);
        update_actions();
        match phase {
            // `title.decay` has the title, and says when a crossing begins.
            Phase.Title => {}
            Phase.Arriving => { advance_arrival(dt); }
            Phase.Resolving => { advance_beats(); }
            Phase.Player => {
                handle_input();
            }
            Phase.Muster => {
                for i in 0..HERO_COUNT {
                    if pressed("Muster" + i) || Input.Keyboard.just_pressed("Digit" + (i + 1.0)) {
                        toggle_hero(i);
                    }
                }
                if Save.flag("open_spring", false) && (pressed("MusterSpring") || Input.Keyboard.just_pressed("S")) {
                    spring = !spring;
                    Save.set_flag("spring", spring);
                    Audio.play("audio/select.wav", 0.4);
                    show_muster();
                }
                if Save.flag("open_spring", false) {
                    var label = "Calm tides";
                    if spring { label = "Spring tides"; }
                    fade_plate("MusterSpring", label, "fff4dc", 1.0);
                } else {
                    fade_plate("MusterSpring", "", "fff4dc", 0.0);
                }
                if chosen.length == 3.0 && (pressed("MusterButton") || Input.Keyboard.just_pressed("Enter")) {
                    set_out();
                }
            }
            Phase.Won => {
                if pressed("HeldButton") || Input.Keyboard.just_pressed("Enter") {
                    show_screen("Held", false);
                    phase = Phase.Upgrade;
                    // A warden joins where the road enters a new world.
                    // What the island's omen pays: two boons, an upgrade, or
                    // none at all after still water.
                    let omen = omen_on(island);
                    boons_left = 1.0;
                    if omen == OMEN_HOST { boons_left = 2.0; }
                    if omen == OMEN_STILL { boons_left = 0.0; }
                    // A bonus objective met is one more.
                    if objective_met() { boons_left += 1.0; }
                    if world_of(roads[0]) != world_of(island) && wardens.length < 4.0 {
                        // A recruit is chosen first; the boons follow it.
                        offer_recruits();
                    } else if boons_left == 0.0 {
                        go_on();
                        return;
                    } else {
                        offer_boons(omen == OMEN_WRECK);
                    }
                    show_screen("Upgrade", true);
                }
            }
            Phase.Route => {
                for k in 0..2 {
                    if pressed("Route" + k) || Input.Keyboard.just_pressed("Digit" + (k + 1.0)) {
                        take_road(k);
                        return;
                    }
                }
            }
            Phase.Upgrade => {
                for i in 0..4 {
                    if pressed("Upgrade" + i) || Input.Keyboard.just_pressed("Digit" + (i + 1.0)) {
                        show_screen("Upgrade", false);
                        take_boon(i);
                        return;
                    }
                }
            }
            Phase.Lost | Phase.Crossed => {
                if pressed("FallenButton") || pressed("CrossedButton") || Input.Keyboard.just_pressed("Enter") {
                    show_title();
                }
            }
        }
        Game.set("phase", phase_number());
        Game.set("round", board.round);
        Game.set("hearth", board.hearth);
        Game.set("island", island);
    }

    fn phase_number() -> number {
        return match phase {
            Phase.Title => 0.0,
            Phase.Muster => 7.0,
            Phase.Route => 8.0,
            Phase.Arriving | Phase.Resolving => 1.0,
            Phase.Player => 2.0,
            Phase.Won => 3.0,
            Phase.Upgrade => 4.0,
            Phase.Lost => 5.0,
            Phase.Crossed => 6.0,
        };
    }
}
