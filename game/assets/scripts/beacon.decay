// What the walker is walking towards.
//
// It does nothing but sit there and be brighter once somebody arrives, which
// is the whole of its job: a goal that moved, or that had rules, would be a
// second thing to understand in a game whose one idea is that you build the
// way to it.
//
// How it lights is authored rather than written here: the beacon's "arrive"
// sequence swells it and sounds the chime on its first cue, and "glow" is the
// breathing it settles into. This only says when each plays.
script Beacon {
    var lit: bool = false;

    fn update(dt: f32) {
        if !lit && Game.get("arrived", 0.0) > 0.0 {
            Sequence.play(this.entity, "arrive");
            lit = true;
        }
        if Sequence.playing(this.entity) == "arrive" && Sequence.is_finished(this.entity) {
            Sequence.play(this.entity, "glow");
        }
    }
}
