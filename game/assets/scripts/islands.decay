                + "01233210"
                + "12344321"
                + "12333211"
                + "12332211"
                + "01222111"
                + "00122110"
                + "00011100",
            features: "........"
                + "...H..L."
                + "...B..LL"
                + "..H.1.LL"
                + "...2.3LL"
                + ".....LL."
                + "....LL.."
                + "........",
            rounds: 5.0,
            rises: [2.0, 4.0],
            start: "HH",
            waves: ["H", "HS", "HH", "S", ""],
            shore: "mud",
            land: "ground",
            high: "moss",
        );
    }
    if index == 1.0 {
        return IslandDef(
            name: "The Fold",
            blurb: "Sheep country, folded into two hills with a dip between. The Hollow come at it from both ends of the dip.",
            heights: "01111000"
                + "12332110"
                + "23443211"
                + "23322111"
                + "12211221"
                + "11222331"
                + "01233321"
                + "00111110",
            features: "........"
                + "..H...L."
                + "..B..LLL"
                + "...1.LL."
                + ".....2LL"
                + "..3...H."
                + "...H...."
                + "........",
            rounds: 5.0,
            rises: [1.0, 3.0],
            start: "HHS",
            waves: ["HB", "HS", "HM", "BS", ""],
            shore: "sand",
            land: "ground",
            high: "ground",
        );
    }
    if index == 2.0 {
        return IslandDef(
            name: "Quarry Rise",
            blurb: "A worked-out quarry, all ledges and drops. Shove a Hollow off a ledge and the fall hurts it.",
            heights: "00122100"
                + "01354310"
                + "12453321"
                + "23441122"
                + "12441111"
                + "12553321"
                + "01243210"
                + "00122100",
            features: "........"
                + "...H...."
                + "..B..S.L"
                + ".1...LLL"
                + "..S..LLL"
                + "..H2..L."
                + "...3...."
                + "........",
            rounds: 6.0,
            rises: [2.0, 4.0],
            start: "BHS",
            waves: ["HM", "BS", "HM", "S", "B", ""],
            shore: "gravel",
            land: "stone",
            high: "rock",
        );
    }
    if index == 3.0 {
        return IslandDef(
            name: "The Lighthouse",
            blurb: "The last island before open sea, and the lamp that keeps the causeway. The Colossus has come for it.",
            heights: "00111100"
                + "01234310"
                + "12355321"
                + "12354221"
                + "12343211"
                + "12332111"
                + "01222110"
                + "00111100",
            features: "........"
                + "...H...."
                + "...B...."
                + "..1..LLL"
                + "...H.LLL"
                + "..2.3LL."
                + "......L."
                + "........",
            rounds: 6.0,
            rises: [2.0, 4.0],
            start: "HHS",
            waves: ["C", "H", "HS", "M", "S", ""],
            shore: "sand",
            land: "ground",
            high: "stone",
        );
    }
    if index == 4.0 {
        return IslandDef(
            name: "Ashfall Shelf",
            blurb: "A shelf of cooled stone inside the mountain, and a lake of fire round it. Throw water on lava and it sets into new ground.",
            heights: "00122100"
                + "01233210"
                + "12344321"
                + "12343221"
                + "12332211"
                + "01232111"
                + "00122110"
                + "00011100",
            features: "........"
                + "..H.~.L."
                + ".~.B..LL"
                + "..1V..LL"
                + "..2.4.LL"
                + ".^.3..L."
                + "...H...."
                + "........",
            rounds: 5.0,
            rises: [2.0, 4.0],
            start: "HI",
            waves: ["H", "IH", "HX", "I", ""],
            shore: "ash",
            land: "basalt",
            high: "cinder",
            world: "caldera",
            recruit: "T",
        );
    }
    if index == 5.0 {
        return IslandDef(
            name: "The Crucible",
            blurb: "A ring of rock round a pit of fire, and two vents that never sleep. Bursters come with the Imps.",
            heights: "01122100"
                + "12333210"
                + "23444321"
                + "23411122"
                + "23410111"
                + "12433321"
                + "01233210"
                + "00111100",
            features: "........"
                + "...H...."
                + ".V.B.~L."
                + ".1...LLL"
                + "..2..LLL"
                + ".3.4.^v."
                + "...H...."
                + "........",
            rounds: 6.0,
            rises: [2.0, 4.0],
            start: "IX",
            waves: ["HI", "XS", "IX", "B", "H", ""],
            shore: "ash",
            land: "basalt",
            high: "cinder",
            world: "caldera",
        );
    }
    return IslandDef(
        name: "The Kiln's Throat",
        blurb: "The heart of the mountain. The Kiln climbs out of it, belching fire, and nothing the wardens carry will move it.",
        heights: "00111100"
            + "01233210"
            + "12344321"
            + "12345221"
            + "12344211"
            + "12332111"
            + "01222110"
            + "00111100",
        features: "........"
            + "...HV..."
            + "...B..L."
            + ".~1..LLL"
            + "..2.4LLL"
            + ".vH3.LL."
            + "......^."
            + "........",
        rounds: 6.0,
        rises: [2.0, 4.0],
        start: "KH",
        waves: ["X", "IX", "H", "XI", "S", ""],
        shore: "ash",
        land: "basalt",
        high: "cinder",
        world: "caldera",
    );

}

shared fn kind_of_letter(letter: String) -> Kind {
    if letter == "B" { return Kind.Brute; }
    if letter == "S" { return Kind.Spitter; }
    if letter == "M" { return Kind.Mortar; }
    if letter == "C" { return Kind.Colossus; }
    if letter == "I" { return Kind.Imp; }
    if letter == "X" { return Kind.Burster; }
    if letter == "K" { return Kind.Kiln; }
    return Kind.Husk;
}

shared fn kinds_of(letters: String) -> List<Kind> {
    var kinds: List<Kind> = [];
    for i in 0..letters.length {
        kinds.push(kind_of_letter(letters.slice(i, i + 1.0)));
    }
    return kinds;
}

shared fn digit_of(text: String) -> number {
    let digits = "0123456789";
    let at = digits.find(text);
    if at < 0.0 { return 0.0; }
    return at;
}

// The cells the Hollow may climb out on.
shared fn landing_of(def: IslandDef) -> List<number> {
    var cells: List<number> = [];
    for c in 0..(SIZE * SIZE) {
        if def.features.slice(c, c + 1.0) == "L" {
            cells.push(c);
        }
    }
    return cells;
}

// A warden as the run has made it: its kind, what it has earned, and whether
// it is fit to fight.
struct Warden {
    kind: Kind,
    max_hp: number,
    move: number,
    power: number,
}

// The board an island starts as: its ground, its buildings and stones, the
// wardens where they deploy, and the first Hollow already climbing out.
shared fn board_of(def: IslandDef, wardens: List<Warden>, hearth: number) -> Board {
    var heights: List<number> = [];
    for c in 0..(SIZE * SIZE) {
        heights.push(digit_of(def.heights.slice(c, c + 1.0)));
    }
    var pools: List<number> = [];
    for c in 0..(SIZE * SIZE) {
        let mark = def.features.slice(c, c + 1.0);
        var pool = DRY;
        if mark == "~" { pool = WATER; }
        if mark == "^" { pool = LAVA; }
        pools.push(pool);
    }
    var board = Board(heights: heights, tide: 0.0, units: [], spawns: [], beats: [],
        round: 1.0, rounds: def.rounds, rises: def.rises, hearth: hearth, next_id: 1.0,
        arrivals: kinds_of(def.start), pools: pools, molten: def.world == "caldera");
    for c in 0..(SIZE * SIZE) {
        let mark = def.features.slice(c, c + 1.0);
        let x = c % SIZE;
        let z = floor(c / SIZE);
        var kind = Kind.Stone;
        var placed = false;
        if mark == "H" { kind = Kind.House; placed = true; }
        if mark == "B" { kind = Kind.Beacon; placed = true; }
        if mark == "S" { kind = Kind.Stone; placed = true; }
        if mark == "V" || mark == "v" { kind = Kind.Vent; placed = true; }
        if placed {
            var charge = 0.0;
            if mark == "v" { charge = 1.0; }
            board.units.push(Unit(id: board.next_id, kind: kind, x: x, z: z, hp: kind_hp(kind),
                max_hp: kind_hp(kind), move: 0.0, charge: charge));
            board.next_id += 1.0;
        }
        for w in 0..wardens.length {
            if mark == "" + (w + 1.0) {
                let warden = wardens[w];
                board.units.push(Unit(id: board.next_id, kind: warden.kind, x: x, z: z,
                    hp: warden.max_hp, max_hp: warden.max_hp, move: warden.move, power: warden.power));
                board.next_id += 1.0;
            }
        }
    }
    return board;
}

// The Hollow that arrive at the end of a round, or none past the last wave.
shared fn wave_of(def: IslandDef, round: number) -> List<Kind> {
    let index = round - 1.0;
    if index < 0.0 || index >= def.waves.length {
        var none: List<Kind> = [];
        return none;
    }
    return kinds_of(def.waves[index]);
}

// The warden who joins the crossing on this island, if one does.
shared fn recruit_of(def: IslandDef) -> List<Kind> {
    var kinds: List<Kind> = [];
    if def.recruit == "T" { kinds.push(Kind.Tidecaller); }
    return kinds;
}
