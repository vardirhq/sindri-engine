// The islands of a crossing, as text you can read.
//
// Each island is two maps of eight rows of eight cells, north row first and
// west cell first, written so the rows line up with each other:
//
// - `heights`: how many blocks tall each cell stands. 0 is open water.
// - `features`: what stands on it. `.` nothing, `H` a house, `B` the beacon,
//   `S` a stone, `1` to `4` where the wardens start, in the order they joined,
//   `L` landing ground, where the Hollow climb out of the mud, `~` a pool of
//   water, `^` a pool of lava, `*` ice, and `V` or `v` a vent: `V` throws lava
//   from the first round, `v` rests a round first.
//
// The Hollow come over the causeway from the mainland, which is east, so the
// landing ground is on the east of every island and low: as the tide comes
// in it drowns, and the arrivals stop. Holding until high tide is winning.
//
// Waves are one letter per Hollow: `H` Husk, `B` Brute, `S` Spitter,
// `M` Mortar, `C` the Colossus, `I` Cinder Imp, `X` Burster, `K` the Kiln,
// `A` Hailer, `R` the Rimeback.
// `start` climbs out before the first turn; the waves arrive at the end of
// each round, in order.
//
// An island is in a world: `sea`, the islands of the causeway; `caldera`,
// the burning mountain beyond it, where lava rises round the island instead
// of the tide; or `rime`, the ice to the north, where thrown water freezes
// and anything shoved onto ice skids on. A fourth warden joins on the first island of a new world, and
// stands on the `4`.
//
// A crossing is a road of six steps, and at some steps the road forks: the
// crossing takes one island of each step, chosen on the way (`layer_of`).
// Past the Lighthouse it forks between worlds, and stays in the one taken
// (`roads_from`).

struct IslandDef {
    name: String,
    blurb: String,
    heights: String,
    features: String,
    rounds: number,
    rises: List<number>,
    start: String,
    waves: List<String>,
    // The block a cell's top is made of, from low to high ground.
    shore: String,
    land: String,
    high: String,
    world: String = "sea",
}

shared const ISLAND_COUNT: number = 12.0;

// The steps of the road, and which islands lie on each. The road forks after
// Saltmarsh, between The Fold and Quarry Rise; after the Lighthouse, between
// the mountain and the ice; and again in either, before the last island.
shared const LAYER_COUNT: number = 6.0;

shared fn layer_of(index: number) -> number {
    if index == 0.0 { return 0.0; }
    if index <= 2.0 { return 1.0; }
    if index == 3.0 { return 2.0; }
    if index == 4.0 { return 3.0; }
    if index <= 6.0 { return 4.0; }
    if index == 7.0 { return 5.0; }
    if index == 8.0 { return 3.0; }
    if index <= 10.0 { return 4.0; }
    return 5.0;
}

// Where the road goes on to from an island: the next step's islands in the
// same world, or every world's where this one ends.
shared fn roads_from(index: number) -> List<number> {
    let next = layer_islands(layer_of(index) + 1.0);
    var same: List<number> = [];
    for i in next {
        if world_of(i) == world_of(index) { same.push(i); }
    }
    if same.length > 0.0 { return same; }
    return next;
}

shared fn layer_islands(layer: number) -> List<number> {
    var found: List<number> = [];
    for i in 0..ISLAND_COUNT {
        if layer_of(i) == layer { found.push(i); }
    }
    return found;
}

// Whether a warden joins on this island: the first of a new world does.
shared fn recruits_on(index: number) -> bool {
    if layer_of(index) == 0.0 { return false; }
    for i in layer_islands(layer_of(index) - 1.0) {
        if world_of(i) == world_of(index) { return false; }
    }
    return true;
}

// Which world an island is in, as a number the pictures can use: 0 the sea,
// 1 the burning mountain.
shared fn world_of(index: number) -> number {
    let world = island_def(index).world;
    if world == "caldera" { return 1.0; }
    if world == "rime" { return 2.0; }
    return 0.0;
}

// The name of the world an island is in, for the screens.
shared fn world_name(index: number) -> String {
    if world_of(index) == 1.0 { return "The Cinderfast"; }
    if world_of(index) == 2.0 { return "The Rime"; }
    return "The Shallows";
}

