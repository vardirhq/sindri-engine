// The four islands of a crossing, as text you can read.
//
// Each island is two maps of eight rows of eight cells, north row first and
// west cell first, written so the rows line up with each other:
//
// - `heights`: how many blocks tall each cell stands. 0 is open water.
// - `features`: what stands on it. `.` nothing, `H` a house, `B` the beacon,
//   `S` a stone, `1` to `4` where the wardens start, in the order they joined,
//   `L` landing ground, where the Hollow climb out of the mud, `~` a pool of
//   water, `^` a pool of lava, and `V` or `v` a vent: `V` throws lava from
//   the first round, `v` rests a round first.
//
// The Hollow come over the causeway from the mainland, which is east, so the
// landing ground is on the east of every island and low: as the tide comes
// in it drowns, and the arrivals stop. Holding until high tide is winning.
//
// Waves are one letter per Hollow: `H` Husk, `B` Brute, `S` Spitter,
// `M` Mortar, `C` the Colossus, `I` Cinder Imp, `X` Burster, `K` the Kiln.
// `start` climbs out before the first turn; the waves arrive at the end of
// each round, in order.
//
// An island is in a world: `sea`, the islands of the causeway, or `caldera`,
// the burning mountain beyond it, where lava rises round the island instead
// of the tide. A warden named in `recruit` (`T` the Tidecaller) joins the
// crossing on that island.

struct IslandDef {
    name: String,
    blurb: String,
    heights: String,
    features: String,
    rounds: number,
    rises: List<number>,
    start: String,
    waves: List<String>,
    // The block a cell's top is made of, from low to high ground.
    shore: String,
    land: String,
    high: String,
    world: String = "sea",
    recruit: String = "",
}

shared const ISLAND_COUNT: number = 7.0;

// Which world an island is in, as a number the pictures can use: 0 the sea,
// 1 the burning mountain.
shared fn world_of(index: number) -> number {
    if island_def(index).world == "caldera" { return 1.0; }
    return 0.0;
}

// The name of the world an island is in, for the screens.
shared fn world_name(index: number) -> String {
    if world_of(index) == 1.0 { return "The Cinderfast"; }
    return "The Shallows";
}

shared fn island_def(index: number) -> IslandDef {
    if index == 0.0 {
        return IslandDef(
            name: "Saltmarsh",
            blurb: "The first island off the mainland. Two houses and the old beacon, on a hump of grass in the reeds.",
