shared fn kind_of_letter(letter: String) -> Kind {
    if letter == "B" { return Kind.Brute; }
    if letter == "S" { return Kind.Spitter; }
    if letter == "M" { return Kind.Mortar; }
    if letter == "C" { return Kind.Colossus; }
    if letter == "I" { return Kind.Imp; }
    if letter == "X" { return Kind.Burster; }
    if letter == "K" { return Kind.Kiln; }
    if letter == "A" { return Kind.Hailer; }
    if letter == "R" { return Kind.Rimeback; }
    return Kind.Husk;
}

shared fn kinds_of(letters: String) -> List<Kind> {
    var kinds: List<Kind> = [];
    for i in 0..letters.length {
        kinds.push(kind_of_letter(letters.slice(i, i + 1.0)));
    }
    return kinds;
}

shared fn digit_of(text: String) -> number {
    let digits = "0123456789";
    let at = digits.find(text);
    if at < 0.0 { return 0.0; }
    return at;
}

// The cells the Hollow may climb out on.
shared fn landing_of(def: IslandDef) -> List<number> {
    var cells: List<number> = [];
    for c in 0..(SIZE * SIZE) {
        if def.features.slice(c, c + 1.0) == "L" {
            cells.push(c);
        }
    }
    return cells;
}

// A warden as the run has made it: its kind, what it has earned, and whether
// it is fit to fight.
struct Warden {
    kind: Kind,
    max_hp: number,
    move: number,
    power: number,
    // The upgrades that change how its skill works (`PERK_A`, `PERK_B`).
    perks: number = 0.0,
}

// The board an island starts as: its ground, its buildings and stones, the
// wardens where they deploy, and the first Hollow already climbing out.
shared fn board_of(def: IslandDef, wardens: List<Warden>, hearth: number) -> Board {
    var heights: List<number> = [];
    for c in 0..(SIZE * SIZE) {
        heights.push(digit_of(def.heights.slice(c, c + 1.0)));
    }
    var pools: List<number> = [];
    for c in 0..(SIZE * SIZE) {
        let mark = def.features.slice(c, c + 1.0);
        var pool = DRY;
        if mark == "~" { pool = WATER; }
        if mark == "^" { pool = LAVA; }
        if mark == "*" { pool = ICE; }
        pools.push(pool);
    }
    var board = Board(heights: heights, tide: 0.0, units: [], spawns: [], beats: [],
        round: 1.0, rounds: def.rounds, rises: def.rises, hearth: hearth, next_id: 1.0,
        arrivals: kinds_of(def.start), pools: pools, molten: def.world == "caldera",
        frozen: def.world == "rime");
    for c in 0..(SIZE * SIZE) {
        let mark = def.features.slice(c, c + 1.0);
        let x = c % SIZE;
        let z = floor(c / SIZE);
        var kind = Kind.Stone;
        var placed = false;
        if mark == "H" { kind = Kind.House; placed = true; }
        if mark == "B" { kind = Kind.Beacon; placed = true; }
        if mark == "S" { kind = Kind.Stone; placed = true; }
        if mark == "V" || mark == "v" { kind = Kind.Vent; placed = true; }
        if placed {
            var charge = 0.0;
            if mark == "v" { charge = 1.0; }
            board.units.push(Unit(id: board.next_id, kind: kind, x: x, z: z, hp: kind_hp(kind),
                max_hp: kind_hp(kind), move: 0.0, charge: charge));
            board.next_id += 1.0;
        }
        for w in 0..wardens.length {
            if mark == "" + (w + 1.0) {
                let warden = wardens[w];
                board.units.push(Unit(id: board.next_id, kind: warden.kind, x: x, z: z,
                    hp: warden.max_hp, max_hp: warden.max_hp, move: warden.move, power: warden.power,
                    perks: warden.perks));
                board.next_id += 1.0;
            }
        }
    }
    return board;
}

// The Hollow that arrive at the end of a round, or none past the last wave.
// --- Bonus objectives -------------------------------------------------------------

// Something more an island asks of a crossing, rolled with its omen. Meeting
// it earns one more boon.
shared const OBJ_HOUSES: number = 0.0;
shared const OBJ_DEEP: number = 1.0;
shared const OBJ_SLAY: number = 2.0;
shared const OBJ_STAND: number = 3.0;
shared const OBJ_EMBER: number = 4.0;
shared const OBJECTIVE_COUNT: number = 5.0;

// How many an objective that counts asks for.
shared fn objective_goal(objective: number) -> number {
    if objective == OBJ_DEEP { return 3.0; }
    if objective == OBJ_SLAY { return 6.0; }
    return 0.0;
}

shared fn objective_name(objective: number, def: IslandDef) -> String {
    if objective == OBJ_HOUSES { return "Every house stands"; }
    if objective == OBJ_DEEP { return "Three to the deep"; }
    if objective == OBJ_SLAY { return "Six fall"; }
    if objective == OBJ_STAND { return "No warden falls"; }
    return "Keep the fire";
}

shared fn objective_text(objective: number, def: IslandDef) -> String {
    if objective == OBJ_HOUSES { return "Lose no house on this island."; }
    if objective == OBJ_DEEP {
        if def.world == "caldera" { return "Send three Hollow into the lava."; }
        return "Send three Hollow into the sea.";
    }
    if objective == OBJ_SLAY { return "Destroy six Hollow."; }
    if objective == OBJ_STAND { return "Lose no warden on this island."; }
    return "Lose no more than 1 Hearth on this island.";
}

// --- Omens ---------------------------------------------------------------------

// What hangs over an island on this crossing, rolled when the crossing sets
// out, and what holding it pays. Each trades danger for reward, so a fork in
// the road is a choice between them.
shared const OMEN_PLAIN: number = 0.0;
// Still water: every wave one Hollow lighter, and no boon after.
shared const OMEN_STILL: number = 1.0;
// A Hollow host: one more Hollow every round, and two boons after.
shared const OMEN_HOST: number = 2.0;
// A wreck ashore: the boon after is one of the wardens' upgrades.
shared const OMEN_WRECK: number = 3.0;
// Lit windows: hold it and the Hearth regains 2 and can hold one more.
shared const OMEN_LIT: number = 4.0;

shared fn omen_name(omen: number) -> String {
    if omen == OMEN_STILL { return "Still water"; }
    if omen == OMEN_HOST { return "A Hollow host"; }
    if omen == OMEN_WRECK { return "A wreck ashore"; }
    if omen == OMEN_LIT { return "Lit windows"; }
    return "";
}

shared fn omen_text(omen: number) -> String {
    if omen == OMEN_STILL { return "One Hollow fewer every round, and no boon after."; }
    if omen == OMEN_HOST { return "One more Hollow every round, and two boons after."; }
    if omen == OMEN_WRECK { return "Something washed up here: the boon after is an upgrade."; }
    if omen == OMEN_LIT { return "Hold it and the Hearth regains 2 and can hold one more."; }
    return "";
}

// An omen for an island, from a roll of 0 to 99. The first island is always
// plain: it is where a crossing learns the game.
shared fn omen_of_roll(index: number, roll: number) -> number {
    if index == 0.0 { return OMEN_PLAIN; }
    if roll < 40.0 { return OMEN_PLAIN; }
    if roll < 55.0 { return OMEN_STILL; }
    if roll < 75.0 { return OMEN_HOST; }
    if roll < 90.0 { return OMEN_WRECK; }
    return OMEN_LIT;
}

// The lowest of a world's Hollow, the one a host brings more of.
shared fn host_kind(def: IslandDef) -> Kind {
    if def.world == "caldera" { return Kind.Imp; }
    if def.world == "rime" { return Kind.Hailer; }
    return Kind.Husk;
}

// A round's arrivals under an island's omen.
shared fn wave_under(def: IslandDef, round: number, omen: number) -> List<Kind> {
    var wave = wave_of(def, round);
    let last_wave = round - 1.0 >= def.waves.length - 1.0;
    if omen == OMEN_STILL && wave.length > 0.0 {
        wave.remove_at(wave.length - 1.0);
    }
    if omen == OMEN_HOST && !last_wave {
        wave.push(host_kind(def));
    }
    return wave;
}

shared fn wave_of(def: IslandDef, round: number) -> List<Kind> {
    let index = round - 1.0;
    if index < 0.0 || index >= def.waves.length {
        var none: List<Kind> = [];
        return none;
    }
    return kinds_of(def.waves[index]);
}

