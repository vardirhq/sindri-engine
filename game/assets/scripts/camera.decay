// Four fixed views of the battlefield, each either as authored or straight
// down from above, where no cell hides in a pit or behind a ledge. The title
// owns the camera until it hands the authored pose back; turns and the view
// from above keep its focus and lens.
state BattlefieldView {
    var angle: number = 0.0;
    var turning: bool = false;
    var dragging: bool = false;
    // Looking straight down, or on the way there.
    var top: bool = false;
}

// What the camera turns and tips about: the middle of the board.
const PIVOT_X: number = 28.0;
const PIVOT_Y: number = 1.4;
const PIVOT_Z: number = 28.0;

script CameraRig {
    // World units of island that must fit across and up.
    @export let board_width: number = 9.5;
    @export let board_height: number = 10.0;

    var aspect: number = 0.0;
    // Nearer than the board needs, below 1: the title draws the island in.
    var zoom: number = 1.0;
    var applied: number = 1.0;

    var enabled: bool = false;
    var home_position: Vec3 = Vec3(0.0, 0.0, 0.0);
    var home_rotation: Quat = Quat(x: 0.0, y: 0.0, z: 0.0, w: 1.0);
    var last_position: Vec3 = Vec3(0.0, 0.0, 0.0);
    var from: number = 0.0;
    var target: number = 0.0;
    // How far over towards straight down the camera is tipped, 0..1.
    var tilt: number = 0.0;
    var tilt_from: number = 0.0;
    var tilt_to: number = 0.0;
    // Radians from the authored pitch to looking straight down, and the turn
    // that squares the board up with the screen once it is seen from above:
    // up the screen is then the way the cursor's up key goes.
    var lift: number = 0.0;
    var square: number = 0.0;
    var elapsed: number = 1.0;

    fn set_home(position: Vec3, rotation: Quat) {
        home_position = position;
        home_rotation = rotation;
        last_position = position;
        // Read from the authored pose itself, so a scene that changes the
        // camera's pitch still ends up looking straight down.
        this.transform.rotation = rotation;
        lift = PI / 2.0 + this.transform.pitch;
        square = -this.transform.yaw;
        while square > PI { square -= TAU; }
        while square < -PI { square += TAU; }
    }

    fn battle_view(on: bool) {
        enabled = on;
        BattlefieldView.angle = 0.0;
        BattlefieldView.turning = false;
        BattlefieldView.dragging = false;
        BattlefieldView.top = false;
        from = 0.0;
        target = 0.0;
        tilt = 0.0;
        tilt_from = 0.0;
        tilt_to = 0.0;
        elapsed = 1.0;
        last_position = home_position;
        label_top();
        if on { print("Causeway battlefield ready"); }
    }

    fn rotate(direction: number) {
        if !enabled || BattlefieldView.turning { return; }
        from = target;
        target += direction * PI / 2.0;
        tilt_from = tilt_to;
        elapsed = 0.0;
        BattlefieldView.turning = true;
    }

    // Over to looking straight down, or back to the authored view.
    fn toggle_top() {
        if !enabled || BattlefieldView.turning { return; }
        from = target;
        tilt_from = tilt_to;
        tilt_to = 1.0 - tilt_to;
        elapsed = 0.0;
        BattlefieldView.turning = true;
        BattlefieldView.top = tilt_to > 0.5;
        label_top();
    }

    // The button names the view it goes to.
    fn label_top() {
        let label = World.find("ViewTop Label");
        if label == null { return; }
        if BattlefieldView.top { Ui.set_text(label, "3D"); } else { Ui.set_text(label, "Top"); }
    }

    fn pressed(name: String) -> bool {
        let e = World.find(name);
        return e != null && World.is_active(e) && Ui.is_pressed(e);
    }

    fn turn(dt: number) {
        if !enabled { return; }
        if Input.Keyboard.just_pressed("J") || pressed("RotateLeft") { rotate(-1.0); }
        if Input.Keyboard.just_pressed("L") || pressed("RotateRight") { rotate(1.0); }
        if Input.Keyboard.just_pressed("T") || pressed("ViewTop") { toggle_top(); }
        if !BattlefieldView.turning { return; }
        elapsed += dt;
        let t = min(1.0, elapsed / 0.3);
        let eased = t * t * (3.0 - 2.0 * t);
        let angle = from + (target - from) * eased;
        let tipped = tilt_from + (tilt_to - tilt_from) * eased;
        let pivot = Vec3(PIVOT_X, PIVOT_Y, PIVOT_Z);
        if angle != BattlefieldView.angle || tipped != tilt {
            // Keep the engine's transient impact shake separate from the pose.
            let shake = this.transform.position - last_position;
            this.transform.position = home_position;
            this.transform.rotation = home_rotation;
            this.transform.rotate_around(pivot, Vec3(0.0, 1.0, 0.0), angle + square * tipped);
            if tipped > 0.0 {
                // Up and over the board about the camera's own sideways axis,
                // so above is still turned the way the view was.
                this.transform.rotate_around(pivot, this.transform.right, -lift * tipped);
            }
            last_position = this.transform.position;
            this.transform.position = last_position + shake;
            BattlefieldView.angle = angle;
            tilt = tipped;
        }
        // Rays are sampled before scripts: leave a settling frame before picking.
        if elapsed >= 0.35 {
            BattlefieldView.turning = false;
            print("Causeway view settled: " + BattlefieldView.angle);
        }
    }

    fn set_zoom(value: number) {
        zoom = value;
    }

    fn update(dt: number) {
        turn(dt);
        if abs(Viewport.aspect - aspect) < 0.001 && abs(zoom - applied) < 0.0001 { return; }
        aspect = Viewport.aspect;
        applied = zoom;
        var size = board_height;
        if aspect > 0.0 && board_width / aspect > size {
            size = board_width / aspect;
        }
        Camera.orthographic_size(this.entity, size * zoom);
    }
}
