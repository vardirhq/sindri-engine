// Frames the island whatever shape the screen is.
//
// The camera never follows anything: a tactics board is read best from one
// place. What changes is how much it shows -- a phone held upright needs the
// whole board across its narrow width, a wide screen fits it by height -- and
// that is the orthographic size, set once per change of shape.

script CameraRig {
    // World units of island that must fit across and up.
    @export let board_width: number = 12.5;
    @export let board_height: number = 10.0;

    var aspect: number = 0.0;

    fn update(dt: number) {
        if abs(Viewport.aspect - aspect) < 0.001 { return; }
        aspect = Viewport.aspect;
        var size = board_height;
        if aspect > 0.0 && board_width / aspect > size {
            size = board_width / aspect;
        }
        Camera.orthographic_size(this.entity, size);
    }
}
