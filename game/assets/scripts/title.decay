// The title: the Lighthouse at dusk, the camera drifting round it, Hollow
// trudging over the causeway, and the logo and menu coming up out of the
// dark over it. Beginning a crossing hands the camera back to the battle's
// view and the light back to day before the battle is told to start, so the
// first thing a player sees of the board is it settling into place.
//
// The battle says when the title is wanted (`TitleShown`) and this says when
// it is done (`CrossingBegins`). Between the two, the camera, the sun, the sea
// and the title's own screen are this script's.

event TitleShown();
event CrossingBegins();

enum Stage { Hidden, Showing, Leaving }

// Where the island's middle is, which the camera sways round.
const PIVOT_X: number = 28.0;
const PIVOT_Y: number = 1.4;
const PIVOT_Z: number = 28.0;

// The causeway's road, from the mainland end to the island's edge.
const ROAD_FAR: number = 41.8;
const ROAD_NEAR: number = 33.0;
const ROAD_Z: number = 27.5;
const ROAD_TOP: number = 0.7;

script TitleShow {
    @export let walker: Prefab;
    // How far the camera swings either side, in radians, and how long a whole
    // swing takes.
    @export let sway: number = 0.38;
    @export let sway_seconds: number = 30.0;
    // How much nearer than the battle's view the title is, and how far the
    // view is raised so the island sits under the logo.
    @export let zoom: number = 1.04;
    @export let lift: number = 1.7;
    // How far a wide screen's view slides, so the island stands right of the
    // logo and menu.
    @export let side: number = 3.9;
    @export let leave_seconds: number = 1.7;

    var stage: Stage = Stage.Hidden;
    var clock: number = 0.0;
    var leave_clock: number = 0.0;
    // How much of the title is in the camera, the light and the sea: 1 on
    // the title, 0 in a battle.
    var mood: number = 0.0;
    var angle: number = 0.0;
    var hovered: String = "";
    var howto_open: bool = false;
    var swapped: bool = false;
    var fader: Entity = null;

    var root: Entity = null;
    var camera: Entity = null;
    var sun: Entity = null;
    var world: Entity = null;
    var lantern: Entity = null;
    var beacon: Entity = null;
    var walkers: List<Entity> = [];
    // Alpha as two hex digits for a `[color=#rrggbbaa]` span, in sixteenths.
    var alpha_hex: List<String> = ["00", "11", "22", "33", "44", "55", "66", "77", "88", "99", "aa", "bb", "cc", "dd", "ee", "ff"];
    var walked: List<number> = [];

    // The battle's view and the day, as the scene authored them.
    var home_position: Vec3 = Vec3(0.0, 0.0, 0.0);
    var home_rotation: Quat = Quat(x: 0.0, y: 0.0, z: 0.0, w: 1.0);
    var day_sun: Color = Color(1.0, 1.0, 1.0);
    var day_sun_intensity: number = 1.0;
    var day_pitch: number = 0.0;
    var day_ambient: Color = Color(1.0, 1.0, 1.0);
    var day_ambient_intensity: number = 1.0;
    var day_background: Color = Color(0.0, 0.0, 0.0);
    var day_sea: Color = Color(1.0, 1.0, 1.0);
    var day_sea_alpha: number = 1.0;
    var day_lantern: number = 1.0;
    var day_beacon: number = 1.0;

    fn start() {
        root = World.find("Title");
        fader = World.find("TitleFade");
        camera = World.find("World Camera");
        sun = World.find("Sun");
        world = World.find("Environment");
        lantern = World.find("Lantern Light");
        beacon = World.find("Beacon Light");
        home_position = camera.transform.position;
        home_rotation = camera.transform.rotation;
        CameraRig.on(camera).set_home(home_position, home_rotation);
        day_sun = sun.light.color;
        day_sun_intensity = sun.light.intensity;
        day_pitch = sun.transform.pitch;
        day_ambient = world.environment.ambient_color;
        day_ambient_intensity = world.environment.ambient_intensity;
        day_background = world.environment.background;
        let tiles = World.with_tag("sea");
        if tiles.length > 0 {
            day_sea = tiles[0].sprite.tint;
            day_sea_alpha = tiles[0].sprite.tint.a;
        }
        day_lantern = lantern.light.intensity;
        day_beacon = beacon.light.intensity;
        for i in 0..3 {
            let w = World.spawn(walker);
            World.set_active(w, false);
            walkers.push(w);
            walked.push(i * 3.0);
        }
    }

    on TitleShown() {
        CameraRig.on(camera).battle_view(false);
        stage = Stage.Showing;
        clock = 0.0;
        angle = 0.0;
        howto_open = false;
        World.set_active(root, true);
        World.set_active(fader, true);
        World.set_active(World.find("HowTo"), false);
        for w in walkers { World.set_active(w, true); }
        Audio.play("audio/tide.wav", 0.35);
        print("Causeway title ready");
    }

    fn update(dt: number) {
        match stage {
            Stage.Hidden => {
                World.set_active(fader, false);
                return;
            }
            Stage.Showing => { showing(dt); }
            Stage.Leaving => { leaving(dt); }
        }
        place_camera();
        shade_world();
        walk(dt);
    }

    // --- On the title ---------------------------------------------------------

    fn showing(dt: number) {
        clock += dt;
        mood = min(1.0, mood + dt / 1.2);
        angle = sin(clock * TAU / sway_seconds) * sway;

        // Up out of the dusk, a piece at a time. Not from black: straight after
        // a loading screen, a black frame reads as a game that has hung.
        fade("TitleFade", 0.55 * (1.0 - ramp(0.0, 1.0)));
        fade("TitleShadeTop", ramp(0.3, 1.6));
        if Viewport.aspect > 1.2 { fade("TitleShadeSide", ramp(0.3, 1.6)); } else { fade("TitleShadeSide", 0.0); }
        fade("TitleShadeBottom", ramp(0.3, 1.6));
        fade("TitleHalo", ramp(0.9, 2.2) * 0.9);
        fade("TitleLogo", ramp(1.1, 2.6));
        words("TitleTagline", "Hold the islands  ·  Turn the tide", "f3e3bf", ramp(2.0, 3.0));
        plate("BeginButton", "Begin a crossing", "fff4dc", ramp(2.5, 3.3));
        plate("HowToButton", "How to play", "e9dcc0", ramp(2.7, 3.5));
        let crossings = Save.number("crossings", 0.0);
        var record = "No warden has yet held the whole causeway.";
        if crossings == 1.0 { record = "One crossing made."; }
        if crossings > 1.0 { record = "Crossings made: " + crossings; }
        words("TitleRecord", record, "9fb4bf", ramp(3.0, 3.8));
        var prompt = "";
        // A phone has no Enter key to be told about.
        if Viewport.aspect >= 1.0 && clock > 3.8 {
            prompt = "Press Enter to begin";
        }
        words("TitlePrompt", prompt, "c9d6dc", 0.4 + 0.35 * (0.5 + 0.5 * sin(clock * 2.6)));
        if howto_open {
            plate("HowToClose", "Back", "e9dcc0", 1.0);
        }

        // Nothing is pressed before there is something to see, except by a
        // player who already knows the way in.
        let enter = Input.Keyboard.just_pressed("Enter") || Input.Keyboard.just_pressed("Space");
        if howto_open {
            if enter || Input.Keyboard.just_pressed("Escape") || pressed("HowToClose") {
                show_howto(false);
            }
            return;
        }
        if enter || pressed("BeginButton") {
            leave();
            return;
        }
        if pressed("HowToButton") || Input.Keyboard.just_pressed("H") {
            show_howto(true);
        }
    }

    fn show_howto(on: bool) {
        howto_open = on;
        World.set_active(World.find("HowTo"), on);
        Audio.play("audio/select.wav", 0.3);
    }

    fn leave() {
        stage = Stage.Leaving;
        leave_clock = 0.0;
        swapped = false;
        World.set_active(World.find("HowTo"), false);
        Audio.play("audio/boon.wav", 0.6);
    }

    // --- Into the battle --------------------------------------------------------

    // The menu goes, the camera starts home and the light turns to day; at
    // the darkest of a short dip the title's island is swapped for the first
    // battle's, and the board comes up as the camera settles.
    fn leaving(dt: number) {
        leave_clock += dt;
        let t = min(1.0, leave_clock / leave_seconds);
        let out = 1.0 - smooth(min(1.0, leave_clock / 0.45));
        for name in ["TitleShadeTop", "TitleShadeSide", "TitleShadeBottom", "TitleHalo", "TitleLogo"] {
            fade(name, min(alpha_of(name), out));
        }
        words("TitleTagline", "Hold the islands  ·  Turn the tide", "f3e3bf", out);
        plate("BeginButton", "Begin a crossing", "fff4dc", out);
        plate("HowToButton", "How to play", "e9dcc0", out);
        words("TitleRecord", "", "9fb4bf", 0.0);
        words("TitlePrompt", "", "c9d6dc", 0.0);
        let dip = 0.45;
        let swap_at = dip * leave_seconds;
        if leave_clock < swap_at {
            fade("TitleFade", smooth(leave_clock / swap_at));
        } else {
            if !swapped {
                swapped = true;
                for w in walkers { World.set_active(w, false); }
                World.set_active(root, false);
                CrossingBegins.emit();
            }
            fade("TitleFade", 1.0 - smooth((leave_clock - swap_at) / (leave_seconds - swap_at)));
        }
        mood = 1.0 - smooth(t);
        angle = angle * (1.0 - smooth(t));
        if t >= 1.0 {
            mood = 0.0;
            angle = 0.0;
            stage = Stage.Hidden;
            CameraRig.on(camera).battle_view(true);
            fade("TitleFade", 0.0);
            place_camera();
            shade_world();
        }
    }

    // --- The world behind it ------------------------------------------------------

    // The battle's view, swung round the island, raised and drawn nearer by
    // as much of the title as there is.
    fn place_camera() {
        camera.transform.position = home_position;
        camera.transform.rotation = home_rotation;
        if angle != 0.0 {
            camera.transform.rotate_around(Vec3(PIVOT_X, PIVOT_Y, PIVOT_Z), Vec3(0.0, 1.0, 0.0), angle);
        }
        // The opening pushes out from nearer still.
        var near = 0.0;
        if stage == Stage.Showing { near = 1.0 - smooth(min(1.0, clock / 5.0)); }
        let raise = lift * mood + 1.2 * near;
        var slide = 0.0;
        if Viewport.aspect > 1.2 { slide = side * mood; }
        camera.transform.position = camera.transform.position + camera.transform.up * raise
            - camera.transform.right * slide;
        CameraRig.on(camera).set_zoom(1.0 + (zoom - 1.0) * mood - 0.18 * near);
    }

    // Day for a battle, dusk for the title: a low warm sun, a cool sky, a
    // darker sea and the lamps up.
    fn shade_world() {
        sun.light.color = day_sun.lerp(Color(1.0, 0.46, 0.26), mood);
        sun.light.intensity = day_sun_intensity + (1.35 - day_sun_intensity) * mood;
        sun.transform.pitch = day_pitch + (-0.33 - day_pitch) * mood;
        world.environment.ambient_color = day_ambient.lerp(Color(0.34, 0.34, 0.7), mood);
        world.environment.ambient_intensity = day_ambient_intensity + (0.42 - day_ambient_intensity) * mood;
        world.environment.background = day_background.lerp(Color(0.03, 0.05, 0.1), mood);
        let sea = day_sea.lerp(Color(0.05, 0.16, 0.26), mood);
        for tile in World.with_tag("sea") {
            tile.sprite.tint = sea;
            tile.sprite.tint.a = day_sea_alpha;
        }
        lantern.light.intensity = day_lantern + (4.5 - day_lantern) * mood;
        beacon.light.intensity = day_beacon + (9.0 - day_beacon) * mood;
    }

    // Hollow on the causeway, spaced along it, coming out of the mainland's
    // haze and fading where the island begins.
    fn walk(dt: number) {
        for i in 0..walkers.length {
            let w = walkers[i];
            var along = walked[i] + dt * 0.45;
            let span = ROAD_FAR - ROAD_NEAR;
            if along > span { along -= span; }
            walked[i] = along;
            let x = ROAD_FAR - along;
            let show = min(1.0, along / 0.8) * min(1.0, (x - ROAD_NEAR) / 0.8) * mood;
            let step = abs(sin(Time.elapsed * 5.0 + i * 1.7));
            w.transform.position = Vec3(x, ROAD_TOP + step * 0.06, ROAD_Z + sin(i * 2.3) * 0.25);
            w.transform.yaw = PI + sin(Time.elapsed * 2.5 + i) * 0.08;
            // Off rather than shrunk to nothing where it is all but gone: a
            // figure scaled to a speck has no shape left to draw.
            // And off for good once the title's island has gone.
            let shown = show > 0.02 && !(stage == Stage.Leaving && swapped);
            World.set_active(w, shown);
            if shown {
                w.transform.scale = Vec3(show, show * (1.0 - step * 0.04), show);
            }
        }
    }

    // --- Pieces of the screen ----------------------------------------------------------

    // How far along `from`..`to` seconds the opening is, eased.
    fn ramp(from: number, to: number) -> number {
        return smooth(clamp((clock - from) / (to - from), 0.0, 1.0));
    }

    fn smooth(t: number) -> number {
        return t * t * (3.0 - 2.0 * t);
    }

    fn fade(name: String, alpha: number) {
        let e = World.find(name);
        if e != null { e.ui_image.tint.a = alpha; }
    }

    fn alpha_of(name: String) -> number {
        let e = World.find(name);
        if e == null { return 0.0; }
        return e.ui_image.tint.a;
    }

    fn words(name: String, text: String, rgb: String, alpha: number) {
        let e = World.find(name);
        if e == null { return; }
        if text == "" || alpha <= 0.0 {
            Ui.set_text(e, "");
            return;
        }
        let level = clamp(floor(alpha * 15.0 + 0.5), 0.0, 15.0);
        Ui.set_text(e, "[color=#" + rgb + alpha_hex[level] + "]" + text + "[/color]");
    }

    // A plate button: its plate and label at `alpha`, the plate lit while
    // the pointer is over it and pressed down while held.
    fn plate(name: String, label: String, rgb: String, alpha: number) {
        let button = World.find(name);
        if button == null { return; }
        var light = 0.86;
        if alpha > 0.9 && Ui.is_hovered(button) {
            light = 1.0;
            if hovered != name {
                hovered = name;
                Audio.play("audio/select.wav", 0.15);
            }
        } else if hovered == name {
            hovered = "";
        }
        if Ui.is_held(button) { light = 0.72; }
        let plate = World.find(name + " Plate");
        if plate != null {
            plate.ui_image.tint = Color(light, light, light);
            plate.ui_image.tint.a = alpha;
        }
        words(name + " Label", label, rgb, alpha);
    }

    fn pressed(name: String) -> bool {
        let e = World.find(name);
        return e != null && World.is_active(e) && Ui.is_pressed(e);
    }
}
