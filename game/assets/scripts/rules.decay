// The rules of Causeway, and nothing else.
//
// A battle is one value, a `Board`, and everything that can happen to it is a
// shared function that takes one and gives back the next. Nothing here touches
// an entity, plays a sound or reads the clock: the battle director owns the
// pictures and the timing, and asks these functions what happens.
//
// That split is what lets the game show the future. Aiming a skill runs the
// skill on a copy of the board, and the beats the copy produced are what the
// preview draws; playing it for real runs the same function on the real board.
// A preview and its outcome cannot disagree, because they are one computation.
//
// Every change also leaves a `Beat` behind: a unit walked, a stone flew, a
// Hollow went into the water. The director plays the beats back in order, so
// the rules decide what happened and the pictures only say so.

// The board is always eight cells square.
shared const SIZE: number = 8.0;

enum Kind {
    // The wardens.
    Bulwark,
    Mason,
    Lamplighter,
    Tidecaller,
    Harpooner,
    Shieldback,
    // The Hollow, who cross at low tide.
    Husk,
    Brute,
    Spitter,
    Mortar,
    Colossus,
    // The Hollow of the burning mountain.
    Imp,
    Burster,
    Kiln,
    // The Hollow of the ice.
    Hailer,
    Rimeback,
    // What stands on the island and does not move.
    House,
    Beacon,
    Stone,
    // A crack in a burning island that throws up lava.
    Vent,
}

// What lies on a cell above its ground: nothing, a pool of water, or lava.
shared const DRY: number = 0.0;
shared const WATER: number = 1.0;
shared const LAVA: number = 2.0;
shared const ICE: number = 3.0;

// Rounds a vent rests after it erupts.
shared const VENT_REST: number = 1.0;

enum BeatKind {
    // A unit walked to (x, z) from (tx, tz), one cell at a time.
    Walk,
    // A unit struck towards (tx, tz).
    Strike,
    // A bolt flew from (x, z) to (tx, tz).
    Bolt,
    // A stone or a glob arced from (x, z) to (tx, tz).
    Lob,
    // A unit lost `amount` health.
    Hit,
    // A unit was pushed from (x, z) to (tx, tz).
    Push,
    // A push was stopped at (x, z) by whatever is at (tx, tz).
    Bump,
    // A unit fell from a height and is hurt by it.
    Fall,
    // A Hollow went into the water and sank.
    Drown,
    // A unit was destroyed.
    Die,
    // A Hollow climbed out of the mud at (x, z).
    Emerge,
    // Something stood on a Hollow's way up, and was hurt for it.
    Smother,
    // A stone rose from the ground at (x, z).
    Raise,
    // The tide rose to `amount`.
    Tide,
    // A strike that found nothing.
    Miss,
    // A Hollow went into lava and burned.
    Burn,
    // A unit standing in lava was scorched by it.
    Scorch,
    // A vent at (x, z) threw lava onto (tx, tz).
    Erupt,
    // A pool of `amount` (WATER or LAVA) formed at (x, z).
    Pool,
    // Lava at (x, z) met water at (tx, tz) and both went to steam and stone.
    Quench,
    // The ground at (x, z) rose to `amount`, cooled out of lava and water.
    Basalt,
    // Water hissed at (x, z): a vent choked, a pool dried.
    Steam,
    // A Burster at (x, z) burst and threw everything round it outward.
    Burst,
    // Water was thrown from (x, z) to (tx, tz).
    Douse,
    // A harpoon flew from (x, z) to (tx, tz), and its line went taut.
    Harpoon,
    // A unit at (x, z) was warded against the next blow.
    Ward,
    // A ward at (x, z) took a blow, and the unit under it took none.
    Block,
}

struct Unit {
    id: number,
    kind: Kind,
    x: number,
    z: number,
    hp: number,
    max_hp: number,
    move: number = 3.0,
    // Extra damage a warden's skill does, from upgrades.
    power: number = 0.0,
    moved: bool = false,
    acted: bool = false,
    // Where a warden stood before it moved this turn, so the move can be
    // taken back.
    from_x: number = -1.0,
    from_z: number = -1.0,
    // A Hollow's intent: the direction it will strike, and how far. -1 is
    // none. The direction is kept rather than the target cell, which is the
    // whole game: push a Hollow and its strike goes with it.
    dir: number = -1.0,
    reach: number = 1.0,
    // When it strikes, among the Hollow: 1 first.
    order: number = 0.0,
    // A vent's rounds of rest before it erupts again.
    charge: number = 0.0,
    // Blows a ward will still turn aside this round.
    ward: number = 0.0,
    // A warden's upgrades, as the sum of the `PERK_` flags it has.
    perks: number = 0.0,
}

struct Spawn {
    x: number,
    z: number,
    kind: Kind,
}

struct Beat {
    kind: BeatKind,
    unit: number = -1.0,
    x: number = 0.0,
    z: number = 0.0,
    tx: number = 0.0,
    tz: number = 0.0,
    amount: number = 0.0,
}

struct Board {
    heights: List<number>,
    tide: number,
    units: List<Unit>,
    spawns: List<Spawn>,
    beats: List<Beat>,
    // The round being played, from 1, and how many until high tide.
    round: number,
    rounds: number,
    // The rounds after which the tide comes up a level.
    rises: List<number>,
    // What the island has left to lose; it is the run's, carried between
    // islands, and every point of damage a building takes comes off it.
    hearth: number,
    next_id: number,
    // The kinds that may climb out this round and how many.
    arrivals: List<Kind>,
    // What lies on each cell above its ground: DRY, WATER or LAVA.
    pools: List<number>,
    // Whether what rises round the island is lava rather than the sea.
    molten: bool = false,
    // Whether the island is in the ice, where thrown water freezes.
    frozen: bool = false,
}

// --- Cells and directions ----------------------------------------------

shared fn in_bounds(x: number, z: number) -> bool {
    return x >= 0.0 && z >= 0.0 && x < SIZE && z < SIZE;
}

shared fn cell_of(x: number, z: number) -> number {
    return z * SIZE + x;
}

// North is towards smaller z, then clockwise: east, south, west.
shared fn dir_x(d: number) -> number {
    if d == 1.0 { return 1.0; }
    if d == 3.0 { return -1.0; }
    return 0.0;
}

shared fn dir_z(d: number) -> number {
    if d == 0.0 { return -1.0; }
    if d == 2.0 { return 1.0; }
    return 0.0;
}

// The direction from one cell to another on the same row or column, or -1.
shared fn dir_towards(x: number, z: number, tx: number, tz: number) -> number {
    if tx == x && tz < z { return 0.0; }
    if tz == z && tx > x { return 1.0; }
    if tx == x && tz > z { return 2.0; }
    if tz == z && tx < x { return 3.0; }
    return -1.0;
}

shared fn steps_between(x: number, z: number, tx: number, tz: number) -> number {
    return abs(tx - x) + abs(tz - z);
}

// --- What each kind is ----------------------------------------------------

shared fn is_warden(kind: Kind) -> bool {
    return kind == Kind.Bulwark || kind == Kind.Mason || kind == Kind.Lamplighter
        || kind == Kind.Tidecaller || kind == Kind.Harpooner || kind == Kind.Shieldback;
}

// The six wardens a crossing may be mustered from, in the order the muster
// shows them.
shared const HERO_COUNT: number = 6.0;

shared fn hero_kind(index: number) -> Kind {
    if index == 1.0 { return Kind.Mason; }
    if index == 2.0 { return Kind.Lamplighter; }
    if index == 3.0 { return Kind.Tidecaller; }
    if index == 4.0 { return Kind.Harpooner; }
    if index == 5.0 { return Kind.Shieldback; }
    return Kind.Bulwark;
}

shared fn hero_index(kind: Kind) -> number {
    for i in 0..HERO_COUNT {
        if hero_kind(i) == kind { return i; }
    }
    return -1.0;
}

shared fn is_hollow(kind: Kind) -> bool {
    return kind == Kind.Husk || kind == Kind.Brute || kind == Kind.Spitter
        || kind == Kind.Mortar || kind == Kind.Colossus || kind == Kind.Imp
        || kind == Kind.Burster || kind == Kind.Kiln || kind == Kind.Hailer || kind == Kind.Rimeback;
}

// The Hollow that lob what they throw onto a cell 2 to 4 away.
shared fn is_lobber(kind: Kind) -> bool {
    return kind == Kind.Mortar || kind == Kind.Kiln || kind == Kind.Hailer;
}

// The giants: they sweep the three cells in front, nothing moves them, and
// the sea does not take them.
shared fn is_giant(kind: Kind) -> bool {
    return kind == Kind.Colossus || kind == Kind.Rimeback;
}

// What strikes at the end of the wardens' turn and shows where first: the
// Hollow, and the vents.
shared fn is_threat(kind: Kind) -> bool {
    return is_hollow(kind) || kind == Kind.Vent;
}

// Born of the mountain: lava does not burn these, and water does.
shared fn is_fireproof(kind: Kind) -> bool {
    return kind == Kind.Imp || kind == Kind.Kiln;
}

shared fn is_building(kind: Kind) -> bool {
    return kind == Kind.House || kind == Kind.Beacon;
}

// Nothing pushes these: the buildings, the stones, and the Colossus, which is
// too heavy for anything the wardens carry.
shared fn is_fixed(kind: Kind) -> bool {
    return is_building(kind) || kind == Kind.Stone || is_giant(kind)
        || kind == Kind.Kiln || kind == Kind.Vent;
}

// What a shove, a burst or a harpoon cannot move: the fixed, and the
// Shieldback, who sets its feet.
shared fn is_heavy(kind: Kind) -> bool {
    return is_fixed(kind) || kind == Kind.Shieldback;
}

// --- Upgrades ------------------------------------------------------------------

// Each warden has two upgrades that change how its skill works, won as boons
// on the way. A unit's `perks` is the sum of the ones it has.
shared const PERK_A: number = 1.0;
shared const PERK_B: number = 2.0;

shared fn has_perk(unit: Unit, perk: number) -> bool {
    return knows(unit.perks, perk);
}

// Whether a sum of `PERK_` flags includes `perk`.
shared fn knows(perks: number, perk: number) -> bool {
    return floor(perks / perk) % 2.0 == 1.0;
}

shared fn perk_name(kind: Kind, perk: number) -> String {
    let a = perk == PERK_A;
    return match kind {
        Kind.Bulwark => if_text(a, "Battering Ram", "Shield Up"),
        Kind.Mason => if_text(a, "Avalanche", "Long Arm"),
        Kind.Lamplighter => if_text(a, "Lance", "Blast"),
        Kind.Tidecaller => if_text(a, "Flood", "Undertow"),
        Kind.Harpooner => if_text(a, "Long Line", "Gaff"),
        _ => if_text(a, "Phalanx", "Stand Fast"),
    };
}

shared fn perk_text(kind: Kind, perk: number) -> String {
    let a = perk == PERK_A;
    return match kind {
        Kind.Bulwark => if_text(a, "The bash shoves its target two cells.",
            "After a bash, the Bulwark is warded against the next blow."),
        Kind.Mason => if_text(a, "Everything beside where the stone lands takes 1 before it is shoved.",
            "The stone can be thrown 2 to 6 cells."),
        Kind.Lamplighter => if_text(a, "The bolt goes on through the first figure and strikes the next in line too.",
            "Whatever the bolt strikes is knocked back two cells."),
        Kind.Tidecaller => if_text(a, "The water also falls on the cells either side of the target.",
            "A figure the water strikes is drawn a cell towards the Tidecaller instead of washed away."),
        Kind.Harpooner => if_text(a, "The harpoon reaches to the far edge of the board.",
            "A Hollow hauled in is struck again for 1 when it arrives."),
        _ => if_text(a, "The ward also covers every warden and building beside the one braced.",
            "Wardens beside the Shieldback cannot be shoved."),
    };
}

shared fn if_text(choose: bool, yes: String, no: String) -> String {
    if choose { return yes; }
    return no;
}

// Whether a Shieldback with Stand Fast stands beside (x, z).
shared fn steadied(board: Board, x: number, z: number) -> bool {
    for side in 0..4 {
        let at = unit_at(board, x + dir_x(side), z + dir_z(side));
        if at >= 0.0 {
            let u = board.units[at];
            if u.kind == Kind.Shieldback && u.hp > 0.0 && has_perk(u, PERK_B) { return true; }
        }
    }
    return false;
}

shared fn kind_hp(kind: Kind) -> number {
    return match kind {
        Kind.Bulwark => 4.0,
        Kind.Mason => 3.0,
        Kind.Lamplighter => 3.0,
        Kind.Tidecaller => 3.0,
        Kind.Harpooner => 3.0,
        Kind.Shieldback => 5.0,
        Kind.Husk => 2.0,
        Kind.Brute => 3.0,
        Kind.Spitter => 2.0,
        Kind.Mortar => 2.0,
        Kind.Colossus => 8.0,
        Kind.Imp => 2.0,
        Kind.Burster => 2.0,
        Kind.Kiln => 9.0,
        Kind.Hailer => 2.0,
        Kind.Rimeback => 9.0,
        Kind.House => 1.0,
        Kind.Beacon => 2.0,
        Kind.Stone => 1.0,
        Kind.Vent => 99.0,
    };
}

shared fn kind_move(kind: Kind) -> number {
    return match kind {
        Kind.Bulwark => 3.0,
        Kind.Mason => 3.0,
        Kind.Lamplighter => 4.0,
        Kind.Tidecaller => 3.0,
        Kind.Harpooner => 3.0,
        Kind.Shieldback => 2.0,
        Kind.Husk => 3.0,
        Kind.Brute => 2.0,
        Kind.Spitter => 2.0,
        Kind.Mortar => 2.0,
        Kind.Colossus => 2.0,
        Kind.Imp => 3.0,
        Kind.Burster => 2.0,
        Kind.Kiln => 1.0,
        Kind.Hailer => 2.0,
        Kind.Rimeback => 1.0,
        _ => 0.0,
    };
}

// How hard a Hollow's strike lands.
shared fn kind_damage(kind: Kind) -> number {
    return match kind {
        Kind.Husk => 1.0,
        Kind.Brute => 2.0,
        Kind.Spitter => 1.0,
        Kind.Mortar => 2.0,
        Kind.Colossus => 2.0,
        Kind.Imp => 1.0,
        Kind.Burster => 1.0,
        Kind.Kiln => 2.0,
        Kind.Hailer => 1.0,
        Kind.Rimeback => 3.0,
        _ => 0.0,
    };
}

shared fn kind_name(kind: Kind) -> String {
    return match kind {
        Kind.Bulwark => "Bulwark",
        Kind.Mason => "Mason",
        Kind.Lamplighter => "Lamplighter",
        Kind.Tidecaller => "Tidecaller",
        Kind.Harpooner => "Harpooner",
        Kind.Shieldback => "Shieldback",
        Kind.Husk => "Husk",
        Kind.Brute => "Brute",
        Kind.Spitter => "Spitter",
        Kind.Mortar => "Mortar",
        Kind.Colossus => "The Colossus",
        Kind.Imp => "Cinder Imp",
        Kind.Burster => "Burster",
        Kind.Kiln => "The Kiln",
        Kind.Hailer => "Hailer",
        Kind.Rimeback => "The Rimeback",
        Kind.House => "House",
        Kind.Beacon => "Beacon",
        Kind.Stone => "Stone",
        Kind.Vent => "Vent",
    };
}

shared fn skill_name(kind: Kind) -> String {
    return match kind {
        Kind.Bulwark => "Shield Bash",
        Kind.Mason => "Heave Stone",
        Kind.Lamplighter => "Lantern Bolt",
        Kind.Tidecaller => "Drench",
        Kind.Harpooner => "Harpoon",
        Kind.Shieldback => "Brace",
        Kind.Husk => "Claw",
        Kind.Brute => "Maul",
        Kind.Spitter => "Spit",
        Kind.Mortar => "Lob",
        Kind.Colossus => "Sweep",
        Kind.Imp => "Scratch",
        Kind.Burster => "Butt",
        Kind.Kiln => "Belch",
        Kind.Hailer => "Hail",
        Kind.Rimeback => "Frost Sweep",
        Kind.Vent => "Erupt",
        _ => "",
    };
}

shared fn skill_text(kind: Kind) -> String {
    return match kind {
        Kind.Bulwark => "Strike a neighbour for 2 and shove it a cell away.",
        Kind.Mason => "Throw a stone 2 to 4 cells. It hits for 1 and shoves everything beside it outward. On open ground it stays, a new stone.",
        Kind.Lamplighter => "Fire along a line. The first thing in the way takes 1 and is knocked back a cell.",
        Kind.Tidecaller => "Throw water 1 to 3 cells along a line. Lava cools to stone, and lava by water makes new ground. A figure is washed a cell back; fire takes 2; a vent chokes. Bare ground is left a pool the Hollow cannot cross; in the ice, it freezes.",
        Kind.Harpooner => "Throw a harpoon up to 5 cells along a line and haul in the first thing it bites: a Hollow takes 1 and is dragged to you. Anything too heavy to drag hauls you to it instead.",
        Kind.Shieldback => "Ward itself, or a warden or building up to 2 cells away: the next blow it takes this round does nothing. Too heavy to shove.",
        Kind.Husk => "Claws the cell in front for 1.",
        Kind.Brute => "Mauls the cell in front for 2 and shoves it.",
        Kind.Spitter => "Spits along a line: the first thing in the way takes 1.",
        Kind.Mortar => "Lobs a glob onto a cell 2 to 4 away for 2.",
        Kind.Colossus => "Sweeps the three cells in front for 2. Too heavy to push.",
        Kind.Imp => "Scratches the cell in front for 1. Walks in lava, and leaves lava where it stood. Water puts it out.",
        Kind.Burster => "Butts the cell in front for 1. Bursts when it dies, throwing everything beside it a cell away.",
        Kind.Kiln => "Belches fire onto a cell 2 to 4 away for 2, and leaves it lava. Too heavy to push; water hurts it.",
        Kind.Hailer => "Lobs hail onto a cell 2 to 4 away for 1, and leaves it ice.",
        Kind.Rimeback => "Sweeps the three cells in front for 3 and leaves them ice. Too heavy to push.",
        Kind.Vent => "Throws lava 2 or 3 cells every other round. Water chokes it for a round.",
        Kind.House => "Somebody lives here. Every point of damage costs the Hearth.",
        Kind.Beacon => "The island's beacon. Every point of damage costs the Hearth.",
        Kind.Stone => "In the way. Shoving something into it hurts both.",
        _ => "",
    };
}

// --- Reading the board ------------------------------------------------------

shared fn height_at(board: Board, x: number, z: number) -> number {
    return board.heights[cell_of(x, z)];
}

shared fn pool_at(board: Board, x: number, z: number) -> number {
    return board.pools[cell_of(x, z)];
}

// Whether what rises round the island covers a cell.
shared fn under_level(board: Board, x: number, z: number) -> bool {
    return height_at(board, x, z) <= board.tide;
}

shared fn is_water(board: Board, x: number, z: number) -> bool {
    if under_level(board, x, z) { return !board.molten; }
    return pool_at(board, x, z) == WATER;
}

shared fn is_lava(board: Board, x: number, z: number) -> bool {
    if under_level(board, x, z) { return board.molten; }
    return pool_at(board, x, z) == LAVA;
}

// Whether water or lava covers a cell rather than bare ground.
// Ice: ground that holds anyone up, and lets nothing shoved onto it stop.
shared fn is_ice(board: Board, x: number, z: number) -> bool {
    return !under_level(board, x, z) && pool_at(board, x, z) == ICE;
}

shared fn is_wet(board: Board, x: number, z: number) -> bool {
    return is_water(board, x, z) || is_lava(board, x, z);
}

// How high something standing on a cell stands: on the ground, or on the
// water where the sea covers it.
shared fn stand_height(board: Board, x: number, z: number) -> number {
    return max(height_at(board, x, z), board.tide);
}

// The index of the unit standing on a cell, or -1. The fallen stand nowhere.
shared fn unit_at(board: Board, x: number, z: number) -> number {
    for i in 0..board.units.length {
        let u = board.units[i];
        if u.hp > 0.0 && u.x == x && u.z == z {
            return i;
        }
    }
    return -1.0;
}

shared fn unit_index(board: Board, id: number) -> number {
    for i in 0..board.units.length {
        if board.units[i].id == id {
            return i;
        }
    }
    return -1.0;
}

shared fn spawn_at(board: Board, x: number, z: number) -> bool {
    for s in board.spawns {
        if s.x == x && s.z == z {
            return true;
        }
    }
    return false;
}

shared fn count_alive(board: Board, wardens: bool) -> number {
    var count = 0.0;
    for u in board.units {
        if u.hp > 0.0 {
            if wardens && is_warden(u.kind) { count += 1.0; }
            if !wardens && is_hollow(u.kind) { count += 1.0; }
        }
    }
    return count;
}

// Whether the tide comes up at the end of this round.
shared fn rises_this_round(board: Board) -> bool {
    return board.rises.contains(board.round);
}

// Whether a cell will be under water once this round's tide has come.
shared fn floods_next(board: Board, x: number, z: number) -> bool {
    if rises_this_round(board) {
        return height_at(board, x, z) <= board.tide + 1.0;
    }
    return is_wet(board, x, z);
}

// Whether a unit of this kind may stand on a cell. The Hollow are made of the
// mud they climb out of, and water takes them apart, but the ones born of the
// mountain stand in lava. The wardens wade water, and nobody walks into lava
// who can burn.
shared fn can_stand(board: Board, kind: Kind, x: number, z: number) -> bool {
    if !in_bounds(x, z) { return false; }
    if is_water(board, x, z) && is_hollow(kind) && !is_giant(kind) { return false; }
    if is_lava(board, x, z) && !is_fireproof(kind) { return false; }
    return true;
}

// Whether what is rising round the island will not hurt this kind.
shared fn braves_level(board: Board, kind: Kind) -> bool {
    if board.molten { return is_fireproof(kind); }
    return is_giant(kind) || is_warden(kind);
}

// Every cell a unit can walk to this turn, as cell indices, nearest first.
// A step climbs or drops at most one level, and nothing walks through
// anything else.
shared fn reachable(board: Board, index: number) -> List<number> {
    let unit = board.units[index];
    var found: List<number> = [];
    var cost: List<number> = [];
    for i in 0..(SIZE * SIZE) { cost.push(-1.0); }
    var frontier: List<number> = [cell_of(unit.x, unit.z)];
    cost[cell_of(unit.x, unit.z)] = 0.0;
    var head = 0.0;
    while head < frontier.length {
        let c = frontier[head];
        head += 1.0;
        let cx = c % SIZE;
        let cz = floor(c / SIZE);
        if cost[c] >= unit.move { continue; }
        for d in 0..4 {
            let nx = cx + dir_x(d);
            let nz = cz + dir_z(d);
            if !in_bounds(nx, nz) { continue; }
            let n = cell_of(nx, nz);
            if cost[n] >= 0.0 { continue; }
            if !can_stand(board, unit.kind, nx, nz) { continue; }
            if abs(stand_height(board, nx, nz) - stand_height(board, cx, cz)) > 1.0 { continue; }
            if unit_at(board, nx, nz) >= 0.0 { continue; }
            cost[n] = cost[c] + 1.0;
            frontier.push(n);
            found.push(n);
        }
    }
    return found;
}

// The cells a walk passes through, start excluded, found the same way as
// `reachable` and walked back from the end.
shared fn walk_path(board: Board, index: number, tx: number, tz: number) -> List<number> {
    let unit = board.units[index];
    var came: List<number> = [];
    for i in 0..(SIZE * SIZE) { came.push(-1.0); }
    let start = cell_of(unit.x, unit.z);
    let goal = cell_of(tx, tz);
    var frontier: List<number> = [start];
    came[start] = start;
    var head = 0.0;
    while head < frontier.length {
        let c = frontier[head];
        head += 1.0;
        if c == goal { break; }
        let cx = c % SIZE;
        let cz = floor(c / SIZE);
        for d in 0..4 {
            let nx = cx + dir_x(d);
            let nz = cz + dir_z(d);
            if !in_bounds(nx, nz) { continue; }
            let n = cell_of(nx, nz);
            if came[n] >= 0.0 { continue; }
            if !can_stand(board, unit.kind, nx, nz) { continue; }
            if abs(stand_height(board, nx, nz) - stand_height(board, cx, cz)) > 1.0 { continue; }
            if unit_at(board, nx, nz) >= 0.0 { continue; }
            came[n] = c;
            frontier.push(n);
        }
    }
    var path: List<number> = [];
    if came[goal] < 0.0 { return path; }
    var at = goal;
    while at != start {
        path.insert(0, at);
        at = came[at];
    }
    return path;
}

// --- Changing the board ------------------------------------------------------

shared fn with_beat(board: Board, beat: Beat) -> Board {
    var next = board;
    next.beats.push(beat);
    return next;
}

// Moves a unit along a walk, leaving one beat per cell so the picture can hop
// it there.
shared fn walk(board: Board, index: number, tx: number, tz: number) -> Board {
    var next = board;
    var unit = next.units[index];
    let path = walk_path(board, index, tx, tz);
    var px = unit.x;
    var pz = unit.z;
    for c in path {
        let cx = c % SIZE;
        let cz = floor(c / SIZE);
        next.beats.push(Beat(kind: BeatKind.Walk, unit: unit.id, x: cx, z: cz, tx: px, tz: pz));
        px = cx;
        pz = cz;
    }
    unit.x = tx;
    unit.z = tz;
    next.units[index] = unit;
    return next;
}

// Takes health off a unit. A building's loss comes off the Hearth too, point
// for point, and anything that reaches nothing is gone.
shared fn hurt(board: Board, index: number, amount: number) -> Board {
    var next = board;
    var unit = next.units[index];
    if unit.hp <= 0.0 || amount <= 0.0 { return next; }
    if unit.ward > 0.0 {
        unit.ward -= 1.0;
        next.units[index] = unit;
        next.beats.push(Beat(kind: BeatKind.Block, unit: unit.id, x: unit.x, z: unit.z));
        return next;
    }
    let taken = min(unit.hp, amount);
    unit.hp -= taken;
    next.beats.push(Beat(kind: BeatKind.Hit, unit: unit.id, x: unit.x, z: unit.z, amount: taken));
    if is_building(unit.kind) {
        next.hearth = max(0.0, next.hearth - taken);
    }
    if unit.hp <= 0.0 {
        next.beats.push(Beat(kind: BeatKind.Die, unit: unit.id, x: unit.x, z: unit.z));
    }
    next.units[index] = unit;
    if unit.hp <= 0.0 && unit.kind == Kind.Burster {
        next = burst(next, unit.x, unit.z);
    }
    return next;
}

// A Burster dies loud: everything beside it is thrown a cell outward, and
// another Burster thrown into something may go the same way.
shared fn burst(board: Board, x: number, z: number) -> Board {
    var next = board;
    next.beats.push(Beat(kind: BeatKind.Burst, x: x, z: z));
    for side in 0..4 {
        next = push(next, x + dir_x(side), z + dir_z(side), side);
    }
    return next;
}

shared fn hurt_at(board: Board, x: number, z: number, amount: number) -> Board {
    let index = unit_at(board, x, z);
    if index < 0.0 { return board; }
    return hurt(board, index, amount);
}

// The sea takes a Hollow standing in it.
shared fn drown(board: Board, index: number) -> Board {
    var next = board;
    var unit = next.units[index];
    if unit.hp <= 0.0 { return next; }
    unit.hp = 0.0;
    next.units[index] = unit;
    next.beats.push(Beat(kind: BeatKind.Drown, unit: unit.id, x: unit.x, z: unit.z));
    return next;
}

// Lava takes a Hollow standing in it.
shared fn burn(board: Board, index: number) -> Board {
    var next = board;
    var unit = next.units[index];
    if unit.hp <= 0.0 { return next; }
    unit.hp = 0.0;
    next.units[index] = unit;
    next.beats.push(Beat(kind: BeatKind.Burn, unit: unit.id, x: unit.x, z: unit.z));
    return next;
}

// A Hollow where it cannot stand: lava burns it, water drowns it.
shared fn sink(board: Board, index: number) -> Board {
    let unit = board.units[index];
    if in_bounds(unit.x, unit.z) && is_lava(board, unit.x, unit.z) { return burn(board, index); }
    if !in_bounds(unit.x, unit.z) && board.molten { return burn(board, index); }
    return drown(board, index);
}

// A warden in lava: it is scorched, and climbs out next turn if it can.
shared fn scorch(board: Board, index: number, amount: number) -> Board {
    var next = board;
    let unit = next.units[index];
    next.beats.push(Beat(kind: BeatKind.Scorch, unit: unit.id, x: unit.x, z: unit.z, amount: amount));
    return hurt(next, index, amount);
}

// Shoves whatever stands on (x, z) one cell in direction `d`.
//
// Into something: both take 1 and neither moves. Up a step of two or more:
// it hits the wall and takes 1. Off a drop of two or more: it lands, and
// takes 1. Into the sea, a Hollow sinks.
shared fn push(board: Board, x: number, z: number, d: number) -> Board {
    let index = unit_at(board, x, z);
    if index < 0.0 { return board; }
    let unit = board.units[index];
    if is_heavy(unit.kind) { return board; }
    if is_warden(unit.kind) && steadied(board, x, z) { return board; }
    let tx = x + dir_x(d);
    let tz = z + dir_z(d);
    var next = board;
    if !in_bounds(tx, tz) {
        // The edge of the board is the deep channel. A Hollow shoved off it
        // is gone; a warden catches itself on the edge.
        if is_hollow(unit.kind) {
            next.beats.push(Beat(kind: BeatKind.Push, unit: unit.id, x: x, z: z, tx: tx, tz: tz));
            var gone = next.units[index];
            gone.x = tx;
            gone.z = tz;
            next.units[index] = gone;
            return sink(next, index);
        }
        next.beats.push(Beat(kind: BeatKind.Bump, unit: unit.id, x: x, z: z, tx: tx, tz: tz));
        return next;
    }
    let other = unit_at(board, tx, tz);
    if other >= 0.0 {
        next.beats.push(Beat(kind: BeatKind.Bump, unit: unit.id, x: x, z: z, tx: tx, tz: tz));
        next = hurt(next, index, 1.0);
        return hurt(next, other, 1.0);
    }
    let rise = stand_height(board, tx, tz) - stand_height(board, x, z);
    if rise >= 2.0 {
        next.beats.push(Beat(kind: BeatKind.Bump, unit: unit.id, x: x, z: z, tx: tx, tz: tz));
        return hurt(next, index, 1.0);
    }
    var moved = next.units[index];
    moved.x = tx;
    moved.z = tz;
    next.units[index] = moved;
    next.beats.push(Beat(kind: BeatKind.Push, unit: unit.id, x: x, z: z, tx: tx, tz: tz));
    if is_hollow(unit.kind) && !can_stand(next, unit.kind, tx, tz) {
        return sink(next, index);
    }
    if is_warden(unit.kind) && is_lava(next, tx, tz) {
        next = scorch(next, index, 2.0);
    }
    if rise <= -2.0 {
        next.beats.push(Beat(kind: BeatKind.Fall, unit: unit.id, x: tx, z: tz));
        next = hurt(next, index, 1.0);
    }
    return slide(next, unit.id, d);
}

// Whatever a shove leaves on ice keeps going the same way, a cell at a time,
// until it is off the ice or something stops it.
shared fn slide(board: Board, id: number, d: number) -> Board {
    let at = unit_index(board, id);
    if at < 0.0 { return board; }
    let unit = board.units[at];
    if unit.hp <= 0.0 || !in_bounds(unit.x, unit.z) || !is_ice(board, unit.x, unit.z) { return board; }
    return push(board, unit.x, unit.z, d);
}

// The first cell along a line from (x, z) that something stands on, as a cell
// index, or the last cell on the board when nothing does. `ignore` is a unit
// id the line passes through: the shooter, wherever it is imagined to stand.
shared fn line_end(board: Board, x: number, z: number, d: number, ignore: number) -> number {
    var cx = x + dir_x(d);
    var cz = z + dir_z(d);
    var last = -1.0;
    while in_bounds(cx, cz) {
        let at = unit_at(board, cx, cz);
        if at >= 0.0 && board.units[at].id != ignore {
            return cell_of(cx, cz);
        }
        last = cell_of(cx, cz);
        cx += dir_x(d);
        cz += dir_z(d);
    }
    return last;
}

// --- The wardens' skills -------------------------------------------------------

// Every cell a warden's skill may be aimed at from where it stands.
shared fn skill_targets(board: Board, index: number) -> List<number> {
    let unit = board.units[index];
    var cells: List<number> = [];
    for d in 0..4 {
        var low = 1.0;
        var high = 1.0;
        if unit.kind == Kind.Mason {
            low = 2.0;
            high = 4.0;
            if has_perk(unit, PERK_B) { high = 6.0; }
        }
        if unit.kind == Kind.Lamplighter { high = SIZE; }
        if unit.kind == Kind.Tidecaller { high = 3.0; }
        if unit.kind == Kind.Harpooner {
            high = 5.0;
            if has_perk(unit, PERK_A) { high = SIZE; }
        }
        if unit.kind == Kind.Shieldback { high = 2.0; }
        for r in low..(high + 1.0) {
            let tx = unit.x + dir_x(d) * r;
            let tz = unit.z + dir_z(d) * r;
            if in_bounds(tx, tz) {
                cells.push(cell_of(tx, tz));
            }
        }
    }
    // The Shieldback may brace itself where it stands.
    if unit.kind == Kind.Shieldback { cells.push(cell_of(unit.x, unit.z)); }
    return cells;
}

// Uses a warden's skill on a cell, which must be one of its targets.
shared fn use_skill(board: Board, index: number, tx: number, tz: number) -> Board {
    var next = board;
    var unit = next.units[index];
    let d = dir_towards(unit.x, unit.z, tx, tz);
    let own = tx == unit.x && tz == unit.z;
    if d < 0.0 && !(own && unit.kind == Kind.Shieldback) { return board; }
    unit.acted = true;
    unit.moved = true;
    next.units[index] = unit;
    if unit.kind == Kind.Shieldback {
        return brace(next, index, tx, tz);
    }
    if unit.kind == Kind.Harpooner {
        return harpoon(next, index, d);
    }
    if unit.kind == Kind.Bulwark {
        next.beats.push(Beat(kind: BeatKind.Strike, unit: unit.id, x: unit.x, z: unit.z, tx: tx, tz: tz));
        if unit_at(next, tx, tz) < 0.0 {
            next.beats.push(Beat(kind: BeatKind.Miss, unit: unit.id, x: tx, z: tz));
            return next;
        }
        let struck = next.units[unit_at(next, tx, tz)].id;
        next = hurt_at(next, tx, tz, 2.0 + unit.power);
        if has_perk(unit, PERK_A) {
            next = haul(next, struck, d, 2.0);
        } else {
            next = push(next, tx, tz, d);
        }
        if has_perk(unit, PERK_B) {
            let me = unit_index(next, unit.id);
            if me >= 0.0 && next.units[me].hp > 0.0 {
                var guarded = next.units[me];
                guarded.ward = max(guarded.ward, 1.0);
                next.units[me] = guarded;
                next.beats.push(Beat(kind: BeatKind.Ward, unit: unit.id, x: guarded.x, z: guarded.z));
            }
        }
        return next;
    }
    if unit.kind == Kind.Lamplighter {
        let end = line_end(next, unit.x, unit.z, d, unit.id);
        let ex = end % SIZE;
        let ez = floor(end / SIZE);
        next.beats.push(Beat(kind: BeatKind.Bolt, unit: unit.id, x: unit.x, z: unit.z, tx: ex, tz: ez));
        if unit_at(next, ex, ez) < 0.0 {
            next.beats.push(Beat(kind: BeatKind.Miss, unit: unit.id, x: ex, z: ez));
            return next;
        }
        let first = next.units[unit_at(next, ex, ez)].id;
        // With Lance the bolt goes on to the next figure in line.
        var second = -1.0;
        if has_perk(unit, PERK_A) {
            let beyond = line_end(next, ex, ez, d, unit.id);
            let sx = beyond % SIZE;
            let sz = floor(beyond / SIZE);
            let at = unit_at(next, sx, sz);
            if at >= 0.0 && !(sx == ex && sz == ez) {
                second = next.units[at].id;
                next.beats.push(Beat(kind: BeatKind.Bolt, unit: unit.id, x: ex, z: ez, tx: sx, tz: sz));
            }
        }
        var knock = 1.0;
        if has_perk(unit, PERK_B) { knock = 2.0; }
        for id in [first, second] {
            let at = unit_index(next, id);
            if id < 0.0 || at < 0.0 || next.units[at].hp <= 0.0 { continue; }
            next = hurt(next, at, 1.0 + unit.power);
            next = haul(next, id, d, knock);
        }
        return next;
    }
    if unit.kind == Kind.Tidecaller {
        next = drench(next, index, tx, tz, d);
        if has_perk(unit, PERK_A) {
            // Flood: the cells either side of the target too.
            for side in [(d + 1.0) % 4.0, (d + 3.0) % 4.0] {
                let sx = tx + dir_x(side);
                let sz = tz + dir_z(side);
                if in_bounds(sx, sz) { next = drench(next, unit_index(next, unit.id), sx, sz, d); }
            }
        }
        return next;
    }
    // The Mason's stone.
    next.beats.push(Beat(kind: BeatKind.Lob, unit: unit.id, x: unit.x, z: unit.z, tx: tx, tz: tz));
    if unit_at(next, tx, tz) >= 0.0 {
        next = hurt_at(next, tx, tz, 1.0 + unit.power);
    } else if !is_wet(next, tx, tz) {
        next = raise_stone(next, tx, tz);
    } else {
        next.beats.push(Beat(kind: BeatKind.Miss, unit: unit.id, x: tx, z: tz));
    }
    for side in 0..4 {
        if has_perk(unit, PERK_A) { next = hurt_at(next, tx + dir_x(side), tz + dir_z(side), 1.0); }
        next = push(next, tx + dir_x(side), tz + dir_z(side), side);
    }
    return next;
}

// The Shieldback's ward, on whatever stands at (tx, tz): a warden or a
// building turns the next blow aside. A Hollow or bare ground is no use.
shared fn brace(board: Board, index: number, tx: number, tz: number) -> Board {
    var next = board;
    let unit = next.units[index];
    let at = unit_at(next, tx, tz);
    if at < 0.0 || !(is_warden(next.units[at].kind) || is_building(next.units[at].kind)) {
        next.beats.push(Beat(kind: BeatKind.Miss, unit: unit.id, x: tx, z: tz));
        return next;
    }
    var warded = next.units[at];
    warded.ward = 1.0 + unit.power;
    next.units[at] = warded;
    next.beats.push(Beat(kind: BeatKind.Ward, unit: warded.id, x: tx, z: tz));
    if has_perk(unit, PERK_A) {
        // Phalanx: everyone it protects beside the one braced.
        for side in 0..4 {
            let beside = unit_at(next, tx + dir_x(side), tz + dir_z(side));
            if beside < 0.0 { continue; }
            var also = next.units[beside];
            if !(is_warden(also.kind) || is_building(also.kind)) || also.hp <= 0.0 { continue; }
            also.ward = max(also.ward, 1.0 + unit.power);
            next.units[beside] = also;
            next.beats.push(Beat(kind: BeatKind.Ward, unit: also.id, x: also.x, z: also.z));
        }
    }
    return next;
}

// The Harpooner's harpoon, thrown along direction `d` at the first thing in
// reach. A Hollow is hurt and hauled in, a cell at a time, until it is beside
// the Harpooner or something stops it; a warden is hauled the same way,
// unhurt. Whatever cannot be dragged hauls the Harpooner to it instead.
shared fn harpoon(board: Board, index: number, d: number) -> Board {
    var next = board;
    let unit = next.units[index];
    var reach = 0.0;
    var hx = unit.x;
    var hz = unit.z;
    var hit = -1.0;
    var most = 5.0;
    if has_perk(unit, PERK_A) { most = SIZE; }
    while reach < most && hit < 0.0 {
        let cx = hx + dir_x(d);
        let cz = hz + dir_z(d);
        if !in_bounds(cx, cz) { break; }
        hx = cx;
        hz = cz;
        reach += 1.0;
        hit = unit_at(next, hx, hz);
    }
    next.beats.push(Beat(kind: BeatKind.Harpoon, unit: unit.id, x: unit.x, z: unit.z, tx: hx, tz: hz));
    if hit < 0.0 {
        next.beats.push(Beat(kind: BeatKind.Miss, unit: unit.id, x: hx, z: hz));
        return next;
    }
    let target = next.units[hit];
    if is_hollow(target.kind) {
        next = hurt(next, hit, 1.0 + unit.power);
    }
    let back = (d + 2.0) % 4.0;
    if is_heavy(target.kind) {
        // Hauled along the line to it, the same way a shove moves anyone.
        return haul(next, unit.id, d, steps_between(unit.x, unit.z, hx, hz) - 1.0);
    }
    next = haul(next, target.id, back, steps_between(unit.x, unit.z, hx, hz) - 1.0);
    if has_perk(unit, PERK_B) && is_hollow(target.kind) {
        // Gaff: struck again as it arrives.
        let at = unit_index(next, target.id);
        if at >= 0.0 && next.units[at].hp > 0.0 { next = hurt(next, at, 1.0); }
    }
    return next;
}

// Drags a unit up to `cells` cells in direction `d`, one shove at a time,
// stopping as soon as a shove does not move it or it is gone.
shared fn haul(board: Board, id: number, d: number, cells: number) -> Board {
    var next = board;
    for step in 0..cells {
        let at = unit_index(next, id);
        if at < 0.0 { return next; }
        let before = next.units[at];
        if before.hp <= 0.0 { return next; }
        next = push(next, before.x, before.z, d);
        let after = next.units[unit_index(next, id)];
        if after.x == before.x && after.z == before.z { return next; }
        if after.hp <= 0.0 || !in_bounds(after.x, after.z) { return next; }
    }
    return next;
}

// The Tidecaller's water, thrown onto (tx, tz) in direction `d`.
shared fn drench(board: Board, index: number, tx: number, tz: number, d: number) -> Board {
    var next = board;
    let unit = next.units[index];
    next.beats.push(Beat(kind: BeatKind.Douse, unit: unit.id, x: unit.x, z: unit.z, tx: tx, tz: tz));
    let at = unit_at(next, tx, tz);
    if at >= 0.0 {
        let target = next.units[at];
        if target.kind == Kind.Vent {
            // Choked: it throws nothing this round, and tries again next.
            var vent = target;
            vent.dir = -1.0;
            next.units[at] = vent;
            next.beats.push(Beat(kind: BeatKind.Steam, x: tx, z: tz));
            return next;
        }
        if is_fireproof(target.kind) {
            next.beats.push(Beat(kind: BeatKind.Steam, x: tx, z: tz));
            next = hurt(next, at, 2.0 + unit.power);
        }
        // Undertow draws it in rather than washing it away.
        var way = d;
        if has_perk(unit, PERK_B) { way = (d + 2.0) % 4.0; }
        next = push(next, tx, tz, way);
        return settle(next);
    }
    if is_lava(next, tx, tz) {
        next.beats.push(Beat(kind: BeatKind.Steam, x: tx, z: tz));
        return settle(cool(next, tx, tz));
    }
    // In the ice, water thrown on the ground freezes where it lands.
    if next.frozen {
        if is_ice(next, tx, tz) || under_level(next, tx, tz) {
            next.beats.push(Beat(kind: BeatKind.Miss, unit: unit.id, x: tx, z: tz));
            return next;
        }
        return make_pool(next, tx, tz, ICE);
    }
    if is_water(next, tx, tz) {
        next.beats.push(Beat(kind: BeatKind.Miss, unit: unit.id, x: tx, z: tz));
        return next;
    }
    return settle(make_pool(next, tx, tz, WATER));
}

// Leaves a pool on bare ground.
shared fn make_pool(board: Board, x: number, z: number, pool: number) -> Board {
    if !in_bounds(x, z) || under_level(board, x, z) { return board; }
    var next = board;
    next.pools[cell_of(x, z)] = pool;
    next.beats.push(Beat(kind: BeatKind.Pool, x: x, z: z, amount: pool));
    return next;
}

// Water or lava at a cell set hard: a pool dries off, and where the level
// itself is cooled the ground rises out of it, a new cell to stand on.
shared fn cool(board: Board, x: number, z: number) -> Board {
    var next = board;
    let c = cell_of(x, z);
    if under_level(next, x, z) {
        next.heights[c] = next.tide + 1.0;
        next.pools[c] = DRY;
        next.beats.push(Beat(kind: BeatKind.Basalt, x: x, z: z, amount: next.heights[c]));
        return next;
    }
    next.pools[c] = DRY;
    next.beats.push(Beat(kind: BeatKind.Pool, x: x, z: z, amount: DRY));
    return next;
}

// Wherever lava now touches water, the two quench each other: both set, in
// steam, and new ground rises out of whichever was the level.
//
// What rises round the island is all one liquid, so lava can only meet water
// where at least one of them is a pool: only pools are looked round. That
// keeps this cheap enough to run after every change, which the bot does
// thousands of times a turn.
shared fn settle(board: Board) -> Board {
    var next = board;
    var changed = true;
    while changed {
        changed = false;
        for c in 0..(SIZE * SIZE) {
            let pool = next.pools[c];
            if pool == DRY || pool == ICE { continue; }
            let x = c % SIZE;
            let z = floor(c / SIZE);
            for d in 0..4 {
                let nx = x + dir_x(d);
                let nz = z + dir_z(d);
                if !in_bounds(nx, nz) { continue; }
                var meets = false;
                if pool == LAVA { meets = is_water(next, nx, nz); } else { meets = is_lava(next, nx, nz); }
                if !meets { continue; }
                if pool == LAVA {
                    next.beats.push(Beat(kind: BeatKind.Quench, x: x, z: z, tx: nx, tz: nz));
                } else {
                    next.beats.push(Beat(kind: BeatKind.Quench, x: nx, z: nz, tx: x, tz: z));
                }
                next = cool(next, x, z);
                next = cool(next, nx, nz);
                changed = true;
                break;
            }
        }
    }
    return next;
}

shared fn raise_stone(board: Board, x: number, z: number) -> Board {
    var next = board;
    next.units.push(Unit(id: next.next_id, kind: Kind.Stone, x: x, z: z,
        hp: kind_hp(Kind.Stone), max_hp: kind_hp(Kind.Stone), move: 0.0));
    next.beats.push(Beat(kind: BeatKind.Raise, unit: next.next_id, x: x, z: z));
    next.next_id += 1.0;
    return next;
}

// Puts a warden back where it started this turn, if it has not acted.
shared fn undo_move(board: Board, index: number) -> Board {
    var next = board;
    var unit = next.units[index];
    if !unit.moved || unit.acted || unit.from_x < 0.0 { return board; }
    unit.x = unit.from_x;
    unit.z = unit.from_z;
    unit.moved = false;
    next.units[index] = unit;
    return next;
}

// A warden walks to a cell it can reach.
shared fn move_warden(board: Board, index: number, tx: number, tz: number) -> Board {
    var unit = board.units[index];
    if unit.moved || unit.acted { return board; }
    if !reachable(board, index).contains(cell_of(tx, tz)) { return board; }
    unit.from_x = unit.x;
    unit.from_z = unit.z;
    unit.moved = true;
    var next = board;
    next.units[index] = unit;
    return walk(next, index, tx, tz);
}

// --- The Hollow ---------------------------------------------------------------

// Every cell a Hollow's strike reaches from (x, z) in direction `d`, as cell
// indices: one for most, the three in front for the Colossus, and the end of
// the line for a Spitter. `ignore` is the striker's own id.
shared fn strike_cells(board: Board, kind: Kind, x: number, z: number, d: number, reach: number,
    ignore: number) -> List<number> {
    var cells: List<number> = [];
    if kind == Kind.Spitter {
        let end = line_end(board, x, z, d, ignore);
        if end >= 0.0 { cells.push(end); }
        return cells;
    }
    let tx = x + dir_x(d) * reach;
    let tz = z + dir_z(d) * reach;
    if in_bounds(tx, tz) { cells.push(cell_of(tx, tz)); }
    if is_giant(kind) {
        // The two cells either side of the one in front.
        let sx = dir_x((d + 1.0) % 4.0);
        let sz = dir_z((d + 1.0) % 4.0);
        if in_bounds(tx + sx, tz + sz) { cells.push(cell_of(tx + sx, tz + sz)); }
        if in_bounds(tx - sx, tz - sz) { cells.push(cell_of(tx - sx, tz - sz)); }
    }
    return cells;
}

// One Hollow carries out the strike it showed, from wherever it stands now.
shared fn hollow_strike(board: Board, index: number) -> Board {
    let unit = board.units[index];
    if unit.hp <= 0.0 || unit.dir < 0.0 { return board; }
    var next = board;
    let cells = strike_cells(board, unit.kind, unit.x, unit.z, unit.dir, unit.reach, unit.id);
    if cells.length == 0.0 {
        return next;
    }
    let first = cells[0];
    let fx = first % SIZE;
    let fz = floor(first / SIZE);
    if unit.kind == Kind.Spitter {
        next.beats.push(Beat(kind: BeatKind.Bolt, unit: unit.id, x: unit.x, z: unit.z, tx: fx, tz: fz));
    } else if is_lobber(unit.kind) {
        next.beats.push(Beat(kind: BeatKind.Lob, unit: unit.id, x: unit.x, z: unit.z, tx: fx, tz: fz));
    } else {
        next.beats.push(Beat(kind: BeatKind.Strike, unit: unit.id, x: unit.x, z: unit.z, tx: fx, tz: fz));
    }
    var landed = false;
    for c in cells {
        let cx = c % SIZE;
        let cz = floor(c / SIZE);
        if unit_at(next, cx, cz) >= 0.0 {
            landed = true;
            next = hurt_at(next, cx, cz, kind_damage(unit.kind));
            if unit.kind == Kind.Brute {
                next = push(next, cx, cz, unit.dir);
            }
        }
    }
    if !landed {
        next.beats.push(Beat(kind: BeatKind.Miss, unit: unit.id, x: fx, z: fz));
    }
    if unit.kind == Kind.Kiln {
        next = spill_lava(next, fx, fz);
    }
    // Hail and the Rimeback's breath leave the ground they hit iced over.
    if unit.kind == Kind.Hailer || unit.kind == Kind.Rimeback {
        for c in cells { next = freeze(next, c % SIZE, floor(c / SIZE)); }
    }
    return next;
}

// Ices a cell over: bare ground or a pool of water. Lava and the sea are
// too much for it.
shared fn freeze(board: Board, x: number, z: number) -> Board {
    if !in_bounds(x, z) || under_level(board, x, z) { return board; }
    let pool = pool_at(board, x, z);
    if pool != DRY && pool != WATER { return board; }
    return make_pool(board, x, z, ICE);
}

// Lava thrown onto a cell: a Hollow there burns, a building is lost, a warden
// is scorched and thrown clear, and the cell is left a lava pool.
shared fn spill_lava(board: Board, x: number, z: number) -> Board {
    var next = board;
    if !in_bounds(x, z) || is_wet(next, x, z) { return next; }
    let at = unit_at(next, x, z);
    if at >= 0.0 {
        let unit = next.units[at];
        if is_building(unit.kind) || unit.kind == Kind.Stone {
            next = hurt(next, at, unit.hp);
        } else if is_hollow(unit.kind) && !is_fireproof(unit.kind) {
            next = make_pool(next, x, z, LAVA);
            next = burn(next, at);
            return settle(next);
        }
    }
    next = make_pool(next, x, z, LAVA);
    let still = unit_at(next, x, z);
    if still >= 0.0 && is_warden(next.units[still].kind) {
        next = scorch(next, still, 1.0);
    }
    return settle(next);
}

// A vent throws what it aimed at. It rests after, unless it was choked.
shared fn erupt(board: Board, index: number) -> Board {
    var next = board;
    var vent = next.units[index];
    if vent.dir < 0.0 { return next; }
    let tx = vent.x + dir_x(vent.dir) * vent.reach;
    let tz = vent.z + dir_z(vent.dir) * vent.reach;
    next.beats.push(Beat(kind: BeatKind.Erupt, unit: vent.id, x: vent.x, z: vent.z, tx: tx, tz: tz));
    vent.dir = -1.0;
    vent.charge = VENT_REST;
    next.units[index] = vent;
    let at = unit_at(next, tx, tz);
    if at >= 0.0 && is_warden(next.units[at].kind) {
        // Thrown clear of it, the way the lava came.
        next = hurt(next, at, 1.0);
        next = push(next, tx, tz, board.units[index].dir);
    }
    return spill_lava(next, tx, tz);
}

// Where a vent will throw next, if it is ready: a cell two or three away
// along a line, bare ground, chosen by the mountain.
shared fn plan_vent(board: Board, index: number) -> Board {
    var next = board;
    var vent = next.units[index];
    vent.dir = -1.0;
    if vent.charge > 0.0 {
        vent.charge -= 1.0;
        next.units[index] = vent;
        return next;
    }
    var dirs: List<number> = [];
    var reaches: List<number> = [];
    for d in 0..4 {
        for r in 2..4 {
            let tx = vent.x + dir_x(d) * r;
            let tz = vent.z + dir_z(d) * r;
            if !in_bounds(tx, tz) || is_wet(next, tx, tz) { continue; }
            // The mountain is blind, but the island's people built well
            // clear of its vents.
            let at = unit_at(next, tx, tz);
            if at >= 0.0 && (next.units[at].kind == Kind.Vent || is_building(next.units[at].kind)) { continue; }
            dirs.push(d);
            reaches.push(r);
        }
    }
    if dirs.length > 0.0 {
        let pick = Random.int(0.0, dirs.length - 1.0);
        vent.dir = dirs[pick];
        vent.reach = reaches[pick];
    }
    next.units[index] = vent;
    return next;
}

// Whether a vent means to throw onto (x, z) this round.
shared fn vent_aims_at(board: Board, x: number, z: number) -> bool {
    for u in board.units {
        if u.kind != Kind.Vent || u.dir < 0.0 { continue; }
        if u.x + dir_x(u.dir) * u.reach == x && u.z + dir_z(u.dir) * u.reach == z { return true; }
    }
    return false;
}

// How much a Hollow wants what its strike would hit.
shared fn want_of(board: Board, cells: List<number>, striker: number, damage: number) -> number {
    var score = 0.0;
    for c in cells {
        let at = unit_at(board, c % SIZE, floor(c / SIZE));
        if at < 0.0 { continue; }
        let target = board.units[at];
        if target.id == striker { continue; }
        if target.kind == Kind.Vent { continue; }
        if target.kind == Kind.Beacon { score += 13.0; }
        else if is_building(target.kind) { score += 10.0; }
        else if is_warden(target.kind) {
            score += 6.0;
            if target.hp <= damage { score += 3.0; }
        } else if is_hollow(target.kind) { score -= 7.0; }
        else { score += 0.5; }
    }
    return score;
}

// Where a Hollow would rather stand when nothing is in reach: as close as it
// can get to the nearest building or warden.
shared fn nearest_prey(board: Board, x: number, z: number) -> number {
    var best = 99.0;
    for u in board.units {
        if u.hp <= 0.0 { continue; }
        if is_building(u.kind) || is_warden(u.kind) {
            best = min(best, steps_between(x, z, u.x, u.z));
        }
    }
    return best;
}

// One Hollow chooses where to go and what to strike. It is moved and its
// intent is set; the strike itself waits for the end of the wardens' turn.
shared fn plan_hollow(board: Board, index: number) -> Board {
    var next = board;
    let unit = next.units[index];
    if unit.hp <= 0.0 { return next; }
    var options: List<number> = reachable(next, index);
    options.insert(0, cell_of(unit.x, unit.z));
    var best_score = -999.0;
    var best_cell = cell_of(unit.x, unit.z);
    var best_dir = -1.0;
    var best_reach = 1.0;
    for option in options {
        let ox = option % SIZE;
        let oz = floor(option / SIZE);
        // The Hollow know the sea is coming, and where the mountain will spit.
        var place = 0.0;
        if floods_next(next, ox, oz) && !braves_level(next, unit.kind) { place -= 20.0; }
        if vent_aims_at(next, ox, oz) && !is_fireproof(unit.kind) { place -= 15.0; }
        // A little noise, so two equal choices are not always the same one,
        // and a seeded run still repeats exactly.
        place += Random.range(0.0, 0.4);
        place -= nearest_prey(next, ox, oz) * 0.05;
        for d in 0..4 {
            var low = 1.0;
            var high = 1.0;
            if is_lobber(unit.kind) { low = 2.0; high = 4.0; }
            for r in low..(high + 1.0) {
                let cells = strike_cells(next, unit.kind, ox, oz, d, r, unit.id);
                let score = place + want_of(next, cells, unit.id, kind_damage(unit.kind));
                if score > best_score {
                    best_score = score;
                    best_cell = option;
                    best_dir = d;
                    best_reach = r;
                }
            }
        }
    }
    // Nothing worth striking: close in on the nearest prey instead, and
    // strike the way it lies.
    if best_score < 1.0 {
        var closest = 999.0;
        for option in options {
            let ox = option % SIZE;
            let oz = floor(option / SIZE);
            var distance = nearest_prey(next, ox, oz);
            if floods_next(next, ox, oz) && !braves_level(next, unit.kind) { distance += 50.0; }
            if distance < closest {
                closest = distance;
                best_cell = option;
            }
        }
    }
    let bx = best_cell % SIZE;
    let bz = floor(best_cell / SIZE);
    if bx != unit.x || bz != unit.z {
        next = walk(next, index, bx, bz);
        // An Imp leaves lava where it stood.
        if unit.kind == Kind.Imp {
            next = settle(make_pool(next, unit.x, unit.z, LAVA));
        }
    }
    var planned = next.units[index];
    planned.dir = best_dir;
    planned.reach = best_reach;
    if best_dir < 0.0 {
        // Strike towards the nearest prey along whichever axis is longer.
        planned.dir = facing_towards_prey(next, bx, bz);
        planned.reach = 1.0;
        if is_lobber(unit.kind) { planned.reach = 2.0; }
    }
    next.units[index] = planned;
    return next;
}

shared fn facing_towards_prey(board: Board, x: number, z: number) -> number {
    var best = 99.0;
    var dx = 0.0;
    var dz = 1.0;
    for u in board.units {
        if u.hp <= 0.0 { continue; }
        if !(is_building(u.kind) || is_warden(u.kind)) { continue; }
        let distance = steps_between(x, z, u.x, u.z);
        if distance < best {
            best = distance;
            dx = u.x - x;
            dz = u.z - z;
        }
    }
    if abs(dx) > abs(dz) {
        if dx > 0.0 { return 1.0; }
        return 3.0;
    }
    if dz < 0.0 { return 0.0; }
    return 2.0;
}

// Every Hollow plans, in the order they will strike.
shared fn plan_all(board: Board) -> Board {
    var next = board;
    for i in 0..next.units.length {
        if next.units[i].kind == Kind.Vent && next.units[i].hp > 0.0 {
            next = plan_vent(next, i);
        }
    }
    var order = 1.0;
    for i in 0..next.units.length {
        let unit = next.units[i];
        if unit.hp > 0.0 && is_hollow(unit.kind) {
            next = plan_hollow(next, i);
            var planned = next.units[i];
            planned.order = order;
            next.units[i] = planned;
            order += 1.0;
        }
    }
    return next;
}

// Where Hollow will climb out next round: dry cells marked as landing
// ground on the island, free, and not already promised.
shared fn mark_spawns(board: Board, landing: List<number>) -> Board {
    var next = board;
    next.spawns.clear();
    for kind in next.arrivals {
        var choices: List<number> = [];
        for c in landing {
            let x = c % SIZE;
            let z = floor(c / SIZE);
            if floods_next(next, x, z) || is_wet(next, x, z) { continue; }
            if unit_at(next, x, z) >= 0.0 { continue; }
            if spawn_at(next, x, z) { continue; }
            choices.push(c);
        }
        if choices.length == 0.0 { continue; }
        let pick = choices[Random.int(0.0, choices.length - 1.0)];
        next.spawns.push(Spawn(x: pick % SIZE, z: floor(pick / SIZE), kind: kind));
    }
    return next;
}

// The marked Hollow climb out. One that finds its cell taken hurts whatever
// is standing there and does not come up at all.
shared fn emerge(board: Board) -> Board {
    var next = board;
    for s in board.spawns {
        let there = unit_at(next, s.x, s.z);
        if there >= 0.0 {
            next.beats.push(Beat(kind: BeatKind.Smother, x: s.x, z: s.z));
            next = hurt(next, there, 1.0);
            continue;
        }
        if is_wet(next, s.x, s.z) { continue; }
        next.units.push(Unit(id: next.next_id, kind: s.kind, x: s.x, z: s.z, hp: kind_hp(s.kind),
            max_hp: kind_hp(s.kind), move: kind_move(s.kind)));
        next.beats.push(Beat(kind: BeatKind.Emerge, unit: next.next_id, x: s.x, z: s.z));
        next.next_id += 1.0;
    }
    next.spawns.clear();
    return next;
}

// The tide comes up a level, and every Hollow it reaches sinks. Buildings it
// reaches are lost with everything in them.
shared fn raise_tide(board: Board) -> Board {
    var next = board;
    next.tide += 1.0;
    next.beats.push(Beat(kind: BeatKind.Tide, amount: next.tide));
    // What the level now covers is the level's, not a pool's.
    for c in 0..(SIZE * SIZE) {
        if next.heights[c] <= next.tide { next.pools[c] = DRY; }
    }
    for i in 0..next.units.length {
        let unit = next.units[i];
        if unit.hp <= 0.0 { continue; }
        if !under_level(next, unit.x, unit.z) { continue; }
        if is_building(unit.kind) {
            next = hurt(next, i, unit.hp);
        } else if is_hollow(unit.kind) && !can_stand(next, unit.kind, unit.x, unit.z) {
            next = sink(next, i);
        } else if is_warden(unit.kind) && next.molten {
            next = scorch(next, i, 2.0);
        }
    }
    return settle(next);
}

// The end of the wardens' turn: every Hollow strikes in order, the tide
// comes if it is due, and the marked Hollow climb out.
shared fn hollow_turn(board: Board) -> Board {
    var next = board;
    for order in 1..(count_alive(next, false) + 1.0) {
        for i in 0..next.units.length {
            let unit = next.units[i];
            if unit.hp > 0.0 && is_hollow(unit.kind) && unit.order == order {
                next = hollow_strike(next, i);
            }
        }
    }
    for i in 0..next.units.length {
        let unit = next.units[i];
        if unit.kind == Kind.Vent && unit.hp > 0.0 {
            next = erupt(next, i);
        }
    }
    if rises_this_round(next) {
        next = raise_tide(next);
    }
    // Anyone still standing in lava who can burn is scorched for it.
    for i in 0..next.units.length {
        let unit = next.units[i];
        if unit.hp > 0.0 && is_warden(unit.kind) && is_lava(next, unit.x, unit.z) {
            next = scorch(next, i, 1.0);
        }
    }
    return emerge(next);
}

// Clears the dead off the board and readies the wardens for a new turn.
shared fn new_turn(board: Board) -> Board {
    var next = board;
    var kept: List<Unit> = [];
    for unit in next.units {
        if unit.hp > 0.0 || is_warden(unit.kind) {
            var fresh = unit;
            fresh.moved = false;
            fresh.acted = false;
            fresh.from_x = -1.0;
            fresh.from_z = -1.0;
            fresh.ward = 0.0;
            if !is_hollow(fresh.kind) { fresh.dir = -1.0; }
            kept.push(fresh);
        }
    }
    next.units = kept;
    next.beats.clear();
    return next;
}

// Whether every warden has done all it can this turn.
shared fn all_spent(board: Board) -> bool {
    for u in board.units {
        if u.hp > 0.0 && is_warden(u.kind) && !u.acted {
            return false;
        }
    }
    return true;
}

// The total a Hollow's strike would do to the Hearth, for the danger readout.
shared fn hearth_threat(board: Board) -> number {
    var preview = hollow_turn(board);
    return board.hearth - preview.hearth;
}
