// A crossing played by a bot, for the tests.
//
// It plays through the real rules with nothing drawn: every warden tries every
// cell it can reach and every target from there, keeps whichever leaves the
// Hollow's coming strikes doing the least harm, and the Hollow answer as they
// always do. What it reports is how the crossing went, so a change to the
// rules that makes an island unwinnable, or trivial, fails a test rather than
// a play-test.

// How good a board is for the wardens, before the Hollow strike. `hearth` is
// what the Hearth was when the turn began, so harm the wardens did themselves
// counts as much as harm the Hollow are about to do: knocking down your own
// beacon to spare it from the Hollow is not a saving.
fn worth(board: Board, hearth: number) -> number {
    let after = hollow_turn(board);
    var score = 0.0;
    score -= (hearth - after.hearth) * 10.0;
    for u in after.units {
        if is_warden(u.kind) {
            score += u.hp * 2.0;
            if u.hp <= 0.0 { score -= 12.0; }
        }
    }
    for u in board.units {
        if is_hollow(u.kind) {
            if u.hp <= 0.0 { score += 6.0; } else { score -= u.hp; }
        }
    }
    return score;
}

script Autoplay {
    @export let seed: number = 7.0;
    // The island the bot starts on, so one world can be tuned on its own.
    @export let first: number = 0.0;
    // Prints the board before every Hollow turn, for reading a game through.
    @export let tracing: bool = false;

    var island: number = 0.0;
    var party: List<Warden> = [];
    var board: Board = board_of(island_def(0.0), [], 0.0);
    var started: bool = false;
    var turn_warden: number = 0.0;
    var turn_hearth: number = 0.0;
    var done: bool = false;

    fn fresh(kind: Kind) -> Warden {
        return Warden(kind: kind, max_hp: kind_hp(kind), move: kind_move(kind), power: 0.0);
    }

    // A warden none of the party is, picked by the dice, as a player picking
    // at random would.
    fn stranger() -> Warden {
        var left: List<number> = [];
        for i in 0..HERO_COUNT {
            var has = false;
            for w in party { if w.kind == hero_kind(i) { has = true; } }
            if !has { left.push(i); }
        }
        let pick = left[Random.int(0.0, left.length - 1.0)];
        return fresh(hero_kind(pick));
    }

    // Writes who is in the party, as hero numbers, for the report.
    fn record_party() {
        for i in 0..party.length {
            Game.set("party_" + i, hero_index(party[i].kind) + 1.0);
        }
    }

    fn begin(hearth: number) {
        let def = island_def(island);
        // The first island of a new world brings a fourth warden.
        if recruits_on(island) && party.length < 4.0 {
            party.push(stranger());
            record_party();
        }
        board = board_of(def, party, hearth);
        board = mark_spawns(board, landing_of(def));
        board = emerge(board);
        board = plan_all(board);
        board.arrivals = wave_of(def, board.round);
        board = mark_spawns(board, landing_of(def));
        board.beats.clear();
        turn_warden = 0.0;
    }

    // The warden being decided, the cells it may move to, and the best of
    // what it has tried so far. One cell is tried a frame, so no frame's work
    // outgrows the script budget.
    var deciding: number = -1.0;
    var cells: List<number> = [];
    var tried: number = 0.0;
    var best: Board = board_of(island_def(0.0), [], 0.0);
    var best_score: number = 0.0;

    fn decide(index: number) {
        deciding = index;
        cells = reachable(board, index);
        cells.insert(0, cell_of(board.units[index].x, board.units[index].z));
        tried = 0.0;
        best = board;
        best_score = worth(board, turn_hearth);
    }

    fn try_next() {
        let c = cells[tried];
        tried += 1.0;
        var moved = board;
        if c != cells[0] {
            moved = move_warden(board, deciding, c % SIZE, floor(c / SIZE));
        }
        for t in skill_targets(moved, deciding) {
            let result = use_skill(moved, deciding, t % SIZE, floor(t / SIZE));
            let score = worth(result, turn_hearth);
            if score > best_score {
                best_score = score;
                best = result;
            }
        }
        if tried >= cells.length {
            board = best;
            var spent = board.units[deciding];
            spent.acted = true;
            board.units[deciding] = spent;
            deciding = -1.0;
        }
    }

    fn letter(kind: Kind) -> String {
        return match kind {
            Kind.Bulwark => "1", Kind.Mason => "2", Kind.Lamplighter => "3", Kind.Tidecaller => "4",
            Kind.Harpooner => "5", Kind.Shieldback => "6",
            Kind.Husk => "h", Kind.Brute => "b", Kind.Spitter => "s", Kind.Mortar => "m",
            Kind.Colossus => "c", Kind.Imp => "i", Kind.Burster => "x", Kind.Kiln => "k",
            Kind.Hailer => "a", Kind.Rimeback => "r",
            Kind.House => "H", Kind.Beacon => "B", Kind.Stone => "S", Kind.Vent => "V",
        };
    }

    // The board as text: a letter per figure with the way it faces, `##` for
    // lava, `~~` for water, and the ground's height elsewhere.
    fn trace() {
        var text = "island " + island + " round " + board.round + " hearth " + board.hearth + " tide " + board.tide + "\n";
        for z in 0..SIZE {
            var row = "";
            for x in 0..SIZE {
                let at = unit_at(board, x, z);
                if at >= 0.0 {
                    let u = board.units[at];
                    var arrow = "";
                    if u.dir == 0.0 { arrow = "^"; }
                    if u.dir == 1.0 { arrow = ">"; }
                    if u.dir == 2.0 { arrow = "v"; }
                    if u.dir == 3.0 { arrow = "<"; }
                    if arrow == "" { arrow = " "; }
                    row += letter(u.kind) + arrow + " ";
                } else if is_lava(board, x, z) {
                    row += "## ";
                } else if is_water(board, x, z) {
                    row += "~~ ";
                } else if is_ice(board, x, z) {
                    row += "** ";
                } else {
                    row += "." + height_at(board, x, z) + " ";
                }
            }
            text += row + "\n";
        }
        print(text);
    }

    fn update(dt: number) {
        if done { return; }
        if !started {
            started = true;
            Random.seed(seed);
            Game.set("hearth", 7.0);
            island = first;
            // Three wardens mustered by the dice; starting past the island
            // a fourth joins on still brings one.
            party = [];
            for k in 0..3 { party.push(stranger()); }
            for i in 0..first {
                if recruits_on(i) { party.push(stranger()); }
            }
            record_party();
            begin(7.0);
            return;
        }
        if deciding >= 0.0 {
            try_next();
            return;
        }
        if turn_warden == 0.0 { turn_hearth = board.hearth; }
        while turn_warden < board.units.length {
            let u = board.units[turn_warden];
            turn_warden += 1.0;
            if is_warden(u.kind) && u.hp > 0.0 {
                decide(turn_warden - 1.0);
                return;
            }
        }
        if tracing { trace(); }
        board = hollow_turn(board);
        // What took the Hearth and the wardens' health this turn, by what
        // last moved before the hit: the report reads these.
        var cause = "strike";
        for beat in board.beats {
            if beat.kind == BeatKind.Erupt { cause = "vent"; }
            if beat.kind == BeatKind.Tide { cause = "level"; }
            if beat.kind == BeatKind.Strike || beat.kind == BeatKind.Lob || beat.kind == BeatKind.Bolt { cause = "strike"; }
            if beat.kind == BeatKind.Hit {
                let at = unit_index(board, beat.unit);
                if at >= 0.0 && is_building(board.units[at].kind) {
                    Game.set("dmg_" + cause + "_" + island, Game.get("dmg_" + cause + "_" + island, 0.0) + beat.amount);
                }
                if at >= 0.0 && is_warden(board.units[at].kind) {
                    Game.set("wdmg_" + cause + "_" + island, Game.get("wdmg_" + cause + "_" + island, 0.0) + beat.amount);
                }
            }
        }
        Game.set("hearth", board.hearth);
        if board.hearth <= 0.0 || count_alive(board, true) == 0.0 {
            Game.set("lost_on", island + 1.0);
            done = true;
            return;
        }
        board.round += 1.0;
        if board.round > board.rounds {
            Game.set("won_" + island, 1.0);
            Game.set("hearth_" + island, board.hearth);
            if layer_of(island) + 1.0 >= LAYER_COUNT {
                Game.set("crossed", 1.0);
                done = true;
                return;
            }
            // Down one road or the other where it forks, by the dice.
            let was = island;
            let roads = roads_from(island);
            island = roads[Random.int(0.0, roads.length - 1.0)];
            // A new world rekindles the Hearth, as it does in the game.
            if world_of(island) != world_of(was) {
                begin(7.0);
                return;
            }
            begin(board.hearth);
            return;
        }
        let def = island_def(island);
        board = new_turn(board);
        board = plan_all(board);
        board.arrivals = wave_of(def, board.round);
        board = mark_spawns(board, landing_of(def));
        board.beats.clear();
        turn_warden = 0.0;
        Game.set("rounds_played", Game.get("rounds_played", 0.0) + 1.0);
    }
}
