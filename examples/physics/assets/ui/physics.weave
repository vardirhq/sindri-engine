#title { font-size: 25px; }
#subtitle, #legend, #query-label, #result-label, #events-label, #hint {
    font-size: 12px;
}
#sensors-label, #mask-label, #inside-label, #less-label, #more-label,
#drop-label, #left-label, #reset-label, #right-label, #query-mode-label { font-size: 12px; }
@media (min-height: 700px) {
    #title { font-size: 28px; }
    #sensors-label, #mask-label, #inside-label, #less-label, #more-label,
    #drop-label, #left-label, #reset-label, #right-label, #query-mode-label { font-size: 13px; }
}
