// The Voxel Quarry: the playground's 3D annex.
//
// The floor is a voxel world with a voxel collider. Crates are 3D rigid
// bodies resting on it; digging a block out from under one opens a real hole
// it falls into. A laser sweeps across firing a 3D ray straight down and says
// what it hits. K, or the button, goes back to the room.

script Quarry {
    @export let crate_prefab: Prefab;
    @export let sweep: f32 = 8.0;
    @export let laser_speed: f32 = 3.0;

    // Every block dug, and what it was, so RESET can fill the holes again.
    var dug: List<Vec3> = [];
    var was: List<String> = [];
    var dropped: List<Entity> = [];
    var scan: f32 = -8.0;
    var scan_direction: f32 = 1.0;
    var laser_on: bool = true;
    var ray: String = "";

    fn update(dt: f32) {
        if Input.just_pressed("K") || Ui.is_pressed(World.find("q-back")) {
            print("Playground quarry back to the room");
            Scene.go("playground.scene");
            return;
        }
        if Input.just_pressed("Digit1") || Ui.is_pressed(World.find("q-act-1")) { drop_crates(); }
        if Input.just_pressed("Digit2") || Ui.is_pressed(World.find("q-act-2")) { dig_under(); }
        if Input.just_pressed("Digit3") || Ui.is_pressed(World.find("q-act-3")) { shove(); }
        if Input.just_pressed("Digit4") || Ui.is_pressed(World.find("q-act-4")) {
            this.laser_on = !this.laser_on;
            var words = "START LASER";
            if this.laser_on { words = "STOP LASER"; }
            Ui.set_text(World.find("q-act-4-label"), words);
        }
        if Input.just_pressed("R") || Ui.is_pressed(World.find("q-reset")) { reset(); }
        if Pointer.just_pressed("Left") && !Pointer.over_ui && Aim.hit {
            if dig(Aim.x, Aim.y, Aim.z) { print("Playground quarry dug " + Aim.x + " " + Aim.y + " " + Aim.z); }
        }
        laser(dt);
        Ui.set_text(World.find("q-stats"), World.with_tag("crate").length + " crates  /  " + this.dug.length + " blocks dug  /  gravity 16");
        Ui.set_text(World.find("q-readout"), this.ray);
    }

    // Takes one block out of the floor, remembering what it was. Bodies near
    // the hole are nudged awake so a resting crate notices the floor is gone.
    fn dig(column: f32, row: f32, level: f32) -> bool {
        let ground = World.find("Quarry Floor");
        let block = Grid.block(ground, column, row, level);
        if block == "" { return false; }
        Grid.set_block(ground, column, row, level, "");
        this.dug.push(Vec3(column, row, level));
        this.was.push(block);
        let hole = Vec3(column + 0.5, level + 0.5, row + 0.5);
        for crate in World.with_tag("crate") {
            if crate.transform.world_position.distance(hole) < 3.0 {
                Physics3d.apply_impulse(crate, Vec3(0.0, 0.01, 0.0));
            }
        }
        return true;
    }

    // Finds the ground under every crate with a 3D ray and digs a pit there,
    // three by three and two deep, so each one drops into its own hole.
    fn dig_under() {
        let ground = World.find("Quarry Floor");
        var pits = 0.0;
        for crate in World.with_tag("crate") {
            let at = crate.transform.world_position;
            let hit = Physics3d.raycast(at, Vec3(0.0, -1.0, 0.0), 30.0, Physics3d.layer("solid"), false, crate);
            if hit != null {
                if hit.entity == ground {
                    let column = floor(at.x);
                    let row = floor(at.z);
                    let level = floor(hit.point.y - 0.5);
                    for dx in 0..3 {
                        for dz in 0..3 {
                            dig(column + dx - 1.0, row + dz - 1.0, level);
                            dig(column + dx - 1.0, row + dz - 1.0, level - 1.0);
                        }
                    }
                    pits += 1.0;
                }
            }
        }
        print("Playground quarry dug under " + pits + " crates");
    }

    fn drop_crates() {
        for i in 0..6 {
            let crate: Entity = World.spawn(this.crate_prefab);
            crate.transform.position = Vec3(Random.range(-5.0, 4.0), 16.0 + i * 1.3, Random.range(-4.0, 5.0));
            this.dropped.push(crate);
        }
        print("Playground quarry crates dropped");
    }

    fn shove() {
        for crate in World.with_tag("crate") {
            Physics3d.apply_impulse(crate, Vec3(Random.range(-3.0, 3.0), Random.range(6.0, 10.0), Random.range(-3.0, 3.0)));
            Physics3d.set_angular_velocity(crate, Vec3(Random.range(-4.0, 4.0), Random.range(-4.0, 4.0), Random.range(-4.0, 4.0)));
        }
        print("Playground quarry shoved");
    }

    fn reset() {
        let ground = World.find("Quarry Floor");
        var index = this.dug.length - 1.0;
        while index >= 0.0 {
            let cell = this.dug[index];
            Grid.set_block(ground, cell.x, cell.y, cell.z, this.was[index]);
            index -= 1.0;
        }
        this.dug.clear();
        this.was.clear();
        for crate in this.dropped {
            if World.exists(crate) { World.despawn(crate); }
        }
        this.dropped.clear();
        QuarryReset.emit();
        print("Playground quarry reset");
    }

    // A 3D ray fired straight down from above the quarry, swept back and
    // forth; the laser is drawn as long as the ray travelled.
    fn laser(dt: f32) {
        let beam = World.find("q-laser");
        let spot = World.find("q-laser-hit");
        World.set_active(beam, this.laser_on);
        World.set_active(spot, this.laser_on);
        if !this.laser_on {
            this.ray = "3D RAY / off";
            return;
        }
        this.scan += this.scan_direction * this.laser_speed * dt;
        if abs(this.scan) > this.sweep {
            this.scan = clamp(this.scan, 0.0 - this.sweep, this.sweep);
            this.scan_direction = 0.0 - this.scan_direction;
        }
        let top = 20.0;
        let origin = Vec3(this.scan, top, 0.5);
        let hit = Physics3d.raycast(origin, Vec3(0.0, -1.0, 0.0), 40.0, Physics3d.layer("solid"), false, null);
        var reach = 40.0;
        if hit != null {
            reach = hit.distance;
            spot.transform.position = hit.point;
            let ground = World.find("Quarry Floor");
            if hit.entity == ground {
                let column = floor(hit.point.x);
                let row = floor(hit.point.z);
                let level = floor(hit.point.y - 0.5);
                this.ray = "3D RAY / " + Grid.block(ground, column, row, level) + " block " + column + ", " + level + ", " + row + " at " + hit.distance.fixed(2) + " m";
            } else {
                this.ray = "3D RAY / a crate at " + hit.distance.fixed(2) + " m, normal " + hit.normal.y.fixed(2) + " up";
            }
        } else {
            this.ray = "3D RAY / nothing below";
        }
        beam.transform.position = Vec3(this.scan, top - reach * 0.5, 0.5);
        beam.transform.scale = Vec3(0.06, max(0.01, reach), 0.06);
    }
}

// RESET in the quarry: the authored crates go home.
event QuarryReset();

script QuarryCrate {
    var home: Vec3 = Vec3(0.0, 0.0, 0.0);

    fn start() { this.home = this.transform.position; }

    on QuarryReset() {
        this.transform.position = this.home;
        this.transform.rotation_z = 0.0;
        Physics3d.set_velocity(this.entity, Vec3(0.0, 0.0, 0.0));
        Physics3d.set_angular_velocity(this.entity, Vec3(0.0, 0.0, 0.0));
    }
}
