// The contraptions' controls. Each listens for its own ToyAction and its own
// ResetToy; the physics is all authored joints and bodies in the scene.

// A steel ball on a rigid arm. A hinge position motor winds it up; letting
// go switches the motor off so the arm swings free; cutting the rope disables
// the hinge, and the ball keeps whatever speed it had.
script WreckingBall {
    @export let wind_angle: f32 = -1.15;
    var winding: bool = false;

    fn start() { relax(); }

    on ToyAction(toy, action) {
        if toy != 1.0 { return; }
        let hinge = World.find("wreck-hinge");
        if action == 1.0 {
            this.winding = true;
            Physics.set_joint_enabled(hinge, true);
            Physics.set_hinge_position_motor(hinge, this.wind_angle, 7000.0, 900.0, 14000.0);
            print("Playground wrecking ball winding");
        }
        if action == 2.0 { relax(); print("Playground wrecking ball released"); }
        if action == 3.0 {
            relax();
            Physics.set_joint_enabled(hinge, false);
            print("Playground wrecking ball cut loose");
        }
        if action == 4.0 { ResetToy.emit(1.0); }
    }

    on ResetToy(toy) {
        if toy == 0.0 || toy == 1.0 { relax(); }
    }

    on DropEverything(on) { relax(); }

    fn relax() {
        this.winding = false;
        // Zero torque coasts rather than brakes: the arm swings free.
        Physics.set_hinge_motor(World.find("wreck-hinge"), 0.0, 0.0);
    }
}

// A trolley on a slider along the ceiling girder, driven by a position
// motor; a hook on a spring whose rest length is the winch; and a grip, a
// distance joint created at runtime between the hook and the cargo under it.
script Crane {
    @export let speed: f32 = 5.0;
    @export let high: f32 = 1.4;
    @export let low: f32 = 9.5;
    var cable: f32 = 1.4;
    var depth: f32 = 9.5;
    var lowering: bool = false;
    // Where the trolley is told to be, along the rail from its middle.
    var target: f32 = -4.0;
    var parked: bool = false;
    var gripping: bool = false;
    var held: Entity? = null;

    fn update(dt: f32) {
        var drive = 0.0;
        if Game.toy == 2.0 {
            if Ui.is_held(World.find("act-1")) || Input.is_down("Digit1") || Input.is_down("ArrowLeft") { drive = -1.0; }
            if Ui.is_held(World.find("act-2")) || Input.is_down("Digit2") || Input.is_down("ArrowRight") { drive = 1.0; }
        }
        if drive != 0.0 || !this.parked {
            // A position motor chasing a target that runs ahead of it: the
            // trolley keeps an even speed under any load, and stops dead
            // where the target stops however the hook swings.
            this.target = clamp(this.target + drive * this.speed * dt, -11.5, 11.5);
            Physics.set_slider_position_motor(World.find("crane-slider"), this.target, 600.0, 90.0, 4000.0);
            this.parked = drive == 0.0;
        }
        var goal = this.high;
        if this.lowering { goal = this.depth; }
        if abs(goal - this.cable) > 0.01 {
            let step = 4.0 * dt;
            this.cable = this.cable + clamp(goal - this.cable, -step, step);
            Physics.set_spring(World.find("crane-cable"), this.cable, 90.0, 6.0);
        }
        draw();
    }

    on ToyAction(toy, action) {
        if toy != 2.0 { return; }
        if action == 3.0 {
            this.lowering = !this.lowering;
            if this.lowering { this.depth = sound(); }
            print("Playground crane hoist " + this.lowering);
        }
        if action == 4.0 {
            if this.gripping { release(); } else { grab(); }
        }
    }

    on ResetToy(toy) {
        if toy == 0.0 || toy == 2.0 {
            release();
            this.cable = 1.4;
            this.lowering = false;
            this.target = -4.0;
            this.parked = false;
            Physics.set_spring(World.find("crane-cable"), this.cable, 90.0, 6.0);
        }
    }

    on DropEverything(on) { release(); }

    // How far down to let the hook go: the hook's own footprint, swept
    // straight down, finds the first thing it would land on, so it stops
    // just above the load instead of shoving it off whatever it stands on.
    fn sound() -> f32 {
        let hook = World.find("crane-hook");
        let at = hook.transform.world_position;
        let mask = Physics.mask(["static", "props", "balls", "glass"]);
        let hit = Physics.cast_box(Vec2(at.x, at.y - 0.25), Vec2(0.5, 0.3), 0.0, Vec2(0.0, -1.0), 30.0, mask, false, hook);
        if hit == null { return this.low; }
        return clamp(this.cable + hit.distance - 0.08, this.high, this.low);
    }

    // The room's own cargo only: an authored joint names bodies in its own
    // scene, and loose things spawned at runtime are not in it.
    fn grab() {
        let hook = World.find("crane-hook");
        let at = hook.transform.world_position;
        for thing in Physics.overlap_box(Vec2(at.x, at.y - 0.7), Vec2(0.7, 0.6), 0.0, movable_mask(), false, hook) {
            if !this.gripping && World.has_tag(thing, "cargo") {
                Physics.create_distance_joint(World.find("crane-grip"), hook, thing, 1.0);
                this.gripping = true;
                this.held = thing;
                print("Playground crane grabbed");
            }
        }
        if !this.gripping { print("Playground crane found nothing"); }
    }

    fn release() {
        if this.gripping {
            Physics.remove_joint(World.find("crane-grip"));
            print("Playground crane dropped");
        }
        this.gripping = false;
        this.held = null;
    }

    fn draw() {
        let trolley = World.find("crane-trolley").transform.world_position;
        let hook = World.find("crane-hook").transform.world_position;
        line(World.find("crane-cable-line"), Vec2(trolley.x, trolley.y - 0.25), Vec2(hook.x, hook.y + 0.12), 0.06);
        let grip = World.find("crane-grip-line");
        let held = this.held;
        if held != null {
            if World.exists(held) {
                let at = held.transform.world_position;
                line(grip, Vec2(hook.x, hook.y), Vec2(at.x, at.y), 0.08);
                World.set_active(grip, true);
                return;
            }
        }
        World.set_active(grip, false);
    }
}

// A cannon on a hinge held by a position motor. Shells leave at a speed that
// covers more than a pane's thickness in one fixed step, so with continuous
// collision off most of them pass through the glass without touching it.
state Gallery {
    var hits: f32 = 0.0;
    var ghosts: f32 = 0.0;
    var fired: f32 = 0.0;
    var ccd: bool = true;
}

script Cannon {
    @export let shell: Prefab;
    @export let muzzle_speed: f32 = 90.0;
    var aim: f32 = 0.25;
    var cooldown: f32 = 0.0;

    fn update(dt: f32) {
        this.cooldown = max(0.0, this.cooldown - dt);
        if Game.toy == 3.0 {
            var turn = 0.0;
            if Ui.is_held(World.find("act-1")) || Input.is_down("Digit1") || Input.is_down("ArrowUp") { turn = 1.0; }
            if Ui.is_held(World.find("act-2")) || Input.is_down("Digit2") || Input.is_down("ArrowDown") { turn = -1.0; }
            if turn != 0.0 {
                this.aim = clamp(this.aim + turn * 0.9 * dt, -0.1, 1.15);
                Physics.set_hinge_position_motor(World.find("cannon-hinge"), this.aim, 400.0, 60.0, 3000.0);
            }
            if Ui.is_held(World.find("act-3")) && this.cooldown <= 0.0 { fire(); }
            var ccd = "CCD ON";
            if !Gallery.ccd { ccd = "CCD OFF"; }
            Ui.set_text(World.find("hint"), ccd + "   /   " + Gallery.fired + " fired   " + Gallery.hits + " panes hit   " + Gallery.ghosts + " passed straight through");
        }
    }

    on ToyAction(toy, action) {
        if toy != 3.0 { return; }
        if action == 3.0 && this.cooldown <= 0.0 { fire(); }
        if action == 4.0 {
            Gallery.ccd = !Gallery.ccd;
            print("Playground cannon ccd " + Gallery.ccd);
        }
    }

    on ResetToy(toy) {
        if toy == 0.0 || toy == 3.0 {
            this.aim = 0.25;
            Gallery.hits = 0.0;
            Gallery.ghosts = 0.0;
            Gallery.fired = 0.0;
            Physics.set_hinge_position_motor(World.find("cannon-hinge"), this.aim, 400.0, 60.0, 3000.0);
        }
    }

    fn fire() {
        this.cooldown = 0.18;
        let barrel = World.find("cannon-barrel");
        let at = barrel.transform.world_position;
        let angle = barrel.transform.rotation_z;
        let along = Vec2(cos(angle), sin(angle));
        let muzzle = Vec2(at.x, at.y) + along * 1.45;
        let shell = World.spawn(this.shell);
        shell.transform.position = Vec3(muzzle.x, muzzle.y, 0.35);
        Physics.set_continuous_collision(shell, Gallery.ccd);
        let speed = along * this.muzzle_speed;
        Physics.set_velocity(shell, speed.x, speed.y);
        // Recoil: the barrel is shoved back at its muzzle, and the motor
        // brings it back to its aim.
        let kick = along * -1.6;
        Physics.apply_impulse_at_point(barrel, kick, muzzle);
        Effects.burst_at(World.find("muzzle-flash"), muzzle.x, muzzle.y);
        Camera.impact(0.15);
        Gallery.fired += 1.0;
        print("Playground cannon fired");
    }
}

// A shell: remembers whether it touched glass, and leaves after a while.
script Shell {
    var age: f32 = 0.0;
    var hit_glass: bool = false;
    fn update(dt: f32) {
        this.age += dt;
        for other in Physics.collision_started() {
            if World.has_tag(other, "glass") { this.hit_glass = true; }
        }
        if this.age > 4.0 { World.despawn(this.entity); }
    }
}

// A pane of glass on a hinge. A shell that touches it knocks it off its
// hinge; a reset hangs it back up.
script GlassPane {
    @export let index: f32 = 0.0;
    var home: Vec3 = Vec3(0.0, 0.0, 0.0);
    var broken: bool = false;
    fn start() { this.home = this.transform.position; }
    fn update(dt: f32) {
        for other in Physics.collision_started() {
            if World.has_tag(other, "shell") && !this.broken {
                this.broken = true;
                Gallery.hits += 1.0;
                Physics.set_joint_enabled(World.find("pane-hinge-" + this.index), false);
                let at = this.transform.world_position;
                Effects.burst_at(World.find("glass-shards"), at.x, at.y);
                this.shape.fill = Color(0.66, 0.9, 1.0, 0.2);
                print("Playground pane " + this.index + " shattered");
            }
        }
    }
    on ResetToy(toy) {
        if toy == 0.0 || toy == 3.0 {
            this.broken = false;
            this.transform.position = this.home;
            this.transform.rotation_z = 0.0;
            this.shape.fill = Color(0.38, 0.79, 1.0, 0.45);
            Physics.set_velocity(this.entity, 0.0, 0.0);
            Physics.set_angular_velocity(this.entity, 0.0);
        }
    }
}

// Behind the gallery: counts the shells that got here without touching glass.
// Every pane hangs across the gallery's whole height, so a shell at that
// height that reached here while a pane still hung must have crossed one.
script BackStop {
    @export let top: f32 = -2.9;
    @export let bottom: f32 = -11.5;
    fn update(dt: f32) {
        for other in Physics.sensor_entered() {
            if World.has_tag(other, "shell") {
                let y = other.transform.world_position.y;
                let crossed = y < this.top && y > this.bottom && Gallery.hits < 4.0;
                if crossed && !Shell.on(other).hit_glass {
                    Gallery.ghosts += 1.0;
                    print("Playground shell passed through");
                }
                World.despawn(other);
            }
        }
    }
}
