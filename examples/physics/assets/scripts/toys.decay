// The contraptions' controls. Each listens for its own ToyAction and its own
// ResetToy; the physics is all authored joints and bodies in the scene.

// A steel ball on a rigid arm. A hinge position motor winds it up; letting
// go switches the motor off so the arm swings free; cutting the rope disables
// the hinge, and the ball keeps whatever speed it had.
script WreckingBall {
    @export let wind_angle: f32 = -1.15;
    var winding: bool = false;

    fn start() { relax(); }

    on ToyAction(toy, action) {
        if toy != 1.0 { return; }
        let hinge = World.find("wreck-hinge");
        if action == 1.0 {
            this.winding = true;
            Physics.set_joint_enabled(hinge, true);
            Physics.set_hinge_position_motor(hinge, this.wind_angle, 7000.0, 900.0, 14000.0);
            print("Playground wrecking ball winding");
        }
        if action == 2.0 { relax(); print("Playground wrecking ball released"); }
        if action == 3.0 {
            relax();
            Physics.set_joint_enabled(hinge, false);
            print("Playground wrecking ball cut loose");
        }
        if action == 4.0 { ResetToy.emit(1.0); }
    }

    on ResetToy(toy) {
        if toy == 0.0 || toy == 1.0 { relax(); }
    }

    on DropEverything(on) { relax(); }

    fn relax() {
        this.winding = false;
        // Zero torque coasts rather than brakes: the arm swings free.
        Physics.set_hinge_motor(World.find("wreck-hinge"), 0.0, 0.0);
    }
}

// A trolley on a slider along the ceiling girder, driven by a position
// motor; a hook on a spring whose rest length is the winch; and a grip, a
// distance joint created at runtime between the hook and the cargo under it.
script Crane {
    @export let speed: f32 = 5.0;
    @export let high: f32 = 1.4;
    @export let low: f32 = 9.5;
    var cable: f32 = 1.4;
    var depth: f32 = 9.5;
    var lowering: bool = false;
    // Where the trolley is told to be, along the rail from its middle.
    var target: f32 = -4.0;
    var parked: bool = false;
    var gripping: bool = false;
    var held: Entity? = null;

    fn update(dt: f32) {
        var drive = 0.0;
        if Game.toy == 2.0 {
            if Ui.is_held(World.find("act-1")) || Input.is_down("Digit1") || Input.is_down("ArrowLeft") { drive = -1.0; }
            if Ui.is_held(World.find("act-2")) || Input.is_down("Digit2") || Input.is_down("ArrowRight") { drive = 1.0; }
        }
        if drive != 0.0 || !this.parked {
            // A position motor chasing a target that runs ahead of it: the
            // trolley keeps an even speed under any load, and stops dead
            // where the target stops however the hook swings.
            this.target = clamp(this.target + drive * this.speed * dt, -11.5, 11.5);
            Physics.set_slider_position_motor(World.find("crane-slider"), this.target, 600.0, 90.0, 4000.0);
            this.parked = drive == 0.0;
        }
        var goal = this.high;
        if this.lowering { goal = this.depth; }
        if abs(goal - this.cable) > 0.01 {
            let step = 4.0 * dt;
            this.cable = this.cable + clamp(goal - this.cable, -step, step);
            Physics.set_spring(World.find("crane-cable"), this.cable, 90.0, 6.0);
        }
        draw();
    }

    on ToyAction(toy, action) {
        if toy != 2.0 { return; }
        if action == 3.0 {
            this.lowering = !this.lowering;
            if this.lowering { this.depth = sound(); }
            print("Playground crane hoist " + this.lowering);
        }
        if action == 4.0 {
            if this.gripping { release(); } else { grab(); }
        }
    }

    on ResetToy(toy) {
        if toy == 0.0 || toy == 2.0 {
            release();
            this.cable = 1.4;
            this.lowering = false;
            this.target = -4.0;
            this.parked = false;
            Physics.set_spring(World.find("crane-cable"), this.cable, 90.0, 6.0);
        }
    }

    on DropEverything(on) { release(); }

    // How far down to let the hook go: the hook's own footprint, swept
    // straight down, finds the first thing it would land on, so it stops
    // just above the load instead of shoving it off whatever it stands on.
    fn sound() -> f32 {
        let hook = World.find("crane-hook");
        let at = hook.transform.world_position;
        let mask = Physics.mask(["static", "props", "balls", "glass"]);
        let hit = Physics.cast_box(Vec2(at.x, at.y - 0.25), Vec2(0.5, 0.3), 0.0, Vec2(0.0, -1.0), 30.0, mask, false, hook);
        if hit == null { return this.low; }
        return clamp(this.cable + hit.distance - 0.08, this.high, this.low);
    }

    // The room's own cargo only: an authored joint names bodies in its own
    // scene, and loose things spawned at runtime are not in it.
    fn grab() {
        let hook = World.find("crane-hook");
        let at = hook.transform.world_position;
        for thing in Physics.overlap_box(Vec2(at.x, at.y - 0.7), Vec2(0.7, 0.6), 0.0, movable_mask(), false, hook) {
            if !this.gripping && World.has_tag(thing, "cargo") {
                Physics.create_distance_joint(World.find("crane-grip"), hook, thing, 1.0);
                this.gripping = true;
                this.held = thing;
                print("Playground crane grabbed");
            }
        }
        if !this.gripping { print("Playground crane found nothing"); }
    }

    fn release() {
        if this.gripping {
            Physics.remove_joint(World.find("crane-grip"));
            print("Playground crane dropped");
        }
        this.gripping = false;
        this.held = null;
    }

    fn draw() {
        let trolley = World.find("crane-trolley").transform.world_position;
        let hook = World.find("crane-hook").transform.world_position;
        line(World.find("crane-cable-line"), Vec2(trolley.x, trolley.y - 0.25), Vec2(hook.x, hook.y + 0.12), 0.06);
        let grip = World.find("crane-grip-line");
        let held = this.held;
        if held != null {
            if World.exists(held) {
                let at = held.transform.world_position;
                line(grip, Vec2(hook.x, hook.y), Vec2(at.x, at.y), 0.08);
                World.set_active(grip, true);
                return;
            }
        }
        World.set_active(grip, false);
    }
}

// A cannon on a hinge held by a position motor. Shells leave at a speed that
// covers more than a pane's thickness in one fixed step, so with continuous
// collision off most of them pass through the glass without touching it.
state Gallery {
    var hits: f32 = 0.0;
    var ghosts: f32 = 0.0;
    var fired: f32 = 0.0;
    var ccd: bool = true;
}

script Cannon {
    @export let shell: Prefab;
    @export let muzzle_speed: f32 = 90.0;
    var aim: f32 = 0.25;
    var cooldown: f32 = 0.0;

    fn update(dt: f32) {
        this.cooldown = max(0.0, this.cooldown - dt);
        if Game.toy == 3.0 {
            var turn = 0.0;
            if Ui.is_held(World.find("act-1")) || Input.is_down("Digit1") || Input.is_down("ArrowUp") { turn = 1.0; }
            if Ui.is_held(World.find("act-2")) || Input.is_down("Digit2") || Input.is_down("ArrowDown") { turn = -1.0; }
            if turn != 0.0 {
                this.aim = clamp(this.aim + turn * 0.9 * dt, -0.1, 1.15);
                Physics.set_hinge_position_motor(World.find("cannon-hinge"), this.aim, 400.0, 60.0, 3000.0);
            }
            if Ui.is_held(World.find("act-3")) && this.cooldown <= 0.0 { fire(); }
            var ccd = "CCD ON";
            if !Gallery.ccd { ccd = "CCD OFF"; }
            Ui.set_text(World.find("hint"), ccd + "   /   " + Gallery.fired + " fired   " + Gallery.hits + " panes hit   " + Gallery.ghosts + " passed straight through");
        }
    }

    on ToyAction(toy, action) {
        if toy != 3.0 { return; }
        if action == 3.0 && this.cooldown <= 0.0 { fire(); }
        if action == 4.0 {
            Gallery.ccd = !Gallery.ccd;
            print("Playground cannon ccd " + Gallery.ccd);
        }
    }

    on ResetToy(toy) {
        if toy == 0.0 || toy == 3.0 {
            this.aim = 0.25;
            Gallery.hits = 0.0;
            Gallery.ghosts = 0.0;
            Gallery.fired = 0.0;
            Physics.set_hinge_position_motor(World.find("cannon-hinge"), this.aim, 400.0, 60.0, 3000.0);
        }
    }

    fn fire() {
        this.cooldown = 0.18;
        let barrel = World.find("cannon-barrel");
        let at = barrel.transform.world_position;
        let angle = barrel.transform.rotation_z;
        let along = Vec2(cos(angle), sin(angle));
        let muzzle = Vec2(at.x, at.y) + along * 1.45;
        let shell = World.spawn(this.shell);
        shell.transform.position = Vec3(muzzle.x, muzzle.y, 0.35);
        Physics.set_continuous_collision(shell, Gallery.ccd);
        let speed = along * this.muzzle_speed;
        Physics.set_velocity(shell, speed.x, speed.y);
        // Recoil: the barrel is shoved back at its muzzle, and the motor
        // brings it back to its aim.
        let kick = along * -1.6;
        Physics.apply_impulse_at_point(barrel, kick, muzzle);
        Effects.burst_at(World.find("muzzle-flash"), muzzle.x, muzzle.y);
        Camera.impact(0.15);
        Gallery.fired += 1.0;
        print("Playground cannon fired");
    }
}

// A shell: remembers whether it touched glass, and leaves after a while.
script Shell {
    var age: f32 = 0.0;
    var hit_glass: bool = false;
    fn update(dt: f32) {
        this.age += dt;
        for other in Physics.collision_started() {
            if World.has_tag(other, "glass") { this.hit_glass = true; }
        }
        if this.age > 4.0 { World.despawn(this.entity); }
    }
}

// A pane of glass on a hinge. A shell that touches it knocks it off its
// hinge; a reset hangs it back up.
script GlassPane {
    @export let index: f32 = 0.0;
    var home: Vec3 = Vec3(0.0, 0.0, 0.0);
    var broken: bool = false;
    fn start() { this.home = this.transform.position; }
    fn update(dt: f32) {
        for other in Physics.collision_started() {
            if World.has_tag(other, "shell") && !this.broken {
                this.broken = true;
                Gallery.hits += 1.0;
                Physics.set_joint_enabled(World.find("pane-hinge-" + this.index), false);
                let at = this.transform.world_position;
                Effects.burst_at(World.find("glass-shards"), at.x, at.y);
                this.shape.fill = Color(0.66, 0.9, 1.0, 0.2);
                print("Playground pane " + this.index + " shattered");
            }
        }
    }
    on ResetToy(toy) {
        if toy == 0.0 || toy == 3.0 {
            this.broken = false;
            this.transform.position = this.home;
            this.transform.rotation_z = 0.0;
            this.shape.fill = Color(0.38, 0.79, 1.0, 0.45);
            Physics.set_velocity(this.entity, 0.0, 0.0);
            Physics.set_angular_velocity(this.entity, 0.0);
        }
    }
}

// Behind the gallery: counts the shells that got here without touching glass.
// Every pane hangs across the gallery's whole height, so a shell at that
// height that reached here while a pane still hung must have crossed one.
script BackStop {
    @export let top: f32 = -2.9;
    @export let bottom: f32 = -11.5;
    fn update(dt: f32) {
        for other in Physics.sensor_entered() {
            if World.has_tag(other, "shell") {
                let y = other.transform.world_position.y;
                let crossed = y < this.top && y > this.bottom && Gallery.hits < 4.0;
                if crossed && !Shell.on(other).hit_glass {
                    Gallery.ghosts += 1.0;
                    print("Playground shell passed through");
                }
                World.despawn(other);
            }
        }
    }
}

state Pit {
    var score: f32 = 0.0;
    var lifting: bool = true;
    var lifts: f32 = 0.0;
}

// The pinball wall and the lift that feeds it. The flippers are position
// motors between a rest angle and a raised one; the lift is a slider
// position motor that waits at the bottom, climbs, and tips its bucket.
script Pinball {
    @export let ball: Prefab;
    @export let wait_bottom: f32 = 2.5;
    @export let wait_top: f32 = 1.2;
    // 0 waiting below, 1 climbing, 2 pouring, 3 coming down.
    var phase: f32 = 0.0;
    var clock: f32 = 0.0;
    var left_up: bool = false;
    var right_up: bool = false;
    var balls: List<Entity> = [];

    fn update(dt: f32) {
        flippers();
        lift(dt);
        if Game.toy == 4.0 {
            var running = "LIFT RUNNING";
            if !Pit.lifting { running = "LIFT STOPPED"; }
            Ui.set_text(World.find("hint"), "Score " + Pit.score + "   /   " + running + "   /   " + Pit.lifts + " loads carried   /   flip with Z and M");
        }
    }

    fn flippers() {
        let selected = Game.toy == 4.0;
        let left = Input.is_down("Z") || (selected && (Ui.is_held(World.find("act-1")) || Input.is_down("Digit1")));
        let right = Input.is_down("M") || (selected && (Ui.is_held(World.find("act-2")) || Input.is_down("Digit2")));
        if left != this.left_up {
            this.left_up = left;
            var angle = -0.45;
            if left { angle = 0.45; }
            Physics.set_hinge_position_motor(World.find("flipper-left-hinge"), angle, 2500.0, 80.0, 6000.0);
        }
        if right != this.right_up {
            this.right_up = right;
            var angle = 0.45;
            if right { angle = -0.45; }
            Physics.set_hinge_position_motor(World.find("flipper-right-hinge"), angle, 2500.0, 80.0, 6000.0);
        }
    }

    fn lift(dt: f32) {
        if !Pit.lifting && this.phase == 0.0 { return; }
        this.clock += dt;
        let slider = World.find("lift-slider");
        let tilt = World.find("lift-tilt");
        if this.phase == 0.0 && this.clock > this.wait_bottom {
            this.phase = 1.0;
            this.clock = 0.0;
            // Lean back so the load rolls against the far wall, then climb.
            Physics.set_hinge_position_motor(tilt, -0.25, 1500.0, 120.0, 6000.0);
            Physics.set_slider_position_motor(slider, 12.6, 900.0, 140.0, 8000.0);
        }
        if this.phase == 1.0 && World.find("lift-car").transform.world_position.y > 11.3 {
            this.phase = 2.0;
            this.clock = 0.0;
            Physics.set_hinge_position_motor(tilt, 1.1, 1500.0, 120.0, 6000.0);
            Pit.lifts += 1.0;
            print("Playground lift pouring");
        }
        if this.phase == 2.0 && this.clock > this.wait_top {
            this.phase = 3.0;
            this.clock = 0.0;
            Physics.set_hinge_position_motor(tilt, 0.0, 1500.0, 120.0, 6000.0);
            Physics.set_slider_position_motor(slider, -12.4, 900.0, 140.0, 8000.0);
        }
        if this.phase == 3.0 && World.find("lift-car").transform.world_position.y < -13.0 {
            this.phase = 0.0;
            this.clock = 0.0;
        }
    }

    on ToyAction(toy, action) {
        if toy != 4.0 { return; }
        if action == 3.0 {
            Pit.lifting = !Pit.lifting;
            print("Playground lift " + Pit.lifting);
        }
        if action == 4.0 { multiball(); }
    }

    // Six balls straight into the chute at the top of the table.
    fn multiball() {
        for i in 0..6 {
            let ball = World.spawn(this.ball);
            ball.transform.position = Vec3(24.4 - i * 0.65, 11.6 + i * 0.2, 0.3);
            this.balls.push(ball);
        }
        while this.balls.length > 60.0 {
            let old = this.balls.remove_at(0);
            if World.exists(old) { World.despawn(old); }
        }
        print("Playground multiball");
    }

    on ResetToy(toy) {
        if toy == 0.0 || toy == 4.0 {
            for ball in this.balls {
                if World.exists(ball) { World.despawn(ball); }
            }
            this.balls.clear();
            Pit.score = 0.0;
            Pit.lifts = 0.0;
            this.phase = 0.0;
            this.clock = 0.0;
            Physics.set_slider_position_motor(World.find("lift-slider"), -12.4, 900.0, 140.0, 8000.0);
            Physics.set_hinge_position_motor(World.find("lift-tilt"), 0.0, 1500.0, 120.0, 6000.0);
        }
    }
}

// A bumper: whatever touches it is kicked away along the contact normal, and
// it lights up. The kick is an impulse, so a heavy ball leaves slower.
script Bumper {
    var glow: f32 = 0.0;
    fn update(dt: f32) {
        this.glow = max(0.0, this.glow - dt * 4.0);
        for other in Physics.collision_started() {
            if World.has_tag(other, "loose") || World.has_tag(other, "body") {
                let here = this.transform.world_position;
                let there = other.transform.world_position;
                let away = Vec2(there.x - here.x, there.y - here.y).normalized;
                Physics.apply_impulse(other, away.x * 1.6, away.y * 1.6);
                this.glow = 1.0;
                Pit.score += 100.0;
                Effects.burst_at(World.find("bumper-sparks"), there.x, there.y);
            }
        }
        this.shape.fill = Color(1.0, 0.36 + this.glow * 0.6, 0.56 + this.glow * 0.4, 1.0);
        this.transform.scale = Vec3(1.4 + this.glow * 0.25, 1.4 + this.glow * 0.25, 1.0);
    }
}

// Ice, wood and rubber on one frictionless ramp. They do not collide with one
// another, so each has the ramp to itself; only their materials differ.
script Racer {
    @export let lane: f32 = 0.0;
    var home: Vec3 = Vec3(0.0, 0.0, 0.0);
    var turn: f32 = 0.0;
    fn start() {
        this.home = this.transform.position;
        this.turn = this.transform.rotation_z;
    }
    on ToyAction(toy, action) {
        if toy != 5.0 { return; }
        if action == 1.0 { go(2.5); }
        if action == 3.0 { go(7.0); }
    }
    on ResetToy(toy) {
        if toy == 0.0 || toy == 5.0 { go(0.0); }
    }
    // Back to the top of the ramp, then the same push down the slope for all.
    fn go(push: f32) {
        this.transform.position = this.home;
        this.transform.rotation_z = this.turn;
        let along = Vec2(cos(this.turn), sin(this.turn));
        Physics.set_velocity(this.entity, along.x * push, along.y * push);
        Physics.set_angular_velocity(this.entity, 0.0);
    }
    // Read by the lab's readout. A field, because another script's function
    // is a message: it runs after the pass and gives nothing back.
    var travelled: f32 = 0.0;
    fn update(dt: f32) {
        this.travelled = this.transform.position.x - this.home.x;
    }
}

// The same ball dropped on four pads; remembers how high it came back up.
script Bouncer {
    @export let pad: f32 = 0.0;
    var home: Vec3 = Vec3(0.0, 0.0, 0.0);
    var landed: bool = false;
    var bounces: f32 = 0.0;
    var peak: f32 = 0.0;
    // How high the bounce came back above where it rests on its pad.
    var rebound: f32 = 0.0;
    fn start() { this.home = this.transform.position; }
    fn update(dt: f32) {
        // The first bounce only: later ones are lower and would hide it.
        for other in Physics.collision_started() {
            this.bounces += 1.0;
            if !this.landed {
                this.landed = true;
                this.peak = this.transform.position.y;
            }
        }
        if this.bounces == 1.0 && this.transform.position.y > this.peak {
            this.peak = this.transform.position.y;
        }
        let mark = World.find("bounce-mark-" + pad_name(this.pad));
        if this.landed {
            mark.transform.position.y = this.peak;
            this.rebound = this.peak + 13.5 - 0.35;
        }
    }
    on ToyAction(toy, action) {
        if toy == 5.0 && action == 2.0 { drop(); }
    }
    on ResetToy(toy) {
        if toy == 0.0 || toy == 5.0 { drop(); }
    }
    fn drop() {
        this.transform.position = this.home;
        Physics.set_velocity(this.entity, 0.0, 0.0);
        this.landed = false;
        this.bounces = 0.0;
        this.peak = this.home.y;
        this.rebound = 0.0;
    }
}

shared fn pad_name(index: f32) -> String {
    if index == 1.0 { return "steel"; }
    if index == 2.0 { return "wood"; }
    if index == 3.0 { return "clay"; }
    return "rubber";
}

script MaterialLab {
    fn update(dt: f32) {
        if Game.toy != 5.0 { return; }
        let ice = Racer.on(World.find("racer-ice")).travelled;
        let wood = Racer.on(World.find("racer-wood")).travelled;
        let rubber = Racer.on(World.find("racer-rubber")).travelled;
        var bounce = "";
        for i in 0..4 {
            let height = Bouncer.on(World.find("bouncer-" + pad_name(i))).rebound;
            bounce = bounce + "  " + pad_name(i) + " " + height.fixed(1);
        }
        Ui.set_text(World.find("hint"), "RACE ice " + ice.fixed(1) + "  wood " + wood.fixed(1) + "  rubber " + rubber.fixed(1) + "   /   BOUNCE" + bounce);
    }
    on ToyAction(toy, action) {
        if toy == 5.0 && action == 4.0 { ResetToy.emit(5.0); }
    }
}

// The seesaw's anvil hangs on a rope; dropping it cuts the rope. The
// trampoline's two springs can be made stiffer or softer.
script Seesaw {
    var stiffness: f32 = 160.0;
    fn update(dt: f32) {
        let rope = World.find("anvil-rope-line");
        let hanging = Physics.joint_enabled(World.find("anvil-rope"));
        World.set_active(rope, hanging);
        if hanging {
            let hook = World.find("anvil-hook").transform.world_position;
            let anvil = World.find("anvil").transform.world_position;
            line(rope, Vec2(hook.x, hook.y), Vec2(anvil.x, anvil.y), 0.05);
        }
        if Game.toy == 6.0 {
            let ball = World.find("seesaw-ball").transform.world_position;
            Ui.set_text(World.find("hint"), "Ball height " + (ball.y + 14.0).fixed(1) + "   /   trampoline springs " + this.stiffness + " N/m");
        }
    }
    on ToyAction(toy, action) {
        if toy != 6.0 { return; }
        if action == 1.0 {
            Physics.set_joint_enabled(World.find("anvil-rope"), false);
            print("Playground anvil dropped");
        }
        if action == 2.0 {
            let ball = World.find("tramp-ball");
            ball.transform.position = Vec3(-7.0, -3.0, 0.25);
            Physics.set_velocity(ball, 0.0, 0.0);
            print("Playground trampoline ball");
        }
        if action == 3.0 { tune(this.stiffness * 1.5); }
        if action == 4.0 { tune(this.stiffness / 1.5); }
    }
    on ResetToy(toy) {
        if toy == 0.0 || toy == 6.0 { tune(160.0); }
    }
    fn tune(stiffness: f32) {
        this.stiffness = clamp(round(stiffness), 20.0, 1200.0);
        Physics.set_spring(World.find("tramp-spring-left"), 2.2, this.stiffness, 0.4);
        Physics.set_spring(World.find("tramp-spring-right"), 2.2, this.stiffness, 0.4);
        print("Playground trampoline " + this.stiffness);
    }
}
