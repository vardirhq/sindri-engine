// Everything here reads what the player means -- `move` and `boost` -- rather
// than which key they pressed. The scene's `sindri.input.actions` says what
// each is bound to, and the buttons below rebind `boost` while it runs.
script InputDemo {
    // Which binding of `boost` the next key goes to, or -1 when not waiting.
    var waiting: f32 = -1.0;

    fn update(dt: f32) {
        if this.waiting < 0.0 {
            if Ui.is_pressed(World.find("rebind")) || Input.just_pressed("K") {
                listen(0.0);
            } else if Ui.is_pressed(World.find("add")) {
                listen(Action.bindings("boost").length);
            }
        } else {
            capture();
        }
        Ui.set_text(World.find("move-label"), "MOVE   " + listed("move"));
        Ui.set_text(World.find("boost-label"), "BOOST   " + listed("boost"));
        fit_arena();
    }

    // The arena fills the room the layout left between the bindings and the
    // controls, read in overlay units (half the screen's height is one) and
    // turned into the world's, so a phone held upright gets a tall arena and
    // a desktop a wide one.
    fn fit_arena() {
        let bindings = World.find("bindings");
        let status = World.find("status");
        let upper = Ui.position(bindings).y - Ui.size(bindings).y * 0.5;
        let lower = Ui.position(status).y + Ui.size(status).y * 0.5;
        var high: f32 = 12.0;
        if Viewport.aspect < 1.0 { high = 12.0 / Viewport.aspect; }
        let unit = high * 0.5;
        let gap = 0.04;
        let wide = Ui.size(bindings).x;
        let arena = World.find("arena");
        arena.transform.scale = Vec3(wide * unit, max(0.5, (upper - lower - gap * 2.0) * unit), 1.0);
        arena.transform.position = Vec3(0.0, (upper + lower) * 0.5 * unit, -0.5);
    }

    fn listen(index: f32) {
        this.waiting = index;
        Ui.set_text(World.find("status"), "Press a key or a pad button for BOOST. Escape cancels.");
        print("Input waiting");
    }

    // The next key, mouse button or pad button becomes the binding. The
    // click that asked is not it, so the mouse is skipped.
    fn capture() {
        let pressed = Action.last_pressed();
        if pressed == "" || pressed.starts_with("mouse.") { return; }
        if pressed == "key.Escape" {
            Ui.set_text(World.find("status"), "Rebinding cancelled.");
        } else {
            Action.rebind("boost", this.waiting, pressed);
            Ui.set_text(World.find("status"), "BOOST is now on " + pressed + ".");
            print("Input rebound " + pressed);
        }
        this.waiting = -1.0;
    }

    // Each binding as its text, short enough to read: `key.` is understood,
    // and a pad is said as a pad.
    fn listed(action: String) -> String {
        var said = "";
        for binding in Action.bindings(action) {
            if said != "" { said = said + "   "; }
            said = said + binding.replace("key.", "").replace("gamepad.", "pad ");
        }
        return said;
    }
}

script Ship {
    @export let speed: f32 = 3.0;

    fn update(dt: f32) {
        let way = Action.vector("move");
        var pace = this.speed;
        this.shape.fill = Color(0.18, 0.82, 1.0, 1.0);
        if Action.held("boost") {
            pace = this.speed * 2.5;
            this.shape.fill = Color(1.0, 0.52, 0.22, 1.0);
        }
        if Action.pressed("boost") { print("Input boost"); }
        // Kept inside the arena, whatever shape the screen gave it.
        let arena = World.find("arena");
        let reach_x = arena.transform.scale.x * 0.5 - 0.3;
        let reach_y = arena.transform.scale.y * 0.5 - 0.3;
        let centre_y = arena.transform.position.y;
        let p = this.transform.position;
        this.transform.position = Vec3(
            max(-reach_x, min(reach_x, p.x + way.x * pace * dt)),
            max(centre_y - reach_y, min(centre_y + reach_y, p.y + way.y * pace * dt)),
            p.z
        );
    }
}
