          "actions": [
            {
              "name": "move",
              "kind": "vector",
              "bindings": [
                {
                  "vector": {
                    "up": "key.W",
                    "down": "key.S",
                    "left": "key.A",
                    "right": "key.D"
                  }
                },
                {
                  "vector": {
                    "up": "key.ArrowUp",
                    "down": "key.ArrowDown",
                    "left": "key.ArrowLeft",
                    "right": "key.ArrowRight"
                  }
                },
                {
                  "vector": {
                    "up": "gamepad.dpad_up",
                    "down": "gamepad.dpad_down",
                    "left": "gamepad.dpad_left",
                    "right": "gamepad.dpad_right"
                  }
                }
              ]
            },
            {
              "name": "boost",
              "kind": "button",
              "bindings": [
                "key.Space",
                "gamepad.south"
              ]
            }
          ]
        },
        "sindri.script": {
          "source": "input.decay",
