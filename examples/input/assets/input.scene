                    "left": "gamepad.dpad_left",
                    "right": "gamepad.dpad_right"
                  }
                }
              ]
            },
            {
              "name": "boost",
              "kind": "button",
              "bindings": [
                "key.Space",
                "gamepad.south"
              ]
            }
          ]
        },
        "sindri.script": {
          "source": "input.decay",
