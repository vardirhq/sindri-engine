          "actions": [
            {
              "name": "move",
              "kind": "vector",
              "bindings": [
                {
                  "vector": {
                    "up": "key.W",
                    "down": "key.S",
                    "left": "key.A",
                    "right": "key.D"
                  }
                },
                {
                  "vector": {
                    "up": "key.ArrowUp",
                    "down": "key.ArrowDown",
                    "left": "key.ArrowLeft",
                    "right": "key.ArrowRight"
                  }
                },
                {
                  "vector": {
