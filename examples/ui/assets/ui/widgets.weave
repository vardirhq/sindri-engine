/* Weave Control Room: every size, colour and state the widgets show.
   Decay writes values and words; this decides how they look. */

:root {
    --ink: #e6f0f7;
    --muted: #8aa1b6;
    --accent: #5fe3cf;
    --accent-deep: #0f3b3a;
    --panel: #0b1522;
    --well: #07101b;
    --line: #22384c;
    --control: #0f1c2b;
    --warm: #f0b35a;
}

sindri.ui.text { color: var(--ink); }
/* Wrapped to its box, so a label set to start lines up with its box's edge. */
.control-label, .input-text, .row-label, .row-number, .section-title, .small { text-wrap: word; }

.room {
    width: 100vw;
    height: 100vh;
    padding: 26px;
    direction: column;
    gap: 14px;
    justify-content: start;
    align-items: center;
}

.masthead {
    width: 100%;
    height: 66px;
    direction: column;
    gap: 4px;
    justify-content: center;
    align-items: center;
}
.heading { width: 100%; height: 38px; font-size: 30px; letter-spacing: 4px; text-align: center; }
.subtitle { width: 100%; height: 22px; font-size: 14px; color: var(--muted); text-align: center; }

.deck {
    width: 100%;
    height: 356px;
    direction: row;
    gap: 28px;
    justify-content: center;
    align-items: start;
}

.panel {
    width: 46%;
    max-width: 460px;
    height: 356px;
    padding: 18px;
    direction: column;
    gap: 10px;
    justify-content: start;
    align-items: center;
    background: var(--panel);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 14px;
}
.section-title { width: 100%; height: 26px; font-size: 14px; letter-spacing: 3px; color: var(--accent); text-align: start; }
.small { width: 100%; height: 18px; font-size: 11px; color: var(--muted); text-align: start; }
.readout { width: 100%; height: 20px; font-size: 12px; letter-spacing: 2px; color: var(--warm); text-align: start; text-wrap: word; }

/* Toggle, checkbox and field share one control shape. */
.control {
    width: 100%;
    height: 46px;
    padding: 0px 14px;
    direction: row;
    justify-content: space-between;
    align-items: center;
    background: var(--control);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 9px;
}
.control:hover { background: #142638; border-color: #3b5a73; }
.control:focus { border-color: var(--accent); border-width: 2px; }
.control:disabled { background: #0a121c; border-color: #17232f; }
.control-label { width: 72%; height: 22px; font-size: 15px; text-align: start; }
.control:disabled .control-label { color: #4d6072; }

.track { width: 46px; height: 24px; background: #1d2e40; border-radius: 12px; border-color: #2f4658; border-width: 1px; }
.knob { width: 18px; height: 18px; x: -11px; background: var(--muted); border-radius: 9px; }
.switch:checked .track { background: var(--accent-deep); border-color: var(--accent); }
.switch:checked .knob { x: 11px; background: var(--accent); }
.switch:disabled .knob { background: #33485a; }

.box { width: 24px; height: 24px; background: #0a1520; border-color: #3b5a73; border-width: 2px; border-radius: 5px; }
.tick { width: 12px; height: 12px; background: transparent; border-radius: 2px; }
.checkbox:checked .box { border-color: var(--accent); }
.checkbox:checked .tick { background: var(--accent); }

.input { justify-content: start; background: var(--well); }
.input-text { width: 100%; height: 22px; font-size: 15px; color: var(--ink); text-align: start; }

/* The archive: a clipped list that is as tall as its rows. */
.scroll {
    width: 100%;
    height: 236px;
    padding: 6px;
    gap: 5px;
    background: var(--well);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 8px;
}
.archive-row {
    width: 100%;
    height: 36px;
    padding: 0px 12px;
    flex-shrink: 0;
    gap: 14px;
    background: #10202f;
    border-color: #1c3043;
    border-width: 1px;
    border-radius: 6px;
}
.archive-row:hover { background: #17334a; border-color: #3f7a8a; }
.archive-row:active { background: var(--accent-deep); border-color: var(--accent); }
.archive-row:disabled { background: #0b141e; border-color: #141f2a; }
.row-number { width: 28px; height: 18px; font-size: 12px; color: var(--accent); text-align: start; }
.row-label { width: 78%; height: 18px; font-size: 14px; text-align: start; }
.archive-row:disabled .row-number, .archive-row:disabled .row-label { color: #45596b; }

.status { width: 100%; height: 26px; font-size: 16px; letter-spacing: 1px; color: var(--accent); text-align: center; }
.footer { width: 100%; height: 18px; font-size: 11px; letter-spacing: 1px; color: var(--muted); text-align: center; }

/* Phones: the two panels stack, and everything takes the width. */
@media (orientation: portrait) {
    .room { padding: 16px; gap: 10px; }
    .masthead { height: 54px; }
    .heading { height: 30px; font-size: 21px; letter-spacing: 2px; }
    .subtitle { height: 18px; font-size: 12px; }
    .deck { height: 670px; direction: column; gap: 12px; align-items: center; }
    .panel { width: 100%; padding: 14px; gap: 8px; }
    .settings { height: 314px; }
    .inventory { height: 346px; }
    .scroll { height: 262px; }
    .control-label { font-size: 14px; }
    .status { height: 22px; font-size: 13px; }
    .footer { height: 16px; font-size: 9px; letter-spacing: 0px; }
}

/* Short landscape: a phone on its side. Tighter rows, same two panels. */
@media (orientation: landscape) and (max-height: 460px) {
    .room { padding: 10px; gap: 6px; }
    .masthead { height: 40px; gap: 0px; }
    .heading { height: 26px; font-size: 20px; }
    .subtitle { height: 14px; font-size: 11px; }
    .deck { height: 236px; }
    .panel { height: 236px; padding: 10px; gap: 5px; }
    .section-title { height: 18px; font-size: 12px; }
    .control { height: 36px; }
    .control-label { font-size: 13px; }
    .scroll { height: 160px; }
    .archive-row { height: 30px; }
    .small { height: 14px; font-size: 10px; }
    .readout { height: 14px; font-size: 10px; }
    .status { height: 18px; font-size: 12px; }
    .footer { height: 14px; font-size: 9px; }
}
