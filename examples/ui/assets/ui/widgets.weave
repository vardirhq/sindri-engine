.heading { width: 90vw; height: 48px; font-size: 30px; color: #f1f5f9; letter-spacing: 3px; text-align: center; }
.subtitle { width: 90vw; height: 30px; font-size: 15px; color: #91a7be; text-align: center; }
.panel { background: #0c1726; border-color: #284256; border-width: 1px; border-radius: 12px; box-shadow: 0px 10px 28px #00000070; }
.section-title { width: 95%; height: 28px; color: #73dfcf; font-size: 16px; letter-spacing: 2px; text-align: center; }
.copy, .control-label, .row-label { color: #dce9f2; font-size: 15px; text-align: center; }
.small { width: 95%; height: 28px; color: #91a7be; font-size: 12px; text-align: center; }
.toggle, .input { background: #101f31; border-color: #3d5871; border-width: 1px; border-radius: 7px; }
.toggle:checked { background: #123c3b; border-color: #53dfb5; }
.toggle:hover, .archive-row:hover { background: #204355; border-color: #78dfd0; }
.input:focus { border-color: #78dfd0; border-width: 2px; }
.scroll { background: #08111e; border-color: #264052; border-width: 1px; border-radius: 3px; }
.archive-row { background: #142439; border-color: #263c52; border-width: 1px; border-radius: 4px; }
.status { width: 92vw; height: 30px; color: #76e5c0; font-size: 16px; text-align: center; letter-spacing: 1px; }
.footer { width: 92vw; height: 26px; color: #91a7be; font-size: 12px; text-align: center; }
@media (orientation: portrait) {
    .heading { y: 0.92; font-size: 21px; letter-spacing: 1px; }
    .subtitle { y: 0.83; font-size: 13px; }
    .panel { width: 88vw; height: 0.69; }
    .settings { x: 0; y: 0.38; }
    .inventory { x: 0; y: -0.36; }
    .section-title { y: 0.27; font-size: 13px; }
    .toggle, .input { width: 78vw; height: 0.105; }
    #toggle { y: 0.13; }
    #checkbox { y: 0; }
    #callsign { y: -0.13; }
    #input-help { y: -0.26; }
    .control-label { width: 70vw; font-size: 14px; }
    .scroll { width: 78vw; height: 0.43; y: -0.02; }
    .archive-row { width: 72vw; }
    .row-label { width: 66vw; font-size: 14px; }
    #scroll-help { y: -0.28; font-size: 10px; }
    .status { y: -0.80; font-size: 13px; }
    .footer { y: -0.94; font-size: 10px; }
}
