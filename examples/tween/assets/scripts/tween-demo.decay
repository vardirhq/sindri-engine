// A feature example: managed playback, with game decisions entirely in Decay.
state Demo {
    var action: f32 = 0.0;
    var revision: f32 = 0.0;
}
script TweenDemo {
    @export let easing: String = "linear";
    var movement: Vec3Tween = null;
    var size: Vec3Tween = null;
    var tint: ColorTween = null;
    var turn: NumberTween = null;
    var revision: f32 = 0.0;
    var right: bool = true;
    var span: f32 = 1.8;

    fn start() {
        this.span = min(2.6, Viewport.aspect * 2.6);
        let position = this.transform.position;
        this.transform.position = Vec3(-this.span, position.y, position.z);
        create();
    }
    fn create() {
        var target = this.span;
        if !this.right { target = -this.span; }
        let position = this.transform.position;
        this.movement = Tween.vec3(position, Vec3(target, position.y, position.z), 2.5, this.easing);
        this.size = Tween.vec3(this.transform.scale, Vec3(0.55, 0.55, 1.0), 2.5, this.easing);
        this.tint = Tween.color(this.shape.fill, Color(1.0, 0.52, 0.22, 1.0), 2.5, this.easing);
        this.turn = Tween.number(this.transform.rotation_z, 6.2831853, 2.5, this.easing);
    }
    fn update(dt: f32) {
        if this.revision != Demo.revision {
            this.revision = Demo.revision;
            control();
        }
        this.transform.position = Tween.vec3_value(this.movement);
        this.transform.scale = Tween.vec3_value(this.size);
        this.shape.fill = Tween.color_value(this.tint);
        this.transform.rotation_z = Tween.number_value(this.turn);
    }
    fn control() {
        if Demo.action == 1.0 {
            Tween.resume(this.movement); Tween.resume(this.size);
            Tween.resume(this.tint); Tween.resume(this.turn);
        } else if Demo.action == 2.0 {
            Tween.pause(this.movement); Tween.pause(this.size);
            Tween.pause(this.tint); Tween.pause(this.turn);
        } else if Demo.action == 3.0 {
            Tween.restart(this.movement); Tween.restart(this.size);
            Tween.restart(this.tint); Tween.restart(this.turn);
        } else if Demo.action == 4.0 {
            Tween.cancel(this.movement); Tween.cancel(this.size);
            Tween.cancel(this.tint); Tween.cancel(this.turn);
        } else {
            // Replacement starts at the currently displayed value.
            Tween.dispose(this.movement); Tween.dispose(this.size);
            Tween.dispose(this.tint); Tween.dispose(this.turn);
            this.right = !this.right;
            create();
        }
    }
}
script TweenControls {
    fn update(dt: f32) {
        if Input.just_pressed("P") { request(2.0); }
        if Input.just_pressed("R") { request(3.0); }
        if Input.just_pressed("C") { request(4.0); }
        if Input.just_pressed("V") { request(5.0); }
        if Input.just_pressed("Space") { request(1.0); }
    }
    fn request(action: f32) {
        Demo.action = action;
        Demo.revision += 1.0;
        print("Tween demo action " + action);
    }
}
script TweenButton {
    @export let action: f32 = 1.0;
    fn update(dt: f32) {
        if Ui.is_pressed(this.entity) {
            Demo.action = this.action;
            Demo.revision += 1.0;
            print("Tween demo action " + this.action);
        }
    }
}
// Composition: across and back as a sequence, the return waiting half a
// second after the crossing, while a yoyo makes the marker breathe for ever.
script TweenSequence {
    var across: Vec3Tween = null;
    var back: Vec3Tween = null;
    var breathe: Vec3Tween = null;
    var revision: f32 = 0.0;
    var span: f32 = 1.8;

    fn start() {
        this.span = min(2.6, Viewport.aspect * 2.6);
        create();
    }
    fn create() {
        let y = this.transform.position.y;
        let left = Vec3(-this.span, y, 0.0);
        let right = Vec3(this.span, y, 0.0);
        this.across = Tween.vec3(left, right, 1.2, "ease-in-out");
        this.back = Tween.vec3(right, left, 1.2, "ease-in-out");
        Tween.set_delay(this.back, 0.5);
        Tween.after(this.back, this.across);
        this.breathe = Tween.vec3(Vec3(0.23, 0.23, 1.0), Vec3(0.34, 0.34, 1.0), 0.4, "ease-in-out");
        Tween.set_loops(this.breathe, 0.0);
        Tween.set_yoyo(this.breathe, true);
    }
    fn update(dt: f32) {
        if this.revision != Demo.revision {
            this.revision = Demo.revision;
            control();
        }
        if Tween.is_done(this.across) {
            this.transform.position = Tween.vec3_value(this.back);
        } else {
            this.transform.position = Tween.vec3_value(this.across);
        }
        this.transform.scale = Tween.vec3_value(this.breathe);
    }
    fn control() {
        if Demo.action == 1.0 {
            Tween.resume(this.across); Tween.resume(this.back); Tween.resume(this.breathe);
        } else if Demo.action == 2.0 {
            Tween.pause(this.across); Tween.pause(this.back); Tween.pause(this.breathe);
        } else if Demo.action == 4.0 {
            Tween.cancel(this.across); Tween.cancel(this.back); Tween.cancel(this.breathe);
        } else {
            // Restart and replace both play the sequence again from the left.
            Tween.restart(this.across); Tween.restart(this.back); Tween.restart(this.breathe);
        }
    }
}
